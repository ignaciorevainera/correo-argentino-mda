# ============================================
# Correo Argentino MDA â€” Environment Variables
# ============================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# --- Storage ---
EXTERNAL_STORAGE_DIR="./data/storage"
# Root directory for all uploaded files (apps, icons, PDFs).
# Files are organized into subdirectories automatically:
#   {dir}/apps/  â€” application binaries (.zip, .exe, .msi, .rar)
#   {dir}/icons/ â€” icon files (.png, .jpg, .svg, .ico)
#   {dir}/pdfs/  â€” instruction PDFs (confidential, auth-protected)

# --- Session & Encryption ---
SESSION_SECRET=""
# A random 64-character hex string for session signing.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

ENCRYPTION_KEY=""
# A 32-character hex string for AES-256-GCM encryption of credentials.
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"

# --- HTTPS (producciÃ³n) ---
SESSION_COOKIE_SECURE="false"
# Poner en "true" cuando el portal se sirva por HTTPS. Marca la cookie de sesiÃ³n
# como Secure. En prod se define en ecosystem.config.cjs (runtime, sin rebuild).

INTERNAL_ORIGIN=""
# Opcional. Base URL para self-fetch server-side (el adapter de Astro en modo
# middleware no detecta https detrÃ¡s del proxy Apache). Default: http://127.0.0.1:{PORT}

# --- InvGate API ---
INVGATE_API_USERNAME="portalmda"
INVGATE_BASE_URL="https://correoargentino.sd.cloud.invgate.net/api/v1/"
INVGATE_API_KEY=""

# --- InvGate Automatizaciones (mÃ³dulo /automatizaciones) ---
INVGATE_AUTOMATION_GROUP_ID=""
# Override opcional de la/s cola/s (nivel de helpdesk en helpdesksandlevels)
# donde viven los tickets de automatizaciÃ³n de sucursales. Acepta uno o varios
# IDs separados por comas (producciÃ³n 2026-09 usa dos colas: el helpdesk AUTSUC
# y su nivel histÃ³rico). La cola se resuelve automÃ¡ticamente: helpdesk por
# nombre ("Mesa de CoordinaciÃ³n" o "TI_GSM_MDC AUTSUC") + desambiguaciÃ³n empÃ­rica
# de niveles contra la categorÃ­a resuelta. Usar solo si esa resoluciÃ³n falla o
# como fast-path de performance.

INVGATE_AUTOMATION_CATEGORY_ID=""
# Override opcional del ID de la categorÃ­a hoja. La categorÃ­a se resuelve
# automÃ¡ticamente por la ruta vigente (2026-09:
# "Tecnologia informatica Â» GestiÃ³n de Servicios Â» Mesa de CoordinaciÃ³n Â»
# Proyectos Â» Automatizar sucursal"); usar solo si esa ruta cambia o falla.

INVGATE_AUTOMATION_VIEW_ID=""
# Override opcional: ID de una vista guardada de InvGate filtrada SOLO por la
# categorÃ­a hoja de automatizaciones (sin filtro de mesa ni de estado). Es la
# fuente autoritativa de padres por categorÃ­a: trae los tickets asignados a
# CUALQUIER mesa, incluidos los finalizados (producciÃ³n 2026-10: view 64).
# Si se deja vacÃ­o, se usa el sweep por estado (activos) + tracking persistido.

# --- Caches del mÃ³dulo /automatizaciones (minutos) ---
AUTOMATION_DETAIL_TTL_MIN="5"
# Snapshot persistido del detalle resuelto: una pipeline por id cada TTL,
# compartida entre usuarios y restarts. Default 5.

AUTOMATION_CHILD_CACHE_TTL_MIN="30"
# Cache de tasks/solutions por ticket hijo (cambian poco). Default 30.

AUTOMATION_USERS_CACHE_TTL_MIN="1440"
# Cache de nombres de usuarios y del mapa de sectores. Default 1440 (24 h).

AUTOMATION_PROGRESS_TTL_MIN="2"
# Cache del progreso liviano de las cards del listado. Default 2.

INVGATE_METRICS="0"
# 1 = loguea el conteo de llamadas a la API de InvGate por flujo (mediciÃ³n).

AUTOMATION_CLOSE_THRESHOLD="80"
# Umbral de progreso (%) a partir del cual un admin puede cerrar un caso
# manualmente desde el portal (cierre local, no toca InvGate). Default 80.
# El flujo que llega al 100% sin etapas bloqueantes faltantes se finaliza
# automÃ¡ticamente en el portal.

AUTOMATION_AGE_THRESHOLD_DAYS="30"
# AntigÃ¼edad (dÃ­as) a partir de la cual un caso en curso se marca "crÃ­tico"
# en las mÃ©tricas. Default 30.

AUTOMATION_STALLED_THRESHOLD_DAYS="15"
# DÃ­as sin actualizaciÃ³n en InvGate para marcar un caso en curso como
# "estancado". Default 15.

# --- Mesa de autogestiones ---
INVGATE_AGENTS_HELPDESK_ID="3950"
# Helpdesk donde vive la cola de autogestiones. QA=3950, producciÃ³n=2510.
# Consumido por src/lib/invgate/agsHelpdesk.ts. OJO: si queda vacÃ­o o es
# invÃ¡lido el cÃ³digo usa 3950 (QA) silenciosamente â€” en producciÃ³n eso apunta
# a la mesa equivocada y la automatizaciÃ³n asigna sobre tickets de QA.

INVGATE_MOSAIC_VIEW_ID=""
# ID de la vista guardada de InvGate con los tickets Mosaic (errores de la
# aplicaciÃ³n de sucursal). Alimenta el monitoreo post-automatizaciÃ³n: si estÃ¡
# vacÃ­o, la secciÃ³n "Sucursales con errores post-automatizaciÃ³n" no consulta
# InvGate y muestra el aviso de configuraciÃ³n.

AUTOMATION_POST_WINDOW_DAYS="3"
# DÃ­as posteriores al cierre de la automatizaciÃ³n en los que se buscan errores
# de la sucursal (Mosaic/hardware) por `location_id`. Default 3.

AUTOMATION_POST_CANDIDATE_DAYS="30"
# DÃ­as hacia atrÃ¡s para considerar una automatizaciÃ³n "reciÃ©n finalizada" y
# revisar su ventana post-cierre. Default 30 (mayor que la ventana de errores,
# porque el monitoreo sigue siendo Ãºtil despuÃ©s de que la ventana se cierra).

# --- InvGate QA API (test environment) ---
INVGATE_QA_API_USERNAME="portalmda"
INVGATE_QA_BASE_URL="https://qacorreo.sd.cloud.invgate.net/api/v1/"
INVGATE_QA_API_KEY=""
# QA/test environment. Separate server from production. Use for testing requests that edit sensitive data.

# --- InvGate QA MCP (Model Context Protocol) ---
INVGATE_QA_MCP_URL="https://qacorreo.sd.cloud.invgate.net/mcp/v1"
INVGATE_QA_MCP_TOKEN=""
# Token for InvGate QA MCP server. One token per team, unlimited per profile.
# Configure in opencode.jsonc under mcp > "InvGate QA MCP" > headers > Authorization.

# --- Wise CX API ---
WISE_CX_BASE_URL="https://api.wcx.cloud"
WISE_CX_API_KEY=""
WISE_CX_API_USER=""
WISE_CX_WALLBOARD_COMPANY=
WISE_CX_WALLBOARD_TAB_GUID=
WISE_CX_WALLBOARD_WIDGET_ID=
# Wallboard de presencia (src/lib/wise-cx-presence.ts). Si falta cualquiera de
# las tres, la sección de presencia queda sin datos y loguea el aviso.
# Generate API key: Settings â†’ Canales â†’ Api in Wise CX dashboard.
# WISE_CX_API_USER is the username registered when generating the key.
# --- Evaluación IA de calidad (opencode headless; el modelo corre en la nube, no en el servidor) ---
# Requiere opencode instalado en el servidor (npm i -g opencode-ai). Listar modelos: opencode models
# Los modelos *-free pueden rotar o desaparecer; sin SLA.
OPENCODE_BIN="opencode"
OPENCODE_MODEL="opencode/deepseek-v4.1-flash-free"
OPENCODE_TIMEOUT_MS="120000"
OPENCODE_API_KEY=
# Opcional: API key de opencode. Si está, se escribe en un auth.json aislado por
# corrida (src/lib/ai/opencodeProvider.ts:119). Vacío = usa la auth global del binario.

# LDAP (api/usuarios/ad-groups-licenses.ts, api/usuarios/net-user.ts)
LDAP_SERVER=ldap://servidor.correo.local
LDAP_PORT=389
LDAP_BASE_DN=DC=correo,DC=local
LDAP_USER=usuario_consulta
LDAP_PASS=cambiar
LDAP_TIMEOUT_MS=5000
# Timeout de conexión LDAP en ms (src/lib/ldap.ts). Default 5000.
LDAP_TLS_CA_PATH=
# Ruta al CA corporativo para LDAPS. Vacío = usa el trust store del sistema.
LDAP_TLS_REJECT_UNAUTHORIZED=
# Reservado: declarado en src/lib/env.ts, hoy ningún módulo lo consume.

# MidPoint (scripts/sync-users.ts)
MIDPOINT_USER=cambiar
MIDPOINT_PASS=cambiar
MIDPOINT_URL=https://cdc.correoargentino.com.ar
# Base de MidPoint usada por scripts/sync-users.ts. Se puede apuntar a otro
# entorno sin editar el script.

# Express SSR (server.mjs; en prod lo define ecosystem.config.cjs)
PORT=4321
HOST=127.0.0.1

# Scripts de mantenimiento
LEGACY_INVENTORY_URL=http://host-interno/mda/terminales_consulta.php
REVAL_OUT=./reval-out.json
TITLE_KB_THRESHOLD=0.6
INVGATE_MCP_TOKEN=cambiar
MDA_SKIP_PRE_PUSH=0
# "1" omite el chequeo pre-push (src/lib/deploy/prePushCheck.ts). Escape hatch
# para commits locales; nunca en el servidor.

DATABASE_PATH=./database/mda.db
# SQLite usado por scripts/reencrypt-credentials-v2.mts. Default ./database/mda.db.

# --- IA / transcripción ---
GROQ_API_KEY=
# API key de Groq para transcripción de audio (src/lib/ai/groqWhisper.ts).
# Sin ella el endpoint de transcripción responde con error explícito.

# --- Entra ID (SSO) ---
ENTRA_ENABLED=0
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=
# Reservado: declarado en src/lib/env.ts, hoy ningún módulo lo consume (no hay SSO cableado).
