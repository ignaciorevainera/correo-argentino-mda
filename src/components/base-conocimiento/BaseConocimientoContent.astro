---
import { Icon } from "astro-icon/components";
import SectionCard from "@components/ui/SectionCard.astro";

const user = Astro.locals.user;
// Contenido real a futuro: filtrar server-side por helpdeskId (FK confiable),
// NUNCA por el nombre display del cliente.
const mesaName = (user?.helpdeskName ?? "Sin mesa de ayuda").trim();
---

<div class="space-y-4" id="base-conocimiento-root">
  <SectionCard title={`Contenido para ${mesaName}`}>
    <div class="flex flex-col items-center gap-3 py-12 text-center">
      <Icon
        name="boxicons:book-content-filled"
        size={48}
        class="text-base-content/30"
      />
      <p class="text-base-content/60 max-w-md text-sm">
        Todavía no hay artículos publicados para
        <strong>{mesaName}</strong>. El contenido de esta sección se cargará
        próximamente y quedará dedicado a tu mesa de ayuda.
      </p>
    </div>
  </SectionCard>
</div>
