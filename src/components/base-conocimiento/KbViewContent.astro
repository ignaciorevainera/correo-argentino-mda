---
import { Icon } from "astro-icon/components";
import ActionButton from "@components/ui/ActionButton.astro";
import { getCleanBase } from "@lib/baseUrl";
import { resolveUrl } from "@lib/url";
import { renderMarkdown } from "@lib/markdown";
import type { KbArticle } from "@lib/kb";

interface Props {
  article: KbArticle | null;
  canWrite: boolean;
  isAdmin: boolean;
  loadError?: boolean;
  csrfToken: string;
}

const { article, canWrite, isAdmin, loadError = false, csrfToken } = Astro.props;
const backHref = resolveUrl("/base-conocimiento");
const editHref = article
  ? resolveUrl(`/base-conocimiento/edit/${article.id}`)
  : resolveUrl("/base-conocimiento");

const statusLabels: Record<string, string> = {
  draft: "Borrador",
  published: "Publicado",
  archived: "Archivado",
};

const statusClasses: Record<string, string> = {
  draft: "badge-warning",
  published: "badge-success",
  archived: "badge-neutral",
};

const articleStatus = article?.status ?? "";
const statusLabel = statusLabels[articleStatus] ?? "Estado desconocido";
const statusClass = statusClasses[articleStatus] ?? "badge-ghost";
const updatedAtDate = article?.updatedAt
  ? new Date(article.updatedAt as string | Date)
  : null;
const updatedAtLabel =
  updatedAtDate && !Number.isNaN(updatedAtDate.getTime())
    ? new Intl.DateTimeFormat("es-AR", {
        dateStyle: "medium",
        timeStyle: "short",
      }).format(updatedAtDate)
    : "Sin fecha de actualización";
const articleHtml = article
  ? renderMarkdown(article.content, { imageBase: getCleanBase() })
  : "";
---

{
  loadError ? (
    <div class="alert alert-error" role="alert">
      <Icon name="boxicons:x-circle-filled" size={24} />
      <div>
        <p class="font-semibold">No se pudo cargar el artículo.</p>
        <p class="text-sm">Intentá de nuevo más tarde.</p>
      </div>
    </div>
  ) : article ? (
    <article class="space-y-6">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0">
          <a
            href={backHref}
            class="text-base-content/60 hover:text-secondary mb-3 inline-flex items-center gap-1 text-sm font-semibold"
          >
            <Icon name="boxicons:arrow-big-left-filled" size={24} />
            Volver a la base de conocimiento
          </a>
          <h1 class="text-base-content text-3xl font-bold tracking-tight">
            {article.title}
          </h1>
          <div class="text-base-content/60 mt-3 flex flex-wrap items-center gap-2 text-sm">
            <span class="badge badge-ghost">
              {article.category || "Sin categoría"}
            </span>
            {isAdmin && (
              <span class="badge badge-accent">
                {article.mesaName || "Mesa desconocida"}
              </span>
            )}
            <span>Autor: {article.authorName || "Desconocido"}</span>
            <span>Actualizado: {updatedAtLabel}</span>
            {canWrite && (
              <span class={`badge ${statusClass}`}>{statusLabel}</span>
            )}
          </div>
        </div>
        {canWrite && article && (
          <div class="flex shrink-0 flex-wrap items-center gap-2">
            <ActionButton
              href={editHref}
              size="md"
              icon="boxicons:pencil-filled"
              label="Editar artículo"
            />
            <form
              method="POST"
              action={`${getCleanBase()}base-conocimiento/${article.id}/eliminar`}
              onsubmit="return confirm('¿Mover este artículo a la papelera?')"
            >
              <input type="hidden" name="csrf_token" value={csrfToken} />
              <ActionButton
                type="submit"
                variant="soft"
                color="btn-error"
                size="md"
                icon="boxicons:trash-filled"
                label="Eliminar"
                ariaLabel="Eliminar artículo"
              />
            </form>
          </div>
        )}
      </div>

      <div class="border-base-300 bg-base-100 rounded-box border p-6 shadow-sm sm:p-8">
        <div class="kb-article-body max-w-4xl" set:html={articleHtml} />
      </div>
    </article>
  ) : null
}

<style is:global>
  .kb-article-body {
    color: var(--color-base-content);
    font-size: 1rem;
    line-height: 1.75;
  }

  .kb-article-body > :first-child {
    margin-top: 0;
  }

  .kb-article-body > :last-child {
    margin-bottom: 0;
  }

  .kb-article-body h1,
  .kb-article-body h2,
  .kb-article-body h3,
  .kb-article-body h4,
  .kb-article-body h5,
  .kb-article-body h6 {
    color: var(--color-base-content);
    font-weight: 700;
    line-height: 1.25;
    margin: 1.75rem 0 0.5rem;
  }

  .kb-article-body h1 {
    font-size: 1.875rem;
  }

  .kb-article-body h2 {
    font-size: 1.75rem;
  }

  .kb-article-body h3 {
    font-size: 1.375rem;
  }

  .kb-article-body h4 {
    font-size: 1.125rem;
    font-weight: 600;
  }

  .kb-article-body h5 {
    font-size: 1rem;
    font-weight: 600;
  }

  .kb-article-body h6 {
    color: color-mix(in oklab, var(--color-base-content) 70%, transparent);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .kb-article-body p {
    margin: 0 0 0.875rem;
  }

  .kb-article-body ul,
  .kb-article-body ol,
  .kb-article-body blockquote,
  .kb-article-body pre,
  .kb-article-body table {
    margin: 1rem 0;
  }

  .kb-article-body ul,
  .kb-article-body ol {
    padding-left: 1.5rem;
  }

  .kb-article-body ul {
    list-style: disc;
  }

  .kb-article-body ol {
    list-style: decimal;
  }

  .kb-article-body ul:has(> li > input[type="checkbox"]) {
    list-style: none;
    padding-left: 0.25rem;
  }

  .kb-article-body li > input[type="checkbox"] {
    margin-right: 0.5rem;
    vertical-align: middle;
  }

  .kb-article-body li > ul,
  .kb-article-body li > ol {
    margin: 0.25rem 0;
  }

  .kb-article-body a {
    color: var(--color-secondary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .kb-article-body strong {
    font-weight: 700;
  }

  .kb-article-body blockquote {
    border-left: 4px solid var(--color-base-300);
    color: var(--color-base-content);
    padding-left: 1rem;
  }

  .kb-article-body code {
    background-color: var(--color-base-200);
    border-radius: var(--radius-field);
    font-family: var(--font-mono);
    padding: 0.125rem 0.35rem;
  }

  .kb-article-body pre {
    background-color: var(--color-neutral);
    border-radius: var(--radius-box);
    color: var(--color-neutral-content);
    overflow-x: auto;
    padding: 1rem;
  }

  .kb-article-body pre code {
    background-color: transparent;
    padding: 0;
  }

  .kb-article-body img {
    border-radius: var(--radius-box);
    height: auto;
    max-width: 100%;
  }

  .kb-article-body table {
    border-collapse: collapse;
    display: block;
    max-width: 100%;
    overflow-x: auto;
    width: max-content;
  }

  .kb-article-body th,
  .kb-article-body td {
    border: 1px solid var(--color-base-300);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }

  .kb-article-body th {
    background-color: var(--color-base-200);
    font-weight: 700;
  }

  .kb-article-body hr {
    border-color: var(--color-base-300);
    margin: 1.5rem 0;
  }
</style>
