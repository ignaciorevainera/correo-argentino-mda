---
import CopyButton from "@components/ui/CopyButton.astro";
import ActionEditButton from "@components/ui/ActionEditButton.astro";
import ActionInvGateButton from "@components/ui/ActionInvGateButton.astro";
import ActionNetUserButton from "@components/ui/ActionNetUserButton.astro";

const userRole = Astro.locals.user?.role || "";
const isAdmin = userRole === "admin";
---

<template id="user-card-template">
  <div
    class="card bg-base-100 border-base-300 hover:border-base-content/20 border shadow-md transition-all duration-300"
  >
    <div class="card-body gap-4 p-4">
      <div class="flex min-w-0 items-center gap-4">
        <div class="avatar placeholder shrink-0">
          <div
            class="flex size-12 items-center justify-center rounded-full text-lg font-bold"
            data-user-avatar-bg
            data-user-initials
          >
            ??
          </div>
        </div>
        <div class="min-w-0 flex-1">
          <h3
            class="text-base-content truncate text-base font-bold"
            data-user-nombre
          >
            Nombre Completo
          </h3>
          <div class="mt-1 flex items-center gap-1.5">
            <span data-invgate-badge></span>
          </div>
        </div>
      </div>

      <div class="flex grow flex-col gap-4">
        <div class="border-base-200 grid grid-cols-2 gap-4 border-y py-3">
          <div class="flex flex-col gap-1">
            <span
              class="text-xxs text-base-content/40 font-bold tracking-wider uppercase"
              >Usuario</span
            >
            <CopyButton
              value=""
              variant="value"
              size="xs"
              appearance="surface"
              monospace={true}
              fullWidth={true}
              class="user-card-username-btn w-full justify-between"
            />
          </div>
          <div class="flex flex-col gap-1">
            <span
              class="text-xxs text-base-content/40 font-bold tracking-wider uppercase"
              >Legajo</span
            >
            <CopyButton
              value=""
              variant="value"
              size="xs"
              appearance="surface"
              monospace={true}
              fullWidth={true}
              class="user-card-legajo-btn w-full justify-between"
            />
          </div>
          <div class="flex flex-col gap-1">
            <span
              class="text-xxs text-base-content/40 font-bold tracking-wider uppercase"
              >DNI</span
            >
            <CopyButton
              value=""
              variant="value"
              size="xs"
              appearance="surface"
              monospace={true}
              fullWidth={true}
              class="user-card-dni-btn w-full justify-between"
            />
          </div>
          <div class="flex flex-col gap-1">
            <span
              class="text-xxs text-base-content/40 font-bold tracking-wider uppercase"
              >Interno</span
            >
            <CopyButton
              value=""
              variant="value"
              size="xs"
              appearance="surface"
              monospace={true}
              fullWidth={true}
              class="user-card-interno-btn w-full justify-between"
            />
          </div>
          <div class="flex flex-col gap-1">
            <span
              class="text-xxs text-base-content/40 font-bold tracking-wider uppercase"
              >Teléfono</span
            >
            <CopyButton
              value=""
              variant="value"
              size="xs"
              appearance="surface"
              monospace={true}
              fullWidth={true}
              class="user-card-telefono-btn w-full justify-between"
            />
          </div>
        </div>

        <div class="flex flex-col gap-1">
          <span
            class="text-xxs text-base-content/40 font-bold tracking-wider uppercase"
            >Email</span
          >
          <CopyButton
            value=""
            variant="value"
            size="xs"
            appearance="surface"
            monospace={true}
            fullWidth={true}
            class="user-card-email-btn w-full justify-between"
          />
        </div>

        <div class="flex flex-col gap-1">
          <span
            class="text-xxs text-base-content/40 font-bold tracking-wider uppercase"
            >Ubicación</span
          >
          <div class="user-card-sucursal-wrap flex flex-wrap gap-1.5">
            <CopyButton
              value=""
              variant="value"
              size="xs"
              appearance="surface"
              monospace={true}
              fullWidth={false}
              class="user-card-sucursal-btn"
            />
          </div>
        </div>
      </div>

      <div
        class="card-actions border-base-200 mt-2 flex w-full items-center justify-end gap-2 border-t pt-3"
      >
        <ActionNetUserButton data-net-user-btn ariaLabel="Ver grupos de red" />
        <ActionEditButton data-edit-user-btn ariaLabel="Editar contacto" />
        {
          isAdmin && (
            <ActionInvGateButton
              data-invgate-create-ticket-btn
              ariaLabel="Crear solicitud en InvGate"
            />
          )
        }
      </div>
    </div>
  </div>
</template>
