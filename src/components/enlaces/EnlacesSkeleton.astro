---
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
---

<PageContainer width="xl">
  <div>
    <PageHeader
      description="Accesos clave para resolver tareas operativas de soporte con menos fricción."
      class="max-w-3xl"
    />

    <div class="skeleton mb-4 h-12 w-full max-w-md rounded-lg"></div>

    <!-- Announcement Banner Skeleton -->
    <div class="skeleton mb-6 h-28 w-full rounded-xl"></div>

    <!-- Masonry Grid Skeleton: misma fuente de columnas que el grid real
         (--columns-effective), para que el fallback no muestre 3 fijas.
         Sin `skeleton-debounced` a proposito (issue #123, propuesta #5): para
         /recursos el esqueleto conviene visible desde el primer paint, no tras
         el fade de 300ms. No reponer la clase. -->
    <div
      class="mt-4 grid gap-2"
      style="grid-template-columns: repeat(var(--columns-effective), minmax(0, 1fr));"
    >
      {
        Array.from({ length: 6 }).map((_, i) => (
          <div
            class={`card bg-base-100 border-base-300 rounded-2xl border p-5 shadow-sm ${i % 3 === 0 ? "h-64" : i % 3 === 1 ? "h-48" : "h-56"}`}
          >
            <div class="mb-4 flex items-center gap-3">
              <div class="skeleton size-8 rounded-lg" />
              <div class="skeleton h-5 w-36 rounded" />
            </div>
            <div class="space-y-4">
              {Array.from({
                length: i % 3 === 0 ? 3 : i % 3 === 1 ? 2 : 3,
              }).map(() => (
                <div class="flex flex-col gap-1">
                  <div class="skeleton h-4 w-44 rounded" />
                  <div class="skeleton h-3 w-64 rounded" />
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</PageContainer>
