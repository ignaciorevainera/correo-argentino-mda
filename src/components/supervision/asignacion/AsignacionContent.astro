              <span id="modal-assign-to-ticket-title" class="truncate font-semibold text-base-content">Selecciona un operador</span>
              <span id="modal-assign-to-ticket-creator" class="badge badge-soft badge-neutral badge-sm font-medium text-xs text-base-content/80 hidden"></span>
            </div>
          </div>
        </div>
        <form method="dialog">
          <button class="btn btn-sm btn-circle btn-ghost text-base-content/60 hover:text-base-content">✕</button>
        </form>
      </div>

      <!-- Barra de Configuración de Asignación / Revisión -->
      <div class="px-4 py-2.5 bg-base-200/50 border-b border-base-300 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2.5">
        <div class="flex items-center gap-2 min-w-0">
          <div id="modal-assign-to-revision-alert" class="hidden flex items-center gap-1.5 text-xs font-bold text-secondary bg-secondary/15 px-2.5 py-1 rounded-lg border border-secondary/30 shrink-0">
            <Icon name="boxicons:alert-octagon" size={16} class="shrink-0" />
            <span>Solicitud en revisión / rechazo</span>
          </div>
          <span class="text-xs text-base-content/60 font-medium truncate">
            Asigna sin modificar el turno del operador
          </span>
        </div>
        <label class="label cursor-pointer justify-start sm:justify-end gap-2.5 py-0 select-none shrink-0" title="Si se activa, el operador conserva su posición actual en la cola de asignación">
          <input type="checkbox" id="modal-assign-to-skip-queue" class="toggle toggle-secondary toggle-sm" />
          <span class="label-text text-xs font-bold text-base-content/85">
            Conservar posición en la cola
          </span>
        </label>
      </div>

      <!-- Search Bar -->
      <div class="p-3.5 border-b border-base-300 bg-base-100">
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-base-content/40">
            <Icon name="boxicons:search" size={18} />
          </div>
          <input
            id="modal-assign-to-search"
            type="text"
            placeholder="Buscar operador por nombre o usuario..."
            class="input input-bordered input-sm sm:input-md w-full pl-10 text-xs sm:text-sm rounded-xl focus:outline-none focus:border-secondary"
          />
        </div>
      </div>

      <!-- Body / Lists -->
      <div class="p-4 sm:p-5 overflow-y-auto flex-1 space-y-5" id="modal-assign-to-scroll">
        <!-- Grupo 1: Operadores Disponibles -->
        <div class="space-y-2.5">
          <div class="flex items-center justify-between pb-1.5 border-b border-base-200">
            <div class="flex items-center gap-2">
              <span class="size-2 rounded-full bg-success"></span>
              <h4 class="text-xs font-bold uppercase tracking-wider text-base-content/75">
                Operadores Disponibles
              </h4>
            </div>
            <span id="modal-assign-to-available-count" class="badge badge-soft badge-success badge-sm font-mono font-bold">
              0
            </span>
          </div>

          <div id="modal-assign-to-available-list" class="space-y-2">
            <!-- Rendered dynamically from latestDisponibilidadData -->
          </div>
        </div>

        <!-- Grupo 2: Operadores No Disponibles -->
        <div class="space-y-2.5 pt-2">
          <div class="flex items-center justify-between pb-1.5 border-b border-base-200">
            <div class="flex items-center gap-2">
              <span class="size-2 rounded-full bg-base-content/30"></span>
              <h4 class="text-xs font-bold uppercase tracking-wider text-base-content/50">
                Operadores No Disponibles
              </h4>
            </div>
            <span id="modal-assign-to-unavailable-count" class="badge badge-soft badge-neutral badge-sm font-mono font-bold text-base-content/70">
              0
            </span>
          </div>

          <div id="modal-assign-to-unavailable-list" class="space-y-2">
            <!-- Rendered dynamically from latestDisponibilidadData -->
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div class="p-3.5 sm:p-4 bg-base-200/40 border-t border-base-300 flex items-center justify-between">
        <span class="text-xs text-base-content/45 font-medium">Mesa de Ayuda #${AGS_HELPDESK_ID}</span>
        <form method="dialog">
