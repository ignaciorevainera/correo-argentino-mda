---
import { getCleanBase } from "@lib/baseUrl";
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import DataTable from "@components/ui/DataTable.astro";
import DataTableHeaderCell from "@components/ui/DataTableHeaderCell.astro";
import { Icon } from "astro-icon/components";
import { db } from "@db/index";
import { agents } from "@db/schema";
import { eq } from "drizzle-orm";
import {
  getDisponibilidadHoy,
  asignarSiguienteAutogestion,
  asignarManual,
  getLockStatus,
} from "@lib/disponibilidad";
import { getUnassignedTicketsByHelpdesk } from "@/lib/invgate/agsTickets";
import { AGS_HELPDESK_ID } from "@/lib/invgate/agsHelpdesk";
import { AUTOGESTION_AUTOMATION_RULES } from "@/lib/autogestion/rulesEngine";
import { getAutogestionRuleStates, resolveRuleEnabled } from "@/lib/autogestion/ruleState";
import { readPersistedCache } from "@/lib/invgate/cache";
import type { AutoAssignCycleResult } from "@/lib/autogestion/autoAssignRunner";
import { getCsrfTokenForSession } from "@lib/csrf";
import { can } from "@lib/roleConfig";

import { normalizeRole } from "@lib/rbac";
import { matchesCurrentUser } from "@lib/currentUserMatch";

const cleanBase = getCleanBase();

const invgateApiBase = import.meta.env.INVGATE_QA_BASE_URL || import.meta.env.INVGATE_BASE_URL || "";
const invgateWebBase = invgateApiBase
  ? invgateApiBase.replace(/\/api\/v1\/?$/, "").replace(/\/$/, "")
  : "";

const user = Astro.locals.user;
const role = normalizeRole(user.role);
const currentUsername = (user?.username || "").toLowerCase();

const tabParam = Astro.url.searchParams.get("tab");
const initialTab = tabParam === "monitoreo" ? "monitoreo" : tabParam === "automatizacion" ? "automatizacion" : "asignacion";

const lockStatus = await getLockStatus();
const ruleStates = await getAutogestionRuleStates();
const activeRulesCount = AUTOGESTION_AUTOMATION_RULES.filter((r) =>
  resolveRuleEnabled(r.id, ruleStates)
).length;
const canToggleRules = can(role, "referent");
let hasLock = false;
let lockHolderName: string | null = null;
let lockReleaseRequested = false;

if (lockStatus.status === "occupied") {
  hasLock = lockStatus.user.userId === user?.id;
  lockHolderName = lockStatus.user.username;
  lockReleaseRequested = lockStatus.user.releaseRequested;
}

const isReadOnly = role === "agent" || !hasLock;

if (Astro.request.method === "POST" && !isReadOnly) {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get("action") as string;
    let msg = "";
    let msgType = "success";

    const userClean = user?.username ? user.username.split("@")[0].toLowerCase().trim() : "";
    const allOpsForAuthor = await getDisponibilidadHoy();
    const loggedInOp = allOpsForAuthor.find((op) => op.username && op.username.split("@")[0].toLowerCase().trim() === userClean);
    const authorInvgateId = loggedInOp?.invgateId;

    if (action === "assign_manual") {
      const agentId = Number(formData.get("agentId"));
      if (!isNaN(agentId)) {
        const res = await asignarManual(agentId, user?.username || "Sistema", authorInvgateId);
        if (res.success) {
          const [ag] = await db
            .select({ name: agents.name })
            .from(agents)
            .where(eq(agents.id, agentId));

          msg = res.ticketNumber
            ? `Autogestión ${res.ticketNumber} asignada manualmente a ${ag?.name ?? `ID ${agentId}`} en InvGate QA.`
            : `Autogestión asignada manualmente a ${ag?.name ?? `ID ${agentId}`}.`;
        } else {
          msg = res.error || "Error al asignar autogestión.";
          msgType = "error";
        }
      }
    } else if (action === "assign_cyclic") {
      const res = await asignarSiguienteAutogestion(user?.username || "Sistema", authorInvgateId);
      if (res.success && res.agent) {
        msg = res.ticketNumber
          ? `Autogestión ${res.ticketNumber} asignada a ${res.agent.nombre} en InvGate QA.`
          : `Autogestión asignada cíclicamente a ${res.agent.nombre}.`;
      } else {
        msg = res.error || "No hay operadores disponibles o dentro de horario operativo para asignar.";
        msgType = "error";
      }
    }

    if (msg) {
      const url = new URL(Astro.request.url);
      url.searchParams.set("toast_msg", msg);
      url.searchParams.set("toast_type", msgType);
      return Astro.redirect(url.pathname + url.search);
    }
  } catch (e: any) {
    const url = new URL(Astro.request.url);
    url.searchParams.set("toast_msg", `Ocurrió un error al procesar la acción: ${e.message}`);
    url.searchParams.set("toast_type", "error");
    return Astro.redirect(url.pathname + url.search);
  }
}

// Fetch availability calculations
const allOperators = (await getDisponibilidadHoy()).filter((op) => op.asignableAgs);
allOperators.sort((a, b) => a.nombre.localeCompare(b.nombre));

const disponiblesCount = allOperators.filter((op) => op.disponible).length;
const noDisponiblesList = allOperators.filter((op) => !op.disponible);
const noDisponiblesCount = noDisponiblesList.length;

// Find the operator who was most recently assigned
const maxAssignedTime = Math.max(
  ...allOperators.map((o) => o.lastAutogestionAssignedAt ?? 0),
);
const lastAssignedOperator =
  maxAssignedTime > 0
    ? allOperators.find((o) => o.lastAutogestionAssignedAt === maxAssignedTime)
    : null;
const maxAssignedOperatorId = lastAssignedOperator?.agentId ?? null;

// Find the next suggested operators (up to 10) for the queue
const availableOperators = allOperators.filter((o) => o.disponible);
const nextSuggestedOperators = availableOperators.length > 0
  ? [...availableOperators].sort((a, b) => {
      const tA = a.lastAutogestionAssignedAt ?? 0;
      const tB = b.lastAutogestionAssignedAt ?? 0;
      if (a.lastAutogestionAssignedAt === null && b.lastAutogestionAssignedAt !== null) return -1;
      if (a.lastAutogestionAssignedAt !== null && b.lastAutogestionAssignedAt === null) return 1;
      return tA - tB;
    }).slice(0, 10)
  : [];

// Fetch unassigned InvGate tickets for the autogestions helpdesk
const unassignedRes = await getUnassignedTicketsByHelpdesk(AGS_HELPDESK_ID);
const unassignedTickets = unassignedRes.tickets;
const unassignedCount = unassignedTickets.length;

// Antigüedad del ticket más viejo sin asignar (Issues #294, #292)
const oldestTicket = unassignedTickets.length > 0 ? unassignedTickets[0] : null;
let oldestAgeMin = 0;
let oldestAgeStr = "";
let isOldestWarning = false;
if (oldestTicket?.created_at) {
  oldestAgeMin = Math.floor((Date.now() - oldestTicket.created_at * 1000) / 60000);
  oldestAgeStr = formatWaitTime(oldestAgeMin);
  isOldestWarning = oldestAgeMin >= 20; // Más de 2 ciclos (20 min)
}

// Última corrida del ciclo de autoasignación (Issue #293)
const lastCycle = readPersistedCache<AutoAssignCycleResult>("autogestion_last_cycle_result");
const lastCycleTimeStr = lastCycle?.lastRunAt
  ? new Date(lastCycle.lastRunAt).toLocaleTimeString("es-AR", { hour: "2-digit", minute: "2-digit" })
  : null;
const lastCycleReasonsMap: Record<number, string> = {};
if (lastCycle?.unassignedDetails) {
  for (const d of lastCycle.unassignedDetails) {
    lastCycleReasonsMap[d.ticketId] = d.reason;
  }
}



const STATUS_LABELS: Record<string, string> = {
  "En break": "En Break",
  "Fuera de horario": "Fuera de Horario",
  Franco: "Franco",
  Licencia: "Licencia",
  Vacaciones: "Vacaciones",
};

const PRIORITY_LABELS: Record<number, { label: string; badgeClass: string }> = {
  1: { label: "Baja", badgeClass: "badge-soft badge-neutral text-base-content/70 font-medium" },
  2: { label: "Media", badgeClass: "badge-soft badge-neutral text-base-content/70 font-medium" },
  3: { label: "Alta", badgeClass: "badge-soft badge-warning text-warning font-semibold" },
  4: { label: "Urgente", badgeClass: "badge-soft badge-warning text-warning font-bold" },
  5: { label: "Crítica", badgeClass: "badge-soft badge-error text-error font-bold" },
};

const breakdown: Record<string, number> = {
  "En break": 0,
  "Fuera de horario": 0,
  Franco: 0,
  Licencia: 0,
  Vacaciones: 0,
};

noDisponiblesList.forEach((op) => {
  const mot = op.motivo || "Franco";
  if (breakdown[mot] !== undefined) {
    breakdown[mot]++;
  } else {
    breakdown["Franco"]++;
  }
});

const getBadgeColor = (status: string, disponible: boolean): string => {
  if (disponible) return "badge-soft badge-success text-success shadow-xs";
  switch (status) {
    case "En break":
      return "badge-soft badge-warning text-warning shadow-xs";
    case "Fuera de horario":
    case "Franco":
      return "badge-soft badge-neutral text-base-content/60";
    case "Licencia":
      return "badge-soft badge-error text-error shadow-xs";
    case "Vacaciones":
      return "badge-soft badge-info text-info shadow-xs";
    default:
      return "badge-soft badge-neutral text-base-content/70";
  }
};

const breakdownBadge = (status: string): string => {
  switch (status) {
    case "En break":
      return "bg-warning";
    case "Fuera de horario":
    case "Franco":
      return "bg-neutral opacity-50";
    case "Licencia":
      return "bg-error";
    case "Vacaciones":
      return "bg-info";
    default:
      return "bg-neutral";
  }
};

function getInitials(name: string): string {
  if (!name) return "OP";
  const parts = name.trim().split(/\s+/);
  if (parts.length === 1) return parts[0].substring(0, 2).toUpperCase();
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}

function formatWaitTime(elapsedMin: number): string {
  if (elapsedMin >= 1440) {
    const days = Math.floor(elapsedMin / 1440);
    const hours = Math.floor((elapsedMin % 1440) / 60);
    return hours > 0 ? `${days}d ${hours}h` : `${days}d`;
  }
  if (elapsedMin >= 60) {
    return `${Math.floor(elapsedMin / 60)}h ${elapsedMin % 60}m`;
  }
  return `${elapsedMin}m`;
}

function formatWiseMinutes(min: number | undefined | null): string {
  if (!min || min <= 0) return "";
  if (min >= 1440) {
    const d = Math.floor(min / 1440);
    const h = Math.floor((min % 1440) / 60);
    return h > 0 ? `${d}d ${h}h` : `${d}d`;
  }
  if (min >= 60) {
    const h = Math.floor(min / 60);
    const m = min % 60;
    return m > 0 ? `${h}h ${m}m` : `${h}h`;
  }
  return `${min}m`;
}
---

<PageContainer data-user-username={user?.username}>

  <div class="mb-6 border-b border-base-200 pb-5">
    <PageHeader
      description="Distribución equitativa y controlada de autogestiones entre operadores técnicos."
      descriptionClass="max-w-prose"
    />
  </div>

  <!-- Global Header Bar: Tabs Navigation -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <!-- Tabs Header -->
    <div class="role-tabs tabs tabs-box bg-base-200/60 p-1.5 rounded-2xl inline-flex gap-1 border border-base-300">
      <button
        type="button"
        id="tab-btn-asignacion"
        data-tab-target="panel-asignacion"
        class={`tab font-bold text-xs uppercase tracking-wider px-4 py-2 rounded-xl transition-all flex items-center gap-2 ${initialTab === 'asignacion' ? 'tab-active bg-secondary text-secondary-content shadow-sm' : 'text-base-content/70 hover:text-base-content'}`}
      >
        <Icon name="boxicons:user-check" size={18} />
        Asignación de Autogestión
      </button>
      <button
        type="button"
        id="tab-btn-automatizacion"
        data-tab-target="panel-automatizacion"
        class={`tab font-bold text-xs uppercase tracking-wider px-4 py-2 rounded-xl transition-all flex items-center gap-2 ${initialTab === 'automatizacion' ? 'tab-active bg-secondary text-secondary-content shadow-sm' : 'text-base-content/70 hover:text-base-content'}`}
      >
        <Icon name="boxicons:cog" size={18} />
        Automatización
      </button>
      <button
        type="button"
        id="tab-btn-monitoreo"
        data-tab-target="panel-monitoreo"
        class={`tab font-bold text-xs uppercase tracking-wider px-4 py-2 rounded-xl transition-all flex items-center gap-2 ${initialTab === 'monitoreo' ? 'tab-active bg-secondary text-secondary-content shadow-sm' : 'text-base-content/70 hover:text-base-content'}`}
      >
        <Icon name="boxicons:group" size={18} />
        Monitoreo de Operadores
      </button>
    </div>

    <!-- Acceso a Métricas y Analítica -->
    <a
      href={`${cleanBase}supervision/autogestiones-metricas`}
      class="btn btn-sm btn-outline rounded-xl font-bold uppercase tracking-wider text-xs gap-2 ml-auto"
    >
      <Icon name="boxicons:bar-chart-big-filled" size={18} />
      Métricas y Estadísticas
    </a>
  </div>

  <!-- Pestaña 1: Asignación Operativa -->
  <div id="panel-asignacion" class={initialTab === "asignacion" ? "flex flex-col gap-6" : "flex flex-col gap-6 hidden"}>
    <!-- Workspace Panel Dividido / IDE Style (0 Cajas Flotantes) -->
    <div class="bg-base-100 border border-base-300 rounded-2xl overflow-hidden shadow-xs flex flex-col">
      <!-- Header Superior de Acción -->
      <div id="action-bar-header" class="border-b border-base-300 bg-base-200/30 p-3.5 sm:p-4 flex flex-col md:flex-row items-center justify-between gap-3 transition-all duration-300">
        <div class="flex items-center gap-3 min-w-0">
          <div class={`p-2.5 rounded-xl shrink-0 transition-colors ${!isReadOnly ? "bg-secondary/10 text-secondary" : "bg-base-200 text-base-content/40"}`}>
            <Icon name={!isReadOnly ? "boxicons:user-check" : "boxicons:lock"} size={22} />
          </div>
          <div class="min-w-0 flex flex-col gap-0.5">
            <div class="flex items-center gap-2 flex-wrap">
              <span class={`badge badge-sm font-bold uppercase text-xs tracking-wider ${!isReadOnly ? "badge-soft badge-success" : "badge-soft badge-neutral"}`}>
                {!isReadOnly ? "Control Activo" : "Modo Lectura"}
              </span>
              <p id="action-bar-subtitle" class="text-xs sm:text-sm text-base-content/70 font-medium truncate">
                {!isReadOnly ? (
                  <>{unassignedCount} autogestiones sin asignar • {availableOperators.length} operadores disponibles</>
                ) : (
                  <>Tomá el control desde el indicador de estado para habilitar la asignación.</>
                )}
              </p>
            </div>
          </div>
        </div>

        <!-- Acciones y Lock a la derecha -->
        <div class="flex items-center gap-2.5 shrink-0">
          <div class="flex items-center gap-1.5 bg-base-200/50 rounded-xl p-1 border border-base-300/60">
            <button
              type="button"
              id="btn-refresh-general"
              class="btn btn-ghost btn-xs text-base-content/70 hover:text-secondary hover:bg-secondary/10 font-bold gap-1.5 px-2.5 py-1 h-7 min-h-0 text-xs rounded-lg"
              title="Actualizar tickets y disponibilidad de operadores ahora"
            >
              <Icon name="boxicons:refresh-ccw" size={16} id="btn-refresh-general-icon" class="shrink-0 transition-transform" />
              <span>Actualizar</span>
            </button>
            <div
              id="poll-countdown-badge"
              class="flex items-center gap-1.5 px-2 py-0.5 rounded-lg text-xxs font-mono font-bold text-base-content/60 bg-base-100/70 border border-base-300/50 select-none"
              title="Tiempo restante para la próxima sincronización automática"
            >
              <span id="poll-countdown-dot" class="inline-block size-1.5 rounded-full bg-success"></span>
              <span id="poll-countdown-text">--s</span>
            </div>
          </div>

          {role !== "agent" && (
            <div id="lock-indicator"
                 data-user-id={user?.id}
                 data-user-username={user?.username}
                 data-lock-timeout={10 * 60 * 1000}
                 class="grid grid-cols-[auto_minmax(0,1fr)_auto_auto] items-center gap-2 text-xs font-semibold text-base-content/70">
            </div>
          )}
        </div>
      </div>

      <!-- Grid de Paneles Divididos (60% Tickets / 40% Cola) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 h-[560px] max-h-[560px] border-b border-base-300">
        <!-- Panel Izquierdo (60%): Tickets en Espera -->
        <div class="lg:col-span-7 flex flex-col border-b lg:border-b-0 lg:border-r border-base-300 bg-base-100 h-full overflow-hidden">
          <div class="p-3.5 sm:p-4 border-b border-base-300 bg-base-200/40 flex items-center justify-between gap-3 shrink-0">
            <div class="flex items-center gap-2.5 min-w-0">
              <Icon name="boxicons:inbox" size={22} class="text-secondary shrink-0" />
              <h3 class="font-extrabold text-xs sm:text-sm uppercase tracking-wider text-base-content/80 truncate">
                Sin Asignar (Mesa #{AGS_HELPDESK_ID})
              </h3>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              {lastCycle && (
                <div
                  id="stat-last-cycle-badge"
                  class="dropdown dropdown-end shrink-0"
                  title="Detalle de la última corrida del ciclo de autoasignación"
                >
                  <label
                    tabindex="0"
                    class="badge badge-xs sm:badge-sm font-mono cursor-pointer gap-1 py-1 px-2 border border-base-300 bg-base-200/60 hover:bg-base-200 text-base-content/70"
                  >
                    <Icon name="boxicons:sync" size={13} class="text-secondary shrink-0" />
                    <span>ciclo: <strong class="text-base-content/90 font-bold">{lastCycleTimeStr || "--"}</strong> ({lastCycle.assignedCount}/{lastCycle.evaluatedCount})</span>
                  </label>
                  <div
                    tabindex="0"
                    class="dropdown-content z-20 menu p-3 shadow-lg bg-base-100 rounded-box w-72 text-xs border border-base-300"
                  >
                    <div class="font-bold text-xs uppercase tracking-wider text-base-content/70 border-b border-base-200 pb-1.5 mb-2 flex items-center justify-between">
                      <span>Último Ciclo Automático</span>
                      <span class="font-mono text-[11px] font-normal">{lastCycleTimeStr}</span>
                    </div>
                    <div class="space-y-1 mb-2">
                      <div class="flex justify-between">
                        <span class="text-base-content/60">Tickets evaluados:</span>
                        <strong class="font-mono">{lastCycle.evaluatedCount}</strong>
                      </div>
                      <div class="flex justify-between">
                        <span class="text-base-content/60">Autoasignados:</span>
                        <strong class="font-mono text-success">{lastCycle.assignedCount}</strong>
                      </div>
                      {lastCycle.errors && lastCycle.errors.length > 0 && (
                        <div class="flex justify-between text-error">
                          <span>Errores registrados:</span>
                          <strong class="font-mono">{lastCycle.errors.length}</strong>
                        </div>
                      )}
                    </div>
                    {lastCycle.unassignedDetails && lastCycle.unassignedDetails.length > 0 && (
                      <div class="border-t border-base-200 pt-1.5 mt-1">
                        <span class="font-semibold text-base-content/80 block mb-1">Sin asignar por motivo:</span>
                        <ul class="space-y-1 max-h-36 overflow-y-auto">
                          {lastCycle.unassignedDetails.map((u) => (
                            <li class="bg-base-200/50 p-1.5 rounded text-[11px] leading-tight">
                              <span class="font-mono font-bold text-secondary">{u.ticketNumber}:</span>{" "}
                              <span class="text-base-content/80">{u.reason}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                </div>
              )}
              <span
                id="stat-oldest-age-badge"
                class={`badge badge-xs sm:badge-sm font-mono font-bold gap-1 py-1 px-2 ${unassignedCount === 0 || !oldestAgeStr ? "hidden" : isOldestWarning ? "badge-error text-error-content animate-pulse" : "badge-secondary badge-outline text-secondary"}`}
                title={isOldestWarning ? "Atención: El ticket más antiguo lleva más de 20 min en espera" : "Antigüedad del ticket sin asignar más antiguo"}
              >
                <Icon name="boxicons:clock" size={14} class="shrink-0" />
                <span>espera máx: <strong id="stat-oldest-age-text">{oldestAgeStr || "--"}</strong></span>
              </span>
              <span
                class={`font-mono font-bold text-sm ${unassignedCount > 0 ? "text-secondary" : "text-base-content/50"}`}
                id="stat-unassigned-count"
              >
                {unassignedCount}
              </span>
            </div>
          </div>

          <div id="unassigned-tickets-list" class="divide-y divide-base-200/80 flex-1 overflow-y-auto overflow-x-auto">
            {unassignedTickets.length > 0 ? (
              unassignedTickets.map((t: any) => {
                const timeStr = t.created_at ? new Date(t.created_at * 1000).toLocaleTimeString("es-AR", { hour: "2-digit", minute: "2-digit" }) : "";
                
                let elapsedMin = 0;
                if (t.created_at) {
                  elapsedMin = Math.floor((Date.now() - t.created_at * 1000) / 60000);
                }
                const formatWait = formatWaitTime(elapsedMin);

                const creatorUsername = (t.creator_username || "").toLowerCase().trim();
                const creatorNameNorm = (t.creator_name || "").toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();

                const matchingAvailableOp = availableOperators.find((op) => {
                  if (op.username && creatorUsername && op.username.split("@")[0].toLowerCase().trim() === creatorUsername) return true;
                  if (op.nombre && creatorNameNorm) {
                    const opNameNorm = op.nombre.toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();
                    if (opNameNorm === creatorNameNorm) return true;
                    const tokens = creatorNameNorm.split(" ").filter((k: string) => k.length > 2);
                    if (tokens.length >= 2 && tokens.every((k: string) => opNameNorm.includes(k))) return true;
                  }
                  return false;
                });

                const creatorStr = t.creator_name || t.customer_name || "";
                const customerStr = t.customer_name && t.creator_name && t.customer_name !== t.creator_name ? t.customer_name : "";

                return (
                  <div data-ticket-id={t.id} class="p-4 hover:bg-base-200/50 transition-colors duration-150 flex flex-col gap-2.5 cursor-pointer group min-w-[480px] sm:min-w-0">
                    <div class="flex items-start justify-between gap-3">
                      <div class="font-extrabold text-sm sm:text-base text-base-content leading-snug group-hover:text-secondary transition-colors truncate pr-1" title={t.title}>
                        <span class="font-mono font-bold text-base-content/60 mr-1.5">{t.pretty_id || `#${t.id}`}</span>
                        <span>{t.title}</span>
                      </div>
                      <span class="text-xs text-base-content/50 font-mono font-semibold shrink-0 mt-0.5">
                        {timeStr}
                      </span>
                    </div>
                    <div class="flex items-center gap-2 min-w-0 flex-wrap">
                      {t.priority_id && (
                        <span class={`badge badge-sm font-bold text-xs tracking-wider uppercase shrink-0 ${PRIORITY_LABELS[t.priority_id]?.badgeClass || 'badge-soft badge-neutral'}`}>
                          {PRIORITY_LABELS[t.priority_id]?.label || `P${t.priority_id}`}
                        </span>
                      )}
                      {t.category_last_name && (
                        <span class="badge badge-soft badge-neutral badge-sm font-semibold text-xs tracking-tight max-w-[170px] truncate shrink-0" title={t.category_name || t.category_last_name}>
                          {t.category_last_name}
                        </span>
                      )}
                      {t.created_at && (
                        <span class={`badge badge-soft badge-sm font-mono text-xs px-2 py-0.5 shrink-0 ${
                          elapsedMin >= 60
                            ? "badge-error text-error font-bold"
                            : elapsedMin >= 30
                            ? "badge-warning text-warning font-semibold"
                            : "badge-neutral text-base-content/70"
                        }`} title="Tiempo de espera en cola">
                          ⏱ {formatWait}
                        </span>
                      )}
                    </div>
                    <div class="flex items-center justify-between gap-2 text-xs font-medium truncate mt-0.5">
                      <div class="flex items-center gap-1.5 min-w-0 truncate text-base-content/70">
                        {creatorStr ? (
                          <>
                            <Icon name="boxicons:user" size={15} class="opacity-60 shrink-0" />
                            <span class="truncate flex items-center gap-1.5">
                              Generado por: <strong class="text-base-content/90 font-bold">{creatorStr}</strong>
                              {matchingAvailableOp && (
                                <span class="inline-block size-2 rounded-full bg-success shrink-0" title="Operador disponible"></span>
                              )}
                            </span>
                          </>
                        ) : (
                          <span class="opacity-50 italic text-xs">Sin creador especificado</span>
                        )}
                      </div>
                      <div class="flex items-center gap-1.5 shrink-0">
                        <button
                          type="button"
                          class={`btn btn-xs shrink-0 gap-1.5 text-xs px-2.5 h-7 min-h-0 font-bold transition-colors ${
                            isReadOnly
                              ? "btn-ghost btn-disabled opacity-40 cursor-not-allowed text-base-content/40"
                              : "btn-secondary shadow-sm"
                          }`}
                          data-action-assign-to={t.id}
                          title={isReadOnly ? "Toma el control para asignar autogestiones" : `Asignar ticket #${t.pretty_id || t.id} a un operador...`}
                          disabled={isReadOnly}
                        >
                          <Icon name="boxicons:user-plus" size={13} class="shrink-0" />
                          <span>Asignar a...</span>
                        </button>
                      </div>
                    </div>
                    {t.location_name && (
                      <div class="flex items-center gap-1.5 text-xs text-base-content/60 font-medium min-w-0 max-w-full overflow-hidden" title={t.location_name}>
                        <Icon name="boxicons:location-pin" size={14} class="text-info opacity-75 shrink-0" />
                        <span class="truncate block min-w-0 max-w-[260px] sm:max-w-[340px] md:max-w-[420px]">
                          Ubicación: <strong class="text-base-content/85 font-semibold">{t.location_name}</strong>
                        </span>
                      </div>
                    )}
                    {lastCycleReasonsMap[t.id] && (
                      <div class="flex items-start gap-1.5 text-[11px] font-mono text-base-content/70 bg-base-200/60 rounded px-2 py-1 mt-0.5" title="Motivo de no asignación en la última corrida automática">
                        <Icon name="boxicons:info-circle" size={14} class="text-secondary shrink-0 mt-0.5" />
                        <span class="truncate">{lastCycleReasonsMap[t.id]}</span>
                      </div>
                    )}
                  </div>
                );
              })
            ) : (
              <div class="text-sm text-base-content/40 italic py-16 text-center">No hay tickets sin asignar</div>
            )}
          </div>
        </div>

        <!-- Panel Derecho (40%): Gestión y Cola -->
        <div class="lg:col-span-5 flex flex-col divide-y divide-base-300 bg-base-100 h-full overflow-hidden">
          <!-- Sección: Próximos en Cola -->
          <div class="flex-1 flex flex-col overflow-hidden">
            <div class="p-3.5 sm:p-4 bg-base-200/40 border-b border-base-300 flex items-center justify-between gap-2.5 shrink-0">
              <div class="flex items-center gap-2 min-w-0">
                <Icon name="boxicons:sparkles" size={20} class="text-secondary shrink-0" />
                <h3 class="font-extrabold text-xs sm:text-sm uppercase tracking-wider text-base-content/80 truncate">
                  Próximos en Cola
                </h3>
              </div>
            </div>

            <div id="queue-container" class="divide-y divide-base-200/80 flex-1 overflow-y-auto overflow-x-auto">
              {nextSuggestedOperators.length > 0 ? (
                nextSuggestedOperators.map((op, idx) => (
                  <div
                    data-agent-id={op.agentId}
                    class="flex items-center justify-between gap-3.5 p-3.5 transition-colors hover:bg-base-200/60 cursor-default min-w-[360px] sm:min-w-0"
                  >
                    <div class="flex items-center gap-3.5 min-w-0 flex-1">
                      <div class="avatar placeholder size-10 rounded-full shrink-0 flex items-center justify-center font-bold text-sm bg-base-300 text-base-content/70">
                        {getInitials(op.nombre)}
                      </div>
                      <div class="min-w-0 flex-1 flex flex-col gap-0.5">
                        <div class="flex items-center gap-2 flex-wrap">
                          <span class="truncate font-extrabold text-sm text-base-content">
                            {op.nombre}
                          </span>
                          {idx === 0 && (
                            <span class="font-bold uppercase text-xs text-secondary shrink-0">Siguiente</span>
                          )}
                          {(() => {
                            const isDescon = (op.wiseCxStatus && op.wiseCxStatus.toLowerCase().includes("desconectado")) || (op.motivo && op.motivo.toLowerCase().includes("desconectado"));
                            const dur = isDescon ? "" : formatWiseMinutes(op.wiseCxMinutesInStatus);
                            const durLabel = dur ? ` (${dur})` : "";

                            if (op.wiseCxInCall) {
                              return (
                                <span class="badge badge-soft badge-warning text-warning animate-pulse badge-sm font-bold text-xxs px-2 py-0.5 shrink-0 shadow-xs" title="En llamada">
                                  <span class="inline-block size-1.5 rounded-full bg-current mr-1"></span>
                                  En llamada{durLabel}
                                </span>
                              );
                            }
                            if (op.wiseCxStatus && !isDescon) {
                              const variant = op.wiseCxBadgeVariant === "success"
                                ? "badge-success text-success"
                                : op.wiseCxBadgeVariant === "error"
                                ? "badge-error text-error"
                                : "badge-neutral text-base-content/70";
                              return (
                                <span class={`badge badge-soft ${variant} badge-sm font-bold text-xxs px-2 py-0.5 shrink-0 shadow-xs`} title={`Wise CX: ${op.wiseCxStatus}${dur ? ' hace ' + dur : ''}`}>
                                  <span class="inline-block size-1.5 rounded-full bg-current mr-1"></span>
                                  {op.wiseCxStatus}{durLabel}
                                </span>
                              );
                            }
                            if (!op.disponible) {
                              const cleanMotivo = (isDescon && op.motivo !== "Franco" && op.motivo !== "Fuera de horario")
                                ? "Desconectado"
                                : (op.motivo || "No disponible").replace(/\s*\(Wise\s*CX\)$/i, "").trim();
                              return (
                                <span class="badge badge-soft badge-neutral badge-sm font-semibold text-xs shrink-0">
                                  {cleanMotivo}
                                </span>
                              );
                            }
                            return null;
                          })()}
                        </div>
                        <div class="flex items-center gap-2 text-xs text-base-content/60 font-medium flex-wrap">
                          <span class="uppercase font-semibold text-xs opacity-75">{op.modalidadHoy === "Home Office" ? "Home Office" : op.modalidadHoy === "Guardia" ? "Guardia" : "Presencial"}</span>
                          {op.salidaInminente ? (
                            <span class="badge badge-soft badge-error text-error font-bold text-xxs px-2 py-0.5 flex items-center gap-1 shadow-xs" title={`Termina su jornada en ${op.salidaInminenteMin || 1} min`}>
                              <Icon name="boxicons:arrow-out-right-square-half" size={12} class="shrink-0" />
                              <span>Salida en {op.salidaInminenteMin}m ({op.horarioHoy?.split(" - ")[1]})</span>
                            </span>
                          ) : op.horarioHoy && (
                            <span class="font-mono text-base-content/75">{op.horarioHoy}</span>
                          )}
                          {op.breakInminente ? (
                            <span class="badge badge-soft badge-warning text-warning font-bold text-xxs px-2 py-0.5 shadow-xs" title={`Entra en break en ${op.breakInminenteMin || 1} min`}>
                              <span>Break en {op.breakInminenteMin}m ({op.breakInicioHoy})</span>
                            </span>
                          ) : op.breakInicioHoy && op.breakFinHoy && (
                            <span class="font-mono text-base-content/75">
                              Break: {op.breakInicioHoy} - {op.breakFinHoy}
                            </span>
                          )}
                        </div>
                      </div>
                    </div>

                    {unassignedTickets[idx] && (
                      <div
                        class="badge badge-soft badge-neutral font-mono text-xs px-2.5 py-1 flex items-center gap-1 shrink-0 text-base-content/70 cursor-help"
                        title={`Si se asigna en orden, recibirá: ${unassignedTickets[idx].title}`}
                      >
                        <span class="opacity-50 font-sans font-bold">↳</span>
                        <span>{unassignedTickets[idx].pretty_id || `#${unassignedTickets[idx].id}`}</span>
                      </div>
                    )}
                  </div>
                ))
              ) : (
                <div class="text-sm text-base-content/40 italic py-12 text-center" id="stat-suggested-name-empty">
                  No hay operadores disponibles
                </div>
              )}
            </div>
          </div>

          <!-- Sección: Última Asignación -->
          <div class="p-3.5 sm:p-4 bg-base-200/20 shrink-0">
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-2">
                <Icon name="boxicons:history" size={20} class="text-info" />
                <h3 class="font-bold text-xs uppercase tracking-wider text-base-content/70">
                  Última Asignación
                </h3>
              </div>
              <button
                type="button"
                id="btn-open-historial-modal"
                class="btn btn-ghost btn-xs text-info hover:bg-info/10 font-bold gap-1.5 px-2.5 py-1 h-7 min-h-0 text-xs"
                title="Ver historial completo y detallado de asignaciones"
              >
                <Icon name="boxicons:clock" size={14} />
                <span>Ver historial</span>
              </button>
            </div>

            <div id="stat-last-assigned-container">
              {lastAssignedOperator ? (
                <div class="text-xs flex items-center justify-between gap-2 bg-base-100 px-3 py-2 rounded-xl border border-base-300/60 min-w-0">
                  <div class="flex items-center gap-2.5 sm:gap-3 min-w-0 truncate">
                    <span class="text-base-content/70 shrink-0">
                      De: <strong class="text-info font-bold" id="stat-last-assigned-by">{lastAssignedOperator.lastAutogestionAssignedBy || "Sistema"}</strong>
                    </span>
                    <span class="text-base-content/70 truncate">
                      Para: <strong class="text-base-content font-bold" id="stat-last-assigned-to">{lastAssignedOperator.nombre}</strong>
                    </span>
                  </div>
                  <span class="text-xs text-base-content/50 font-mono shrink-0 whitespace-nowrap ml-2" id="stat-last-assigned-time" title="Hora de asignación">
                    {new Date(lastAssignedOperator.lastAutogestionAssignedAt!).toLocaleTimeString("es-AR", { hour: "2-digit", minute: "2-digit" })}
                  </span>
                </div>
              ) : (
                <div class="text-xs text-base-content/40 italic py-1">Sin asignaciones hoy</div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Pestaña 2: Monitoreo de Operadores -->
  <div id="panel-monitoreo" class={initialTab === "monitoreo" ? "flex flex-col gap-6" : "flex flex-col gap-6 hidden"}>
    <!-- Top KPIs (Disponibilidad + Fuera de Servicio) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- Card Disponibles -->
      <div
        class="card bg-base-100 border border-base-300 shadow-md overflow-hidden group hover:border-success/30 transition-colors duration-300"
      >
        <div
          class="absolute -top-4 -right-4 p-4 opacity-5 group-hover:opacity-10 group-hover:scale-110 transition-transform duration-500 pointer-events-none"
        >
          <Icon name="boxicons:user-check" size={128} />
        </div>
        <div class="card-body p-6">
          <div class="flex items-center gap-3 mb-2">
            <div class="p-2 bg-success/10 rounded-lg text-success">
              <Icon name="boxicons:user-check" size={24} />
            </div>
            <h3
              class="font-bold text-xs uppercase tracking-widest text-base-content/50"
            >
              Disponibilidad Actual
            </h3>
          </div>
          <div class="flex items-baseline gap-2">
            <span
              class="text-5xl font-black text-success tracking-tight"
              id="stat-disponibles-count">{disponiblesCount}</span
            >
            <span
              class="text-base-content/40 font-bold uppercase text-xs tracking-wider"
              >operadores activos</span
            >
          </div>
          <div class="mt-6 flex flex-col gap-2">
            <div
              class="flex justify-between text-xs font-bold uppercase tracking-wider px-0.5"
            >
              <span class="text-base-content/40">Tasa de disponibilidad</span>
              <span class="text-success font-mono font-black" id="stat-percentage"
                >{
                  allOperators.length > 0
                    ? Math.round((disponiblesCount / allOperators.length) * 100)
                    : 0
                }%</span
              >
            </div>
            <progress
              class="progress progress-success w-full h-2.5 bg-base-200"
              value={disponiblesCount}
              max={allOperators.length || 1}
              id="stat-progress"></progress>
          </div>
        </div>
      </div>

      <!-- Card No Disponibles -->
      <div
        class="card bg-base-100 border border-base-300 shadow-md overflow-hidden group hover:border-base-content/20 transition-colors duration-300"
      >
        <div
          class="absolute -top-4 -right-4 p-4 opacity-5 group-hover:opacity-10 group-hover:scale-110 transition-transform duration-500 pointer-events-none"
        >
          <Icon name="boxicons:user-x" size={128} />
        </div>
        <div class="card-body p-6">
          <div class="flex items-center gap-3 mb-2">
            <div class="p-2 bg-base-content/5 rounded-lg text-base-content/50">
              <Icon name="boxicons:user-x" size={24} />
            </div>
            <h3
              class="font-bold text-xs uppercase tracking-widest text-base-content/50"
            >
              Fuera de Servicio
            </h3>
          </div>
          <div class="flex items-baseline gap-2">
            <span
              class="text-5xl font-black text-base-content/80 tracking-tight"
              id="stat-no-disponibles-count">{noDisponiblesCount}</span
            >
            <span
              class="text-base-content/40 font-bold uppercase text-xs tracking-wider"
              >en estados especiales</span
            >
          </div>

          <div class="mt-4 grid grid-cols-2 gap-2">
            {
              Object.entries(breakdown).map(([estado, count]) => (
                <div
                  class="flex items-center justify-between p-2 rounded-lg bg-base-200/50 border border-transparent hover:border-base-300 transition-colors duration-200 data-[count='0']:opacity-40"
                  data-breakdown-container
                  data-count={count}
                >
                  <div class="flex items-center gap-2 min-w-0">
                    <span
                      class={`size-2 rounded-full shrink-0 ${breakdownBadge(estado)}`}
                    />
                    <span class="text-xs font-bold truncate text-base-content/60 uppercase tracking-tight">
                      {STATUS_LABELS[estado] ?? estado}
                    </span>
                  </div>
                  <span
                    class="text-xs font-mono font-bold text-base-content/90"
                    data-breakdown-count={estado}
                  >
                    {count}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <!-- Control Bar: Toggle -->
    <div class="flex items-center justify-start gap-4">
      <label class="label cursor-pointer justify-start gap-3 bg-base-200/40 hover:bg-base-200/80 px-4 py-2.5 rounded-xl border border-base-300/45 transition-colors duration-250">
        <input type="checkbox" id="toggle-disponibles" class="toggle toggle-secondary toggle-sm" />
        <span class="label-text font-bold text-xs uppercase tracking-wider text-base-content/70">
          Solo disponibles
        </span>
      </label>
    </div>

    <!-- Tabla de Operadores -->
    <DataTable
      ariaLabel="Lista de operadores para monitoreo de estado"
      headerGridClass="grid-cols-[1.8fr_1.5fr_1.2fr] gap-2 md:gap-4"
      rowGridClass="grid grid-cols-[1.8fr_1.5fr_1.2fr] items-center gap-2 md:gap-4"
    >
      <Fragment slot="header">
        <DataTableHeaderCell sortKey="nombre">Operador</DataTableHeaderCell>
        <DataTableHeaderCell>Horario / Modo</DataTableHeaderCell>
        <DataTableHeaderCell sortKey="estado">Estado</DataTableHeaderCell>
      </Fragment>

      {
        allOperators.map((op) => {
          const isHighlighted = op.agentId === maxAssignedOperatorId;
          const isCurrentUser = matchesCurrentUser(
            op.username,
            op.nombre,
            currentUsername,
          );

          let rowClasses =
            "group border-b border-base-300 px-4 py-2.5 transition-colors duration-300 hover:bg-base-200/50";
          if (isCurrentUser) {
            rowClasses += " bg-accent/10 border-l-4 border-l-accent";
          } else if (isHighlighted) {
            rowClasses += " bg-secondary/10 border-l-4 border-l-secondary";
          }
          if (!op.disponible) {
            rowClasses += " opacity-50 grayscale-[30%]";
          }

          return (
            <div
              class={rowClasses}
              data-table-row
              data-op-id={op.agentId}
              data-op-estado={
                op.disponible ? "disponible" : op.motivo || "offline"
              }
              data-sort-nombre={op.nombre}
              data-sort-estado={
                op.disponible ? "disponible" : op.motivo || "offline"
              }
            >
              {/* Nombre + Last Assigned */}
              <div class="flex min-w-0 flex-col">
                <span class="truncate text-xs font-bold text-base-content">
                  {op.nombre}
                </span>
                <div data-op-last-assigned-container>
                  {op.lastAutogestionAssignedAt ? (
                    <span
                      class="text-tiny text-base-content/75 bg-base-300/50 rounded px-1.5 py-0.5 inline-block font-semibold mt-0.5"
                      data-last-assigned={op.lastAutogestionAssignedAt}
                    >
                      Asignado:{" "}
                      {new Date(op.lastAutogestionAssignedAt).toLocaleTimeString(
                        "es-AR",
                        { hour: "2-digit", minute: "2-digit" },
                      )}
                    </span>
                  ) : (
                    <span class="text-tiny text-base-content/40 bg-base-200/40 rounded px-1.5 py-0.5 inline-block italic mt-0.5">
                      Nunca asignado
                    </span>
                  )}
                </div>
              </div>

              {/* Horario y Modo */}
              <div class="flex flex-col gap-1 min-w-0">
                <div data-op-horario>
                  {op.horarioHoy ? (
                    <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-small text-base-content/70">
                      {op.salidaInminente ? (
                        <span class="badge badge-soft badge-error text-error font-bold text-xxs px-2 py-0.5 flex items-center gap-1 shadow-xs" title={`Termina su jornada en ${op.salidaInminenteMin || 1} min`}>
                          <Icon name="boxicons:arrow-out-right-square-half" size={12} class="shrink-0" />
                          <span>Salida en {op.salidaInminenteMin}m ({op.horarioHoy.split(" - ")[1]})</span>
                        </span>
                      ) : (
                        <span class="flex items-center gap-1 font-semibold">
                          <Icon
                            name="boxicons:clock-dashed-half-filled"
                            size={14}
                            class="opacity-60 shrink-0"
                          />
                          {op.horarioHoy}
                        </span>
                      )}
                      {op.breakInminente ? (
                        <span class="badge badge-soft badge-warning text-warning font-bold text-xxs px-2 py-0.5 flex items-center gap-1 shadow-xs" title={`Entra en break en ${op.breakInminenteMin || 1} min`}>
                          <Icon name="boxicons:cup-hot" size={12} class="shrink-0" />
                          <span>Break en {op.breakInminenteMin}m ({op.breakInicioHoy})</span>
                        </span>
                      ) : op.breakInicioHoy && op.breakFinHoy && (
                        <span class="flex items-center gap-1 opacity-70">
                          <Icon
                            name="boxicons:cup-hot"
                            size={14}
                            class="opacity-60 shrink-0"
                          />
                          {op.breakInicioHoy} - {op.breakFinHoy}
                        </span>
                      )}
                    </div>
                  ) : (
                    <span class="text-base-content/40 italic">Sin horario</span>
                  )}
                </div>

                <div data-op-modalidad>
                  {op.modalidadHoy && op.modalidadHoy !== "Franco" && (
                    <span class="text-xxs font-bold opacity-60 uppercase tracking-tight">
                      {op.modalidadHoy === "Home Office" ? "Home" : op.modalidadHoy === "Guardia" ? "Guardia" : "Presencial"}
                    </span>
                  )}
                </div>
              </div>

              {/* Badge estado */}
              <div
                data-op-status-cell={op.agentId}
                class="flex flex-col items-start gap-1"
              >
                {(() => {
                  const isDescon = (op.wiseCxStatus && op.wiseCxStatus.toLowerCase().includes("desconectado")) || (op.motivo && op.motivo.toLowerCase().includes("desconectado"));
                  const dur = isDescon ? "" : formatWiseMinutes(op.wiseCxMinutesInStatus);
                  const durLabel = dur ? ` (${dur})` : "";
                  
                  let badgeColorClass = getBadgeColor(op.motivo || "", op.disponible);
                  let badgeContent = "Disponible";
                  let dotType = "";

                  if (op.wiseCxInCall) {
                    badgeColorClass = "badge-soft badge-warning text-warning shadow-xs animate-pulse";
                    badgeContent = `En llamada${durLabel}`;
                    dotType = "warning";
                  } else if (op.disponible) {
                    badgeColorClass = "badge-soft badge-success text-success shadow-xs";
                    badgeContent = op.wiseCxStatus ? `${op.wiseCxStatus}${durLabel}` : "Disponible";
                    dotType = "success";
                  } else if (op.motivo === "En break") {
                    badgeColorClass = "badge-soft badge-warning text-warning shadow-xs";
                    badgeContent = `En break - vuelve ${op.retornoEstimado || ""}`;
                    dotType = "warning";
                  } else if (op.wiseCxStatus && !isDescon) {
                    badgeColorClass = op.wiseCxBadgeVariant === "error"
                      ? "badge-soft badge-error text-error shadow-xs"
                      : "badge-soft badge-neutral text-base-content/70";
                    badgeContent = `${op.wiseCxStatus}${durLabel}`;
                    if (op.wiseCxBadgeVariant === "error") dotType = "error";
                  } else if (isDescon && op.motivo !== "Franco" && op.motivo !== "Fuera de horario") {
                    badgeColorClass = "badge-soft badge-neutral text-base-content/70";
                    badgeContent = "Desconectado";
                  } else {
                    const cleanMotivo = (op.motivo || "Franco").replace(/\s*\(Wise\s*CX\)$/i, "").trim();
                    badgeColorClass = getBadgeColor(cleanMotivo, false);
                    badgeContent = cleanMotivo;
                  }

                  return (
                    <span
                      data-op-status-badge={op.agentId}
                      class={`badge ${badgeColorClass} gap-1.5 badge-xs font-semibold uppercase text-tiny tracking-wider py-2`}
                    >
                      {dotType === "success" && <span class="size-1.5 rounded-full bg-success animate-ping" />}
                      {dotType === "warning" && <span class="size-1.5 rounded-full bg-warning animate-pulse" />}
                      {dotType === "error" && <span class="size-1.5 rounded-full bg-error" />}
                      {badgeContent}
                    </span>
                  );
                })()}
              </div>
            </div>
          );
        })
      }
    </DataTable>
  </div>

  <!-- Pestaña 3: Automatización -->
  <div id="panel-automatizacion" data-csrf-token={getCsrfTokenForSession(Astro.locals.sessionId)} class={initialTab === "automatizacion" ? "flex flex-col gap-6" : "flex flex-col gap-6 hidden"}>
    <!-- Tarjeta Principal del Módulo de Automatización -->
    <div class="card bg-base-100 border border-base-300 rounded-2xl shadow-xs overflow-hidden">
      <!-- Cabecera del Panel -->
      <div class="p-5 border-b border-base-300 bg-base-200/30 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="p-2.5 rounded-xl bg-secondary/10 text-secondary shrink-0">
            <Icon name="boxicons:cog" size={24} />
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h3 class="font-bold text-base text-base-content">Módulo de Automatizaciones de Autogestión</h3>
              <span id="automation-active-count" class="badge badge-secondary badge-soft font-mono font-bold text-xs">{activeRulesCount} activa{activeRulesCount !== 1 ? "s" : ""}</span>
            </div>
            <p class="text-xs text-base-content/60">
              Reglas y patrones programados para la asignación inteligente y distribución autónoma de tickets en la mesa de autogestiones
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2 shrink-0">
          <span class="badge badge-neutral badge-soft text-xs font-semibold gap-1.5 py-3 px-3 rounded-xl">
            <Icon name="boxicons:clock" size={16} />
            Sondeo cada 10 min
          </span>
          <span class="badge badge-success badge-soft text-xs font-semibold gap-1.5 py-3 px-3 rounded-xl">
            <Icon name="boxicons:check-shield" size={16} />
            Protección de API
          </span>
        </div>
      </div>

      <!-- Banner de orientación para supervisión -->
      <div class="p-5 bg-base-200/15 border-b border-base-300/60 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-xs">
        <div class="flex items-start gap-3 text-base-content/75 max-w-3xl">
          <div class="p-1.5 rounded-lg bg-info/10 text-info mt-0.5 shrink-0">
            <Icon name="boxicons:info-circle" size={18} />
          </div>
          <div>
            <span class="font-bold text-base-content block mb-0.5">Documentación Operativa para Supervisión:</span>
            <span>
              Este panel describe con fines informativos las automatizaciones activas programadas en el sistema. Los procesos corren de manera autónoma en segundo plano con una cadencia protegida de 10 minutos. Si el operador requerido no está disponible (en break, franco o fuera de horario), el ticket queda protegido en cola hasta que se verifique disponibilidad o se asigne manualmente.
            </span>
          </div>
        </div>
      </div>

      <!-- Listado de Reglas de Automatización Documentadas -->
      <div class="p-5 sm:p-6 flex flex-col gap-6">
        {AUTOGESTION_AUTOMATION_RULES.map((rule) => {
          const isRuleActive = resolveRuleEnabled(rule.id, ruleStates);
          return (
          <div
            data-rule-card={rule.id}
            data-off={isRuleActive ? undefined : "true"}
            class="group border border-base-300 rounded-2xl overflow-hidden shadow-2xs transition-all bg-base-100 hover:border-secondary/40 group-data-[off=true]:bg-base-100/60 group-data-[off=true]:hover:border-base-300"
          >
            <!-- Barra de título de la regla -->
            <div class="p-4 sm:p-5 bg-base-200/25 border-b border-base-300/70 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class="p-2 rounded-xl shrink-0 transition-colors bg-secondary/10 text-secondary group-data-[off=true]:bg-base-200 group-data-[off=true]:text-base-content/40">
                  <Icon name={rule.id === "solicitud_rechazada" ? "boxicons:git-repo-forked" : "boxicons:refresh-cw"} size={22} />
                </div>
                <div>
                  <div class="flex items-center gap-2 flex-wrap">
                    <h4 class="font-extrabold text-base tracking-tight transition-colors text-base-content group-data-[off=true]:text-base-content/50">
                      {rule.name}
                    </h4>
                    <span class={`badge ${rule.priority === 1 ? "badge-secondary" : "badge-neutral"} badge-soft font-bold text-xs uppercase tracking-wider`}>
                      Prioridad {rule.priority ?? 1}
                    </span>
                    <span
                      data-rule-badge={rule.id}
                      class={`badge ${isRuleActive ? "badge-success" : "badge-neutral"} badge-soft font-bold text-xs uppercase tracking-wider`}
                    >
                      {isRuleActive ? "Activa" : "Inactiva"}
                    </span>
                    {
                      canToggleRules && (
                        <label class="flex items-center gap-1.5 cursor-pointer select-none">
                          <input
                            type="checkbox"
                            class="toggle toggle-secondary toggle-sm"
                            data-rule-toggle={rule.id}
                            data-rule-enabled={isRuleActive ? "true" : "false"}
                            checked={isRuleActive}
                            title={isRuleActive ? "Deshabilitar la automatización" : "Habilitar la automatización"}
                            aria-label={`Habilitar o deshabilitar la automatización ${rule.name}`}
                          />
                        </label>
                      )
                    }
                  </div>
                  <p class="text-xs text-base-content/70 mt-1 max-w-2xl leading-relaxed">
                    {rule.description}
                  </p>
                </div>
              </div>

              <div class="flex sm:flex-col items-end justify-between sm:justify-center gap-1 shrink-0 text-right">
                <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wider">Frecuencia</span>
                <span class="badge badge-neutral badge-soft font-mono font-bold text-xs">Cada {rule.intervalMinutes} min</span>
              </div>
            </div>

            <!-- Cuerpo de la regla: 2 Columnas (Condiciones de Disparo vs Efecto / Acciones) -->
            <div class="p-5 sm:p-6 grid grid-cols-1 lg:grid-cols-2 gap-6 bg-base-100">
              <!-- Columna 1: Condiciones de Activación -->
              <div class="flex flex-col gap-3">
                <div class="flex items-center gap-2 text-xs font-bold text-base-content/60 uppercase tracking-wider pb-1 border-b border-base-200">
                  <Icon name="boxicons:filter" size={16} class="text-secondary group-data-[off=true]:text-base-content/40" />
                  <span>Criterios y Condiciones de Activación</span>
                </div>
                <div class="flex flex-col gap-2.5">
                  {rule.conditions.map((cond) => (
                    <div class="flex items-start gap-2.5 p-3 rounded-xl bg-base-200/40 border border-base-300/50">
                      <div class="p-1 rounded-md shrink-0 mt-0.5 transition-colors bg-success/15 text-success group-data-[off=true]:bg-base-300/50 group-data-[off=true]:text-base-content/40">
                        <Icon name="boxicons:check" size={14} class="group-data-[off=true]:hidden" />
                        <Icon name="boxicons:minus" size={14} class="hidden group-data-[off=true]:block" />
                      </div>
                      <div class="flex flex-col gap-0.5">
                        <span class="text-xs font-bold text-base-content">{cond.label}</span>
                        <span class="text-xs text-base-content/70 leading-normal">{cond.description}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Columna 2: Efecto Operativo y Comportamiento -->
              <div class="flex flex-col gap-3">
                <div class="flex items-center gap-2 text-xs font-bold text-base-content/60 uppercase tracking-wider pb-1 border-b border-base-200">
                  <Icon name="boxicons:checks" size={16} class="text-secondary group-data-[off=true]:text-base-content/40" />
                  <span>Efecto y Comportamiento Operativo</span>
                </div>

                <div class="flex flex-col gap-3">
                  <div class="p-3.5 rounded-xl bg-secondary/5 border border-secondary/20 flex flex-col gap-1.5">
                    <span class="text-xs font-bold flex items-center gap-1.5 text-secondary group-data-[off=true]:text-base-content/40">
                      <Icon name={rule.id === "solicitud_rechazada" ? "boxicons:user-check" : "boxicons:group"} size={16} />
                      {rule.id === "solicitud_rechazada" ? "Asignación Directa al Creador" : "Asignación al Próximo en Cola Cíclica"}
                    </span>
                    <p class="text-xs text-base-content/80 leading-relaxed">
                      {rule.effect}
                    </p>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                    <div class="p-3 rounded-xl bg-base-200/30 border border-base-300/50 flex flex-col gap-1">
                      <span class="font-bold text-base-content/70 uppercase tracking-wider text-[11px] flex items-center gap-1">
                        <Icon name="boxicons:refresh-cw" size={14} class="text-info" />
                        Cola Cíclica
                      </span>
                      {rule.id === "solicitud_rechazada" ? (
                        <span class="font-semibold text-success flex items-center gap-1">
                          <Icon name="boxicons:shield-quarter" size={14} />
                          Turno preservado (skipQueue)
                        </span>
                      ) : (
                        <span class="font-semibold text-info flex items-center gap-1">
                          <Icon name="boxicons:refresh-cw" size={14} />
                          Rotación de turno (now)
                        </span>
                      )}
                    </div>

                    <div class="p-3 rounded-xl bg-base-200/30 border border-base-300/50 flex flex-col gap-1">
                      <span class="font-bold text-base-content/70 uppercase tracking-wider text-[11px] flex items-center gap-1">
                        <Icon name="boxicons:history" size={14} class="text-secondary" />
                        Trazabilidad
                      </span>
                      <span class="font-semibold text-base-content/80 font-mono">
                        Tipo: "automatica"
                      </span>
                    </div>
                  </div>

                  <div class="p-3 rounded-xl bg-base-200/25 border border-base-300/40 text-xs text-base-content/65 flex items-center gap-2">
                    <Icon name="boxicons:radar" size={16} class="text-base-content/40 shrink-0" />
                    <span>Disparador: {rule.triggerEvent}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          );
        })}
      </div>
    </div>
  </div>

<!-- Modal Detalle de Ticket Sin Asignar -->
  <dialog id="modal-ticket-detail" class="modal" data-invgate-web-base={invgateWebBase}>
    <div class="modal-box w-11/12 max-w-4xl border border-base-300 bg-base-100 p-0 overflow-hidden shadow-2xl rounded-2xl">
      <!-- Modal Header -->
      <div class="p-4 sm:p-5 bg-base-200/40 border-b border-base-300 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2.5 min-w-0 flex-wrap flex-1">
          <div class="p-2 rounded-xl bg-secondary/10 text-secondary shrink-0">
            <Icon name="boxicons:receipt" size={20} />
          </div>
          <span id="ticket-modal-id" class="badge badge-soft badge-neutral font-mono font-bold text-sm px-3 py-1 shrink-0 text-base-content/70">#0</span>
          <span id="ticket-modal-prio" class="badge badge-soft badge-sm font-bold tracking-wider uppercase shrink-0 text-xs"></span>
          <span id="ticket-modal-cat" class="badge badge-soft badge-neutral badge-sm font-semibold truncate shrink-0 max-w-[280px] text-xs"></span>
        </div>
        <form method="dialog" class="shrink-0">
          <button class="btn btn-sm btn-circle btn-ghost text-base-content/60 hover:text-base-content" aria-label="Cerrar modal">✕</button>
        </form>
      </div>

      <!-- Modal Body -->
      <div class="p-5 sm:p-6 flex flex-col gap-5 max-h-[72vh] overflow-y-auto overflow-x-hidden">
        <!-- Título -->
        <div class="min-w-0">
          <label class="text-xs font-bold text-base-content/50 uppercase tracking-wider block mb-1">Título de la solicitud</label>
          <h3 id="ticket-modal-title" class="text-xl sm:text-2xl font-extrabold text-base-content leading-snug truncate" title=""></h3>
        </div>

        <!-- Grid de Metadatos -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-base-200/25 p-4 sm:p-5 rounded-xl border border-base-300/60 text-xs">
          <div class="min-w-0">
            <span class="font-semibold text-base-content/50 uppercase tracking-wider block mb-0.5">Creado por</span>
            <span id="ticket-modal-creator" class="text-sm sm:text-base font-bold text-base-content truncate block"></span>
          </div>
          <div class="min-w-0">
            <span class="font-semibold text-base-content/50 uppercase tracking-wider block mb-0.5">Usuario afectado (Cliente)</span>
            <span id="ticket-modal-customer" class="text-sm sm:text-base font-bold text-base-content truncate block"></span>
          </div>
          <div class="min-w-0">
            <span class="font-semibold text-base-content/50 uppercase tracking-wider block mb-0.5">Ubicación / Sede</span>
            <span id="ticket-modal-location" class="text-sm font-semibold text-base-content truncate block"></span>
          </div>
          <div class="min-w-0">
            <span class="font-semibold text-base-content/50 uppercase tracking-wider block mb-0.5">Fecha y Hora de Creación</span>
            <span id="ticket-modal-created" class="text-sm font-mono font-semibold text-base-content/80 block"></span>
          </div>
          <div class="min-w-0">
            <span class="font-semibold text-base-content/50 uppercase tracking-wider block mb-0.5">Tiempo en cola</span>
            <span id="ticket-modal-wait" class="text-sm sm:text-base font-mono font-bold block"></span>
          </div>
          <div class="min-w-0">
            <span class="font-semibold text-base-content/50 uppercase tracking-wider block mb-0.5">SLA de Respuesta</span>
            <span id="ticket-modal-sla" class="text-sm font-mono font-semibold text-base-content/75 block"></span>
          </div>
        </div>

        <!-- Categoría Completa -->
        <div id="ticket-modal-cat-full-container" class="hidden min-w-0">
          <label class="text-xs font-bold text-base-content/50 uppercase tracking-wider block mb-1">Ruta de Categoría</label>
          <span id="ticket-modal-cat-full" class="text-xs sm:text-sm font-mono bg-base-200/50 border border-base-300/60 px-3 py-1.5 rounded-lg block text-base-content/80 break-words"></span>
        </div>

        <!-- Descripción Completa -->
        <div class="min-w-0">
          <label class="text-xs font-bold text-base-content/50 uppercase tracking-wider block mb-1">Descripción del ticket</label>
          <div id="ticket-modal-description" class="text-xs sm:text-sm text-base-content/85 whitespace-pre-wrap break-words bg-base-200/30 p-4 rounded-xl border border-base-300/50 font-sans max-h-60 overflow-y-auto leading-relaxed">
            Sin descripción disponible.
          </div>
        </div>

        <!-- Sección de Comentarios y Notas -->
        <div class="space-y-3 pt-1" id="ticket-modal-comments-section">
          <div class="flex items-center justify-between gap-2 border-b border-base-300 pb-2">
            <div class="flex items-center gap-2">
              <Icon name="boxicons:message-circle-detail" size={18} class="text-base-content/60" />
              <h4 class="text-xs font-bold text-base-content/75 uppercase tracking-wider">Comentarios y Notas</h4>
            </div>
            <span id="ticket-modal-comments-count" class="badge badge-soft badge-neutral badge-sm font-mono font-bold">-</span>
          </div>

          <!-- Botón de Carga Diferida (Click-to-Load) -->
          <div id="ticket-modal-comments-trigger-container" class="py-2">
            <button
              type="button"
              id="ticket-modal-load-comments-btn"
              class="btn btn-sm btn-outline btn-secondary w-full gap-2 text-xs font-semibold"
            >
              <Icon name="boxicons:message-circle-dots" size={16} />
              <span>Ver comentarios y notas (Click para cargar)</span>
            </button>
          </div>

          <!-- Operadores MDA Intervinientes -->
          <div id="ticket-modal-mda-operators-container" class="hidden bg-base-200/40 border border-base-300/70 rounded-xl p-3 space-y-2">
            <div class="flex items-center gap-2">
              <Icon name="boxicons:user-check" size={16} class="text-secondary" />
              <span class="text-xs font-bold uppercase tracking-wider text-base-content/70">
                Operadores MDA en comentarios
              </span>
            </div>
            <div id="ticket-modal-mda-operators-list" class="flex flex-wrap gap-2">
            </div>
          </div>

          <!-- Loading state -->
          <div id="ticket-modal-comments-loading" class="hidden flex items-center justify-center gap-2 py-6 text-base-content/50 text-xs font-medium">
            <span class="loading loading-spinner loading-xs text-secondary"></span>
            <span>Cargando comentarios...</span>
          </div>

          <!-- Empty state -->
          <div id="ticket-modal-comments-empty" class="hidden py-6 text-center text-xs text-base-content/40 italic bg-base-200/20 rounded-xl border border-base-300/40">
            No hay comentarios registrados en este ticket.
          </div>

          <!-- Error state -->
          <div id="ticket-modal-comments-error" class="hidden py-4 text-center text-xs text-error bg-error/10 rounded-xl border border-error/20">
            No se pudieron cargar los comentarios.
          </div>

          <!-- List container -->
          <div id="ticket-modal-comments-list" class="hidden space-y-2.5 max-h-72 overflow-y-auto pr-1">
          </div>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="p-4 sm:p-5 bg-base-200/40 border-t border-base-300 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
        <span class="text-xs text-base-content/45 font-medium text-center sm:text-left">Mesa de Ayuda #${AGS_HELPDESK_ID}</span>
        <div class="flex flex-wrap items-center justify-end gap-2">
          <button
            id="ticket-modal-assign-to-btn"
            type="button"
            class="btn btn-secondary btn-sm font-bold gap-1.5 rounded-lg flex-1 sm:flex-initial"
          >
            <Icon name="boxicons:user-plus" size={16} class="shrink-0" />
            <span>Asignar a...</span>
          </button>
          <a
            id="ticket-modal-invgate-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary btn-sm font-bold gap-1.5 rounded-lg flex-1 sm:flex-initial"
          >
            <span>Abrir en InvGate</span>
            <Icon name="boxicons:arrow-out-right-square-half" size={16} class="shrink-0" />
          </a>
          <form method="dialog" class="sm:inline-flex">
            <button class="btn btn-ghost btn-sm font-semibold rounded-lg w-full sm:w-auto">Cerrar</button>
          </form>
        </div>
      </div>
    </div>
  </dialog>

  <!-- Modal Asignar Ticket a Operador Específico -->
  <dialog id="modal-asignar-operador" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box w-11/12 max-w-4xl bg-base-100 p-0 border border-base-300 shadow-2xl rounded-2xl overflow-hidden flex flex-col max-h-[85vh]">
      <!-- Header -->
      <div class="p-4 sm:p-5 border-b border-base-300 bg-base-200/40 flex items-center justify-between gap-3">
        <div class="flex items-center gap-3 min-w-0">
          <div class="p-2.5 rounded-xl bg-secondary/10 text-secondary shrink-0">
            <Icon name="boxicons:user-plus" size={22} />
          </div>
          <div class="min-w-0 flex flex-col gap-0.5">
            <h3 class="font-extrabold text-sm sm:text-base text-base-content uppercase tracking-wider">Asignar Ticket a Operador</h3>
            <div class="flex items-center gap-2 text-xs text-base-content/70 min-w-0 flex-wrap">
