  <script id="initial-unassigned-data" type="application/json" set:html={JSON.stringify(unassignedTickets)} />
  <script id="initial-disponibilidad-data" type="application/json" set:html={JSON.stringify(allOperators)} />
</PageContainer>

<script>
  import { showToast } from "@/lib/toastClient";
  import { escapeHtml } from "@lib/sanitize";
  import { matchesCurrentUser } from "@lib/currentUserMatch";

  let countdownInterval: any = null;
  let heartbeatInterval: any = null;
  let checkReady: any = null;
  let autoPollTimer: any = null;
  let idleTimer: any = null;
  let ticketsAbortController: AbortController | null = null;
  let disponibilidadAbortController: AbortController | null = null;

  const init = () => {
    // Toggle de habilitación de automatizaciones (delegación: los controles son
    // server-rendered y el panel vive siempre en el DOM).
    const rulesPanel = document.getElementById("panel-automatizacion");
    rulesPanel?.addEventListener("change", async (ev) => {
      const input = (ev.target as HTMLElement | null)?.closest?.(
        "[data-rule-toggle]",
      ) as HTMLInputElement | null;
      if (!input) return;
      const ruleId = input.getAttribute("data-rule-toggle");
      if (!ruleId) return;
      const csrfToken = rulesPanel.getAttribute("data-csrf-token") || "";
      const next = input.checked;
      const badge = document.querySelector(
        `[data-rule-badge="${ruleId}"]`,
      ) as HTMLElement | null;
      const card = document.querySelector(
        `[data-rule-card="${ruleId}"]`,
      ) as HTMLElement | null;

      input.disabled = true;
      try {
        const res = await fetch(
          `/api/autogestion/rules/${encodeURIComponent(ruleId)}/toggle`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-CSRF-Token": csrfToken,
            },
            body: JSON.stringify({ enabled: next }),
          },
        );
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || "No se pudo actualizar la regla");

        input.setAttribute("data-rule-enabled", String(next));
        input.title = next
          ? "Deshabilitar la automatización"
          : "Habilitar la automatización";
        if (badge) {
          badge.textContent = next ? "Activa" : "Inactiva";
          badge.classList.toggle("badge-success", next);
          badge.classList.toggle("badge-neutral", !next);
        }
        if (card) {
          // Una sola bandera: todo el apagado visual sale de group-data-[off=true].
          if (next) card.removeAttribute("data-off");
          else card.setAttribute("data-off", "true");
        }
        const counter = document.getElementById("automation-active-count");
        if (counter) {
          const active = document.querySelectorAll(
            "[data-rule-badge].badge-success",
          ).length;
          counter.textContent = `${active} activa${active !== 1 ? "s" : ""}`;
        }
        showToast(
          next ? "Automatización habilitada." : "Automatización deshabilitada.",
          "alert-success",
        );
      } catch (err: any) {
        input.checked = !next; // revierte el switch
        showToast(err?.message || "Error al actualizar la automatización.", "alert-error");
      } finally {
        input.disabled = false;
      }
    });

    const toggle = document.getElementById(
      "toggle-disponibles",
    ) as HTMLInputElement | null;
    if (!toggle) return false;

    // Tab switching listener
    const tabBtns = document.querySelectorAll("[data-tab-target]");
    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-tab-target");

        tabBtns.forEach((b) => {
          b.classList.remove("tab-active", "bg-secondary", "text-secondary-content", "shadow-sm");
          b.classList.add("text-base-content/70", "hover:text-base-content");
        });
        btn.classList.add("tab-active", "bg-secondary", "text-secondary-content", "shadow-sm");
        btn.classList.remove("text-base-content/70", "hover:text-base-content");

        const panels = ["panel-asignacion", "panel-monitoreo", "panel-automatizacion"];
        panels.forEach((pId) => {
          document.getElementById(pId)?.classList.toggle("hidden", pId !== targetId);
        });

        const tabKey = targetId === "panel-monitoreo" ? "monitoreo" : targetId === "panel-automatizacion" ? "automatizacion" : "asignacion";
        const url = new URL(window.location.href);
        url.searchParams.set("tab", tabKey);
        window.history.replaceState({}, "", url.toString());
      });
    });

    let lockExpiresAt = 0;
    let lockTimeoutMs = 300000;
    let currentLockStatus: any = null;
    let clientHasLock = false;
    let latestUnassignedTickets: any[] = [];
    let latestDisponibilidadData: any[] = [];
    let loadedCommentsByTicket = new Map<number, any>();
    let currentModalTicket: any = null;

    const rawTicketsEl = document.getElementById("initial-unassigned-data");
    if (rawTicketsEl && rawTicketsEl.textContent) {
      try {
        latestUnassignedTickets = JSON.parse(rawTicketsEl.textContent);
      } catch {}
    }
    const rawOpsEl = document.getElementById("initial-disponibilidad-data");
    if (rawOpsEl && rawOpsEl.textContent) {
      try {
        latestDisponibilidadData = JSON.parse(rawOpsEl.textContent);
      } catch {}
    }

    const formatCountdown = (ms: number): string => {
      if (ms <= 0) return "0:00";
      const totalSeconds = Math.floor(ms / 1000);
      const minutes = Math.floor(totalSeconds / 60);
      const seconds = totalSeconds % 60;
      return `${minutes}:${seconds.toString().padStart(2, "0")}`;
    };

    const formatWaitTime = (elapsedMin: number): string => {
      if (elapsedMin >= 1440) {
        const days = Math.floor(elapsedMin / 1440);
        const hours = Math.floor((elapsedMin % 1440) / 60);
        return hours > 0 ? `${days}d ${hours}h` : `${days}d`;
      }
      if (elapsedMin >= 60) {
        return `${Math.floor(elapsedMin / 60)}h ${elapsedMin % 60}m`;
      }
      return `${elapsedMin}m`;
    };

    const formatWiseMinutesJs = (min: number | undefined | null): string => {
      if (!min || min <= 0) return "";
      if (min >= 1440) {
        const d = Math.floor(min / 1440);
        const h = Math.floor((min % 1440) / 60);
        return h > 0 ? `${d}d ${h}h` : `${d}d`;
      }
      if (min >= 60) {
        const h = Math.floor(min / 60);
        const m = min % 60;
        return m > 0 ? `${h}h ${m}m` : `${h}h`;
      }
      return `${min}m`;
    };

    const removeTicketCardOptimistically = (ticketId: number | undefined) => {
      if (!ticketId) return;
      const cardEl = document.querySelector(`[data-ticket-id="${ticketId}"]`);
      if (cardEl) {
        cardEl.remove();
      }
      latestUnassignedTickets = latestUnassignedTickets.filter((t) => t.id !== ticketId);
      const countEl = document.getElementById("stat-unassigned-count");
      const currentCount = parseInt(countEl?.textContent || "0", 10);
      const newCount = Math.max(0, (isNaN(currentCount) ? 0 : currentCount) - 1);
      if (countEl) {
        countEl.textContent = String(newCount);
        countEl.className = `font-mono font-bold text-sm ${newCount > 0 ? "text-secondary" : "text-base-content/50"}`;
      }
      updateActionBarSubtitle();
      const listEl = document.getElementById("unassigned-tickets-list");
      if (listEl && newCount === 0) {
        listEl.innerHTML = '<div class="text-sm text-base-content/40 italic py-16 text-center">No hay tickets sin asignar</div>';
      }
    };

    const renderModalComments = (data: any, ticket: any) => {
      const commentsLoading = document.getElementById("ticket-modal-comments-loading");
      const commentsEmpty = document.getElementById("ticket-modal-comments-empty");
      const commentsError = document.getElementById("ticket-modal-comments-error");
      const commentsList = document.getElementById("ticket-modal-comments-list");
      const commentsCount = document.getElementById("ticket-modal-comments-count");
      const mdaContainer = document.getElementById("ticket-modal-mda-operators-container");
      const mdaList = document.getElementById("ticket-modal-mda-operators-list");
      const triggerContainer = document.getElementById("ticket-modal-comments-trigger-container");

      if (triggerContainer) triggerContainer.classList.add("hidden");
      if (commentsLoading) commentsLoading.classList.add("hidden");
      if (commentsError) commentsError.classList.add("hidden");

      const comments = data?.comments || [];
      const rawCommentingOps = data?.commenting_operators || [];
      const commentingOps = rawCommentingOps.filter((op: any) => op.id !== ticket?.creator_id);
      if (commentsCount) commentsCount.textContent = String(comments.length);

      if (commentingOps.length > 0) {
        if (mdaList) {
          mdaList.innerHTML = commentingOps.map((op: any) => `
            <div class="inline-flex items-center gap-2 bg-base-100 border border-base-300 rounded-lg px-2.5 py-1 text-xs">
              <div class="avatar placeholder size-5 rounded-full bg-secondary/15 text-secondary font-bold text-xxs flex items-center justify-center">
                ${escapeHtml((op.name || "OP").substring(0, 2).toUpperCase())}
              </div>
              <span class="text-base-content font-medium">${escapeHtml(op.name)}</span>
              <span class="badge badge-soft badge-secondary badge-xs font-bold font-mono">${op.comment_count}</span>
            </div>
          `).join("");
        }
        if (mdaContainer) mdaContainer.classList.remove("hidden");
      } else {
        if (mdaContainer) mdaContainer.classList.add("hidden");
      }

      if (comments.length === 0) {
        if (commentsEmpty) commentsEmpty.classList.remove("hidden");
        if (commentsList) commentsList.classList.add("hidden");
        return;
      }

      if (commentsEmpty) commentsEmpty.classList.add("hidden");
      if (commentsList) {
        commentsList.classList.remove("hidden");
        commentsList.innerHTML = comments.map((c: any) => {
          const isInternal = c.customer_visible === false || c.customer_visible === 0;
          const authorName = c.author_name || `Usuario #${c.author_id}`;
          const authorParts = authorName.trim().split(/\s+/);
          const initials = authorParts.length >= 2
            ? (authorParts[0][0] + authorParts[authorParts.length - 1][0]).toUpperCase()
            : authorName.substring(0, 2).toUpperCase();

          const timeStr = c.created_at
            ? new Date(c.created_at * 1000).toLocaleString("es-AR", {
                dateStyle: "short",
                timeStyle: "short",
              })
            : "";

          let typeBadge = `<span class="badge badge-soft badge-neutral badge-xs font-semibold px-2 py-0.5">Público</span>`;
          if (c.is_solution) {
            typeBadge = `<span class="badge badge-soft badge-success badge-xs font-bold px-2 py-0.5">Solución</span>`;
          } else if (isInternal) {
            typeBadge = `<span class="badge badge-soft badge-warning badge-xs font-bold px-2 py-0.5">Nota Interna</span>`;
          }

          const mdaBadge = c.is_mda_agent
            ? `<span class="badge badge-soft badge-secondary badge-xs font-medium px-2 py-0.5 gap-1"><svg class="size-2.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><polyline points="16 11 18 13 22 9"></polyline></svg>Operador MDA</span>`
            : "";

          const parser = new DOMParser();
          const doc = parser.parseFromString(c.message || "", "text/html");
          doc.querySelectorAll("script, iframe, object, embed").forEach((node) => node.remove());
          const safeMessage = doc.body.innerHTML;

          const cardClass = isInternal
            ? "bg-warning/5 border border-warning/20"
            : "bg-base-100 border border-base-200/90";
          const avatarClass = isInternal
            ? "bg-warning/15 text-warning"
            : "bg-secondary/10 text-secondary";

          return `
            <div class="p-3.5 sm:p-4 rounded-xl ${cardClass} space-y-2">
              <div class="flex items-center justify-between gap-2 flex-wrap">
                <div class="flex items-center gap-2 flex-wrap">
                  <div class="avatar placeholder size-7 rounded-full shrink-0 flex items-center justify-center font-bold text-xs ${avatarClass}">
                    ${escapeHtml(initials)}
                  </div>
                  <span class="font-bold text-xs sm:text-sm text-base-content">${escapeHtml(authorName)}</span>
                  ${typeBadge}
                  ${mdaBadge}
                </div>
                <span class="text-xs font-mono text-base-content/60">${escapeHtml(timeStr)}</span>
              </div>
              <div class="text-xs sm:text-sm text-base-content/85 whitespace-pre-wrap leading-relaxed pl-9">
                ${safeMessage}
              </div>
            </div>
          `;
        }).join("");
      }
    };

    const stopCountdown = () => {
      if (countdownInterval) {
        clearInterval(countdownInterval);
        countdownInterval = null;
      }
    };

    const startCountdown = () => {
      stopCountdown();

      const tick = () => {
        const remaining = lockExpiresAt - Date.now();
        const countdownEl = document.getElementById("lock-countdown");
        if (remaining <= 0) {
          if (countdownEl) {
            countdownEl.innerText = "0:00";
          }
          stopCountdown();
          fetchLockStatus().then(updateLockBanner);
          return;
        }
        if (countdownEl) {
          countdownEl.innerText = formatCountdown(remaining);
          if (remaining < 60000) {
            countdownEl.classList.remove("bg-base-100/30");
            countdownEl.classList.add("bg-error/70", "text-error-content");
          } else {
            countdownEl.classList.add("bg-base-100/30");
            countdownEl.classList.remove("bg-error/70", "text-error-content");
          }
        }
      };

      tick();
      countdownInterval = setInterval(tick, 1000);
    };


    const updateVisibility = () => {
      const soloDisponibles = toggle.checked;
      const rows = document.querySelectorAll<HTMLElement>("[data-op-id]");
      rows.forEach((row) => {
        const estado = row.getAttribute("data-op-estado") || "";
        if (soloDisponibles && estado !== "disponible") {
          row.classList.add("hidden");
        } else {
          row.classList.remove("hidden");
        }
      });
    };

    toggle.addEventListener("change", updateVisibility);

    const updateActionBarSubtitle = () => {
      const subtitleEl = document.getElementById("action-bar-subtitle");
      if (!subtitleEl) return;

      const lockIndicator = document.getElementById("lock-indicator");
      const clientHasLock = lockIndicator ? lockIndicator.getAttribute("data-has-lock") === "true" : false;
      const clientIsReadOnly = !clientHasLock;

      const availableOps = latestDisponibilidadData.filter((op: any) => op.disponible);
      const unassignedTickets = latestUnassignedTickets || [];

      if (clientIsReadOnly) {
        subtitleEl.textContent = "Tomá el control desde el indicador de estado para habilitar la asignación.";
      } else {
        subtitleEl.textContent = `${unassignedTickets.length} autogestiones sin asignar • ${availableOps.length} operadores disponibles`;
      }
    };

    // Dynamic UI Update from API Response
    const updateUI = (data: any[]) => {
      latestDisponibilidadData = data || [];

      // 1. Calculate highlights (the one with the latest assignment)
      let maxAssignedTime = 0;
      let maxAgentId: number | null = null;
      data.forEach((op) => {
        if (
          op.lastAutogestionAssignedAt &&
          op.lastAutogestionAssignedAt > maxAssignedTime
        ) {
          maxAssignedTime = op.lastAutogestionAssignedAt;
          maxAgentId = op.agentId;
        }
      });

      const currentUsername =
        (
          document
            .querySelector("[data-user-username]")
            ?.getAttribute("data-user-username") || ""
        )
          .toLowerCase()
          .trim();

      // 2. Update summary cards
      const disponiblesCount = data.filter((op) => op.disponible).length;
      const totalCount = data.length || 1;
      const pct = Math.round((disponiblesCount / totalCount) * 100);

      const statDisponibles = document.getElementById("stat-disponibles-count");
      if (statDisponibles)
        statDisponibles.innerText = disponiblesCount.toString();

      const statNoDisponibles = document.getElementById(
        "stat-no-disponibles-count",
      );
      if (statNoDisponibles)
        statNoDisponibles.innerText = (
          data.length - disponiblesCount
        ).toString();

      const statPercentage = document.getElementById("stat-percentage");
      if (statPercentage) statPercentage.innerText = `${pct}%`;

      const statProgress = document.getElementById(
        "stat-progress",
      ) as HTMLProgressElement | null;
      if (statProgress) {
        statProgress.value = disponiblesCount;
        statProgress.max = totalCount;
      }

      // 3. Update breakdown counts
      const breakdown = {
        "En break": 0,
        "Fuera de horario": 0,
        Franco: 0,
        Licencia: 0,
        Vacaciones: 0,
        Excepción: 0,
      };

      data.forEach((op) => {
        if (!op.disponible) {
          const mot = op.motivo || "Franco";
          if (
            [
              "Devolución Supervisor",
              "Break Extendido",
              "Problema Técnico",
            ].includes(mot)
          ) {
            breakdown["Excepción"]++;
          } else if (mot in breakdown) {
            breakdown[mot as keyof typeof breakdown]++;
          }
        }
      });

      for (const [status, count] of Object.entries(breakdown)) {
        const el = document.querySelector(
          `[data-breakdown-count="${status}"]`,
        ) as HTMLElement | null;
        if (el) {
          el.textContent = count.toString();
          const container = el.closest("[data-breakdown-container]");
          if (container) {
            container.setAttribute("data-count", count.toString());
            if (count === 0) {
              container.classList.add("opacity-40");
            } else {
              container.classList.remove("opacity-40");
            }
          }
        }
      }

      // 3b. Update last assigned card and suggested card
      let maxAssignedTimeForCard = 0;
      let lastAssignedOp: any = null;
      for (const op of data) {
        if (
          op.lastAutogestionAssignedAt &&
          op.lastAutogestionAssignedAt > maxAssignedTimeForCard
        ) {
          maxAssignedTimeForCard = op.lastAutogestionAssignedAt;
          lastAssignedOp = op;
        }
      }

      const lastAssignedContainer = document.getElementById("stat-last-assigned-container");
      if (lastAssignedContainer) {
        if (lastAssignedOp && maxAssignedTimeForCard > 0) {
          const timeStr = new Date(maxAssignedTimeForCard).toLocaleTimeString("es-AR", {
            hour: "2-digit",
            minute: "2-digit",
          });
          lastAssignedContainer.innerHTML = `
            <div class="text-xs flex items-center justify-between gap-2 bg-base-100 px-3 py-2 rounded-xl border border-base-300/60 min-w-0">
              <div class="flex items-center gap-2.5 sm:gap-3 min-w-0 truncate">
                <span class="text-base-content/70 shrink-0">
                  De: <strong class="text-info font-bold" id="stat-last-assigned-by">${escapeHtml(lastAssignedOp.lastAutogestionAssignedBy || "Sistema")}</strong>
                </span>
                <span class="text-base-content/70 truncate">
                  Para: <strong class="text-base-content font-bold" id="stat-last-assigned-to">${escapeHtml(lastAssignedOp.nombre)}</strong>
                </span>
              </div>
              <span class="text-xs text-base-content/50 font-mono shrink-0 whitespace-nowrap ml-2" id="stat-last-assigned-time" title="Hora de asignación">
                ${timeStr}
              </span>
            </div>
          `;
        } else {
          lastAssignedContainer.innerHTML = `<span class="text-xs text-base-content/40 italic py-1">Sin asignaciones hoy</span>`;
        }
      }

      const updateQueueUI = (data: any[]) => {
        const queueContainer = document.getElementById("queue-container");
        if (!queueContainer) return;

        const available = data.filter((op) => op.disponible);
        const sortedQueue = [...available].sort((a, b) => {
          const tA = a.lastAutogestionAssignedAt ?? 0;
          const tB = b.lastAutogestionAssignedAt ?? 0;
          if (a.lastAutogestionAssignedAt === null && b.lastAutogestionAssignedAt !== null) return -1;
          if (a.lastAutogestionAssignedAt !== null && b.lastAutogestionAssignedAt === null) return 1;
          return tA - tB;
        }).slice(0, 10);

        const getInitialsJs = (name: string) => {
          if (!name) return "OP";
          const parts = name.trim().split(/\s+/);
          if (parts.length === 1) return parts[0].substring(0, 2).toUpperCase();
          return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
        };

        if (sortedQueue.length > 0) {
          queueContainer.innerHTML = sortedQueue.map((op, idx) => {
            const isFirst = idx === 0;

            const projTicket = latestUnassignedTickets[idx];
            const projBadge = projTicket
              ? `<div class="badge badge-soft badge-neutral font-mono text-xs px-2.5 py-1 flex items-center gap-1 shrink-0 text-base-content/70 cursor-help" title="Si se asigna en orden, recibirá: ${escapeHtml(projTicket.title)}"><span class="opacity-50 font-sans font-bold">↳</span><span>${escapeHtml(projTicket.pretty_id || '#' + projTicket.id)}</span></div>`
              : "";

            let statusBadge = "";
            const isDesconectado = (op.wiseCxStatus && op.wiseCxStatus.toLowerCase().includes("desconectado")) || (op.motivo && op.motivo.toLowerCase().includes("desconectado"));
            const durStr = isDesconectado ? "" : formatWiseMinutesJs(op.wiseCxMinutesInStatus);
            const durLabel = durStr ? ` (${durStr})` : "";

            if (op.wiseCxInCall) {
              statusBadge = `<span class="badge badge-soft badge-warning text-warning animate-pulse badge-sm font-bold text-xxs px-2 py-0.5 shrink-0 shadow-xs" title="En llamada"><span class="inline-block size-1.5 rounded-full bg-current mr-1"></span>En llamada${durLabel}</span>`;
            } else if (op.wiseCxStatus && !isDesconectado) {
              let variantClass = "badge-neutral text-base-content/70";
              if (op.wiseCxBadgeVariant === "success") variantClass = "badge-success text-success";
              else if (op.wiseCxBadgeVariant === "error") variantClass = "badge-error text-error";
              const titleAttr = `Wise CX: ${escapeHtml(op.wiseCxStatus)}${durStr ? ' hace ' + durStr : ''}`;
              statusBadge = `<span class="badge badge-soft ${variantClass} badge-sm font-bold text-xxs px-2 py-0.5 shrink-0 shadow-xs" title="${titleAttr}"><span class="inline-block size-1.5 rounded-full bg-current mr-1"></span>${escapeHtml(op.wiseCxStatus)}${durLabel}</span>`;
            } else if (!op.disponible) {
              const cleanMotivo = (isDesconectado && op.motivo !== "Franco" && op.motivo !== "Fuera de horario")
                ? "Desconectado"
                : (op.motivo || "No disponible").replace(/\s*\(Wise\s*CX\)$/i, "").trim();
              statusBadge = `<span class="badge badge-soft badge-neutral badge-sm font-semibold text-xs shrink-0">${escapeHtml(cleanMotivo)}</span>`;
            }

            let scheduleBadge = "";
            if (op.salidaInminente) {
              const endHour = op.horarioHoy ? op.horarioHoy.split(" - ")[1] : "";
              scheduleBadge = `<span class="badge badge-soft badge-error text-error font-bold text-xxs px-2 py-0.5 flex items-center gap-1 shadow-xs" title="Termina su jornada en ${op.salidaInminenteMin || 1} min"><svg class="size-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg><span>Salida en ${op.salidaInminenteMin}m (${escapeHtml(endHour)})</span></span>`;
            } else if (op.horarioHoy) {
              scheduleBadge = `<span class="font-mono text-base-content/75">${escapeHtml(op.horarioHoy)}</span>`;
            }

            let breakStr = "";
            if (op.breakInminente) {
              breakStr = `<span class="badge badge-soft badge-warning text-warning font-bold text-xxs px-2 py-0.5 shadow-xs" title="Entra en break en ${op.breakInminenteMin || 1} min"><span>Break en ${op.breakInminenteMin}m (${escapeHtml(op.breakInicioHoy)})</span></span>`;
            } else if (op.breakInicioHoy && op.breakFinHoy) {
              breakStr = `<span class="font-mono text-base-content/75">Break: ${escapeHtml(op.breakInicioHoy)} - ${escapeHtml(op.breakFinHoy)}</span>`;
            }

            return `
              <div data-agent-id="${op.agentId}" class="flex items-center justify-between gap-3.5 p-3.5 transition-colors hover:bg-base-200/60 cursor-default min-w-[360px] sm:min-w-0">
                <div class="flex items-center gap-3.5 min-w-0 flex-1">
                  <div class="avatar placeholder size-10 rounded-full shrink-0 flex items-center justify-center font-bold text-sm bg-base-300 text-base-content/70">
                    ${escapeHtml(getInitialsJs(op.nombre))}
                  </div>
                  <div class="min-w-0 flex-1 flex flex-col gap-0.5">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="truncate font-extrabold text-sm text-base-content">
                        ${escapeHtml(op.nombre)}
                      </span>
                      ${isFirst ? '<span class="font-bold uppercase text-xs text-secondary shrink-0">Siguiente</span>' : ''}
                      ${statusBadge}
                    </div>
                    <div class="flex items-center gap-2 text-xs text-base-content/60 font-medium flex-wrap">
                      <span class="uppercase font-semibold text-xs opacity-75">${escapeHtml(op.modalidadHoy === "Home Office" ? "Home Office" : op.modalidadHoy === "Guardia" ? "Guardia" : "Presencial")}</span>
                      ${scheduleBadge}
                      ${breakStr}
                    </div>
                  </div>
                </div>
                ${projBadge}
              </div>
            `;
          }).join("");
        } else {
          queueContainer.innerHTML = `
            <div class="text-sm text-base-content/40 italic py-12 text-center" id="stat-suggested-name-empty">
              No hay operadores disponibles
            </div>
          `;
        }
      };

      updateQueueUI(data);
      updateActionBarSubtitle();

      // If assign modal is open, keep its operator lists updated
      const assignModal = document.getElementById("modal-asignar-operador") as HTMLDialogElement | null;
      if (assignModal && assignModal.open) {
        const badgeEl = document.getElementById("modal-assign-to-ticket-badge");
        const rawId = badgeEl?.textContent?.replace("#", "").trim() || "0";
        const ticketId = Number(rawId) || 0;
        const searchInput = document.getElementById("modal-assign-to-search") as HTMLInputElement | null;
        renderAssignToModalLists(ticketId, searchInput?.value || "");
      }

      // 4. Update each table row
      data.forEach((op) => {
        const row = document.querySelector(
          `[data-op-id="${op.agentId}"]`,
        ) as HTMLElement | null;
        if (!row) return;

        const stateKey = op.disponible ? "disponible" : op.motivo || "offline";
        row.setAttribute("data-op-estado", stateKey);
        row.setAttribute("data-sort-estado", stateKey);

        // Clear previous conditional classes to ensure fresh state
        row.classList.remove(
          "bg-secondary/10",
          "border-l-secondary",
          "bg-secondary/10",
          "border-l-secondary",
          "bg-accent/10",
          "border-l-accent",
          "border-l-4",
          "opacity-50",
          "grayscale-[30%]",
        );

        const isHighlighted = op.agentId === maxAgentId && maxAssignedTime > 0;
        const isCurrentUser = matchesCurrentUser(
          row.getAttribute("data-op-username"),
          row.getAttribute("data-op-nombre"),
          currentUsername,
        );

        if (isCurrentUser) {
          row.classList.add("bg-accent/10", "border-l-4", "border-l-accent");
        } else if (op.estadoExcepcional) {
          row.classList.add(
            "bg-secondary/10",
            "border-l-4",
            "border-l-secondary",
          );
        } else if (isHighlighted) {
          row.classList.add("bg-secondary/10", "border-l-4", "border-l-secondary");
        }

        if (!op.disponible) {
          row.classList.add("opacity-50", "grayscale-[30%]");
        }

        // Update Horario / Break content
        const horarioEl = row.querySelector(`[data-op-horario]`);
        if (horarioEl) {
          if (op.horarioHoy) {
            let scheduleSpan = "";
            if (op.salidaInminente) {
              const endHour = op.horarioHoy.split(" - ")[1] || "";
              scheduleSpan = `<span class="badge badge-soft badge-error text-error font-bold text-xxs px-2 py-0.5 flex items-center gap-1 shadow-xs" title="Termina su jornada en ${op.salidaInminenteMin || 1} min"><svg class="size-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg><span>Salida en ${op.salidaInminenteMin}m (${escapeHtml(endHour)})</span></span>`;
            } else {
              scheduleSpan = `
                <span class="flex items-center gap-1 font-semibold">
                  <svg class="size-3.5 opacity-60 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  ${escapeHtml(op.horarioHoy)}
                </span>
              `;
            }

            let breakHtml = "";
            if (op.breakInminente) {
              breakHtml = `<span class="badge badge-soft badge-warning text-warning font-bold text-xxs px-2 py-0.5 flex items-center gap-1 shadow-xs" title="Entra en break en ${op.breakInminenteMin || 1} min"><svg class="size-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"></path><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path><line x1="6" y1="1" x2="6" y2="4"></line><line x1="10" y1="1" x2="10" y2="4"></line><line x1="14" y1="1" x2="14" y2="4"></line></svg><span>Break en ${op.breakInminenteMin}m (${escapeHtml(op.breakInicioHoy)})</span></span>`;
            } else if (op.breakInicioHoy && op.breakFinHoy) {
              breakHtml = `
                <span class="flex items-center gap-1 opacity-70">
                  <svg class="size-3 opacity-60 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path><line x1="6" y1="2" x2="6" y2="4"></line><line x1="10" y1="2" x2="10" y2="4"></line><line x1="14" y1="2" x2="14" y2="4"></line></svg>
                  ${escapeHtml(op.breakInicioHoy)} - ${escapeHtml(op.breakFinHoy)}
                </span>
              `;
            }

            horarioEl.innerHTML = `
              <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-small text-base-content/70">
                ${scheduleSpan}
                ${breakHtml}
              </div>
            `;
          } else {
            horarioEl.innerHTML = `<span class="text-base-content/40 italic">Sin horario</span>`;
          }
        }

        // Update Modality text
        const modEl = row.querySelector(`[data-op-modalidad]`);
        if (modEl) {
          if (op.modalidadHoy && op.modalidadHoy !== "Franco") {
            const isHome = op.modalidadHoy === "Home Office";
            modEl.innerHTML = `
              <span class="text-xxs font-bold opacity-60 uppercase tracking-tight">
                ${isHome ? "Home" : op.modalidadHoy === "Guardia" ? "Guardia" : "Presencial"}
              </span>
            `;
          } else {
            modEl.innerHTML = "";
          }
        }

        // Update status cell (badge + comment)
        const statusCell = row.querySelector(
          `[data-op-status-cell="${op.agentId}"]`,
        );
        if (statusCell) {
          let badgeHtml = "";
          let commentHtml = "";

          let badgeClass = "badge-soft badge-neutral text-base-content/70";
          let badgeText = op.motivo || "Franco";
          let dotHtml = "";

          const isDesconectado = (op.wiseCxStatus && op.wiseCxStatus.toLowerCase().includes("desconectado")) || (op.motivo && op.motivo.toLowerCase().includes("desconectado"));
          const durStr = isDesconectado ? "" : formatWiseMinutesJs(op.wiseCxMinutesInStatus);
          const durLabel = durStr ? ` (${durStr})` : "";

          if (op.wiseCxInCall) {
            badgeClass = "badge-soft badge-warning text-warning shadow-xs animate-pulse";
            badgeText = `En llamada${durLabel}`;
            dotHtml = `<span class="size-1.5 rounded-full bg-warning animate-pulse"></span>`;
          } else if (op.disponible) {
            badgeClass = "badge-soft badge-success text-success shadow-xs";
            badgeText = op.wiseCxStatus ? `${op.wiseCxStatus}${durLabel}` : "Disponible";
            dotHtml = `<span class="size-1.5 rounded-full bg-success animate-ping"></span>`;
          } else if (op.motivo === "En break") {
            badgeClass = "badge-soft badge-warning text-warning shadow-xs";
            badgeText = `En break - vuelve ${op.retornoEstimado || ""}`;
            dotHtml = `<span class="size-1.5 rounded-full bg-warning animate-pulse"></span>`;
          } else if (op.wiseCxStatus && !isDesconectado) {
            badgeClass = op.wiseCxBadgeVariant === "error"
              ? "badge-soft badge-error text-error shadow-xs"
              : "badge-soft badge-neutral text-base-content/70";
            badgeText = `${op.wiseCxStatus}${durLabel}`;
            if (op.wiseCxBadgeVariant === "error") {
              dotHtml = `<span class="size-1.5 rounded-full bg-error"></span>`;
            }
          } else if (isDesconectado && op.motivo !== "Franco" && op.motivo !== "Fuera de horario") {
            badgeClass = "badge-soft badge-neutral text-base-content/70";
            badgeText = "Desconectado";
          } else if (op.motivo === "Fuera de horario") {
            badgeClass = "badge-soft badge-neutral text-base-content/60";
            badgeText = "Fuera de horario";
          } else if (op.motivo === "Licencia") {
            badgeClass = "badge-soft badge-error text-error shadow-xs";
          } else if (op.motivo === "Vacaciones") {
            badgeClass = "badge-soft badge-info text-info shadow-xs";
          } else if (op.motivo === "Franco") {
            badgeClass = "badge-soft badge-neutral text-base-content/50";
          } else {
            const cleanMotivo = (op.motivo || "Franco").replace(/\s*\(Wise\s*CX\)$/i, "").trim();
            badgeText = cleanMotivo;
            badgeClass = getBadgeColorClient(cleanMotivo, false);
          }

          badgeHtml = `
            <span
              data-op-status-badge="${op.agentId}"
              class="badge ${badgeClass} gap-1.5 badge-xs font-semibold uppercase text-tiny tracking-wider py-2"
            >
              ${dotHtml}${badgeText}
            </span>
          `;

          statusCell.innerHTML = `${badgeHtml}${commentHtml}`;
        }

        // Update Last Assigned text
        const lastAssignedEl = row.querySelector(
          `[data-op-last-assigned-container]`,
        );
        if (lastAssignedEl) {
          if (op.lastAutogestionAssignedAt) {
            const timeStr = new Date(
              op.lastAutogestionAssignedAt,
            ).toLocaleTimeString("es-AR", {
              hour: "2-digit",
              minute: "2-digit",
            });
            lastAssignedEl.innerHTML = `
              <span class="text-tiny text-base-content/75 bg-base-300/50 rounded px-1.5 py-0.5 inline-block font-semibold mt-0.5" data-last-assigned="${op.lastAutogestionAssignedAt}">
                Asignado: ${timeStr}
              </span>
            `;
          } else {
            lastAssignedEl.innerHTML = `<span class="text-tiny text-base-content/40 bg-base-200/40 rounded px-1.5 py-0.5 inline-block italic mt-0.5">Nunca asignado</span>`;
          }
        }
      });

      // Filter rows based on "Ver solo disponibles" toggle check
      updateVisibility();
    };

    const showAlert = (type: "success" | "error" | "warning" | "info", message: string) => {
      const typeMap = {
        success: "alert-success",
        error: "alert-error",
        warning: "alert-warning",
        info: "alert-info",
      } as const;
      showToast(message, typeMap[type]);
    };

    const getBadgeColorClient = (status: string, disponible: boolean): string => {
      if (disponible) return "badge-soft badge-success";
      switch (status) {
        case "En break":
          return "badge-soft badge-warning";
        case "Fuera de horario":
        case "Franco":
          return "badge-soft badge-neutral text-base-content/60";
        case "Licencia":
          return "badge-soft badge-error";
        case "Vacaciones":
          return "badge-soft badge-info";
        case "Devolución Supervisor":
        case "Break Extendido":
        case "Problema Técnico":
          return "badge-soft badge-secondary";
        default:
          return "badge-soft badge-neutral";
      }
    };

    const getInitialsClient = (name: string): string => {
      if (!name) return "?";
      const parts = name.trim().split(" ");
      if (parts.length >= 2) {
        return `${parts[0][0]}${parts[parts.length - 1][0]}`.toUpperCase();
      }
      return name.slice(0, 2).toUpperCase();
    };

    const renderModalOpItem = (op: any, ticketId: number, isReadOnly: boolean, isCreator: boolean = false): string => {
      const isAvailable = !!op.disponible;
      const initials = getInitialsClient(op.nombre);
      const isDesconectado = (op.wiseCxStatus && op.wiseCxStatus.toLowerCase().includes("desconectado")) || (op.motivo && op.motivo.toLowerCase().includes("desconectado"));
      const durStr = isDesconectado ? "" : formatWiseMinutesJs(op.wiseCxMinutesInStatus);
      const durLabel = durStr ? ` (${durStr})` : "";

      let statusBadge = "";
      if (op.wiseCxInCall) {
        statusBadge = `<span class="badge badge-soft badge-warning text-warning animate-pulse badge-xs font-bold px-1.5 py-0.5 shrink-0" title="En llamada"><span class="inline-block size-1.5 rounded-full bg-current mr-1"></span>En llamada${durLabel}</span>`;
      } else if (isAvailable) {
        statusBadge = `<span class="badge badge-soft badge-success text-success badge-sm text-xs font-semibold px-2 py-0.5 shrink-0">Disponible</span>`;
      } else if (op.wiseCxStatus && !isDesconectado) {
        const variantClass = op.wiseCxBadgeVariant === "error"
          ? "badge-error text-error"
          : op.wiseCxBadgeVariant === "success"
          ? "badge-success text-success"
          : "badge-neutral text-base-content/70";
        const titleAttr = `Wise CX: ${escapeHtml(op.wiseCxStatus)}${durStr ? ' hace ' + durStr : ''}`;
        statusBadge = `<span class="badge badge-soft ${variantClass} badge-xs font-bold px-1.5 py-0.5 shrink-0" title="${titleAttr}"><span class="inline-block size-1.5 rounded-full bg-current mr-1"></span>${escapeHtml(op.wiseCxStatus)}${durLabel}</span>`;
      } else if (isDesconectado && op.motivo !== "Franco" && op.motivo !== "Fuera de horario") {
        statusBadge = `<span class="badge badge-soft badge-neutral text-base-content/70 badge-sm text-xs font-semibold px-2 py-0.5 shrink-0" title="Wise CX: Desconectado">Desconectado</span>`;
      } else if (op.motivo === "En break") {
        const breakText = op.retornoEstimado ? `En break (vuelve ${escapeHtml(op.retornoEstimado)})` : "En break";
        statusBadge = `<span class="badge badge-soft badge-warning text-warning badge-sm text-xs font-semibold px-2 py-0.5 shrink-0">${breakText}</span>`;
      } else {
        const cleanMotivo = (op.motivo || "Franco").replace(/\s*\(Wise\s*CX\)$/i, "").trim();
        const badgeColor = getBadgeColorClient(cleanMotivo, false);
        statusBadge = `<span class="badge ${badgeColor} badge-sm text-xs font-semibold px-2 py-0.5 shrink-0">${escapeHtml(cleanMotivo)}</span>`;
      }

      let scheduleInfo = op.horarioHoy ? escapeHtml(op.horarioHoy) : "Sin horario";
      if (op.salidaInminente) {
        const endHour = op.horarioHoy ? op.horarioHoy.split(" - ")[1] : "";
        scheduleInfo = `<span class="badge badge-soft badge-error font-bold text-xxs px-1.5 py-0.5">Salida en ${op.salidaInminenteMin || 1} min (${escapeHtml(endHour)})</span>`;
      }

      let breakInfo = "";
      if (op.breakInminente) {
        breakInfo = ` • <span class="badge badge-soft badge-warning font-bold text-xxs px-1.5 py-0.5">Break en ${op.breakInminenteMin || 1}m (${escapeHtml(op.breakInicioHoy)})</span>`;
      } else if (op.breakInicioHoy && op.breakFinHoy) {
        breakInfo = ` • Break: ${escapeHtml(op.breakInicioHoy)} - ${escapeHtml(op.breakFinHoy)}`;
      }
      const modality = op.modalidadHoy === "Home Office" ? "Home Office" : op.modalidadHoy === "Guardia" ? "Guardia" : "Presencial";

      const btnDisabled = isReadOnly ? 'disabled="true"' : "";

      let containerClasses = "";
      let avatarClasses = "";
      let creatorBadge = "";
      let btnClass = "";

      if (isAvailable) {
        if (isCreator) {
          containerClasses = "border border-success/30 bg-success/5 hover:bg-success/10 transition-colors";
          avatarClasses = "bg-success/15 text-success font-bold";
          creatorBadge = `<span class="badge badge-soft badge-success badge-xs font-bold gap-1"><svg class="size-3 fill-current" viewBox="0 0 24 24"><path d="M12 2 3.5 13h7L9 22l11.5-11h-7z"/></svg>Creador del ticket</span>`;
          btnClass = isReadOnly 
            ? "btn btn-xs btn-disabled opacity-40" 
            : "btn btn-success btn-soft btn-xs font-bold gap-1 px-3 py-1 h-7 min-h-0 text-xs rounded-lg";
        } else {
          containerClasses = "border border-base-200 bg-base-100 hover:bg-base-200/50 transition-colors";
          avatarClasses = "bg-secondary/10 text-secondary font-bold";
          creatorBadge = "";
          btnClass = isReadOnly 
            ? "btn btn-xs btn-disabled opacity-40" 
            : "btn btn-secondary btn-xs font-bold gap-1 px-3 py-1 h-7 min-h-0 text-xs rounded-lg";
        }
      } else {
        if (isCreator) {
          containerClasses = "border border-warning/30 bg-warning/5 hover:bg-warning/10 transition-colors";
          avatarClasses = "bg-warning/15 text-warning font-bold";
          creatorBadge = `<span class="badge badge-soft badge-warning badge-xs font-bold gap-1"><svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>Creador del ticket</span>`;
          btnClass = isReadOnly 
            ? "btn btn-xs btn-disabled opacity-40" 
            : "btn btn-ghost border border-base-300 btn-xs text-base-content/70 hover:bg-base-200 font-semibold gap-1 px-3 py-1 h-7 min-h-0 text-xs rounded-lg";
        } else {
          containerClasses = "border border-base-200 bg-base-100 hover:bg-base-200/50 transition-colors";
          avatarClasses = "bg-base-200 text-base-content/60 font-medium";
          creatorBadge = "";
          btnClass = isReadOnly 
            ? "btn btn-xs btn-disabled opacity-40" 
            : "btn btn-ghost border border-base-300 btn-xs text-base-content/70 hover:bg-base-200 font-semibold gap-1 px-3 py-1 h-7 min-h-0 text-xs rounded-lg";
        }
      }

      return `
        <div
          data-modal-op-item
          data-op-name="${escapeHtml(op.nombre.toLowerCase())}"
          data-op-username="${escapeHtml((op.username || '').toLowerCase())}"
          class="flex items-center justify-between gap-3 p-3 rounded-xl ${containerClasses}"
        >
          <div class="flex items-center gap-3 min-w-0 flex-1">
            <div class="avatar placeholder size-9 rounded-full shrink-0 flex items-center justify-center text-xs ${avatarClasses}">
              ${initials}
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-extrabold text-sm text-base-content truncate">${escapeHtml(op.nombre)}</span>
                ${creatorBadge ? `${creatorBadge} <span class="text-base-content/40 text-xs select-none">•</span>` : ""}
                ${statusBadge}
              </div>
              <div class="text-xs text-base-content/60 font-medium truncate mt-0.5">
                <span class="font-semibold text-base-content/75">${modality}</span> • <span class="font-mono">${scheduleInfo}${breakInfo}</span>
              </div>
            </div>
          </div>
          <div class="flex items-center gap-1.5 shrink-0">
            <button
              type="button"
              class="btn btn-ghost btn-xs text-base-content/70 hover:text-secondary hover:bg-secondary/10 font-bold gap-1 px-2.5 py-1 h-7 min-h-0 text-xs rounded-lg ${isReadOnly ? 'btn-disabled opacity-40 cursor-not-allowed' : ''}"
              data-op-postpone-btn="${op.agentId}"
              data-ticket-id="${ticketId}"
              title="${isReadOnly ? 'Toma el control para posponer autogestiones' : `Posponer autogestión y asignar a ${escapeHtml(op.nombre)} (Esperando fecha)`}"
              ${btnDisabled}
            >
              <svg class="size-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              <span>Posponer</span>
            </button>
            <button
              type="button"
              class="${btnClass}"
              data-op-assign-btn="${op.agentId}"
              data-ticket-id="${ticketId}"
              title="${isReadOnly ? 'Toma el control para asignar autogestiones' : `Asignar ticket a ${escapeHtml(op.nombre)}`}"
              ${btnDisabled}
            >
              <svg class="size-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Asignar</span>
            </button>
          </div>
        </div>
      `;
    };

    const renderAssignToModalLists = (ticketId: number, searchQuery: string = "") => {
      const availableContainer = document.getElementById("modal-assign-to-available-list");
      const unavailableContainer = document.getElementById("modal-assign-to-unavailable-list");
      const availableCountEl = document.getElementById("modal-assign-to-available-count");
      const unavailableCountEl = document.getElementById("modal-assign-to-unavailable-count");
      if (!availableContainer || !unavailableContainer) return;

      const lockIndicator = document.getElementById("lock-indicator");
      const clientHasLock = lockIndicator ? lockIndicator.getAttribute("data-has-lock") === "true" : false;
      const clientIsReadOnly = !clientHasLock;

      const ticket = latestUnassignedTickets.find((t) => t.id === ticketId);
      const creatorUsername = (ticket?.creator_username || "").toLowerCase().trim();
      const creatorNameNorm = (ticket?.creator_name || "").toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();

      const isCreatorOp = (op: any) => {
        if (!creatorUsername && !creatorNameNorm) return false;
        if (op.username && creatorUsername && op.username.split("@")[0].toLowerCase().trim() === creatorUsername) return true;
        if (op.nombre && creatorNameNorm) {
          const opNameNorm = op.nombre.toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();
          if (opNameNorm === creatorNameNorm) return true;
          const tokens = creatorNameNorm.split(" ").filter((k: string) => k.length > 2);
          if (tokens.length >= 2 && tokens.every((k: string) => opNameNorm.includes(k))) return true;
        }
        return false;
      };

      const q = searchQuery.toLowerCase().trim();
      const opsList = latestDisponibilidadData.length > 0 ? latestDisponibilidadData : [];
      const filteredOps = opsList.filter((op: any) => {
        if (!q) return true;
        const name = (op.nombre || "").toLowerCase();
        const user = (op.username || "").toLowerCase();
        return name.includes(q) || user.includes(q);
      });

      const availableOps = filteredOps
        .filter((op: any) => op.disponible)
        .sort((a: any, b: any) => {
          const aCreator = isCreatorOp(a) ? 1 : 0;
          const bCreator = isCreatorOp(b) ? 1 : 0;
          return bCreator - aCreator;
        });

      const unavailableOps = filteredOps
        .filter((op: any) => !op.disponible)
        .sort((a: any, b: any) => {
          const aCreator = isCreatorOp(a) ? 1 : 0;
          const bCreator = isCreatorOp(b) ? 1 : 0;
          return bCreator - aCreator;
        });

      if (availableCountEl) availableCountEl.textContent = String(availableOps.length);
      if (unavailableCountEl) unavailableCountEl.textContent = String(unavailableOps.length);

      if (availableOps.length > 0) {
        availableContainer.innerHTML = availableOps.map((op: any) => renderModalOpItem(op, ticketId, clientIsReadOnly, isCreatorOp(op))).join("");
      } else {
        availableContainer.innerHTML = '<div class="text-xs text-base-content/40 italic py-3 text-center bg-base-200/20 rounded-xl">No hay operadores disponibles' + (q ? ' que coincidan con la búsqueda' : '') + '</div>';
      }

      if (unavailableOps.length > 0) {
        unavailableContainer.innerHTML = unavailableOps.map((op: any) => renderModalOpItem(op, ticketId, clientIsReadOnly, isCreatorOp(op))).join("");
      } else {
        unavailableContainer.innerHTML = '<div class="text-xs text-base-content/40 italic py-3 text-center bg-base-200/20 rounded-xl">No hay operadores no disponibles' + (q ? ' que coincidan con la búsqueda' : '') + '</div>';
      }
    };

    const openAssignToModal = (ticketId: number) => {
      const modal = document.getElementById("modal-asignar-operador") as HTMLDialogElement | null;
      if (!modal) return;

      const ticket = latestUnassignedTickets.find((t) => t.id === ticketId);
      const badgeEl = document.getElementById("modal-assign-to-ticket-badge");
      const titleEl = document.getElementById("modal-assign-to-ticket-title");
      const creatorEl = document.getElementById("modal-assign-to-ticket-creator");
      const searchInput = document.getElementById("modal-assign-to-search") as HTMLInputElement | null;
      const skipQueueToggle = document.getElementById("modal-assign-to-skip-queue") as HTMLInputElement | null;
      const revisionAlert = document.getElementById("modal-assign-to-revision-alert");

      if (badgeEl) badgeEl.textContent = ticket ? (ticket.pretty_id || `#${ticket.id}`) : `#${ticketId}`;
      if (titleEl) titleEl.textContent = ticket?.title || `Ticket #${ticketId}`;
      if (creatorEl) {
        if (ticket?.creator_name) {
          creatorEl.textContent = `Generado por: ${ticket.creator_name}`;
          creatorEl.classList.remove("hidden");
        } else {
          creatorEl.classList.add("hidden");
        }
      }
      if (searchInput) searchInput.value = "";
      if (skipQueueToggle) skipQueueToggle.checked = false;

      if (revisionAlert) {
        const catStr = `${ticket?.category_name || ""} ${ticket?.category_last_name || ""}`.toLowerCase();
        if (catStr.includes("rechazad") || catStr.includes("revisi")) {
          revisionAlert.classList.remove("hidden");
        } else {
          revisionAlert.classList.add("hidden");
        }
      }

      renderAssignToModalLists(ticketId);
      modal.showModal();
    };

    const searchInput = document.getElementById("modal-assign-to-search") as HTMLInputElement | null;
    if (searchInput) {
      searchInput.addEventListener("input", () => {
        const badgeEl = document.getElementById("modal-assign-to-ticket-badge");
        const rawId = badgeEl?.textContent?.replace("#", "").trim() || "0";
        const ticketId = Number(rawId) || 0;
        renderAssignToModalLists(ticketId, searchInput.value);
      });
    }

    // Event delegation for exceptional states, assignments, and ticket details
    document.addEventListener("click", async (e) => {
      const target = e.target as HTMLElement;

      // 1. Open specific operator assignment modal
      const assignToBtn = target.closest("[data-action-assign-to]");
      if (assignToBtn) {
        const ticketId = Number(assignToBtn.getAttribute("data-action-assign-to"));
        if (!isNaN(ticketId) && ticketId > 0) {
          openAssignToModal(ticketId);
        }
        return;
      }

      // 2. Postpone modal trigger
      const postponeBtn = target.closest("[data-op-postpone-btn]");
      if (postponeBtn && !postponeBtn.hasAttribute("disabled") && !(postponeBtn as HTMLButtonElement).disabled) {
        const agentId = Number(postponeBtn.getAttribute("data-op-postpone-btn"));
        const ticketIdAttr = postponeBtn.getAttribute("data-ticket-id");
        const ticketId = ticketIdAttr ? Number(ticketIdAttr) : undefined;

        if (!isNaN(agentId) && ticketId) {
          const modalPosponer = document.getElementById("modal-posponer-ticket") as HTMLDialogElement | null;
          const ticketBadge = document.getElementById("posponer-ticket-badge");
          const opNameEl = document.getElementById("posponer-operator-name");
          const datetimeInput = document.getElementById("posponer-input-datetime") as HTMLInputElement | null;
          const motivoInput = document.getElementById("posponer-input-motivo") as HTMLInputElement | null;

          const ticket = latestUnassignedTickets.find((t) => t.id === ticketId);
          const op = latestDisponibilidadData.find((o) => o.agentId === agentId);

          if (ticketBadge) ticketBadge.textContent = ticket ? (ticket.pretty_id || `#${ticket.id}`) : `#${ticketId}`;
          if (opNameEl) opNameEl.textContent = op?.nombre || `ID ${agentId}`;

          if (modalPosponer) {
            modalPosponer.setAttribute("data-agent-id", String(agentId));
            modalPosponer.setAttribute("data-ticket-id", String(ticketId));
          }

          if (motivoInput) motivoInput.value = "";

          if (datetimeInput) {
            const now = new Date();
            const pad = (n: number) => String(n).padStart(2, "0");
            const nowStr = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}T${pad(now.getHours())}:${pad(now.getMinutes())}`;
            datetimeInput.min = nowStr;

            const badgeSugerencia = document.getElementById("posponer-sugerencia-badge");
            const textSugerencia = document.getElementById("posponer-sugerencia-text");

            if (op?.proximoTurnoDisponible) {
              datetimeInput.value = op.proximoTurnoDisponible;
              if (badgeSugerencia && textSugerencia) {
                textSugerencia.textContent = op.proximoTurnoMotivo || "Sugerido según próximo turno";
                badgeSugerencia.classList.remove("hidden");
              }
            } else {
              const tomorrow = new Date();
              tomorrow.setDate(tomorrow.getDate() + 1);
              tomorrow.setHours(9, 0, 0, 0);
              const defaultStr = `${tomorrow.getFullYear()}-${pad(tomorrow.getMonth() + 1)}-${pad(tomorrow.getDate())}T${pad(tomorrow.getHours())}:${pad(tomorrow.getMinutes())}`;
              datetimeInput.value = defaultStr;
              if (badgeSugerencia) {
                badgeSugerencia.classList.add("hidden");
              }
            }
          }

          if (modalPosponer) {
            modalPosponer.showModal();
          }
        }
        return;
      }

      // 3. Confirm postpone
      const confirmPosponerBtn = target.closest("#btn-confirm-posponer") as HTMLButtonElement | null;
      if (confirmPosponerBtn && !confirmPosponerBtn.disabled) {
        const modalPosponer = document.getElementById("modal-posponer-ticket") as HTMLDialogElement | null;
        const agentId = Number(modalPosponer?.getAttribute("data-agent-id"));
        const ticketId = Number(modalPosponer?.getAttribute("data-ticket-id"));
        const datetimeInput = document.getElementById("posponer-input-datetime") as HTMLInputElement | null;
        const motivoInput = document.getElementById("posponer-input-motivo") as HTMLInputElement | null;
        const skipQueueInput = document.getElementById("modal-assign-to-skip-queue") as HTMLInputElement | null;

        if (!datetimeInput?.value) {
          showAlert("warning", "Por favor selecciona una fecha y hora de reanudación.");
          return;
        }

        if (isNaN(agentId) || isNaN(ticketId) || ticketId <= 0) {
          showAlert("error", "Datos de asignación inválidos.");
          return;
        }

        confirmPosponerBtn.disabled = true;
        confirmPosponerBtn.innerHTML = '<span class="loading loading-spinner loading-xs"></span><span>Posponiendo...</span>';

        const postponeDateFormatted = datetimeInput.value.replace("T", " ") + ":00";
        const reason = motivoInput?.value?.trim() || "";
        const skipQueueUpdate = skipQueueInput ? skipQueueInput.checked : false;

        try {
          const res = await fetch("/api/disponibilidad/asignar-posponer", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              agentId,
              ticketId,
              postponeDate: postponeDateFormatted,
              reason,
              skipQueueUpdate,
            }),
          });
          const data = await res.json();

          if (res.status === 423) {
            showAlert("error", data.error || "Perdiste el control de asignación. Recargando...");
            setTimeout(() => window.location.reload(), 1500);
            return;
          }

          if (res.ok && data.success) {
            if (modalPosponer && modalPosponer.open) modalPosponer.close();
            const modalTicket = document.getElementById("modal-ticket-detail") as HTMLDialogElement | null;
            if (modalTicket && modalTicket.open) modalTicket.close();
            const modalAssignOp = document.getElementById("modal-asignar-operador") as HTMLDialogElement | null;
            if (modalAssignOp && modalAssignOp.open) modalAssignOp.close();

            const dStr = new Date(datetimeInput.value).toLocaleString("es-AR", { dateStyle: "short", timeStyle: "short" });
            const tNumStr = data.ticketNumber ? ` ${data.ticketNumber}` : "";
            const noQueueStr = data.skipQueueUpdate ? " (conservando su posición en cola)" : "";
            showAlert("success", `Autogestión${tNumStr} asignada a ${data.agentName || `ID ${agentId}`} y pospuesta hasta ${dStr}${noQueueStr}.`);
            removeTicketCardOptimistically(ticketId);
            fetchDisponibilidad(false);
            nextPollTimestamp = Date.now() + currentIntervalMs;
            updateCountdownDisplay();
          } else {
            showAlert("error", data.error || "No se pudo posponer la autogestión.");
          }
        } catch (err: any) {
          console.error(err);
          showAlert("error", `Error al posponer autogestión: ${err.message || err}`);
        } finally {
          confirmPosponerBtn.disabled = false;
          confirmPosponerBtn.innerHTML = '<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg><span>Confirmar y Posponer</span>';
        }
        return;
      }

      // 4. Manual assign
      const assignManualBtn = target.closest("[data-op-assign-btn]");
      if (assignManualBtn && !assignManualBtn.hasAttribute("disabled") && !(assignManualBtn as HTMLButtonElement).disabled) {
        const agentId = Number(assignManualBtn.getAttribute("data-op-assign-btn"));
        const ticketIdAttr = assignManualBtn.getAttribute("data-ticket-id");
        const ticketId = ticketIdAttr ? Number(ticketIdAttr) : undefined;
        const skipQueueInput = document.getElementById("modal-assign-to-skip-queue") as HTMLInputElement | null;
        const skipQueueUpdate = skipQueueInput ? skipQueueInput.checked : false;

        if (!isNaN(agentId)) {
          const originalBtnHtml = assignManualBtn.innerHTML;
          assignManualBtn.setAttribute("disabled", "true");
          (assignManualBtn as HTMLButtonElement).disabled = true;
          assignManualBtn.innerHTML = '<span class="loading loading-spinner loading-xs"></span><span>Asignando...</span>';

          try {
            const res = await fetch("/api/disponibilidad/asignar-manual", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ agentId, ticketId, skipQueueUpdate }),
            });
            const data = await res.json();
            if (res.status === 423) {
              showAlert("error", data.error || "Perdiste el control de asignación. Recargando...");
              setTimeout(() => window.location.reload(), 1500);
              return;
            }
            if (res.ok && data.success) {
              const modalTicket = document.getElementById("modal-ticket-detail") as HTMLDialogElement | null;
              if (modalTicket && modalTicket.open) {
                modalTicket.close();
              }
              const modalAssignOp = document.getElementById("modal-asignar-operador") as HTMLDialogElement | null;
              if (modalAssignOp && modalAssignOp.open) {
                modalAssignOp.close();
              }
              const tNumStr = data.ticketNumber ? ` ${data.ticketNumber}` : "";
              const noQueueStr = data.skipQueueUpdate ? " (conservando su posición en cola)" : "";
              showAlert("success", `Autogestión${tNumStr} asignada manualmente a ${data.agentName || `ID ${agentId}`}${noQueueStr}.`);
              removeTicketCardOptimistically(ticketId);
              fetchDisponibilidad(false);
              nextPollTimestamp = Date.now() + currentIntervalMs;
              updateCountdownDisplay();
            } else {
              showAlert("error", data.error || "No se pudo realizar la asignación manual.");
            }
          } catch (err: any) {
            console.error(err);
            showAlert("error", `Ocurrió un error al procesar la asignación manual: ${err.message || err}`);
          } finally {
            assignManualBtn.removeAttribute("disabled");
            (assignManualBtn as HTMLButtonElement).disabled = false;
            assignManualBtn.innerHTML = originalBtnHtml;
          }
        }
        return;
      }

      // 10. Open unassigned ticket detail modal (only from main list, never from inside dialogs)
      const ticketCard = target.closest("[data-ticket-id]");
      if (ticketCard && !target.closest("dialog")) {
        const ticketId = Number(ticketCard.getAttribute("data-ticket-id"));
        const ticket = latestUnassignedTickets.find((t) => t.id === ticketId);
        const modal = document.getElementById("modal-ticket-detail") as HTMLDialogElement | null;

        if (ticket && modal) {
          const webBase = modal.getAttribute("data-invgate-web-base") || "";

          const elId = document.getElementById("ticket-modal-id");
          const elTitle = document.getElementById("ticket-modal-title");
          const elPrio = document.getElementById("ticket-modal-prio");
          const elCat = document.getElementById("ticket-modal-cat");
          const elCatFull = document.getElementById("ticket-modal-cat-full");
          const elCatFullContainer = document.getElementById("ticket-modal-cat-full-container");
          const elCreator = document.getElementById("ticket-modal-creator");
          const elCustomer = document.getElementById("ticket-modal-customer");
          const elLocation = document.getElementById("ticket-modal-location");
          const elCreated = document.getElementById("ticket-modal-created");
          const elWait = document.getElementById("ticket-modal-wait");
          const elSla = document.getElementById("ticket-modal-sla");
          const elDescription = document.getElementById("ticket-modal-description");
          const elLink = document.getElementById("ticket-modal-invgate-link") as HTMLAnchorElement | null;

          const PRIORITY_MAP: Record<number, { label: string; badgeClass: string }> = {
            1: { label: "Baja", badgeClass: "bg-base-200 text-base-content/60 border-none font-medium" },
            2: { label: "Media", badgeClass: "bg-info/15 text-info border-none font-medium" },
            3: { label: "Alta", badgeClass: "bg-warning/15 text-warning border-none font-semibold" },
            4: { label: "Urgente", badgeClass: "bg-warning/20 text-warning border-none font-bold" },
            5: { label: "Crítica", badgeClass: "bg-error/15 text-error border-none font-bold" },
          };

          if (elId) elId.textContent = ticket.pretty_id || `#${ticket.id}`;
          if (elTitle) {
            elTitle.textContent = ticket.title || "Sin título";
            elTitle.setAttribute("title", ticket.title || "");
          }
          
          if (elPrio) {
            const prio = PRIORITY_MAP[ticket.priority_id];
            if (prio) {
              elPrio.textContent = prio.label;
              elPrio.className = `badge badge-sm font-bold tracking-wider uppercase shrink-0 ${prio.badgeClass}`;
              elPrio.classList.remove("hidden");
            } else {
              elPrio.classList.add("hidden");
            }
          }

          if (elCat) {
            if (ticket.category_last_name) {
              elCat.textContent = ticket.category_last_name;
              elCat.classList.remove("hidden");
            } else {
              elCat.classList.add("hidden");
            }
          }

          if (elCatFullContainer && elCatFull) {
            if (ticket.category_name) {
              elCatFull.textContent = ticket.category_name;
              elCatFullContainer.classList.remove("hidden");
            } else {
              elCatFullContainer.classList.add("hidden");
            }
          }

          // Match creator with available operators
          const creatorUsername = (ticket.creator_username || "").toLowerCase().trim();
          const creatorNameNorm = (ticket.creator_name || "").toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();

          const matchingAvailableOp = latestDisponibilidadData.find((op) => {
            if (!op.disponible) return false;
            if (op.username && creatorUsername && op.username.split("@")[0].toLowerCase().trim() === creatorUsername) return true;
            if (op.nombre && creatorNameNorm) {
              const opNameNorm = op.nombre.toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();
              if (opNameNorm === creatorNameNorm) return true;
              const tokens = creatorNameNorm.split(" ").filter((k: string) => k.length > 2);
              if (tokens.length >= 2 && tokens.every((k: string) => opNameNorm.includes(k))) return true;
            }
            return false;
          });

          if (elCreator) {
            if (matchingAvailableOp) {
              elCreator.innerHTML = `<span class="text-success font-bold">${escapeHtml(ticket.creator_name || "Creador")} <span class="text-xxs font-semibold opacity-90">(Disponible)</span></span>`;
            } else {
              elCreator.textContent = ticket.creator_name || "Sin especificar";
            }
          }
          
          if (elCustomer) elCustomer.textContent = ticket.customer_name || "Mismo creador";
          if (elLocation) elLocation.textContent = ticket.location_name || "No especificada";

          const btnAssignToModal = document.getElementById("ticket-modal-assign-to-btn") as HTMLButtonElement | null;
          if (btnAssignToModal) {
            btnAssignToModal.setAttribute("data-action-assign-to", String(ticket.id));
            const lockIndicator = document.getElementById("lock-indicator");
            const clientHasLock = lockIndicator ? lockIndicator.getAttribute("data-has-lock") === "true" : false;
            if (!clientHasLock) {
              btnAssignToModal.disabled = true;
              btnAssignToModal.classList.add("btn-disabled", "opacity-50");
              btnAssignToModal.title = "Toma el control para habilitar la asignación";
            } else {
              btnAssignToModal.disabled = false;
              btnAssignToModal.classList.remove("btn-disabled", "opacity-50");
              btnAssignToModal.title = `Asignar ticket #${ticket.pretty_id || ticket.id} a un operador...`;
            }
          }

          if (elCreated) {
            elCreated.textContent = ticket.created_at
              ? new Date(ticket.created_at * 1000).toLocaleString("es-AR", {
                  dateStyle: "short",
                  timeStyle: "medium",
                })
              : "Desconocida";
          }

          if (elWait) {
            if (ticket.created_at) {
              const elapsedMin = Math.floor((Date.now() - ticket.created_at * 1000) / 60000);
              const formatWait = formatWaitTime(elapsedMin);
              elWait.textContent = formatWait;
              elWait.className = `text-xs font-mono font-bold ${
                elapsedMin >= 60 ? "text-error" : elapsedMin >= 30 ? "text-warning" : "text-base-content/80"
              }`;
            } else {
              elWait.textContent = "-";
            }
          }

          if (elSla) elSla.textContent = ticket.sla_incident_first_reply || "No configurado";

          if (elDescription) {
            const rawDesc = ticket.description && ticket.description.trim().length > 0
              ? ticket.description
              : "Sin descripción provista.";
            
            // Render safe HTML parsing for formatted ticket descriptions (tables, paragraphs, breaks)
            const parser = new DOMParser();
            const doc = parser.parseFromString(rawDesc, "text/html");
            
            // Remove any script or iframe tags if present
            doc.querySelectorAll("script, iframe, object, embed").forEach((node) => node.remove());
            
            elDescription.innerHTML = doc.body.innerHTML;
          }

          if (elLink) {
            if (webBase) {
              elLink.href = `${webBase}/requests/show/index/id/${ticket.id}`;
              elLink.classList.remove("hidden");
            } else {
              elLink.classList.add("hidden");
            }
          }

          // Configuración diferida de comentarios (Zero API cost al abrir modal)
          currentModalTicket = ticket;
          const commentsLoading = document.getElementById("ticket-modal-comments-loading");
          const commentsEmpty = document.getElementById("ticket-modal-comments-empty");
          const commentsError = document.getElementById("ticket-modal-comments-error");
          const commentsList = document.getElementById("ticket-modal-comments-list");
          const commentsCount = document.getElementById("ticket-modal-comments-count");
          const mdaContainer = document.getElementById("ticket-modal-mda-operators-container");
          const mdaList = document.getElementById("ticket-modal-mda-operators-list");
          const triggerContainer = document.getElementById("ticket-modal-comments-trigger-container");

          if (commentsList) {
            commentsList.innerHTML = "";
            commentsList.classList.add("hidden");
          }
          if (mdaList) mdaList.innerHTML = "";
          if (mdaContainer) mdaContainer.classList.add("hidden");
          if (commentsLoading) commentsLoading.classList.add("hidden");
          if (commentsEmpty) commentsEmpty.classList.add("hidden");
          if (commentsError) commentsError.classList.add("hidden");

          if (loadedCommentsByTicket.has(ticket.id)) {
            renderModalComments(loadedCommentsByTicket.get(ticket.id), ticket);
          } else {
            if (triggerContainer) triggerContainer.classList.remove("hidden");
            if (commentsCount) commentsCount.textContent = "-";
          }

          modal.showModal();
        }
        return;
      }
    });

    // Carga de comentarios bajo demanda al clickear el botón del modal
    const loadCommentsBtn = document.getElementById("ticket-modal-load-comments-btn");
    if (loadCommentsBtn) {
      loadCommentsBtn.addEventListener("click", async () => {
        if (!currentModalTicket) return;
        const triggerContainer = document.getElementById("ticket-modal-comments-trigger-container");
        const commentsLoading = document.getElementById("ticket-modal-comments-loading");
        const commentsError = document.getElementById("ticket-modal-comments-error");

        if (triggerContainer) triggerContainer.classList.add("hidden");
        if (commentsLoading) commentsLoading.classList.remove("hidden");
        if (commentsError) commentsError.classList.add("hidden");

        try {
          const creatorQuery = currentModalTicket.creator_id ? `&creator_id=${currentModalTicket.creator_id}` : "";
          const r = await fetch(`/api/invgate/ticket-comments?request_id=${currentModalTicket.id}${creatorQuery}`);
          if (!r.ok) throw new Error("Error fetching comments");
          const data = await r.json();
          loadedCommentsByTicket.set(currentModalTicket.id, data);
          renderModalComments(data, currentModalTicket);
        } catch (err) {
          console.error("Error fetching comments on demand:", err);
          if (commentsLoading) commentsLoading.classList.add("hidden");
          if (commentsError) commentsError.classList.remove("hidden");
          if (triggerContainer) triggerContainer.classList.remove("hidden");
        }
      });
    }

    // Fetch unassigned tickets for the autogestions helpdesk (con abort controller & anti-solapamiento)
    let isFetchingTickets = false;
    const fetchUnassignedTickets = async () => {
      if (isFetchingTickets) return;
      isFetchingTickets = true;

      if (ticketsAbortController) ticketsAbortController.abort();
      ticketsAbortController = new AbortController();

      try {
        const res = await fetch(`/api/invgate/unassigned-tickets?helpdesk_id=${AGS_HELPDESK_ID}`, {
          signal: ticketsAbortController.signal,
        });
        if (!res.ok) return;
        const data = await res.json();
        latestUnassignedTickets = data.tickets || [];
        const countEl = document.getElementById("stat-unassigned-count");
        const listEl = document.getElementById("unassigned-tickets-list");
        const count = data.count ?? 0;

        updateActionBarSubtitle();

        if (countEl) {
          countEl.textContent = String(count);
          countEl.className = `font-mono font-bold text-sm ${count > 0 ? "text-secondary" : "text-base-content/50"}`;
        }

        // Actualizar indicador de antigüedad máxima (Issues #294, #292)
        const oldestBadge = document.getElementById("stat-oldest-age-badge");
        const oldestText = document.getElementById("stat-oldest-age-text");
        if (oldestBadge && oldestText) {
          const oldest = latestUnassignedTickets[0];
          if (count > 0 && oldest?.created_at) {
            const ageMin = Math.floor((Date.now() - oldest.created_at * 1000) / 60000);
            oldestText.textContent = formatWaitTime(ageMin);
            const isWarning = ageMin >= 20;
            oldestBadge.className = `badge badge-xs sm:badge-sm font-mono font-bold gap-1 py-1 px-2 ${isWarning ? "badge-error text-error-content animate-pulse" : "badge-secondary badge-outline text-secondary"}`;
            oldestBadge.classList.remove("hidden");
          } else {
            oldestBadge.classList.add("hidden");
          }
        }
        if (listEl) {
          const prevScroll = listEl.scrollTop;
          if (data.tickets && data.tickets.length > 0) {
            const PRIORITY_MAP: Record<number, { label: string; badgeClass: string }> = {
              1: { label: "Baja", badgeClass: "badge-soft badge-neutral text-base-content/70 font-medium" },
              2: { label: "Media", badgeClass: "badge-soft badge-neutral text-base-content/70 font-medium" },
              3: { label: "Alta", badgeClass: "badge-soft badge-warning text-warning font-semibold" },
              4: { label: "Urgente", badgeClass: "badge-soft badge-warning text-warning font-bold" },
              5: { label: "Crítica", badgeClass: "badge-soft badge-error text-error font-bold" },
            };

            listEl.innerHTML = data.tickets.map((t: any) => {
              const timeStr = t.created_at ? new Date(t.created_at * 1000).toLocaleTimeString("es-AR", { hour: "2-digit", minute: "2-digit" }) : "";
              
              // Calculate elapsed waiting time
              let waitingBadge = "";
              if (t.created_at) {
                const elapsedMin = Math.floor((Date.now() - t.created_at * 1000) / 60000);
                let colorClass = "badge-neutral text-base-content/70";
                if (elapsedMin >= 60) {
                  colorClass = "badge-error text-error font-bold";
                } else if (elapsedMin >= 30) {
                  colorClass = "badge-warning text-warning font-semibold";
                }
                const formatWait = formatWaitTime(elapsedMin);
                waitingBadge = `<span class="badge badge-soft badge-sm font-mono text-xs px-2 py-0.5 shrink-0 ${colorClass}" title="Tiempo de espera en cola">⏱ ${formatWait}</span>`;
              }

              const prioInfo = PRIORITY_MAP[t.priority_id] || (t.priority_id ? { label: `P${t.priority_id}`, badgeClass: "badge-soft badge-neutral" } : null);
              const prioBadge = prioInfo
                ? `<span class="badge badge-sm font-bold text-xs tracking-wider uppercase shrink-0 ${prioInfo.badgeClass}">${escapeHtml(prioInfo.label)}</span>`
                : "";
              const catBadge = t.category_last_name
                ? `<span class="badge badge-soft badge-neutral badge-sm font-semibold text-xs tracking-tight max-w-[170px] truncate shrink-0" title="${escapeHtml(t.category_name || t.category_last_name)}">${escapeHtml(t.category_last_name)}</span>`
                : "";

              const lockIndicator = document.getElementById("lock-indicator");
              const clientHasLock = lockIndicator ? lockIndicator.getAttribute("data-has-lock") === "true" : false;
              const clientIsReadOnly = !clientHasLock;
              const clientIsDisabled = clientIsReadOnly ? 'disabled="true"' : "";
              const clientAssignToClass = clientIsReadOnly
                ? "btn btn-ghost btn-xs btn-disabled opacity-40 cursor-not-allowed text-base-content/40 px-2.5 h-7 min-h-0 font-bold shrink-0 gap-1.5 text-xs"
                : "btn btn-secondary btn-xs font-bold shadow-sm px-2.5 h-7 min-h-0 shrink-0 gap-1.5 text-xs";

              const assignButtons = `
                <button
                  type="button"
                  class="${clientAssignToClass}"
                  data-action-assign-to="${t.id}"
                  ${clientIsDisabled}
                  title="${clientIsReadOnly ? "Solo el supervisor con control puede asignar" : "Asignar este ticket a un operador específico"}"
                >
                  <svg class="size-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
                  <span>Asignar a...</span>
                </button>
              `;

              const creatorUsername = (t.creator_username || "").toLowerCase().trim();
              const creatorNameNorm = (t.creator_name || "").toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();

              const matchingAvailableOp = (latestDisponibilidadData || []).find((op: any) => {
                if (!op.disponible) return false;
                if (op.username && creatorUsername && op.username.split("@")[0].toLowerCase().trim() === creatorUsername) return true;
                if (op.nombre && creatorNameNorm) {
                  const opNameNorm = op.nombre.toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();
                  if (opNameNorm === creatorNameNorm) return true;
                  const tokens = creatorNameNorm.split(" ").filter((k: string) => k.length > 2);
                  if (tokens.length >= 2 && tokens.every((k: string) => opNameNorm.includes(k))) return true;
                }
                return false;
              });

              const creatorStr = t.creator_name || t.customer_name || "";
              const creatorContent = creatorStr
                ? `<svg class="size-3.5 opacity-60 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg><span class="truncate flex items-center gap-1.5">Generado por: <strong class="text-base-content/90 font-bold">${escapeHtml(creatorStr)}</strong>${matchingAvailableOp ? '<span class="inline-block size-2 rounded-full bg-success shrink-0" title="Operador disponible"></span>' : ''}</span>`
                : `<span class="opacity-50 italic text-xs">Sin creador especificado</span>`;

              const userAndActionRow = `
                <div class="flex items-center justify-between gap-2 text-xs font-medium truncate mt-0.5">
                  <div class="flex items-center gap-1.5 min-w-0 truncate text-base-content/70">
                    ${creatorContent}
                  </div>
                  <div class="flex items-center gap-1.5 shrink-0">
                    ${assignButtons}
                  </div>
                </div>
              `;

              const locationRow = t.location_name
                ? `<div class="flex items-center gap-1.5 text-xs text-base-content/60 font-medium min-w-0 max-w-full overflow-hidden" title="${escapeHtml(t.location_name)}"><svg class="size-3.5 text-info opacity-75 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg><span class="truncate block min-w-0 max-w-[260px] sm:max-w-[340px] md:max-w-[420px]">Ubicación: <strong class="text-base-content/85 font-semibold">${escapeHtml(t.location_name)}</strong></span></div>`
                : "";

              return `
                <div
                  class="p-4 hover:bg-base-200/50 transition-colors duration-150 flex flex-col gap-2.5 cursor-pointer group min-w-[480px] sm:min-w-0"
                  data-ticket-id="${t.id}"
                >
                  <div class="flex items-start justify-between gap-3">
                    <div class="font-extrabold text-sm sm:text-base text-base-content leading-snug group-hover:text-secondary transition-colors truncate min-w-0 flex-1 pr-1" title="${escapeHtml(t.title)}">
                      <span class="font-mono font-bold text-base-content/60 mr-1.5">${escapeHtml(t.pretty_id || '#' + t.id)}</span>
                      <span>${escapeHtml(t.title)}</span>
                    </div>
                    <span class="text-xs text-base-content/50 font-mono font-semibold shrink-0 mt-0.5">${timeStr}</span>
                  </div>
                  <div class="flex items-center gap-2 min-w-0 flex-wrap">
                    ${prioBadge}
                    ${catBadge}
                    ${waitingBadge}
                  </div>
                  ${userAndActionRow}
                  ${locationRow}
                </div>
              `;
            }).join("");
          } else {
            listEl.innerHTML = '<div class="text-sm text-base-content/40 italic py-16 text-center">No hay tickets sin asignar</div>';
          }
          listEl.scrollTop = prevScroll;
        }
      } catch (err: any) {
        if (err.name === "AbortError") return;
        console.error("Error fetching unassigned tickets:", err);
      } finally {
        isFetchingTickets = false;
      }
    };

    // Fetch availability data (local SQLite + Wise CX en tiempo real con abort controller & anti-solapamiento)
    let isFetchingDisponibilidad = false;
    const fetchDisponibilidad = async (forceRefresh = false) => {
      if (isFetchingDisponibilidad) return;
      isFetchingDisponibilidad = true;

      if (disponibilidadAbortController) disponibilidadAbortController.abort();
      disponibilidadAbortController = new AbortController();

      try {
        const url = forceRefresh ? "/api/disponibilidad?force_refresh=true" : "/api/disponibilidad";
        const res = await fetch(url, { signal: disponibilidadAbortController.signal });
        if (!res.ok) throw new Error("Error fetching availability");
        const data = await res.json();
        updateUI(data);
      } catch (error: any) {
        if (error.name === "AbortError") return;
        console.error("Failed to sync availability data:", error);
      } finally {
        isFetchingDisponibilidad = false;
      }
    };

    // Fetch lock status
    const fetchLockStatus = async () => {
      try {
        const res = await fetch("/api/disponibilidad/lock");
        if (!res.ok) throw new Error("Error fetching lock status");
        return await res.json();
      } catch (error) {
        console.error("Failed to fetch lock status:", error);
        return null;
      }
    };

    // Refresco general manual (tickets InvGate + disponibilidad SQLite + control lock)
    let isRefreshingGeneral = false;
    const refreshGeneral = async () => {
      if (isRefreshingGeneral) return;
      isRefreshingGeneral = true;

      const refreshBtn = document.getElementById("btn-refresh-general") as HTMLButtonElement | null;
      const refreshIcon = document.getElementById("btn-refresh-general-icon");
      if (refreshIcon) refreshIcon.classList.add("animate-spin");
      if (refreshBtn) refreshBtn.disabled = true;

      updateCountdownDisplay();

      try {
        await Promise.allSettled([
          fetchUnassignedTickets(),
          fetchDisponibilidad(true),
          fetchLockStatus().then(updateLockBanner),
        ]);
        nextPollTimestamp = Date.now() + currentIntervalMs;
      } catch (err) {
        console.error("Error during general refresh:", err);
      } finally {
        isRefreshingGeneral = false;
        if (refreshIcon) refreshIcon.classList.remove("animate-spin");
        if (refreshBtn) refreshBtn.disabled = false;
        updateCountdownDisplay();
      }
    };

    // Listener para botón de refresco general manual
    const refreshGeneralBtn = document.getElementById("btn-refresh-general");
    if (refreshGeneralBtn) {
      refreshGeneralBtn.addEventListener("click", () => {
        refreshGeneral();
      });
    }


    // Dynamic lock banner UI update
    const updateLockBanner = (lockStatus: any) => {
      if (!lockStatus) return;
      currentLockStatus = lockStatus;

      const indicator = document.getElementById("lock-indicator");
      if (!indicator) return;

      const currentUserId = Number(indicator.getAttribute("data-user-id"));
      const bannerTimeoutAttr = Number(indicator.getAttribute("data-lock-timeout")) || 600000;

      let hasLock = false;
      let lockHolderName = null;
      let lockReleaseRequested = false;

      if (lockStatus.status === "occupied") {
        hasLock = lockStatus.user?.userId === currentUserId;
        lockHolderName = lockStatus.user?.username;
        lockReleaseRequested = lockStatus.user?.releaseRequested;

        lockTimeoutMs = lockReleaseRequested ? 60000 : bannerTimeoutAttr;
        lockExpiresAt = lockStatus.user.lastActivityAt + lockTimeoutMs;
        startCountdown();
      } else {
        stopCountdown();
      }

      if (hasLock) {
        indicator.setAttribute("data-has-lock", "true");
      } else {
        indicator.removeAttribute("data-has-lock");
      }
      updateActionBarSubtitle();

      // Actualizar todos los botones "Asignar a..." en las tarjetas de tickets en tiempo real
      document.querySelectorAll("#unassigned-tickets-list [data-action-assign-to]").forEach((btnEl) => {
        const btn = btnEl as HTMLButtonElement;
        if (hasLock) {
          btn.disabled = false;
          btn.removeAttribute("disabled");
          btn.className = "btn btn-secondary btn-xs font-bold shadow-sm px-2.5 h-7 min-h-0 shrink-0 gap-1.5 text-xs";
          btn.title = "Asignar este ticket a un operador específico";
        } else {
          btn.disabled = true;
          btn.setAttribute("disabled", "true");
          btn.className = "btn btn-ghost btn-xs btn-disabled opacity-40 cursor-not-allowed text-base-content/40 px-2.5 h-7 min-h-0 font-bold shrink-0 gap-1.5 text-xs";
          btn.title = "Solo el supervisor con control puede asignar";
        }
      });

      let dotColor = "bg-base-content/30";
      let statusText = "Sin asignador";
      let showTimer = false;
      let timerMs = 0;
      let buttonsHtml = "";

      if (lockStatus.status === "free") {
        dotColor = "bg-base-content/30";
        statusText = "Sin asignador";
        buttonsHtml = `<button type="button" id="btn-acquire-lock" class="btn btn-secondary btn-xs font-bold uppercase tracking-wider shadow-sm">Tomar control</button>`;
      } else if (lockStatus.status === "expired") {
        dotColor = "bg-neutral/50";
        statusText = `Expirado: ${escapeHtml(lockHolderName)}`;
        buttonsHtml = `<button type="button" id="btn-acquire-lock" class="btn btn-secondary btn-xs font-bold uppercase tracking-wider shadow-sm">Tomar control</button>`;
      } else if (lockStatus.status === "occupied") {
        showTimer = true;
        timerMs = lockExpiresAt - Date.now();
        if (hasLock) {
          dotColor = "bg-success";
          statusText = "En control";
          
          let rejectBtn = "";
          if (lockReleaseRequested) {
            rejectBtn = `<button type="button" id="btn-reject-release" class="btn btn-success btn-ghost btn-xs font-bold uppercase tracking-wider">Rechazar</button>`;
          }
          buttonsHtml = `
            ${rejectBtn}
            <button type="button" id="btn-release-lock" class="btn btn-ghost btn-xs font-bold uppercase tracking-wider text-error">Liberar</button>
          `;
        } else {
          dotColor = "bg-warning";
          statusText = `Ocupado: ${escapeHtml(lockHolderName)}`;
          buttonsHtml = `
            <button type="button" id="btn-request-release" class="btn btn-ghost btn-xs font-bold uppercase tracking-wider text-secondary" ${lockReleaseRequested ? 'disabled' : ''}>
              ${lockReleaseRequested ? 'Solicitado' : 'Pedir liberación'}
            </button>
          `;
        }
      }

      let timerHtml = "";
      if (showTimer) {
        const initialCountdown = timerMs > 0 ? formatCountdown(timerMs) : "0:00";
        const isCritical = timerMs > 0 && timerMs < 60000;
        const badgeClass = isCritical ? "bg-error/70 text-error-content" : "bg-base-100/30";
        timerHtml = `<span id="lock-countdown" class="badge badge-xs tabular-nums font-mono border-0 ${badgeClass}">${initialCountdown}</span>`;
      }

      indicator.innerHTML = `
        <span class="size-2 rounded-full ${dotColor}"></span>
        <span>${statusText}</span>
        ${timerHtml}
        <div class="flex items-center gap-1.5 ml-1">
          ${buttonsHtml}
        </div>
      `;

      if (hasLock) {
        startHeartbeat();
      } else {
        stopHeartbeat();
      }

      if (hasLock !== clientHasLock || !autoPollTimer) {
        clientHasLock = hasLock;
        setupAutoPolling(hasLock);
      }
    };



    // Click handler for history modal
    const btnOpenHistorial = document.getElementById("btn-open-historial-modal");
    if (btnOpenHistorial) {
      btnOpenHistorial.addEventListener("click", async () => {
        const modal = document.getElementById("modal-historial-asignaciones") as HTMLDialogElement | null;
        const loadingEl = document.getElementById("historial-loading");
        const emptyEl = document.getElementById("historial-empty");
        const tableContainer = document.getElementById("historial-table-container");
        const rowsEl = document.getElementById("historial-rows");

        if (modal) {
          if (loadingEl) loadingEl.classList.remove("hidden");
          if (emptyEl) emptyEl.classList.add("hidden");
          if (tableContainer) tableContainer.classList.add("hidden");
          modal.showModal();

          const TYPE_MAP: Record<string, { label: string; badgeClass: string }> = {
            cyclic: { label: "Cíclica", badgeClass: "badge-soft badge-secondary font-semibold" },
            manual: { label: "Manual", badgeClass: "badge-soft badge-info font-semibold" },
            revision: { label: "Revisión", badgeClass: "badge-soft badge-warning font-semibold" },
            undo: { label: "Deshecha", badgeClass: "badge-soft badge-warning font-semibold" },
            batch_suggested: { label: "Sugerida", badgeClass: "badge-soft badge-success font-semibold" },
            batch_all: { label: "Lote cola", badgeClass: "badge-soft badge-secondary font-semibold" },
          };

          try {
            const res = await fetch("/api/disponibilidad/historial");
            const data = await res.json();
            if (loadingEl) loadingEl.classList.add("hidden");

            if (res.ok && data.history && data.history.length > 0) {
              if (tableContainer) tableContainer.classList.remove("hidden");
              if (rowsEl) {
                rowsEl.innerHTML = data.history.map((item: any) => {
                  const dateStr = item.assignedAt ? new Date(item.assignedAt).toLocaleString("es-AR", { dateStyle: "short", timeStyle: "short" }) : "-";
                  const typeInfo = TYPE_MAP[item.type] || { label: item.type || "Asignación", badgeClass: "badge-soft badge-neutral font-semibold" };
                  const ticketBadge = item.ticketNumber
                    ? `<span class="badge badge-soft badge-neutral font-mono font-bold text-sm px-2.5 py-1">${escapeHtml(item.ticketNumber)}</span>`
                    : `<span class="text-base-content/40 font-mono text-xs">-</span>`;

                  const actionBtn = item.canUndo
                    ? `<button type="button" class="btn btn-ghost btn-xs text-base-content/70 hover:text-error hover:bg-error/10 px-2.5 py-1 h-7 min-h-0 font-bold gap-1 shrink-0 rounded-lg text-xs" data-undo-ticket="${escapeHtml(item.ticketNumber)}" title="Devolver ${escapeHtml(item.ticketNumber)} a la cola de sin asignar en InvGate"><svg class="size-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg><span>Deshacer</span></button>`
                    : `<span class="text-base-content/30 text-xs italic">-</span>`;

                  return `
                    <tr class="hover:bg-base-200/40 transition-colors">
                      <td class="font-mono text-xs font-semibold text-base-content/75 whitespace-nowrap">${escapeHtml(dateStr)}</td>
                      <td class="font-bold text-sm text-base-content">${escapeHtml(item.agentName)}</td>
                      <td>${ticketBadge}</td>
                      <td><span class="badge badge-sm ${typeInfo.badgeClass}">${escapeHtml(typeInfo.label)}</span></td>
                      <td class="font-medium text-sm text-base-content/80">${escapeHtml(item.assignedBy || "Sistema")}</td>
                      <td class="text-right">${actionBtn}</td>
                    </tr>
                  `;
                }).join("");

                if (rowsEl && !rowsEl.hasAttribute("data-listener-attached")) {
                  rowsEl.setAttribute("data-listener-attached", "true");
                  rowsEl.addEventListener("click", async (e) => {
                    const target = e.target as HTMLElement;
                    const btn = target.closest("[data-undo-ticket]") as HTMLButtonElement | null;
                    if (!btn || btn.disabled) return;

                    const ticketNumber = btn.getAttribute("data-undo-ticket");
                    if (!ticketNumber) return;

                    btn.disabled = true;
                    btn.innerHTML = `<span class="loading loading-spinner loading-xs text-secondary"></span><span>Deshaciendo...</span>`;

                    try {
                      const res = await fetch("/api/disponibilidad/deshacer-ticket", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ ticketNumber }),
                      });
                      const data = await res.json();
                      if (res.ok && data.success) {
                        showAlert("success", data.message || `Ticket ${ticketNumber} devuelto a sin asignar.`);
                        await refreshGeneral();
                        btnOpenHistorial.click();
                      } else {
                        showAlert("error", data.error || "Error al desasignar ticket.");
                        btn.disabled = false;
                        btn.innerHTML = `<svg class="size-3 text-secondary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg><span>Deshacer</span>`;
                      }
                    } catch (err: any) {
                      console.error("Error undoing ticket:", err);
                      showAlert("error", `Error: ${err.message || err}`);
                      btn.disabled = false;
                      btn.innerHTML = `<svg class="size-3 text-secondary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg><span>Deshacer</span>`;
                    }
                  });
                }
              }
            } else {
              if (emptyEl) emptyEl.classList.remove("hidden");
            }
          } catch (err) {
            console.error("Error fetching assignment history:", err);
            if (loadingEl) loadingEl.classList.add("hidden");
            if (emptyEl) {
              emptyEl.textContent = "Ocurrió un error al cargar el historial.";
              emptyEl.classList.remove("hidden");
            }
          }
        }
      });
    }

    // Close dropdowns on Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        document.querySelectorAll(".dropdown.dropdown-open").forEach((d) => {
          d.classList.remove("dropdown-open");
        });
      }
    });

    // Lock heartbeat cada 2 minutos
    const LOCK_HEARTBEAT_MS = 2 * 60 * 1000;

    const startHeartbeat = () => {
      if (heartbeatInterval) clearInterval(heartbeatInterval);
      heartbeatInterval = setInterval(async () => {
        try {
          const res = await fetch("/api/disponibilidad/lock/heartbeat", { method: "POST" });
          if (res.ok) {
            lockExpiresAt = Date.now() + lockTimeoutMs;
          } else {
            console.warn("Heartbeat failed, lock might have been lost");
          }
        } catch (err) {
          console.error("Heartbeat error:", err);
        }
      }, LOCK_HEARTBEAT_MS);
    };

    const stopHeartbeat = () => {
      if (heartbeatInterval) {
        clearInterval(heartbeatInterval);
        heartbeatInterval = null;
      }
    };

    // Auto-polling adaptativo y temporizador visible
    let isUserIdle = false;
    const IDLE_TIMEOUT_MS = 5 * 60 * 1000; // 5 minutos de inactividad
    let currentIntervalMs = 5 * 60 * 1000;
    let nextPollTimestamp = Date.now() + currentIntervalMs;

    const updateCountdownDisplay = () => {
      const countdownEl = document.getElementById("poll-countdown-text");
      const dotEl = document.getElementById("poll-countdown-dot");
      if (!countdownEl) return;

      if (document.hidden || isUserIdle) {
        countdownEl.textContent = "Pausado";
        if (dotEl) {
          dotEl.className = "inline-block size-1.5 rounded-full bg-base-content/30";
        }
        return;
      }

      if (isRefreshingGeneral || isFetchingTickets || isFetchingDisponibilidad) {
        countdownEl.textContent = "Cargando...";
        if (dotEl) {
          dotEl.className = "inline-block size-1.5 rounded-full bg-warning animate-pulse";
        }
        return;
      }

      const diffMs = nextPollTimestamp - Date.now();
      const remainingSec = Math.max(0, Math.ceil(diffMs / 1000));

      if (dotEl) {
        dotEl.className = "inline-block size-1.5 rounded-full bg-success";
      }

      if (remainingSec >= 60) {
        const mins = Math.floor(remainingSec / 60);
        const secs = remainingSec % 60;
        countdownEl.textContent = `${mins}m ${secs}s`;
      } else {
        countdownEl.textContent = `${remainingSec}s`;
      }
    };

    const resetIdleTimer = () => {
      isUserIdle = false;
      updateCountdownDisplay();
      if (idleTimer) clearTimeout(idleTimer);
      idleTimer = setTimeout(() => {
        isUserIdle = true;
        updateCountdownDisplay();
      }, IDLE_TIMEOUT_MS);
    };

    ["mousemove", "keydown", "touchstart", "scroll"].forEach((evt) => {
      window.addEventListener(evt, resetIdleTimer, { passive: true });
    });
    resetIdleTimer();

    const executeAutoPoll = async () => {
      if (document.hidden) return;
      if (isUserIdle) return;
      const panelAsignacion = document.getElementById("panel-asignacion");
      if (panelAsignacion && panelAsignacion.classList.contains("hidden")) return;

      // Limpieza de caché de comentarios en el cliente para el nuevo ciclo
      loadedCommentsByTicket.clear();
      updateCountdownDisplay();

      try {
        await Promise.allSettled([
          fetchDisponibilidad(false),
          fetchUnassignedTickets(),
          fetchLockStatus().then(updateLockBanner),
        ]);
      } finally {
        nextPollTimestamp = Date.now() + currentIntervalMs;
        updateCountdownDisplay();
      }
    };

    const setupAutoPolling = (hasLock: boolean) => {
      currentIntervalMs = hasLock ? 1 * 60 * 1000 : 5 * 60 * 1000;
      nextPollTimestamp = Date.now() + currentIntervalMs;
      updateCountdownDisplay();

      if (!autoPollTimer) {
        autoPollTimer = setInterval(() => {
          if (document.hidden || isUserIdle) {
            updateCountdownDisplay();
            return;
          }

          if (Date.now() >= nextPollTimestamp) {
            nextPollTimestamp = Date.now() + currentIntervalMs;
            updateCountdownDisplay();
            executeAutoPoll();
          } else {
            updateCountdownDisplay();
          }
        }, 1000);
      }
    };

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) {
        resetIdleTimer();
        nextPollTimestamp = Date.now() + currentIntervalMs;
        updateCountdownDisplay();
        executeAutoPoll();
      } else {
        updateCountdownDisplay();
      }
    });

    // Event delegation on #lock-indicator
    const bannerEl = document.getElementById("lock-indicator");
    if (bannerEl) {
      bannerEl.addEventListener("click", async (e) => {
        const target = e.target as HTMLElement;

        // Acquire lock
        const acquireLockBtn = target.closest("#btn-acquire-lock") as HTMLButtonElement | null;
        if (acquireLockBtn) {
          acquireLockBtn.setAttribute("disabled", "true");
          acquireLockBtn.innerText = "Adquiriendo...";
          try {
            const res = await fetch("/api/disponibilidad/lock", { method: "POST" });
            if (res.ok) {
              window.location.reload();
            } else {
              const data = await res.json();
              showAlert("error", data.error || "No se pudo adquirir el control");
              const lockStatus = await fetchLockStatus();
              if (lockStatus) updateLockBanner(lockStatus);
            }
          } catch (err: any) {
            showAlert("error", "Error al adquirir el control");
            const lockStatus = await fetchLockStatus();
            if (lockStatus) updateLockBanner(lockStatus);
          }
          return;
        }

        // Reject release
        const rejectReleaseBtn = target.closest("#btn-reject-release") as HTMLButtonElement | null;
        if (rejectReleaseBtn) {
          rejectReleaseBtn.setAttribute("disabled", "true");
          rejectReleaseBtn.innerText = "Rechazando...";
          try {
            const res = await fetch("/api/disponibilidad/lock/reject-release", { method: "POST" });
            if (res.ok) {
              const lockStatus = await fetchLockStatus();
              if (lockStatus) updateLockBanner(lockStatus);
              showToast("Solicitud de liberación rechazada", "alert-success");
            } else {
              const data = await res.json();
              showToast(data.error || "Error al rechazar", "alert-error");
            }
          } catch {
            showToast("Error al rechazar liberación", "alert-error");
          }
          rejectReleaseBtn.removeAttribute("disabled");
          rejectReleaseBtn.innerText = "Rechazar liberación";
          return;
        }

        // Release lock
        const releaseLockBtn = target.closest("#btn-release-lock") as HTMLButtonElement | null;
        if (releaseLockBtn) {
          releaseLockBtn.setAttribute("disabled", "true");
          try {
            const res = await fetch("/api/disponibilidad/lock", { method: "DELETE" });
            if (res.ok) {
              window.location.reload();
            } else {
              const data = await res.json();
              showAlert("error", data.error || "No se pudo liberar el control");
              const lockStatus = await fetchLockStatus();
              if (lockStatus) updateLockBanner(lockStatus);
            }
          } catch (err: any) {
            showAlert("error", "Error al liberar el control");
            const lockStatus = await fetchLockStatus();
            if (lockStatus) updateLockBanner(lockStatus);
          }
          return;
        }

        // Request release
        const requestReleaseBtn = target.closest("#btn-request-release") as HTMLButtonElement | null;
        if (requestReleaseBtn) {
          requestReleaseBtn.setAttribute("disabled", "true");
          requestReleaseBtn.innerText = "Enviando...";
          try {
            const res = await fetch("/api/disponibilidad/lock/request-release", { method: "POST" });
            if (res.ok) {
              requestReleaseBtn.innerText = "Solicitud enviada";
              const lockStatus = await fetchLockStatus();
              if (lockStatus) updateLockBanner(lockStatus);
            } else {
              showAlert("error", "No se pudo enviar la solicitud");
              const lockStatus = await fetchLockStatus();
              if (lockStatus) updateLockBanner(lockStatus);
            }
          } catch (err: any) {
            showAlert("error", "Error al solicitar liberación");
            const lockStatus = await fetchLockStatus();
            if (lockStatus) updateLockBanner(lockStatus);
          }
          return;
        }
      });
    }

    // Initial fetch of lock status immediately
    fetchLockStatus().then(updateLockBanner);

    // Release lock and clean timers on page unload using fetch with keepalive: true
    window.addEventListener("beforeunload", () => {
      if (autoPollTimer) clearInterval(autoPollTimer);
      if (idleTimer) clearTimeout(idleTimer);
      if (ticketsAbortController) ticketsAbortController.abort();
      if (disponibilidadAbortController) disponibilidadAbortController.abort();
      const indicator = document.getElementById("lock-indicator");
      if (indicator && indicator.getAttribute("data-has-lock") === "true") {
        fetch("/api/disponibilidad/lock", { method: "DELETE", keepalive: true });
      }
    });

    // Run first UI update visibility check
    updateVisibility();

    return true;
  };

  // Wait for dynamic server island component initialization
  if (!init()) {
    checkReady = setInterval(() => {
      if (init()) {
        clearInterval(checkReady);
      }
    }, 50);
  }

  document.addEventListener("astro:before-swap", () => {
    if (countdownInterval) clearInterval(countdownInterval);
    if (heartbeatInterval) clearInterval(heartbeatInterval);
    if (checkReady) clearInterval(checkReady);
    if (autoPollTimer) clearInterval(autoPollTimer);
    if (idleTimer) clearTimeout(idleTimer);
    if (ticketsAbortController) ticketsAbortController.abort();
    if (disponibilidadAbortController) disponibilidadAbortController.abort();
  });
</script>

<style is:global>
  [data-queue-item] {
    position: absolute;
    transition: top 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease-out;
  }
</style>
