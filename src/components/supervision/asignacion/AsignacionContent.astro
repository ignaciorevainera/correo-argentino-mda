        <!-- Input de Fecha y Hora -->
        <div class="form-control space-y-1.5">
          <div class="flex items-center justify-between gap-2 flex-wrap">
            <label class="label-text font-bold text-xs uppercase tracking-wider text-base-content/85">
              Fecha y Hora de Reanudación
            </label>
            <span id="posponer-sugerencia-badge" class="hidden badge badge-soft badge-secondary badge-sm font-bold text-xs px-2.5 py-0.5 gap-1.5 shrink-0">
              <Icon name="boxicons:sparkles" size={13} class="shrink-0" />
              <span id="posponer-sugerencia-text">Sugerido</span>
            </span>
