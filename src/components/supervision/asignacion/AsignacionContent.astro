      <div class="p-4 sm:p-5 space-y-4">
        <!-- Resumen del Ticket y Operador -->
        <div class="p-3.5 rounded-xl bg-base-200/25 border border-base-300/60 space-y-2 text-xs sm:text-sm">
          <div class="flex items-center justify-between gap-2">
            <span class="text-base-content/60 font-semibold uppercase tracking-wider text-xs">Ticket:</span>
            <span id="posponer-ticket-badge" class="font-mono font-bold text-base-content/70 text-xs">#---</span>
