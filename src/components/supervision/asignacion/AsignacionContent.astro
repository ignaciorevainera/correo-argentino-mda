        </div>

        <!-- Input de Nota Interna -->
        <div class="form-control space-y-1.5">
          <label class="label-text font-bold text-xs uppercase tracking-wider text-base-content/85">
            Nota interna para el operador (opcional)
          </label>
          <input
            id="posponer-input-motivo"
            type="text"
            placeholder="Ej. Coordinado con el cliente para el día..."
            class="input input-bordered input-sm sm:input-md w-full text-xs sm:text-sm rounded-xl focus:outline-none focus:border-secondary"
          />
          <p class="text-xs text-base-content/55">Se publicará como comentario interno en el ticket de InvGate visible para el operador.</p>
        </div>
      </div>

      <div class="p-3.5 sm:p-4 bg-base-200/40 border-t border-base-300 flex items-center justify-end gap-2.5">
        <form method="dialog">
          <button class="btn btn-ghost btn-sm font-semibold rounded-lg">Cancelar</button>
        </form>
        <button
          id="btn-confirm-posponer"
          type="button"
          class="btn btn-secondary btn-sm font-bold uppercase tracking-wider px-5 rounded-lg gap-1.5"
        >
          <Icon name="boxicons:calendar-check" size={16} />
          <span>Confirmar y Posponer</span>
        </button>
