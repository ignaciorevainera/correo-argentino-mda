        <div class="flex items-center gap-3">
          <div class="p-2.5 rounded-xl bg-secondary/10 text-secondary shrink-0">
            <Icon name="boxicons:history" size={22} />
          </div>
          <div>
            <h3 class="font-extrabold text-sm sm:text-base text-base-content uppercase tracking-wider">Historial de Asignaciones</h3>
            <p class="text-xs text-base-content/60 font-medium">Registro cronológico detallado de asignaciones de autogestión</p>
