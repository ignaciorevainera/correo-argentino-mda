---
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
---

<PageContainer>
  <div class="skeleton-debounced">
    <div
      class="border-base-200 mb-6 flex flex-col gap-4 border-b pb-5 lg:flex-row lg:items-center lg:justify-between"
    >
      <PageHeader
        description="Distribución equitativa y controlada de autogestiones entre operadores técnicos. Utiliza el botón de asignar próximo para rotar de manera circular."
      />
      <div
        class="bg-base-200/50 border-base-300/40 flex items-center gap-3 self-end rounded-xl border px-4 py-2.5 shadow-sm lg:self-center"
      >
        <div class="skeleton h-4 w-32 rounded"></div>
        <div class="skeleton size-6 rounded-full"></div>
      </div>
    </div>

    <div class="mb-8 grid grid-cols-1 gap-4 md:grid-cols-2">
      <!-- Card Disponibles Skeleton -->
      <div
        class="card bg-base-100 border-base-300 h-44 overflow-hidden border shadow-md"
      >
        <div class="card-body justify-between p-6">
          <div class="flex items-center gap-3">
            <div class="bg-base-200 skeleton size-8 rounded"></div>
            <div class="skeleton h-4 w-28 rounded"></div>
          </div>
          <div class="flex items-baseline gap-2">
            <div class="skeleton h-10 w-16 rounded"></div>
            <div class="skeleton h-3 w-28 rounded"></div>
          </div>
          <div class="mt-2 w-full space-y-2">
            <div class="skeleton h-3 w-full rounded"></div>
          </div>
        </div>
      </div>

      <!-- Card No Disponibles Skeleton -->
      <div
        class="card bg-base-100 border-base-300 h-44 overflow-hidden border shadow-md"
      >
        <div class="card-body justify-between p-6">
          <div class="flex items-center gap-3">
            <div class="bg-base-200 skeleton size-8 rounded"></div>
            <div class="skeleton h-4 w-24 rounded"></div>
          </div>
          <div class="flex items-baseline gap-2">
            <div class="skeleton h-10 w-16 rounded"></div>
            <div class="skeleton h-3 w-24 rounded"></div>
          </div>
          <div class="mt-2 grid grid-cols-2 gap-2">
            <div class="skeleton h-6 w-full rounded"></div>
            <div class="skeleton h-6 w-full rounded"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="mb-4 flex flex-wrap items-center justify-between gap-4">
      <div class="skeleton h-10 w-48 rounded-xl"></div>
      <div class="skeleton h-10 w-52 rounded-xl"></div>
    </div>

    <!-- Table Skeleton -->
    <div
      class="border-base-300 bg-base-100 overflow-hidden rounded-xl border shadow-sm"
    >
      <div
        class="border-base-300 bg-base-200/50 grid grid-cols-[1.8fr_1.5fr_1.2fr_minmax(100px,auto)] gap-4 border-b px-4 py-3"
      >
        <div class="skeleton h-5 w-20 rounded"></div>
        <div class="skeleton h-5 w-24 rounded"></div>
        <div class="skeleton h-5 w-16 rounded"></div>
        <div class="skeleton h-5 w-16 justify-self-end rounded"></div>
      </div>

      <div class="divide-base-300 divide-y">
        {
          Array.from({ length: 8 }).map(() => (
            <div class="grid grid-cols-[1.8fr_1.5fr_1.2fr_minmax(100px,auto)] items-center gap-4 px-4 py-4">
              <div class="space-y-2">
                <div class="skeleton h-4 w-32 rounded" />
                <div class="skeleton h-3 w-24 rounded" />
                <div class="skeleton h-3 w-20 rounded" />
              </div>
              <div class="space-y-1">
                <div class="skeleton h-3.5 w-28 rounded" />
                <div class="skeleton h-3 w-20 rounded" />
              </div>
              <div>
                <div class="skeleton h-6 w-20 rounded-full" />
              </div>
              <div class="flex justify-end gap-2">
                <div class="skeleton h-6 w-14 rounded" />
                <div class="skeleton h-6 w-6 rounded-full" />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</PageContainer>
