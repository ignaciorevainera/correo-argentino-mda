---
import { Icon } from "astro-icon/components";
import StatsCard from "@components/ui/StatsCard.astro";
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import SearchBar from "@components/ui/SearchBar.astro";
import SearchEmptyState from "@components/ui/SearchEmptyState.astro";
import FormField from "@components/ui/forms/FormField.astro";
import FormTextarea from "@components/ui/forms/FormTextarea.astro";
import Modal from "@components/ui/Modal.astro";
import { db } from "@db/index";
import {
  agents,
  users,
  qualityAudits,
  auditParameters,
  auditScores,
  monthlySummaries,
} from "@db/schema";
import { and, eq, inArray } from "drizzle-orm";
import { activeAgentCondition } from "@lib/activeUsers";
import { getResolvedSearchParams } from "@lib/navigation";
import { formatMonthLabel, MONTH_LABELS } from "@lib/monthUtils";
import { getCleanBase } from "@lib/baseUrl";
import OperatorDetailsPanel from "./OperatorDetailsPanel.astro";
import { calculateOperatorChannelStats } from "@lib/qualityCalculator";
import type { ChannelType } from "@/types/quality";


const searchParams = getResolvedSearchParams(Astro.request, Astro.url);

const currentActualMonth = (() => {
  const now = new Date();
  const mm = (now.getMonth() + 1).toString().padStart(2, "0");
  const yyyy = now.getFullYear();
  return `${mm}-${yyyy}`;
})();

const selectedMonth = searchParams.get("month") || currentActualMonth;

// Generate the last 6 months based on the selected month
const getDynamicMonths = (baseMonthStr: string) => {
  const [mm, yyyy] = baseMonthStr.split("-");
  let m = parseInt(mm, 10);
  let y = parseInt(yyyy, 10);
  const res = [];
  for (let i = 0; i < 6; i++) {
    res.push(`${m.toString().padStart(2, "0")}-${y}`);
    m--;
    if (m === 0) {
      m = 12;
      y--;
    }
  }
  return res;
};

const dynamicMonthsList = getDynamicMonths(selectedMonth);

const selectorMonthsList = getDynamicMonths(currentActualMonth);
if (!selectorMonthsList.includes(selectedMonth)) {
  selectorMonthsList.push(selectedMonth);
  selectorMonthsList.sort((a, b) => {
    const [mA, yA] = a.split("-").map(Number);
    const [mB, yB] = b.split("-").map(Number);
    if (yA !== yB) return yB - yA;
    return mB - mA;
  });
}

// Fetch all agents (small table, ~30 rows)
const allAgents = await db
  .select({ id: agents.id, name: agents.name, username: agents.username })
  .from(agents)
  .leftJoin(users, eq(users.id, agents.userId))
  .where(and(eq(agents.incluidoCalidad, true), activeAgentCondition()))
  .orderBy(agents.name);

// Fetch all parameters (for resolving historical scores) and active parameters
const allParameters = await db
  .select()
  .from(auditParameters)
  .orderBy(auditParameters.order);

const activeParameters = allParameters.filter((p) => p.active !== false);

// Fetch audits filtered by dynamic months
const allAudits = await db
  .select()
  .from(qualityAudits)
  .where(inArray(qualityAudits.month, dynamicMonthsList));

// Fetch scores only for loaded audits
const auditIds = allAudits.map((a) => a.id);
const allScores =
  auditIds.length > 0
    ? await db
        .select()
        .from(auditScores)
        .where(inArray(auditScores.auditId, auditIds))
    : [];

// Fetch monthly summaries only for selected month
const allMonthlySummaries = await db
  .select()
  .from(monthlySummaries)
  .where(eq(monthlySummaries.month, selectedMonth));

// Pre-indexar auditorías por agentId
const auditsByAgent = new Map<number, typeof allAudits>();
for (const audit of allAudits) {
  if (!auditsByAgent.has(audit.agentId)) {
    auditsByAgent.set(audit.agentId, []);
  }
  auditsByAgent.get(audit.agentId)!.push(audit);
}

// Pre-indexar scores por auditId
const scoresByAudit = new Map<number, typeof allScores>();
for (const score of allScores) {
  if (!scoresByAudit.has(score.auditId)) {
    scoresByAudit.set(score.auditId, []);
  }
  scoresByAudit.get(score.auditId)!.push(score);
}

// Pre-indexar summaries por agentId
const summariesByAgent = new Map<number, (typeof allMonthlySummaries)[0]>();
for (const s of allMonthlySummaries) {
  summariesByAgent.set(s.agentId, s);
}

import { normalizeRole } from "@lib/rbac";

const user = Astro.locals.user;
const role = normalizeRole(user.role);
const isAgent = role === "agent";

let finalAgents = allAgents;
let agentNotFound = false;

if (isAgent) {
  const matched = allAgents.find(
    (a) =>
      a.username?.toLowerCase().trim() === user.username.toLowerCase().trim(),
  );
  if (matched) {
    finalAgents = [matched];
  } else {
    finalAgents = [];
    agentNotFound = true;
  }
}

const operatorsQuality = finalAgents.map((agent) => {
  const agentAudits = auditsByAgent.get(agent.id) || [];
  const currentMonthAudits = agentAudits.filter(
    (a) => a.month === selectedMonth,
  );

  const monthSummaryRec = summariesByAgent.get(agent.id);
  const monthSummary = monthSummaryRec ? monthSummaryRec.summary : "";

  const averageScore =
    currentMonthAudits.length > 0
      ? Math.round(
          currentMonthAudits.reduce((sum, audit) => sum + audit.totalScore, 0) /
            currentMonthAudits.length,
        )
      : 0;

  const history = dynamicMonthsList
    .slice()
    .reverse()
    .map((m) => {
      const monthAudits = agentAudits.filter((a) => a.month === m);
      const [mm] = m.split("-");
      const shortLabel = MONTH_LABELS[mm] ? MONTH_LABELS[mm].substring(0, 3) : mm;
      return {
        month: m,
        label: shortLabel,
        count: monthAudits.length,
        score:
          monthAudits.length > 0
            ? Math.round(
                monthAudits.reduce((sum, audit) => sum + audit.totalScore, 0) /
                  monthAudits.length,
              )
            : null,
      };
    })
    .filter((h): h is { month: string; label: string; count: number; score: number } => h.score !== null);

  const channelStats = calculateOperatorChannelStats(currentMonthAudits);

  const calls = currentMonthAudits.map((audit) => {
    const auditScoresList = scoresByAudit.get(audit.id) || [];
    const section1Details: Record<string, boolean> = {};
    const section2Details: Record<string, boolean> = {};
    const parameterComments: Record<string, string> = {};

    auditScoresList.forEach((scoreObj) => {
      const param = allParameters.find((p) => p.id === scoreObj.parameterId);
      if (param) {
        if (param.category === "Interacción con Usuario" || param.section === "items") {
          section1Details[param.code] = scoreObj.score;
        } else {
          section2Details[param.code] = scoreObj.score;
        }
        if (scoreObj.comment && scoreObj.comment.trim()) {
          parameterComments[param.code] = scoreObj.comment.trim();
        }
      }
    });

    return {
      id: audit.id,
      channelType: (audit.channelType || "wise_call") as ChannelType,
      callId: audit.callId,
      ticketId: audit.ticketId,
      duration: audit.duration,
      date: audit.date,
      month: audit.month,
      notes: audit.notes || "",
      ringTime: audit.ringTime,
      creationTime: audit.creationTime,
      takeTime: audit.takeTime,
      isPas: audit.isPas,
      appliesMda: (audit.channelType || "wise_call") === "wise_call"
        ? (audit.appliesMda ?? true)
        : audit.appliesMda,
      staysInMda: audit.staysInMda,
      isReclamoNovedad: audit.isReclamoNovedad ?? false,
      recordingUrl: audit.recordingUrl,
      comments: parameterComments,
      section1: {
        score: audit.section1Score,
        maxScore: 100,
        details: section1Details,
      },
      section2: {
        score: audit.section2Score,
        maxScore: 100,
        details: section2Details,
      },
      totalScore: audit.totalScore,
    };
  });

  const prevMonth = dynamicMonthsList[1];
  const prevMonthAudits = prevMonth
    ? agentAudits.filter((a) => a.month === prevMonth)
    : [];
  // Misma fórmula que `averageScore` (promedio de los promedios por canal): el
  // diff comparaba el mes actual por canal contra un promedio plano del mes
  // anterior, así que la flecha no era interpretable con reparto desigual.
  const prevFlatAverage =
    prevMonthAudits.length > 0
      ? Math.round(
          prevMonthAudits.reduce((sum, audit) => sum + audit.totalScore, 0) /
            prevMonthAudits.length,
        )
      : 0;
  const prevAverageScore =
    calculateOperatorChannelStats(prevMonthAudits).globalAverage || prevFlatAverage;
  const prevCallsCount = prevMonthAudits.length;

  return {
    id: agent.id.toString(),
    name: agent.name,
    username: agent.username || "",
    month: selectedMonth,
    monthSummary,
    calls,
    history,
    averageScore: channelStats.globalAverage > 0 ? channelStats.globalAverage : averageScore,
    wiseCallsAvg: channelStats.wiseCallsAvg,
    wiseCallsCount: channelStats.wiseCallsCount,
    wiseEmailsAvg: channelStats.wiseEmailsAvg,
    wiseEmailsCount: channelStats.wiseEmailsCount,
    invgateAgAvg: channelStats.invgateAgAvg,
    invgateAgCount: channelStats.invgateAgCount,
    totalAuditsCount: channelStats.totalAuditsCount,
    quotaFulfilled: channelStats.quotaFulfilled,
    prevAverageScore,
    prevCallsCount,
  };
});

const operatorsDataMap = Object.fromEntries(
  operatorsQuality.map((op) => [op.id, op]),
);

const auditedOperators = operatorsQuality.filter((op) => op.calls.length > 0);
const totalOperators = operatorsQuality.length;

const excellentOperators = auditedOperators.filter(
  (op) => op.averageScore >= 90,
).length;

const needsImprovement = auditedOperators.filter(
  (op) => op.averageScore > 0 && op.averageScore < 80,
).length;

const cleanBase = getCleanBase();
---

<div
  id="audit-parameters-data"
  data-parameters={JSON.stringify(allParameters)}
  class="hidden"
>
</div>
<div
  id="operators-data"
  data-operators={JSON.stringify(operatorsDataMap)}
  data-clean-base={cleanBase}
  class="hidden"
>
</div>
<PageContainer
  class="mx-auto max-w-7xl"
  data-is-agent={isAgent}
  data-agent-not-found={agentNotFound}
>
  <PageHeader
    description="Evaluación de llamadas, métricas y validaciones de la calidad de atención del equipo de operaciones de Mesa de Ayuda."
  />

  <!-- Barra Superior Unificada Compacta -->
  <div
    class="bg-base-100 border-base-200/80 mt-2 mb-4 flex flex-col gap-3 rounded-2xl border p-3.5 shadow-xs sm:flex-row sm:items-center sm:justify-between"
  >
    {/* Extremo Izquierdo: Buscador */}
    <div class="w-full sm:w-80 md:w-96">
      {
        !isAgent ? (
          <SearchBar
            id="operator-search"
            placeholder="Buscar por nombre o legajo..."
          />
        ) : (
          <div class="text-base-content/80 flex items-center gap-2">
            <Icon name="boxicons:calendar" size={20} class="text-primary" />
            <span class="font-semibold text-xs uppercase tracking-wider">Período de evaluación:</span>
          </div>
        )
      }
    </div>
    {/* Extremo Derecho: Selector de mes + Botones */}
    <div class="flex flex-wrap items-center justify-end gap-2">
      <div class="flex items-center gap-1 bg-base-200/40 p-1 rounded-xl border border-base-200/60">
        <button
          id="btn-prev-month"
          class="btn btn-xs btn-square btn-ghost"
          title="Mes anterior"
        >
          <Icon name="boxicons:chevron-left" size={18} />
        </button>
        <select
          id="month-selector"
          class="select select-xs bg-base-100 text-base-content border-0 text-center font-bold sm:w-40 focus:outline-hidden"
        >
          {
            selectorMonthsList.map((m) => (
              <option value={m} selected={selectedMonth === m} class="bg-base-100 text-base-content">
                {formatMonthLabel(m)}
              </option>
            ))
          }
        </select>
        <button
          id="btn-next-month"
          class="btn btn-xs btn-square btn-ghost"
          title="Mes siguiente"
        >
          <Icon name="boxicons:chevron-right" size={18} />
        </button>
      </div>

      <button
        id="btn-export-excel"
        class="btn btn-sm btn-outline btn-secondary gap-1.5 text-xs font-bold uppercase"
        title="Exportar Reporte a Excel (.xlsx)"
      >
        <Icon name="boxicons:file" size={18} />
        <span>Exportar Excel</span>
      </button>
      {
        !isAgent && (
          <>
            <div class="divider divider-horizontal mx-0.5 hidden sm:flex"></div>
            <button
              id="btn-configure-parameters"
              class="btn btn-sm btn-ghost text-base-content/70 hover:text-base-content gap-1.5 text-xs font-semibold"
              title="Configurar Parámetros de Calidad"
            >
              <Icon name="boxicons:cog" size={18} />
              <span class="hidden md:inline">Parámetros</span>
            </button>
            <a
              id="btn-top-new-audit"
              href={`${cleanBase}supervision/calidad-operadores/nueva?month=${selectedMonth}`}
              class="btn btn-sm btn-secondary gap-1.5 text-xs font-bold uppercase tracking-wider shadow-xs hover:shadow-sm"
            >
              <Icon name="boxicons:plus" size={18} />
              <span>Nueva Auditoría</span>
            </a>
          </>
        )
      }
    </div>
  </div>

  {
    agentNotFound ? (
      <div class="alert alert-warning mb-6 flex gap-4 rounded-2xl p-6 shadow-md">
        <Icon
          name="boxicons:alert-circle-filled"
          size={24}
          class="shrink-0 text-amber-600"
        />
        <div>
          <h3 class="text-sm font-bold tracking-wide uppercase">
            Ficha de Operador no encontrada
          </h3>
          <p class="mt-1 text-xs">
            No se encontró tu ficha de operador vinculada a tu nombre de usuario
            (@{user.username}). Por favor, solicita a tu supervisor que cree tu
            ficha en el sistema.
          </p>
        </div>
      </div>
    ) : (
      <div class="mt-4">
        {
          isAgent ? (
            <div id="operator-details-panel" class="w-full space-y-6">
              <OperatorDetailsPanel isAgent={true} />
            </div>
          ) : (
            <>
              {/* Sorter + Grilla de Operadores. El root envuelve barra y grilla;
                  la grilla es el "body" que `clientTableSort` reordena. */}
              <div
                id="operators-sort-root"
                data-table-sort-root
                data-table-sort-default-key="nombre"
                data-table-sort-default-direction="ascending"
                class="space-y-3"
              >
                <div
                  data-table-header
                  class="flex flex-wrap items-center justify-end gap-1.5 px-1 text-xs text-base-content/70"
                >
                  <span class="text-xxs font-semibold tracking-wider text-base-content/50 uppercase">
                    Ordenar por:
                  </span>
                  {
                    [
                      { key: "nombre", label: "Nombre" },
                      { key: "puntaje", label: "Puntaje" },
                      { key: "auditorias", label: "Auditorías" },
                    ].map((sortOption) => {
                      const isDefault = sortOption.key === "nombre";
                      return (
                        <button
                          type="button"
                          data-table-sort-key={sortOption.key}
                          data-table-sort-direction={
                            isDefault ? "ascending" : "none"
                          }
                          aria-sort={isDefault ? "ascending" : "none"}
                          class="btn btn-xs btn-ghost gap-1 rounded-lg border border-base-200/80 bg-base-100 px-2 font-medium hover:border-secondary/40 hover:bg-base-200/50"
                        >
                          <span>{sortOption.label}</span>
                          <span class="relative inline-flex size-3.5 shrink-0 items-center justify-center">
                            <Icon
                              name="boxicons:arrow-down-up-filled"
                              size={12}
                              class="absolute opacity-50"
                              data-table-sort-icon="none"
                            />
                            <Icon
                              name="boxicons:chevron-up"
                              size={14}
                              class="absolute hidden opacity-0"
                              data-table-sort-icon="ascending"
                            />
                            <Icon
                              name="boxicons:chevron-down"
                              size={14}
                              class="absolute hidden opacity-0"
                              data-table-sort-icon="descending"
                            />
                          </span>
                        </button>
                      );
                    })
                  }
                </div>

                <div
                  id="operators-grid"
                  data-table-sort-body
                  class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"
                >
                {operatorsQuality.map((op) => {
                  const initials = op.name
                    .split(" ")
                    .filter(Boolean)
                    .map((n) => n[0])
                    .join("")
                    .substring(0, 2)
                    .toUpperCase();
                  const scoreChipClass =
                    op.averageScore >= 90
                      ? "bg-success/10 text-success border-success/20"
                      : op.averageScore >= 80
                        ? "bg-warning/10 text-warning border-warning/20"
                        : "bg-error/10 text-error border-error/20";
                  const progressPct = Math.min(Math.round((op.calls.length / 12) * 100), 100);

                  return (
                    <button
                      type="button"
                      class="operator-card operator-item bg-base-100 border-base-200/80 hover:border-secondary/40 shadow-xs hover:shadow-md transition-all duration-200 border p-4.5 text-left cursor-pointer group flex flex-col justify-between rounded-2xl focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-secondary/50 focus-visible:border-secondary/50 active:scale-[0.99]"
                      data-name={op.name.toLowerCase()}
                      data-id={op.id.toLowerCase()}
                      data-username={(op.username || "").toLowerCase()}
                      data-operator-id={op.id}
                      data-table-row
                      data-sort-nombre={op.name.toLowerCase()}
                      data-sort-puntaje={op.averageScore}
                      data-sort-auditorias={op.calls.length}
                      data-operator={JSON.stringify({
                        id: op.id,
                        name: op.name,
                        username: op.username,
                        averageScore: op.averageScore,
                        callsCount: op.calls.length,
                      })}
                    >
                      <div class="flex items-start justify-between gap-3">
                        <div class="flex items-center gap-3 min-w-0">
                          <div class="size-11 rounded-xl bg-secondary/10 text-secondary group-hover:bg-secondary group-hover:text-secondary-content flex items-center justify-center font-bold text-sm tracking-wider shadow-xs transition-colors duration-200 shrink-0">
                            <span>{initials}</span>
                          </div>
                          <div class="min-w-0">
                            <div class="flex items-center gap-1.5">
                              <span class="text-base-content font-bold text-sm tracking-tight truncate group-hover:text-secondary transition-colors">
                                {op.name}
                              </span>
                            </div>
                            <div class="text-base-content/50 font-mono text-xs lowercase mt-0.5 truncate">
                              @{op.username || op.id}
                            </div>
                          </div>
                        </div>
                        <div class={`inline-flex items-center px-2 py-0.5 rounded-lg border text-xs font-black tracking-tight ${scoreChipClass} shrink-0`}>
                          {op.averageScore}%
                        </div>
                      </div>

                      <div class="mt-4 pt-3 border-t border-base-200/60">
                        <div class="flex items-center justify-between text-xs">
                          <span class="text-base-content/60 font-medium">Auditorías</span>
                          <span class="text-base-content/80 font-mono text-xxs sm:text-xs">
                            <span class="text-base-content font-bold">{op.calls.length}</span> de 12 completadas
                          </span>
                        </div>
                        <div class="w-full bg-base-200/80 rounded-full h-1.5 mt-2 overflow-hidden">
                          <div
                            class={`h-full rounded-full transition-all duration-300 ${op.calls.length >= 12 ? "bg-success" : "bg-secondary"}`}
                            style={`width: ${progressPct}%`}
                          ></div>
                        </div>
                      </div>
                    </button>
                  );
                })}
                <div id="calidad-empty-state" class="col-span-full hidden py-12">
                  <SearchEmptyState
                    title="Sin resultados"
                    description="No hay operadores que coincidan con la búsqueda. Probá con otro nombre o legajo."
                  />
                </div>
                </div>
              </div>

              {/* Modal de Detalle de Operador para Supervisores */}
              <dialog id="operator-details-modal" class="modal z-150">
                <div class="modal-box w-11/12 max-w-6xl max-h-[90vh] overflow-y-auto p-6 bg-base-100">
                  <div id="operator-details-panel" class="space-y-6">
                    <OperatorDetailsPanel isAgent={false} />
                  </div>
                </div>
                <form method="dialog" class="modal-backdrop">
                  <button>close</button>
                </form>
              </dialog>
            </>
          )
        }
      </div>
    )
  }
</PageContainer>

<Modal
  id="month-summary-modal"
  title="Observaciones del Mes"
  icon="boxicons:note"
  titleClass="font-black text-lg uppercase tracking-tight"
  zIndex="z-200"
  class="max-w-lg"
>
  <Fragment slot="content">
    <form id="month-summary-form" method="POST" class="space-y-4">
      <input type="hidden" name="agentId" id="summary-agent-id" />
      <input
        type="hidden"
        name="month"
        id="summary-month"
        value={selectedMonth}
      />

      <FormTextarea
        id="summary-content"
        name="summary"
        label="Resumen general"
        placeholder="Añadir observación del mes..."
        rows={5}
        textareaClass="textarea-sm font-bold"
      />

      <div class="modal-action mt-6 flex justify-end gap-2">
        <button
          type="button"
          id="btn-close-summary-modal"
          class="btn btn-sm btn-ghost hover:bg-base-200 text-xs font-black uppercase"
        >
          Cancelar
        </button>
        <button
          type="submit"
          id="btn-submit-month-summary"
          class="btn btn-sm btn-secondary text-xs font-black uppercase"
        >
          Guardar
        </button>
      </div>
    </form>
  </Fragment>
</Modal>

<Modal
  id="parameters-modal"
  title="Configuración de Parámetros de Calidad"
  icon="boxicons:cog"
  titleClass="font-black text-base uppercase tracking-tight"
  size="3xl"
  zIndex="z-200"
  fixedFooter={true}
  class="flex flex-col h-[90vh] sm:h-[82vh] max-h-[780px] w-11/12 sm:max-w-3xl"
>
  <Fragment slot="content">
    <!-- Compact Header Bar with Channel & Section Tabs -->
    <div class="bg-base-200/50 rounded-xl p-3 border border-base-200/80 space-y-2.5 mb-4 shrink-0">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
        <!-- Channel Selector: Segmented Control unificado y redondeado -->
        <div class="flex items-center gap-1.5 shrink-0 overflow-x-auto pb-0.5 sm:pb-0 text-xs no-scrollbar">
          <span class="text-xs font-semibold text-base-content/60 mr-1 shrink-0">Canal:</span>
          <div class="inline-flex items-center rounded-xl bg-base-200/80 p-0.5 border border-base-200 shadow-2xs shrink-0" id="param-channel-container">
            <button
              type="button"
              class="btn btn-xs rounded-lg border-0 param-channel-btn btn-active bg-secondary text-secondary-content font-bold shadow-2xs transition-all px-2.5"
              data-channel="wise_call"
            >
              Llamada Wise
            </button>
            <button
              type="button"
              class="btn btn-xs rounded-lg border-0 bg-transparent param-channel-btn font-medium text-base-content/70 hover:text-secondary hover:bg-base-100/60 transition-all px-2.5"
              data-channel="wise_email"
            >
              Mail Wise
            </button>
            <button
              type="button"
              class="btn btn-xs rounded-lg border-0 bg-transparent param-channel-btn font-medium text-base-content/70 hover:text-secondary hover:bg-base-100/60 transition-all px-2.5"
              data-channel="invgate_ticket"
            >
              Autogestión
            </button>
          </div>
        </div>

        <!-- Live Weight & Criteria Summary Badge + Tooltip Disclaimer -->
        <div class="flex items-center gap-1.5 shrink-0 self-start sm:self-auto">
          <div
            id="param-summary-badge"
            class="inline-flex items-center gap-2 px-2.5 py-1 rounded-lg text-xs font-medium bg-base-100 border border-base-200/80 transition-colors"
            title="Resumen de criterios y porcentaje asignado"
          >
            <span id="param-summary-count" class="font-bold text-base-content">0 criterios</span>
            <span class="text-base-content/30">•</span>
            <span id="param-summary-weight" class="font-mono font-bold text-base-content/70">Peso total: 0%</span>
          </div>

          <div
            class="tooltip tooltip-bottom sm:tooltip-left z-210"
            data-tip="La evaluación empieza en 100 puntos y cada ítem no cumplido resta porcentaje. Para que la nota sea justa y equilibrada, la suma de los criterios de cada sección debe dar exactamente 100%. Si supera el 100%, se penaliza de más al operador."
          >
            <button
              type="button"
              class="btn btn-ghost btn-xs btn-circle text-base-content/60 hover:text-base-content"
              aria-label="Información sobre cálculo de pesos y criterios"
            >
              <Icon name="boxicons:info-circle" size={16} />
            </button>
          </div>
        </div>
      </div>

      <!-- Sub-section Tabs -->
      <div class="tabs tabs-box bg-base-100/90 p-1 rounded-lg border border-base-200/60 overflow-x-auto flex">
        <button
          type="button"
          id="param-tab-s1-btn"
          class="tab tab-active parameter-tab flex-1 text-xs font-bold transition-all py-1.5"
          data-tab="s1"
        >
          Interacción con Usuario
        </button>
        <button
          type="button"
          id="param-tab-s2-btn"
          class="tab parameter-tab flex-1 text-xs font-bold transition-all py-1.5"
          data-tab="s2"
        >
          Gestión del Ticket
        </button>
      </div>
    </div>

    <!-- Lists Container with Independent Scroll -->
    <div class="min-h-0 flex-1 space-y-3 pb-2">
      <!-- Section 1 List -->
      <div id="param-list-s1" class="parameter-list-pane space-y-2">
        <!-- populated dynamically -->
      </div>

      <!-- Section 2 List -->
      <div id="param-list-s2" class="parameter-list-pane hidden space-y-2">
        <!-- populated dynamically -->
      </div>
    </div>
  </Fragment>

  <Fragment slot="actions">
    <!-- Fixed Footer Actions -->
    <div class="flex items-center justify-between gap-3 w-full">
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="btn-add-param"
          class="btn btn-sm btn-ghost gap-1 text-xs font-bold transition-transform active:scale-95"
          title="Agregar nuevo criterio a la sección activa"
        >
          <Icon name="boxicons:plus" size={16} />
          <span id="btn-add-param-label">Agregar criterio</span>
        </button>
        <!-- Compatibilidad oculta para selectores legacy -->
        <button type="button" id="btn-add-param-s1" class="hidden"></button>
        <button type="button" id="btn-add-param-s2" class="hidden"></button>
      </div>
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="btn-close-parameters-modal"
          class="btn btn-sm btn-ghost text-xs font-semibold hover:bg-base-200"
        >
          Cancelar
        </button>
        <button
          type="button"
          id="btn-save-parameters"
          class="btn btn-sm btn-secondary text-xs font-bold shadow-xs hover:shadow-md"
        >
          Guardar cambios
        </button>
      </div>
    </div>
  </Fragment>
</Modal>

<style is:global>
  /* RBAC - Vista de calidad para Operador (Solo Lectura) */
  [data-is-agent="true"] #btn-back-to-summary {
    display: none !important;
  }
  [data-is-agent="true"] #btn-new-audit {
    display: none !important;
  }
  [data-is-agent="true"] #btn-edit-month-summary {
    display: none !important;
  }
  [data-is-agent="true"] .edit-audit-btn,
  [data-is-agent="true"] .delete-audit-btn,
  [data-is-agent="true"] #btn-delete-audit {
    display: none !important;
  }
</style>

<style>
  /* Asegurar fondo sólido y scrollbar no transparente en el selector de meses */
  #month-selector,
  #month-selector:focus,
  #month-selector option,
  #month-selector optgroup {
    background-color: var(--color-base-100, #efefef) !important;
    color: var(--color-base-content, #0c0c0c) !important;
  }

  #month-selector::-webkit-scrollbar {
    width: 8px;
    background-color: var(--color-base-100, #efefef);
  }

  #month-selector::-webkit-scrollbar-track {
    background-color: var(--color-base-100, #efefef);
  }

  #month-selector::-webkit-scrollbar-thumb {
    background-color: var(--color-base-300, #cacdce);
    border-radius: 4px;
  }

  /* Ocultar flechas nativas (stepper spinners) en inputs numéricos de peso para evitar desalineación */
  .param-input-weight::-webkit-outer-spin-button,
  .param-input-weight::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .param-input-weight {
    -moz-appearance: textfield;
    appearance: textfield;
  }

  /* Animaciones útiles para las transiciones de estado */
  @media print {
    body * {
      visibility: hidden;
    }
    #operator-details-panel,
    #operator-details-panel * {
      visibility: visible;
    }
    #operator-details-panel {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      margin: 0;
      padding: 0;
    }
    .no-print,
    .btn,
    button,
    select {
      display: none !important;
    }
    .call-card-details {
      display: grid !important;
    } /* Force expand all calls for print */
  }
</style>

<script>
  import { actions } from "astro:actions";
  import {
    calculateChannelAverages,
    formatChannelAverageScore,
    getChannelAverageTextClass,
    hasSection2,
    hasSection2Evaluated,
  } from "@lib/qualityCalculator";
  import { escapeHtml } from "@lib/sanitize";
  import { bindClientTableSort } from "@lib/clientTableSort";

  import { formatMonthLabel } from "@lib/monthUtils";
  import { getCleanBase } from "@lib/baseUrl";
  import type {
    QualityCall,
    OperatorQuality,
    AuditParameter,
  } from "@/types/quality";

  const cleanBase = getCleanBase();

  const ICON_CHECK = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" style="fill: currentColor;"><path d="m10 15.586-3.293-3.293-1.414 1.414L10 18.414l9.707-9.707-1.414-1.414z"></path></svg>`;
  const ICON_X = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" style="fill: currentColor;"><path d="m16.192 6.344-4.243 4.242-4.242-4.242-1.414 1.414L10.535 12l-4.242 4.242 1.414 1.414 4.242-4.242 4.243 4.242 1.414-1.414L13.364 12l4.242-4.242z"></path></svg>`;
  const ICON_ARROW = `<svg class="size-4 text-warning" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" style="fill: currentColor;"><path d="M10.707 17.707 16.414 12l-5.707-5.707-1.414 1.414L13.586 12l-4.293 4.293z"></path></svg>`;
  const ICON_STAR = `<svg class="size-4 text-success" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" style="fill: currentColor;"><path d="M21.947 9.179a1.001 1.001 0 0 0-.868-.676l-5.701-.453-2.467-5.461a.998.998 0 0 0-1.822-.001L8.622 8.05l-5.701.453a1 1 0 0 0-.619 1.713l4.214 4.107-1.29 5.71a1.001 1.001 0 0 0 1.451 1.054L12 18.26l5.324 2.827a1.002 1.002 0 0 0 1.45-1.054l-1.29-5.71 4.214-4.107a1 1 0 0 0 .249-1.037z"></path></svg>`;

  const getAuditParameters = () => {
    const el = document.getElementById("audit-parameters-data");
    if (!el) return [];
    try {
      return JSON.parse(el.getAttribute("data-parameters") || "[]");
    } catch (e) {
      return [];
    }
  };

  const getOperatorFullData = (id: string) => {
    const el = document.getElementById("operators-data");
    if (!el) return null;
    try {
      const map = JSON.parse(el.getAttribute("data-operators") || "{}");
      return map[id] || null;
    } catch (e) {
      return null;
    }
  };

  function renderCallCard(call: QualityCall, index: number) {
    const isUserAgent =
      document
        .querySelector("[data-is-agent]")
        ?.getAttribute("data-is-agent") === "true";
    const s1ScoreColor =
      call.section1.score >= 90
        ? "text-success"
        : call.section1.score >= 70
          ? "text-warning"
          : "text-error";
    const s2ScoreColor =
      call.section2.score >= 90
        ? "text-success"
        : call.section2.score >= 70
          ? "text-warning"
          : "text-error";
    const totalScoreColor =
      call.totalScore >= 90
        ? "text-success"
        : call.totalScore >= 80
          ? "text-warning"
          : "text-error";

    // Filtrar parámetros dinámicos para el canal de la auditoría
    const params: AuditParameter[] = getAuditParameters();
    const currentChannel = call.channelType || "wise_call";
    const channelParams = params.filter(
      (p) => (p.channel || "wise_call") === currentChannel && p.active !== false,
    );

    let s1Params = channelParams.filter((p) => p.section === "items");
    if (s1Params.length === 0) {
      s1Params = params.filter((p) =>
        call.section1.details.hasOwnProperty(p.code),
      );
    }

    let s2Params = channelParams.filter(
      (p) => p.section === "ticket" || p.section === "mda",
    );
    if (s2Params.length === 0) {
      s2Params = params.filter((p) =>
        call.section2.details.hasOwnProperty(p.code),
      );
    }

    const hasS2 = hasSection2(call);
    const s2Evaluated = hasSection2Evaluated(call);

    let s1PassedCount = 0;
    const s1TotalCount = s1Params.length;
    const s1ListHTML = s1Params
      .map((param) => {
        const isEvaluated = param.code in call.section1.details;
        const isChecked = isEvaluated
          ? Boolean(call.section1.details[param.code])
          : false;
        if (isEvaluated && isChecked) s1PassedCount++;

        const isNoCumple = isEvaluated && !isChecked;
        const rowClass = isNoCumple
          ? "bg-error/5 border-l-2 border-l-error pl-2.5 pr-2 py-2 rounded-r-lg transition-colors"
          : "border-b border-base-200/60 last:border-b-0 py-2 transition-colors";

        const weightText = isNoCumple
          ? `<span class="text-3xs font-mono font-bold text-error shrink-0">−${param.weight}%</span>`
          : `<span class="text-3xs font-mono text-base-content/40 shrink-0">${param.weight}%</span>`;

        const comment = call.comments?.[param.code];
        return `
        <li class="flex flex-col group/item ${rowClass}">
          <div class="flex items-center justify-between gap-2">
            <span class="text-xs leading-snug font-medium ${isNoCumple ? "text-error font-semibold" : "text-base-content/85 group-hover/item:text-base-content"}">
              ${escapeHtml(param.name)}
            </span>
            ${weightText}
          </div>
          ${
            comment
              ? `
            <div class="mt-1.5 flex items-start text-xs text-base-content/90 bg-base-200/60 rounded-lg px-2.5 py-1.5 border border-base-300/40">
              <span class="break-words font-sans text-xs text-base-content/80">${escapeHtml(comment)}</span>
            </div>
          `
              : ""
          }
        </li>
      `;
      })
      .join("");

    const isReclamo = Boolean(call.isReclamoNovedad);
    let s2PassedCount = 0;
    const s2TotalCount = s2Params.length;
    const s2ListHTML = !hasS2
      ? `<li class="text-xs text-base-content/40 italic py-3 text-center bg-base-200/30 rounded-xl border border-dashed border-base-300/60">${
          call.channelType === "wise_call"
            ? "No aplica evaluación de ticket (no se generó ticket)."
            : "No aplica ticket MDA."
        }</li>`
      : isReclamo
        ? s2Params
            .map((param) => {
              const comment = call.comments?.[param.code];
              return `
          <li class="flex flex-col group/item border-b border-base-200/60 last:border-b-0 py-2">
            <div class="flex items-center justify-between gap-2">
              <span class="text-base-content/70 font-medium group-hover/item:text-base-content transition-colors text-xs leading-snug">
                ${escapeHtml(param.name)}
                <span class="text-3xs opacity-40 font-normal font-mono ml-1">(${param.weight}%)</span>
              </span>
              <span class="badge badge-xs badge-ghost text-base-content/60 text-3xs font-bold gap-1 shrink-0" title="Eximido: Reclamo o Novedad (100% automático)">
                N/A (Reclamo)
              </span>
            </div>
            ${
              comment
                ? `
              <div class="mt-1.5 flex items-start text-xs text-base-content/90 bg-base-200/60 rounded-lg px-2.5 py-1.5 border border-base-300/40">
                <span class="break-words font-sans text-xs text-base-content/80">${escapeHtml(comment)}</span>
              </div>
            `
                : ""
            }
          </li>
        `;
            })
            .join("")
        : s2Params
            .map((param) => {
              const isEvaluated = param.code in call.section2.details;
              const isChecked = isEvaluated
                ? Boolean(call.section2.details[param.code])
                : call.section2.score === 100;
              if (isChecked) s2PassedCount++;

              const isNoCumple = isEvaluated && !isChecked;
              const rowClass = isNoCumple
                ? "bg-error/5 border-l-2 border-l-error pl-2.5 pr-2 py-2 rounded-r-lg transition-colors"
                : "border-b border-base-200/60 last:border-b-0 py-2 transition-colors";

              const weightText = isNoCumple
                ? `<span class="text-3xs font-mono font-bold text-error shrink-0">−${param.weight}%</span>`
                : `<span class="text-3xs font-mono text-base-content/40 shrink-0">${param.weight}%</span>`;

              const comment = call.comments?.[param.code];
              return `
          <li class="flex flex-col group/item ${rowClass}">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs leading-snug font-medium ${isNoCumple ? "text-error font-semibold" : "text-base-content/85 group-hover/item:text-base-content"}">
                ${escapeHtml(param.name)}
              </span>
              ${weightText}
            </div>
            ${
              comment
                ? `
              <div class="mt-1.5 flex items-start text-xs text-base-content/90 bg-base-200/60 rounded-lg px-2.5 py-1.5 border border-base-300/40">
                <span class="break-words font-sans text-xs text-base-content/80">${escapeHtml(comment)}</span>
              </div>
            `
                : ""
            }
          </li>
        `;
            })
            .join("");

    const notesSection = call.notes
      ? `
        <div class="col-span-full">
          <div class="text-3xs font-bold uppercase tracking-wider text-base-content/40 mb-1">Notas / Observaciones de la evaluación</div>
          <p class="text-xs text-base-content/80 whitespace-pre-line bg-base-100 p-2.5 rounded-xl border border-base-200/80">${escapeHtml(call.notes)}</p>
        </div>
      `
      : "";

    // El usuario puede escribir el ticket con o sin "#": anteponerlo siempre
// producía "##1234". Solo se agrega cuando falta.
const formatTicketRef = (ticketId?: string | null, callId?: string | null) => {
  const t = (ticketId || "").trim();
  if (!t || t === "N/A") return callId || "--";
  return t.startsWith("#") ? t : `#${t}`;
};

    const durationTitle =
      call.channelType === "wise_call"
        ? "Duración de llamada"
        : call.channelType === "wise_email"
          ? "Tiempo de respuesta"
          : "Toma / Lectura";
    const durationText =
      call.channelType === "wise_call"
        ? (call.duration || "00:00")
        : call.channelType === "wise_email"
          ? (call.duration || "00:00")
          : (call.takeTime || call.creationTime || "--");

    const channelTag =
      call.channelType === "wise_call"
        ? "Llamada Wise"
        : call.channelType === "wise_email"
          ? "Mail Wise"
          : "Autogestión";

    return `
      <div class="call-card call-card-container rounded-2xl border border-base-200/90 bg-base-100 overflow-hidden shadow-2xs relative group hover:border-base-300 transition-colors" data-call-id="${call.id}">
        
        <!-- Compact Card Header (Clickable Accordion) -->
        <div class="call-card-header flex flex-wrap sm:flex-nowrap items-center justify-between gap-3 p-3.5 cursor-pointer hover:bg-base-200/40 transition-colors select-none">
          <div class="flex flex-wrap items-center gap-2.5 sm:gap-3.5 min-w-0">
            <!-- 1. Resultado / Score -->
            <span class="${totalScoreColor} font-black font-mono text-sm shrink-0 w-11 text-center">
              ${call.totalScore}%
            </span>

            <!-- 2. Duración -->
            <div class="flex items-center gap-1 text-xs font-mono font-bold text-base-content/80 shrink-0" title="${durationTitle}">
              <svg class="size-3.5 opacity-50 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.486 2 2 6.486 2 12s4.486 10 10 10 10-4.486 10-10S17.514 2 12 2zm0 18c-4.411 0-8-3.589-8-8s3.589-8 8-8 8 3.589 8 8-3.589 8-8 8z"/><path d="M13 7h-2v6h5v-2h-3z"/></svg>
              <span>${escapeHtml(durationText)}</span>
            </div>

            <span class="text-base-content/20 text-xs hidden sm:inline">•</span>

            <!-- 3. Ticket / Nro de Caso -->
            <div class="flex items-center gap-1.5 min-w-0">
              <span class="font-mono text-xs font-bold text-base-content truncate">${escapeHtml(formatTicketRef(call.ticketId, call.callId))}</span>
              ${call.isPas ? '<span class="badge badge-secondary badge-xs font-bold uppercase tracking-wider text-3xs px-1.5 py-0.5 shadow-2xs shrink-0">PAS</span>' : ""}
              ${call.callId && call.ticketId && call.callId !== call.ticketId ? `<span class="text-3xs text-base-content/40 font-mono truncate hidden md:inline">(${escapeHtml(call.callId)})</span>` : ""}
            </div>

            <span class="text-base-content/20 text-xs hidden sm:inline">•</span>

            <!-- 4. Fecha -->
            <span class="text-xs text-base-content/50 font-medium shrink-0">
              ${escapeHtml(call.date || "--")}
            </span>

            <span class="badge badge-xs badge-neutral font-medium text-3xs ml-1 shrink-0">
              ${channelTag}
            </span>

            ${
              isReclamo
                ? `<span class="badge badge-xs badge-neutral font-bold uppercase tracking-wide shrink-0" title="Reclamo o novedad: sección de ticket eximida">Reclamo</span>`
                : ""
            }
          </div>

          <!-- Actions: Edit & Expand Chevron -->
          <div class="flex items-center gap-1 shrink-0 ml-auto sm:ml-0">
            ${
              isUserAgent
                ? ""
                : `
            <button 
              type="button"
              class="btn btn-circle btn-ghost btn-xs text-base-content/50 hover:text-secondary edit-audit-btn" 
              data-call-id="${call.id}"
              title="Editar Auditoría"
            >
              <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="m18.988 2.012-3 3L19.988 9.012l3-3zM3.988 17.012v4h4l12.75-12.75-4-4z"/></svg>
            </button>
            `
            }
            <button 
              type="button"
              class="btn btn-circle btn-ghost btn-xs text-base-content/50 hover:text-base-content accordion-toggle-btn"
              title="Expandir / Minimizar detalles"
            >
              <svg class="size-4.5 transition-transform duration-200 accordion-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M16.293 9.293 12 13.586 7.707 9.293l-1.414 1.414L12 16.414l5.707-5.707z"/></svg>
            </button>
          </div>
        </div>
        
        <!-- Details Grid (2 columnas con alto contraste y resumen de sección) -->
        <div class="call-card-details hidden grid md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-base-200/80 bg-base-200/20 border-t border-base-200/80">
          
          <!-- Section 1 -->
          <div class="p-4 sm:p-5">
            <div class="mb-3 flex items-center justify-between border-b border-base-200/80 pb-2">
              <div>
                <h5 class="font-bold text-xs uppercase tracking-wider text-base-content/80">${call.channelType === "wise_call" ? "Interacción con Usuario" : call.channelType === "wise_email" ? "Gestión del Correo" : "Gestión del Caso"}</h5>
                <span class="text-3xs font-semibold text-base-content/50">${s1PassedCount} de ${s1TotalCount} criterios cumplidos</span>
              </div>
              <div class="flex items-baseline gap-1">
                <span class="text-xl font-black font-mono ${s1ScoreColor}">${call.section1.score}</span>
                <span class="text-3xs font-bold text-base-content/40">/${call.section1.maxScore}</span>
              </div>
            </div>
            <ul class="space-y-1 text-xs">
              ${s1ListHTML}
            </ul>
          </div>
          
          <!-- Section 2: el número usa hasSection2Evaluated (no hasSection2) porque un
             reclamo APLICA S2 —y por eso conserva el desglose de parámetros—
             pero no se evaluó criterio a criterio, así que no tiene puntaje que
             mostrar. Reclamo y "no aplica" muestran ambos N/A, pero son
             causas opuestas (decisión del auditor vs ausencia de ticket), así
             que el badge los distingue. -->
          <div class="p-4 sm:p-5 ${s2Evaluated ? "" : "opacity-60"}">
            <div class="mb-3 flex items-center justify-between border-b border-base-200/80 pb-2">
              <div>
                <div class="flex items-center gap-1.5">
                  <h5 class="font-bold text-xs uppercase tracking-wider text-base-content/80">${isReclamo ? (call.channelType === "wise_call" ? "Gestión del Ticket" : "Ticket MDA") : (call.channelType === "wise_call" ? "Gestión del Ticket" : "Ticket MDA")}</h5>
                  ${
                    s2Evaluated
                      ? ""
                      : isReclamo
                        ? `<span class="badge badge-xs badge-neutral font-bold uppercase tracking-wide" title="Reclamo o novedad: eximido de evaluación individual (100% automático)">Reclamo</span>`
                        : `<span class="badge badge-xs badge-ghost font-bold uppercase tracking-wide" title="${call.channelType === "wise_call" ? "No se generó ticket, no hay gestión que evaluar" : call.channelType === "wise_email" ? "El mail no derivó en ticket MDA" : "El caso no quedó en MDA"}">No aplica</span>`
                  }
                </div>
                <span class="text-3xs font-semibold text-base-content/50">${isReclamo ? "Eximido de evaluación individual (100% automático)" : (hasS2 ? `${s2PassedCount} de ${s2TotalCount} criterios cumplidos` : "No aplica evaluación de ticket")}</span>
              </div>
              <div class="flex items-baseline gap-1">
                ${
                  s2Evaluated
                    ? `<span class="text-xl font-black font-mono ${s2ScoreColor}">${call.section2.score}</span>
                <span class="text-3xs font-bold text-base-content/40">/${call.section2.maxScore}</span>`
                    : `<span class="text-xl font-black font-mono text-base-content/40">N/A</span>`
                }
              </div>
            </div>
            <ul class="space-y-1 text-xs">
              ${s2ListHTML}
            </ul>
          </div>

          <!-- Notes / Observaciones -->
          <div class="col-span-full p-4 sm:p-5 border-t border-base-200/80 bg-base-200/40">
            ${notesSection}
            ${!call.notes ? '<p class="text-3xs text-base-content/40 italic">Sin observaciones o notas registradas para esta evaluación.</p>' : ""}
          </div>

        </div>
      </div>
    `;
  }

  function initQualityMasterDetail() {
    const rootContainer =
      document.getElementById("operators-grid") ||
      document.getElementById("operator-details-panel");
    if (!rootContainer) return false;
    if (rootContainer.dataset.masterDetailBound === "true") return true;
    rootContainer.dataset.masterDetailBound = "true";

    // El sorter es idempotente por `data-table-sort-bound`, así que repetir el
    // bind cuando la island vuelve a streamear no duplica listeners.
    bindClientTableSort();

    let currentActiveChannel = "wise_call";

    const detailsModal = document.getElementById(
      "operator-details-modal",
    ) as HTMLDialogElement | null;

    const monthSelector = document.getElementById(
      "month-selector",
    ) as HTMLSelectElement | null;
    const btnPrevMonth = document.getElementById(
      "btn-prev-month",
    ) as HTMLButtonElement | null;
    const btnNextMonth = document.getElementById(
      "btn-next-month",
    ) as HTMLButtonElement | null;

    const updateMonthButtonsState = () => {
      if (!monthSelector) return;
      const idx = monthSelector.selectedIndex;
      const totalOptions = monthSelector.options.length;

      if (btnPrevMonth) {
        const canGoPrev = idx < totalOptions - 1;
        btnPrevMonth.disabled = !canGoPrev;
        if (!canGoPrev) {
          btnPrevMonth.classList.add("opacity-50");
        } else {
          btnPrevMonth.classList.remove("opacity-50");
        }
      }

      if (btnNextMonth) {
        const canGoNext = idx > 0;
        btnNextMonth.disabled = !canGoNext;
        if (!canGoNext) {
          btnNextMonth.classList.add("opacity-50");
        } else {
          btnNextMonth.classList.remove("opacity-50");
        }
      }
    };

    if (monthSelector) {
      monthSelector.addEventListener("change", (e) => {
        const select = e.target as HTMLSelectElement;
        const url = new URL(window.location.href);
        url.searchParams.set("month", select.value);
        if (activeAgentId) {
          url.searchParams.set("agentId", activeAgentId);
        } else {
          url.searchParams.delete("agentId");
        }
        window.location.href = url.toString();
      });

      updateMonthButtonsState();

      if (btnPrevMonth) {
        btnPrevMonth.addEventListener("click", () => {
          if (monthSelector.selectedIndex < monthSelector.options.length - 1) {
            monthSelector.selectedIndex += 1;
            monthSelector.dispatchEvent(new Event("change"));
          }
        });
      }

      if (btnNextMonth) {
        btnNextMonth.addEventListener("click", () => {
          if (monthSelector.selectedIndex > 0) {
            monthSelector.selectedIndex -= 1;
            monthSelector.dispatchEvent(new Event("change"));
          }
        });
      }
    }

    const dAvatar = document.getElementById("detail-avatar");
    const dName = document.getElementById("detail-name");
    const dId = document.getElementById("detail-id");
    const dMonth = document.getElementById("detail-month");
    const dScore = document.getElementById("detail-score");
    const dStatDiff = document.getElementById("detail-stat-diff");
    const dStatAht = document.getElementById("detail-stat-aht");
    const dStatChannel = {
      wise_call: document.getElementById("detail-stat-wise_call"),
      wise_email: document.getElementById("detail-stat-wise_email"),
      invgate_ticket: document.getElementById("detail-stat-invgate_ticket"),
    };
    const dMonthSummary = document.getElementById("detail-month-summary");
    const dMonthSummaryEmpty = document.getElementById(
      "detail-month-summary-empty",
    );
    const callsContainer = document.getElementById("detail-calls-container");
    const btnBack = document.getElementById("btn-back-to-summary");

    // Month Summary Modal elements
    const summaryModal = document.getElementById(
      "month-summary-modal",
    ) as HTMLDialogElement;
    const summaryForm = document.getElementById(
      "month-summary-form",
    ) as HTMLFormElement;
    const summaryAgentId = document.getElementById(
      "summary-agent-id",
    ) as HTMLInputElement;
    const summaryContent = document.getElementById(
      "summary-content",
    ) as HTMLTextAreaElement;
    const btnCloseSummaryModal = document.getElementById(
      "btn-close-summary-modal",
    ) as HTMLButtonElement;
    const btnEditMonthSummary = document.getElementById(
      "btn-edit-month-summary",
    ) as HTMLButtonElement;

    let activeAgentId = "";
    let activeAgentSummary = "";

    function clearFormErrors(form: HTMLFormElement) {
      form
        .querySelectorAll(".input, .textarea, .checkbox, .select")
        .forEach((el) => {
          el.classList.remove(
            "input-error",
            "textarea-error",
            "checkbox-error",
            "select-error",
          );
        });
      form.querySelectorAll(".field-error-msg").forEach((el) => el.remove());
    }

    interface FormValidationError {
      issues?: Array<{
        path: Array<string | number>;
        message: string;
      }>;
      message?: string;
    }

    function showFormErrors(
      form: HTMLFormElement,
      error: FormValidationError | null | undefined,
    ) {
      clearFormErrors(form);
      if (!error) return;

      const issues = error.issues || [];
      let firstErrorElement: HTMLElement | null = null;

      issues.forEach((issue) => {
        const fieldName = issue.path[0];
        if (!fieldName) return;

        const input = form.querySelector(
          `[name="${fieldName}"]`,
        ) as HTMLElement;
        if (input) {
          if (input.classList.contains("textarea")) {
            input.classList.add("textarea-error");
          } else if (input.classList.contains("checkbox")) {
            input.classList.add("checkbox-error");
          } else if (input.classList.contains("select")) {
            input.classList.add("select-error");
          } else {
            input.classList.add("input-error");
          }

          const errContainer = input.closest("[data-field]");
          if (errContainer) {
            const errMsg = document.createElement("span");
            errMsg.className =
              "text-error text-xs font-bold mt-1 field-error-msg";
            errMsg.textContent = issue.message;
            errContainer.appendChild(errMsg);
          }

          if (!firstErrorElement) {
            firstErrorElement = input;
          }
        }
      });

      if (firstErrorElement) {
        (firstErrorElement as HTMLElement).focus();
      } else {
        alert(error.message || "Error de validación en el formulario.");
      }
    }

    // open modal for editing or new audit
    // Attach "Nueva Auditoría" button listener
    const btnNewAudit = document.getElementById("btn-new-audit");
    if (btnNewAudit) {
      btnNewAudit.addEventListener("click", () => {
        const monthVal = monthSelector?.value || "";
        if (activeAgentId) {
          window.location.href = `${cleanBase}supervision/calidad-operadores/nueva?agentId=${encodeURIComponent(activeAgentId)}&month=${encodeURIComponent(monthVal)}`;
        } else {
          window.location.href = `${cleanBase}supervision/calidad-operadores/nueva?month=${encodeURIComponent(monthVal)}`;
        }
      });
    }

    // Submit form using Astro Actions
    // Handle Month Summary Modal
    const openMonthSummaryModal = () => {
      if (activeAgentId) {
        summaryForm.reset();
        clearFormErrors(summaryForm);
        summaryAgentId.value = activeAgentId;
        summaryContent.value = activeAgentSummary;
        summaryModal.showModal();
      }
    };

    const btnAddObsPlaceholder = document.getElementById("btn-add-observation-placeholder");
    if (btnAddObsPlaceholder) {
      btnAddObsPlaceholder.addEventListener("click", openMonthSummaryModal);
    }

    if (dMonthSummary) {
      dMonthSummary.addEventListener("click", openMonthSummaryModal);
    }

    if (btnCloseSummaryModal) {
      btnCloseSummaryModal.addEventListener("click", () => {
        summaryModal.close();
      });
    }

    summaryForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      clearFormErrors(summaryForm);

      const btnSubmit = summaryForm.querySelector(
        'button[type="submit"]',
      ) as HTMLButtonElement;
      const originalText = btnSubmit.innerHTML;
      btnSubmit.disabled = true;
      btnSubmit.innerHTML =
        '<span class="loading loading-spinner loading-xs"></span> Guardando…';

      const formData = new FormData(summaryForm);
      // Ensure summary is always present (even if textarea is empty)
      if (!formData.has("summary")) {
        formData.set("summary", "");
      }
      try {
        const result = await actions.saveMonthSummary(formData);
        if (result.error) {
          console.error("Validation error:", result.error);
          showFormErrors(summaryForm, result.error);
        } else if (result.data?.success) {
          const url = new URL(window.location.href);
          if (activeAgentId) {
            url.searchParams.set("agentId", activeAgentId);
          }
          url.searchParams.set(
            "toast_msg",
            "Observaciones del mes guardadas con éxito.",
          );
          url.searchParams.set("toast_type", "success");
          window.location.href = url.toString();
        } else {
          (window as any).showToast?.(
            "Error al guardar el resumen.",
            "alert-error",
          );
        }
      } catch (error) {
        console.error(error);
        (window as any).showToast?.(
          "Ocurrió un error inesperado al guardar el resumen.",
          "alert-error",
        );
      } finally {
        btnSubmit.disabled = false;
        btnSubmit.innerHTML = originalText;
      }
    });

    // Delete audit using Astro Actions
    const clearAgentFromUrl = () => {
      activeAgentId = "";
      const currentUrl = new URL(window.location.href);
      if (currentUrl.searchParams.has("agentId")) {
        currentUrl.searchParams.delete("agentId");
        window.history.replaceState({}, "", currentUrl.toString());
      }
    };

    if (detailsModal) {
      detailsModal.addEventListener("close", () => {
        clearAgentFromUrl();
      });
    }

    if (btnBack) {
      btnBack.addEventListener("click", () => {
        if (detailsModal && typeof detailsModal.close === "function") {
          detailsModal.close();
        }
      });
    }

    let searchInput = document.getElementById(
      "operator-search",
    ) as HTMLInputElement | null;
    const noResultsMsg = document.getElementById("calidad-empty-state");

    const updateOperatorsList = () => {
      const term = searchInput?.value.toLowerCase().trim() || "";
      let hasVisibleItems = false;

      const cards = Array.from(
        document.querySelectorAll(".operator-card"),
      ) as HTMLElement[];

      cards.forEach((card) => {
        const name = card.getAttribute("data-name") || "";
        const id = card.getAttribute("data-id") || "";
        const username = card.getAttribute("data-username") || "";

        const matchesSearch =
          !term ||
          name.includes(term) ||
          id.includes(term) ||
          username.includes(term);

        if (matchesSearch) {
          card.classList.remove("hidden");
          hasVisibleItems = true;
        } else {
          card.classList.add("hidden");
        }
      });

      if (!hasVisibleItems && noResultsMsg) {
        noResultsMsg.classList.remove("hidden");
        noResultsMsg.classList.add("flex");
      } else if (noResultsMsg) {
        noResultsMsg.classList.add("hidden");
        noResultsMsg.classList.remove("flex");
      }
    };

    if (searchInput) {
      searchInput.addEventListener("input", updateOperatorsList);
    }

    const displayOperatorDetails = (operatorId: string) => {
      const operator = getOperatorFullData(operatorId) as OperatorQuality | null;
      if (!operator) return;
      activeAgentId = operator.id;

      if (dAvatar)
        dAvatar.textContent = operator.name
          .split(" ")
          .map((n: string) => n[0])
          .join("")
          .substring(0, 2);
      if (dName) dName.textContent = operator.name;
      if (dId) dId.textContent = `@${operator.username || operator.id}`;
      if (dMonth) dMonth.textContent = formatMonthLabel(operator.month);

      if (dScore) {
        dScore.textContent = `${operator.averageScore}%`;
        dScore.className = `text-2xl sm:text-3xl font-black font-mono tracking-tight leading-none ${operator.averageScore >= 90 ? "text-success" : operator.averageScore >= 80 ? "text-warning" : "text-error"}`;
      }

      if (dStatDiff) {
        const currentScore = operator.averageScore;
        const prevScore = operator.prevAverageScore || 0;
        const hasPrevAudits = (operator.prevCallsCount ?? 0) > 0;

        if (hasPrevAudits) {
          const diff = currentScore - prevScore;
          if (diff > 0) {
            dStatDiff.textContent = `+${diff}%`;
            dStatDiff.className = "text-base sm:text-lg font-black font-mono mt-0.5 text-success";
          } else if (diff < 0) {
            dStatDiff.textContent = `${diff}%`;
            dStatDiff.className = "text-base sm:text-lg font-black font-mono mt-0.5 text-error";
          } else {
            dStatDiff.textContent = "0%";
            dStatDiff.className = "text-base sm:text-lg font-black font-mono mt-0.5 text-base-content/60";
          }
        } else {
          dStatDiff.textContent = "Sin datos";
          dStatDiff.className = "text-base sm:text-lg font-black font-mono mt-0.5 text-base-content/40";
        }
      }

      if (dStatAht) {
        const allAudits = operator.calls || [];
        const callAudits = allAudits.filter(
          (c: any) =>
            (c.channelType || "wise_call") === "wise_call" &&
            c.duration &&
            c.duration !== "00:00",
        );
        if (callAudits.length > 0) {
          const parseDurationToSeconds = (durStr: string) => {
            if (!durStr) return 0;
            const parts = durStr.split(":").map(Number);
            if (parts.length === 2) {
              return parts[0] * 60 + parts[1];
            } else if (parts.length === 3) {
              return parts[0] * 3600 + parts[1] * 60 + parts[2];
            }
            return 0;
          };
          const formatSecondsToDuration = (totalSecs: number) => {
            // Redondear los segundos por separado podía dar 60 ("01:60"): el
            // redondeo tiene que cascada al minuto.
            const total = Math.round(totalSecs);
            const m = Math.floor(total / 60);
            const s = total % 60;
            return `${m.toString().padStart(2, "0")}:${s.toString().padStart(2, "0")}`;
          };
          const totalSecs = callAudits.reduce(
            (acc: number, c: any) => acc + parseDurationToSeconds(c.duration),
            0,
          );
          const avgSecs = totalSecs / callAudits.length;
          dStatAht.textContent = formatSecondsToDuration(avgSecs);
          dStatAht.className = "text-base sm:text-lg font-black font-mono mt-0.5 text-base-content";
        } else {
          dStatAht.textContent = "Sin datos";
          dStatAht.className = "text-base sm:text-lg font-black font-mono mt-0.5 text-base-content/40";
        }
      }

      const channelAverages = calculateChannelAverages(
        (operator.calls || []) as any[],
      );

      type ChannelKey = keyof typeof dStatChannel;
      const channelStats: Array<[ChannelKey, number | null]> = [
        ["wise_call", channelAverages.wiseCallsAvg],
        ["wise_email", channelAverages.wiseEmailsAvg],
        ["invgate_ticket", channelAverages.invgateAgAvg],
      ];

      channelStats.forEach(([channel, avg]) => {
        const el = dStatChannel[channel];
        if (!el) return;
        el.textContent = formatChannelAverageScore(avg);
        el.className = `text-base sm:text-lg font-black font-mono mt-0.5 ${getChannelAverageTextClass(avg)}`;
      });

      activeAgentSummary = operator.monthSummary || "";
      if (dMonthSummary) dMonthSummary.textContent = activeAgentSummary;
      if (dMonthSummaryEmpty) {
        if (activeAgentSummary) {
          dMonthSummaryEmpty.classList.add("hidden");
        } else {
          dMonthSummaryEmpty.classList.remove("hidden");
        }
      }

      const historyContainer = document.getElementById("detail-history-chart");
      if (historyContainer) {
        const points = (operator.history || []) as Array<{ month: string; label: string; count: number; score: number }>;
        if (points.length < 2) {
          historyContainer.className = "flex flex-col items-center justify-center min-h-[5.5rem] py-2 text-center text-base-content/40";
          historyContainer.innerHTML = `
            <svg class="size-5 mb-1 opacity-40 text-base-content shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.486 2 2 6.486 2 12s4.486 10 10 10 10-4.486 10-10S17.514 2 12 2zm0 18c-4.411 0-8-3.589-8-8s3.589-8 8-8 8 3.589 8 8-3.589 8-8 8z"/>
              <path d="M11 11h2v6h-2zm0-4h2v2h-2z"/>
            </svg>
            <span class="text-xs font-semibold">Sin datos suficientes para mostrar la tendencia</span>
            <span class="text-3xs text-base-content/40 mt-0.5">Se requieren al menos 2 meses con evaluaciones</span>
          `;
        } else {
          // Ancho y alto acotados y proporcionales (sin deformación de aspecto)
          const width = 260;
          const height = 50;
          const paddingX = 14;
          const paddingY = 8;
          const usableWidth = width - paddingX * 2;
          const usableHeight = height - paddingY * 2;

          // Escala dinámica Y para visibilidad real de pendiente
          const allScores = points.map((p) => p.score);
          const minScore = Math.min(...allScores);
          const maxScore = Math.max(...allScores);
          const yMin = Math.max(0, Math.min(minScore - 6, 75));
          const yMax = Math.min(100, Math.max(maxScore + 2, 100));
          const yRange = yMax - yMin || 20;

          const coords = points.map((item, i) => {
            const x = paddingX + (i / (points.length - 1)) * usableWidth;
            const normalized = (item.score - yMin) / yRange;
            const y = height - paddingY - normalized * usableHeight;
            return { x, y, score: item.score, label: item.label };
          });

          const pathD = coords
            .map((c, i) => (i === 0 ? `M ${c.x.toFixed(1)},${c.y.toFixed(1)}` : `L ${c.x.toFixed(1)},${c.y.toFixed(1)}`))
            .join(" ");

          const firstPoint = coords[0];
          const lastPoint = coords[coords.length - 1];
          const areaD = `${pathD} L ${lastPoint.x.toFixed(1)},${height} L ${firstPoint.x.toFixed(1)},${height} Z`;

          // Contenedor acotado y centrado (máximo ~280px) para evitar aspecto estirado horizontalmente
          historyContainer.className = "w-full max-w-[280px] sm:max-w-[300px] mx-auto flex flex-col items-center justify-center py-0.5";
          historyContainer.innerHTML = `
             <div class="relative w-full h-[54px]">
               <svg class="w-full h-full overflow-visible" viewBox="0 0 ${width} ${height}">
                 <defs>
                   <linearGradient id="trend-area-grad" x1="0" y1="0" x2="0" y2="1">
                     <stop offset="0%" stop-color="var(--color-secondary, #3b82f6)" stop-opacity="0.22" />
                     <stop offset="100%" stop-color="var(--color-secondary, #3b82f6)" stop-opacity="0.0" />
                   </linearGradient>
                 </defs>
                 <path d="${areaD}" fill="url(#trend-area-grad)" />
                 <path d="${pathD}" fill="none" stroke="currentColor" stroke-width="2.5" class="text-secondary drop-shadow-2xs" stroke-linecap="round" stroke-linejoin="round" />
                 ${coords
                   .map(
                     (c, i) => `
                   <circle cx="${c.x.toFixed(1)}" cy="${c.y.toFixed(1)}" r="${i === points.length - 1 ? "4.5" : "3.5"}" fill="currentColor" class="${i === points.length - 1 ? "text-secondary" : "text-base-100"} stroke-secondary stroke-2" />
                 `,
                   )
                   .join("")}
               </svg>
             </div>
             <div class="w-full flex justify-between mt-1 px-1 text-3xs font-mono font-bold text-base-content/60 select-none">
                ${points.map((p) => `<div class="flex flex-col items-center"><span class="text-3xs uppercase tracking-wider opacity-60 font-sans">${p.label}</span><strong class="text-secondary font-mono">${p.score}%</strong></div>`).join("")}
             </div>
           `;
        }
      }

      const insightsContainer = document.getElementById("detail-insights");
      const insightsCard = document.getElementById("detail-card-insights");
      const insightsTitle = document.getElementById("detail-insights-title-text");
      const insightsIconContainer = document.getElementById("detail-insights-icon-container");
      const insightsBadge = document.getElementById("detail-insights-badge");

      if (insightsContainer && operator.calls) {
        const failures: Record<string, number> = {};

        operator.calls.forEach((c) => {
          Object.entries(c.section1.details).forEach(([key, val]) => {
            if (!val) failures[key] = (failures[key] || 0) + 1;
          });
          // Los reclamos se eximen de S2 con 100% automático, pero el action
          // persiste sus parámetros sin evaluar: contarlos como fallos
          // reportaba "Áreas de Mejora" en auditorías que la app marca 100%.
          if (hasSection2Evaluated(c)) {
            Object.entries(c.section2.details).forEach(([key, val]) => {
              if (!val) failures[key] = (failures[key] || 0) + 1;
            });
          }
        });

        const sortedFailures = Object.entries(failures)
          .sort((a, b) => b[1] - a[1])
          .slice(0, 2);

        if (operator.calls.length === 0) {
          if (insightsTitle) insightsTitle.textContent = "Resumen de Calidad";
          if (insightsCard) {
            insightsCard.classList.remove("border-warning/30");
            insightsCard.classList.add("border-base-200/80");
          }
          if (insightsBadge) {
            insightsBadge.className = "badge badge-xs badge-neutral font-bold";
            insightsBadge.textContent = "Sin auditorías";
          }
          if (insightsIconContainer) {
            insightsIconContainer.innerHTML = `<svg class="size-4 text-base-content/50" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.486 2 2 6.486 2 12s4.486 10 10 10 10-4.486 10-10S17.514 2 12 2zm0 18c-4.411 0-8-3.589-8-8s3.589-8 8-8 8 3.589 8 8-3.589 8-8 8z"/><path d="M11 11h2v6h-2zm0-4h2v2h-2z"/></svg>`;
          }
          insightsContainer.innerHTML = `<li class="text-base-content/50 italic text-xs py-2 text-center">No hay auditorías registradas en este período.</li>`;
        } else if (sortedFailures.length > 0) {
          if (insightsTitle) insightsTitle.textContent = "Áreas de Mejora Detectadas";
          if (insightsCard) {
            insightsCard.classList.remove("border-base-200/80");
            insightsCard.classList.add("border-secondary/30");
          }
          if (insightsBadge) {
            insightsBadge.className = "badge badge-xs badge-secondary font-bold";
            insightsBadge.textContent = `${sortedFailures.length} área${sortedFailures.length > 1 ? "s" : ""}`;
          }
          if (insightsIconContainer) {
            insightsIconContainer.innerHTML = `<svg class="size-4 text-secondary" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 1 21h22L12 2zm0 3.99 7.53 13.01H4.47L12 5.99zM11 10h2v4h-2zm0 6h2v2h-2z"/></svg>`;
          }
          const params: AuditParameter[] = getAuditParameters();
          const paramNameMap = new Map<string, string>(
            params.map((p) => [p.code, p.name]),
          );

          insightsContainer.innerHTML = sortedFailures
            .map(
              ([key, count]) => `
             <li class="flex items-center justify-between gap-2 bg-secondary/10 border border-secondary/20 rounded-xl px-3 py-2 text-xs">
               <div class="flex items-center gap-2 min-w-0">
                 <svg class="size-4 text-secondary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M10.707 17.707 16.414 12l-5.707-5.707-1.414 1.414L13.586 12l-4.293 4.293z"/></svg>
                 <span class="text-base-content/80 font-medium truncate">${escapeHtml(paramNameMap.get(key) || key)}</span>
               </div>
               <span class="badge badge-secondary badge-sm font-mono font-bold shrink-0">${count} fallo${count > 1 ? "s" : ""}</span>
             </li>
           `,
            )
            .join("");
        } else {
          if (insightsTitle) insightsTitle.textContent = "Resumen de Calidad";
          if (insightsCard) {
            insightsCard.classList.remove("border-warning/30");
            insightsCard.classList.add("border-base-200/80");
          }
          if (insightsBadge) {
            insightsBadge.className = "badge badge-xs badge-secondary font-bold";
            insightsBadge.textContent = "100% Óptimo";
          }
          if (insightsIconContainer) {
            insightsIconContainer.innerHTML = `<svg class="size-4 text-secondary" viewBox="0 0 24 24" fill="currentColor"><path d="m10 15.586-3.293-3.293-1.414 1.414L10 18.414l9.707-9.707-1.414-1.414z"/></svg>`;
          }
          insightsContainer.innerHTML = `
            <li class="flex items-center gap-2.5 bg-secondary/10 border border-secondary/20 rounded-xl p-3 text-xs text-secondary">
              <svg class="size-4 text-secondary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M21.947 9.179a1.001 1.001 0 0 0-.868-.676l-5.701-.453-2.467-5.461a.998.998 0 0 0-1.822-.001L8.622 8.05l-5.701.453a1 1 0 0 0-.619 1.713l4.214 4.107-1.29 5.71a1.001 1.001 0 0 0 1.451 1.054L12 18.26l5.324 2.827a1.002 1.002 0 0 0 1.45-1.054l-1.29-5.71 4.214-4.107a1 1 0 0 0 .249-1.037z"/></svg>
              <div>
                <span class="font-bold text-secondary block">¡Rendimiento impecable!</span>
                <span class="text-3xs text-base-content/60 font-normal">No se detectaron fallas en las auditorías evaluadas.</span>
              </div>
            </li>
          `;
        }
      }

      currentActiveChannel = "all";

      const updateChannelTabsAndList = () => {
        const allAudits = operator.calls || [];
        const wiseCalls = allAudits.filter(
          (c: any) => (c.channelType || "wise_call") === "wise_call",
        );
        const wiseEmails = allAudits.filter(
          (c: any) => c.channelType === "wise_email",
        );
        const invgateAgs = allAudits.filter(
          (c: any) => c.channelType === "invgate_ticket",
        );

        const bAll = document.getElementById("tab-count-all");
        const bCall = document.getElementById("tab-count-wise_call");
        const bEmail = document.getElementById("tab-count-wise_email");
        const bAg = document.getElementById("tab-count-invgate_ticket");

        if (bAll) bAll.textContent = `${allAudits.length}`;
        if (bCall) bCall.textContent = `${wiseCalls.length}/4`;
        if (bEmail) bEmail.textContent = `${wiseEmails.length}/4`;
        if (bAg) bAg.textContent = `${invgateAgs.length}/4`;

        let filteredCalls: QualityCall[] = [];
        let channelEmptyMsg = "";

        if (currentActiveChannel === "all") {
          filteredCalls = allAudits;
          channelEmptyMsg =
            "No hay evaluaciones registradas para este operador en este mes.";
        } else if (currentActiveChannel === "wise_call") {
          filteredCalls = wiseCalls;
          channelEmptyMsg =
            "No hay llamadas Wise registradas para este operador en este mes.";
        } else if (currentActiveChannel === "wise_email") {
          filteredCalls = wiseEmails;
          channelEmptyMsg =
            "No hay correos Wise registrados para este operador en este mes.";
        } else {
          filteredCalls = invgateAgs;
          channelEmptyMsg =
            "No hay autogestiones registradas para este operador en este mes.";
        }

        if (callsContainer) {
          if (filteredCalls.length === 0) {
            callsContainer.innerHTML = `
              <div class="col-span-full py-8 text-center bg-base-200/40 rounded-2xl border border-base-200/80">
                <p class="text-xs text-base-content/50">${channelEmptyMsg}</p>
              </div>
            `;
          } else {
            callsContainer.innerHTML = filteredCalls
              .map((c, idx) => renderCallCard(c, idx))
              .join("");

            // Acordeón Exclusivo: máximo una auditoría abierta simultáneamente
            callsContainer
              .querySelectorAll(".call-card-header")
              .forEach((trigger) => {
                trigger.addEventListener("click", (e) => {
                  if ((e.target as HTMLElement).closest(".edit-audit-btn")) return;
                  const card = (trigger as HTMLElement).closest(".call-card-container");
                  if (!card) return;
                  const details = card.querySelector(".call-card-details");
                  const arrow = card.querySelector(".accordion-arrow");
                  const isCurrentlyOpen = details && !details.classList.contains("hidden");

                  // Cerrar cualquier otra auditoría abierta
                  callsContainer.querySelectorAll(".call-card-container").forEach((otherCard) => {
                    otherCard.querySelector(".call-card-details")?.classList.add("hidden");
                    otherCard.querySelector(".accordion-arrow")?.classList.remove("rotate-180");
                  });

                  // Si la actual estaba cerrada, abrirla; si ya estaba abierta, queda cerrada
                  if (!isCurrentlyOpen && details) {
                    details.classList.remove("hidden");
                    arrow?.classList.add("rotate-180");
                  }
                });
              });

            // Botón de Edición
            callsContainer
              .querySelectorAll(".edit-audit-btn")
              .forEach((btn) => {
                btn.addEventListener("click", (e) => {
                  e.stopPropagation();
                  const callIdStr =
                    btn.getAttribute("data-call-id") ||
                    (btn.closest(".call-card-container") as HTMLElement)?.getAttribute("data-call-id");
                  if (callIdStr) {
                    const monthVal = monthSelector?.value || "";
                    const url = new URL(`${window.location.origin}${cleanBase}supervision/calidad-operadores/nueva`);
                    url.searchParams.set("auditId", callIdStr);
                    url.searchParams.set("agentId", operator.id);
                    if (monthVal) url.searchParams.set("month", monthVal);
                    window.location.href = url.toString();
                  }
                });
              });
          }
        }
      };

      document.querySelectorAll(".operator-channel-tab").forEach((tabBtn) => {
        tabBtn.onclick = () => {
          document
            .querySelectorAll(".operator-channel-tab")
            .forEach((b) => b.classList.remove("tab-active"));
          tabBtn.classList.add("tab-active");
          currentActiveChannel =
            tabBtn.getAttribute("data-channel") || "all";
          updateChannelTabsAndList();
        };
      });

      document.querySelectorAll(".operator-channel-tab").forEach((b) => {
        b.classList.toggle(
          "tab-active",
          b.getAttribute("data-channel") === "all",
        );
      });
      currentActiveChannel = "all";
      updateChannelTabsAndList();
    };

    // Attach click listeners to operator cards
    document.querySelectorAll(".operator-card").forEach((card) => {
      card.addEventListener("click", () => {
        const opId = card.getAttribute("data-operator-id");
        if (!opId) return;
        const exportDropdown = document.getElementById("operator-export-dropdown");
        if (exportDropdown) {
          exportDropdown.removeAttribute("open");
        }
        displayOperatorDetails(opId);
        if (detailsModal) {
          detailsModal.showModal();
        }
      });
    });

    // --- PARAMETERS CONFIGURATION MODAL ---
    const parametersModal = document.getElementById(
      "parameters-modal",
    ) as HTMLDialogElement;
    const btnConfigureParameters = document.getElementById(
      "btn-configure-parameters",
    );
    const btnCloseParametersModal = document.getElementById(
      "btn-close-parameters-modal",
    );
    const btnAddParam = document.getElementById("btn-add-param");
    const btnAddParamS1 = document.getElementById("btn-add-param-s1");
    const btnAddParamS2 = document.getElementById("btn-add-param-s2");

    let localParams: any[] = [];
    let activeParamChannel: string = "wise_call";
    let activeParamTab: "s1" | "s2" = "s1";

    const channelLabels: Record<string, { s1: string; s2: string; addS1: string; addS2: string }> = {
      wise_call: {
        s1: "Interacción con Usuario",
        s2: "Gestión del Ticket",
        addS1: "Agregar a Interacción",
        addS2: "Agregar a Gestión",
      },
      wise_email: {
        s1: "Gestión de Correo",
        s2: "Ticket MDA",
        addS1: "Agregar a Correo",
        addS2: "Agregar a Ticket MDA",
      },
      invgate_ticket: {
        s1: "Gestión del Caso",
        s2: "Ticket MDA",
        addS1: "Agregar a Caso",
        addS2: "Agregar a Ticket MDA",
      },
    };

    const isMatchingChannel = (p: any) => {
      const ch = p.channel || "wise_call";
      return ch === activeParamChannel;
    };

    const isS1 = (p: any) => {
      return (
        p.section === "items" ||
        p.category === "Items" ||
        p.category === "Interacción con Usuario"
      );
    };

    const isS2 = (p: any) => {
      return (
        p.section === "ticket" ||
        p.section === "mda" ||
        p.category === "Gestión del Ticket" ||
        p.category === "Ticket" ||
        p.category === "MDA"
      );
    };

    function updateParamTabLabels() {
      const labels = channelLabels[activeParamChannel] || channelLabels.wise_call;
      const tab1Btn = document.getElementById("param-tab-s1-btn");
      const tab2Btn = document.getElementById("param-tab-s2-btn");

      if (tab1Btn) tab1Btn.textContent = labels.s1;
      if (tab2Btn) tab2Btn.textContent = labels.s2;
    }

    function updateParamSummary() {
      const summaryCountEl = document.getElementById("param-summary-count");
      const summaryWeightEl = document.getElementById("param-summary-weight");
      const summaryBadgeEl = document.getElementById("param-summary-badge");
      if (!summaryCountEl || !summaryWeightEl || !summaryBadgeEl) return;

      const currentActive = localParams.filter(
        (p) =>
          !p.isDeleted &&
          isMatchingChannel(p) &&
          (activeParamTab === "s1" ? isS1(p) : isS2(p)),
      );
      const count = currentActive.length;
      const totalWeight =
        Math.round(
          currentActive.reduce(
            (sum, p) => sum + (parseFloat(p.weight) || 0),
            0,
          ) * 10,
        ) / 10;

      summaryCountEl.textContent = `${count} criterio${count === 1 ? "" : "s"}`;
      summaryWeightEl.textContent = `Peso total: ${totalWeight}%`;

      if (count > 0 && Math.abs(totalWeight - 100) < 0.05) {
        summaryBadgeEl.className =
          "inline-flex items-center gap-2 px-2.5 py-1 rounded-lg text-xs font-semibold bg-success/15 text-success border border-success/30 shrink-0 self-start sm:self-auto transition-colors";
        summaryBadgeEl.title = "Distribución perfecta: la suma da exactamente 100%";
        summaryCountEl.className = "font-bold text-success";
        summaryWeightEl.className = "font-mono font-bold text-success";
      } else if (totalWeight > 100) {
        summaryBadgeEl.className =
          "inline-flex items-center gap-2 px-2.5 py-1 rounded-lg text-xs font-semibold bg-error/15 text-error border border-error/30 shrink-0 self-start sm:self-auto transition-colors";
        summaryBadgeEl.title = `Atención: los criterios suman ${totalWeight}%. Al superar el 100%, se penaliza de más al operador ante cualquier falta.`;
        summaryCountEl.className = "font-bold text-error";
        summaryWeightEl.className = "font-mono font-bold text-error";
      } else {
        summaryBadgeEl.className =
          "inline-flex items-center gap-2 px-2.5 py-1 rounded-lg text-xs font-semibold bg-warning/20 text-warning-content border border-warning/40 shrink-0 self-start sm:self-auto transition-colors";
        summaryBadgeEl.title = `Configuración incompleta: los criterios suman ${totalWeight}%. Faltan ítems o puntos para llegar al 100%.`;
        summaryCountEl.className = "font-bold text-warning-content";
        summaryWeightEl.className = "font-mono font-bold text-warning-content";
      }
    }

    // Channel buttons in parameters modal
    document.querySelectorAll(".param-channel-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const ch = btn.getAttribute("data-channel");
        if (!ch) return;
        activeParamChannel = ch;

        document.querySelectorAll(".param-channel-btn").forEach((b) => {
          b.classList.remove("btn-active", "bg-secondary", "text-secondary-content", "font-bold", "shadow-2xs");
          b.classList.add("bg-transparent", "font-medium", "text-base-content/70", "hover:text-secondary", "hover:bg-base-100/60");
        });
        btn.classList.add("btn-active", "bg-secondary", "text-secondary-content", "font-bold", "shadow-2xs");
        btn.classList.remove("bg-transparent", "font-medium", "text-base-content/70", "hover:bg-base-100/60");

        updateParamTabLabels();
        renderParametersList();
      });
    });

    if (btnConfigureParameters) {
      btnConfigureParameters.addEventListener("click", () => {
        localParams = getAuditParameters().map((p: any) => ({
          ...p,
          channel: p.channel || "wise_call",
          section: p.section || (p.category === "Gestión del Ticket" ? "ticket" : "items"),
          isDeleted: false,
        }));

        activeParamChannel = "wise_call";
        activeParamTab = "s1";

        const chBtns = document.querySelectorAll(".param-channel-btn");
        chBtns.forEach((b) => {
          b.classList.remove("btn-active", "bg-secondary", "text-secondary-content", "font-bold", "shadow-2xs");
          b.classList.add("bg-transparent", "font-medium", "text-base-content/70", "hover:text-secondary", "hover:bg-base-100/60");
        });
        chBtns[0]?.classList.add("btn-active", "bg-secondary", "text-secondary-content", "font-bold", "shadow-2xs");
        chBtns[0]?.classList.remove("bg-transparent", "font-medium", "text-base-content/70", "hover:bg-base-100/60");

        // Reset tabs to S1
        const tabs = document.querySelectorAll(".parameter-tab");
        tabs.forEach((t) => t.classList.remove("tab-active"));
        tabs[0]?.classList.add("tab-active");

        document.getElementById("param-list-s1")?.classList.remove("hidden");
        document.getElementById("param-list-s2")?.classList.add("hidden");

        updateParamTabLabels();
        renderParametersList();
        parametersModal.showModal();
      });
    }

    if (btnCloseParametersModal) {
      btnCloseParametersModal.addEventListener("click", () => {
        parametersModal.close();
      });
    }

    const handleAddParam = (section: "items" | "ticket" | "mda") => {
      const category =
        section === "items"
          ? (activeParamChannel === "wise_call" ? "Interacción con Usuario" : "Items")
          : (activeParamChannel === "wise_call" ? "Gestión del Ticket" : "MDA");

      localParams.push({
        id: null,
        name: "",
        weight: 1.0,
        category: category,
        channel: activeParamChannel,
        section: section,
        active: true,
        isDeleted: false,
      });
      renderParametersList();

      const paneId = section === "items" ? "param-list-s1" : "param-list-s2";
      const pane = document.getElementById(paneId);
      if (pane) {
        setTimeout(() => {
          pane.lastElementChild?.scrollIntoView({ behavior: "smooth" });
          (
            pane.lastElementChild?.querySelector(
              ".param-input-name",
            ) as HTMLElement
          )?.focus();
        }, 50);
      }
    };

    if (btnAddParam) {
      btnAddParam.addEventListener("click", () => {
        handleAddParam(
          activeParamTab === "s1"
            ? "items"
            : (activeParamChannel === "wise_call" ? "ticket" : "mda"),
        );
      });
    }

    if (btnAddParamS1) {
      btnAddParamS1.addEventListener("click", () => {
        handleAddParam("items");
      });
    }

    if (btnAddParamS2) {
      btnAddParamS2.addEventListener("click", () => {
        handleAddParam(activeParamChannel === "wise_call" ? "ticket" : "mda");
      });
    }

    function handleMoveParam(actualIndex: number, direction: -1 | 1) {
      const currentList = localParams
        .map((p, i) => ({ p, i }))
        .filter(
          (item) =>
            isMatchingChannel(item.p) &&
            (activeParamTab === "s1" ? isS1(item.p) : isS2(item.p)) &&
            (item.p.active || !item.p.id || item.p.isDeleted),
        );

      const pos = currentList.findIndex((item) => item.i === actualIndex);
      if (pos === -1) return;

      const targetPos = pos + direction;
      if (targetPos < 0 || targetPos >= currentList.length) return;

      const targetActualIndex = currentList[targetPos].i;

      // Intercambiar en localParams
      const temp = localParams[actualIndex];
      localParams[actualIndex] = localParams[targetActualIndex];
      localParams[targetActualIndex] = temp;

      renderParametersList();
    }

    function renderParameterRow(
      param: any,
      actualIndex: number,
      displayIndex: number,
      isFirst: boolean,
      isLast: boolean,
    ) {
      const isDeleted = param.isDeleted;
      const isNew = !param.id;

      return `
        <div class="group flex items-center gap-2 sm:gap-3 bg-base-100 hover:bg-base-200/40 p-2 sm:p-2.5 rounded-xl border border-base-200/80 shadow-2xs transition-colors ${
          isDeleted ? "opacity-45 bg-error/5 border-error/20 line-through" : ""
        }" data-index="${actualIndex}">
          <!-- Reorder Controls -->
          <div class="flex flex-col gap-0.5 shrink-0 ${isDeleted ? "invisible pointer-events-none" : ""}">
            <button
              type="button"
              class="btn btn-ghost btn-2xs size-4.5 p-0 text-base-content/40 hover:text-secondary hover:bg-base-200 param-btn-move-up ${isFirst ? "opacity-20 pointer-events-none" : ""}"
              data-index="${actualIndex}"
              title="Mover arriba"
              aria-label="Mover arriba"
              ${isFirst ? "disabled" : ""}
            >
              <svg class="size-3" viewBox="0 0 24 24" fill="currentColor"><path d="M5 15h14l-7-7z"/></svg>
            </button>
            <button
              type="button"
              class="btn btn-ghost btn-2xs size-4.5 p-0 text-base-content/40 hover:text-secondary hover:bg-base-200 param-btn-move-down ${isLast ? "opacity-20 pointer-events-none" : ""}"
              data-index="${actualIndex}"
              title="Mover abajo"
              aria-label="Mover abajo"
              ${isLast ? "disabled" : ""}
            >
              <svg class="size-3" viewBox="0 0 24 24" fill="currentColor"><path d="M5 9h14l-7 7z"/></svg>
            </button>
          </div>

          <!-- Number Indicator -->
          <div class="flex items-center justify-center size-7 rounded-lg bg-base-200/70 font-mono text-xs font-semibold text-base-content/60 shrink-0">
            ${isNew ? '<span class="text-success font-black text-sm">+</span>' : displayIndex}
          </div>

          <!-- Parameter Name Input -->
          <div class="flex-1 min-w-0">
            <input 
              type="text" 
              value="${escapeHtml(param.name)}" 
              placeholder="Nombre del criterio de evaluación..."
              class="input input-sm w-full font-medium bg-base-200/30 hover:bg-base-200/50 focus:bg-base-100 border border-transparent focus:border-secondary rounded-lg text-xs sm:text-sm text-base-content transition-colors param-input-name"
              ${isDeleted ? "disabled" : ""}
              data-index="${actualIndex}"
              aria-label="Nombre del criterio"
            />
          </div>

          <!-- Weight Input with % suffix -->
          <div class="flex items-center gap-1 shrink-0">
            <span class="text-[11px] font-bold text-base-content/50 uppercase tracking-wider hidden sm:inline">Peso:</span>
            <div class="relative">
              <input 
                type="number" 
                step="0.1" 
                min="0"
                max="100"
                value="${param.weight}" 
                class="input input-sm w-16 sm:w-20 text-center font-mono font-bold text-xs sm:text-sm bg-base-200/30 hover:bg-base-200/50 focus:bg-base-100 border border-transparent focus:border-secondary rounded-lg param-input-weight pr-5"
                ${isDeleted ? "disabled" : ""}
                data-index="${actualIndex}"
                aria-label="Peso del criterio"
              />
              <span class="absolute right-1.5 top-1/2 -translate-y-1/2 text-[10px] font-bold text-base-content/40 pointer-events-none">%</span>
            </div>
          </div>

          <!-- Actions: Delete or Restore -->
          <div class="shrink-0 flex items-center">
            ${
              isDeleted
                ? `
              <button 
                type="button" 
                class="btn btn-xs btn-ghost text-success hover:bg-success/10 font-bold param-btn-restore gap-1" 
                data-index="${actualIndex}" 
                title="Restaurar criterio"
                aria-label="Restaurar criterio"
              >
                Restaurar
              </button>
            `
                : `
              <button 
                type="button" 
                class="btn btn-xs sm:btn-sm btn-ghost btn-square text-base-content/30 hover:text-error hover:bg-error/10 param-btn-delete rounded-lg transition-colors" 
                data-index="${actualIndex}" 
                title="Descartar criterio"
                aria-label="Descartar criterio"
              >
                <svg class="size-4" viewBox="0 0 24 24" fill="currentColor"><path d="m20.37 5.91-1 .92a2 2 0 0 1-1.39.57H6A2 2 0 0 1 4.6 6.84l-1-.93L2.24 7.27l1 .93a4 4 0 0 0 2.76 1.14h12A4 4 0 0 0 20.76 8.2l1-.93zm-3.5 4v9a2 2 0 0 1-2 2h-6a2 2 0 0 1-2-2v-9h-2v9a4 4 0 0 0 4 4h6a4 4 0 0 0 4-4v-9zM8.5 3h7V1h-7z"/></svg>
              </button>
            `
            }
          </div>
        </div>
      `;
    }

    function renderParametersList() {
      const s1Container = document.getElementById("param-list-s1");
      const s2Container = document.getElementById("param-list-s2");
      if (!s1Container || !s2Container) return;

      const s1Items = localParams
        .map((p, i) => ({ p, i }))
        .filter(
          (item) =>
            isMatchingChannel(item.p) &&
            isS1(item.p) &&
            (item.p.active || !item.p.id || item.p.isDeleted),
        );

      const s1Html = s1Items
        .map((item, idx) =>
          renderParameterRow(
            item.p,
            item.i,
            idx + 1,
            idx === 0,
            idx === s1Items.length - 1,
          ),
        )
        .join("");

      const s2Items = localParams
        .map((p, i) => ({ p, i }))
        .filter(
          (item) =>
            isMatchingChannel(item.p) &&
            isS2(item.p) &&
            (item.p.active || !item.p.id || item.p.isDeleted),
        );

      const s2Html = s2Items
        .map((item, idx) =>
          renderParameterRow(
            item.p,
            item.i,
            idx + 1,
            idx === 0,
            idx === s2Items.length - 1,
          ),
        )
        .join("");

      s1Container.innerHTML =
        s1Html ||
        '<p class="text-xs text-base-content/40 italic text-center py-6">No hay criterios activos en esta sección para este canal.</p>';
      s2Container.innerHTML =
        s2Html ||
        '<p class="text-xs text-base-content/40 italic text-center py-6">No hay criterios activos en esta sección para este canal.</p>';

      if (activeParamTab === "s1") {
        s1Container.classList.remove("hidden");
        s2Container.classList.add("hidden");
      } else {
        s1Container.classList.add("hidden");
        s2Container.classList.remove("hidden");
      }

      // Attach input change listeners
      s1Container
        .querySelectorAll(".param-input-name, .param-input-weight")
        .forEach(attachInputListeners);
      s2Container
        .querySelectorAll(".param-input-name, .param-input-weight")
        .forEach(attachInputListeners);

      // Attach delete/restore button listeners
      s1Container
        .querySelectorAll(".param-btn-delete")
        .forEach((btn) => btn.addEventListener("click", handleDeleteParam));
      s1Container
        .querySelectorAll(".param-btn-restore")
        .forEach((btn) => btn.addEventListener("click", handleRestoreParam));
      s2Container
        .querySelectorAll(".param-btn-delete")
        .forEach((btn) => btn.addEventListener("click", handleDeleteParam));
      s2Container
        .querySelectorAll(".param-btn-restore")
        .forEach((btn) => btn.addEventListener("click", handleRestoreParam));

      // Attach move up / move down button listeners
      s1Container.querySelectorAll(".param-btn-move-up").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const idx = parseInt((e.currentTarget as HTMLElement).getAttribute("data-index") || "0", 10);
          handleMoveParam(idx, -1);
        });
      });
      s1Container.querySelectorAll(".param-btn-move-down").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const idx = parseInt((e.currentTarget as HTMLElement).getAttribute("data-index") || "0", 10);
          handleMoveParam(idx, 1);
        });
      });
      s2Container.querySelectorAll(".param-btn-move-up").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const idx = parseInt((e.currentTarget as HTMLElement).getAttribute("data-index") || "0", 10);
          handleMoveParam(idx, -1);
        });
      });
      s2Container.querySelectorAll(".param-btn-move-down").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const idx = parseInt((e.currentTarget as HTMLElement).getAttribute("data-index") || "0", 10);
          handleMoveParam(idx, 1);
        });
      });

      // Update summary badge
      updateParamSummary();
    }

    function attachInputListeners(input: Element) {
      input.addEventListener("input", (e) => {
        const target = e.target as HTMLInputElement;
        const idx = parseInt(target.getAttribute("data-index") || "0", 10);
        if (target.classList.contains("param-input-name")) {
          localParams[idx].name = target.value;
        } else if (target.classList.contains("param-input-weight")) {
          localParams[idx].weight = parseFloat(target.value) || 0;
          updateParamSummary();
        }
      });
    }

    function handleDeleteParam(e: Event) {
      const target = e.currentTarget as HTMLElement;
      const idx = parseInt(target.getAttribute("data-index") || "0", 10);
      localParams[idx].isDeleted = true;
      renderParametersList();
    }

    function handleRestoreParam(e: Event) {
      const target = e.currentTarget as HTMLElement;
      const idx = parseInt(target.getAttribute("data-index") || "0", 10);
      localParams[idx].isDeleted = false;
      renderParametersList();
    }

    // Tab switching in parameters modal
    const paramTabs = document.querySelectorAll(".parameter-tab");
    paramTabs.forEach((tab) => {
      tab.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLElement;
        const tabName = target.getAttribute("data-tab") as "s1" | "s2";
        activeParamTab = tabName || "s1";

        paramTabs.forEach((t) => t.classList.remove("tab-active"));
        target.classList.add("tab-active");

        const paneS1 = document.getElementById("param-list-s1");
        const paneS2 = document.getElementById("param-list-s2");

        if (tabName === "s1") {
          paneS1?.classList.remove("hidden");
          paneS2?.classList.add("hidden");
        } else {
          paneS1?.classList.add("hidden");
          paneS2?.classList.remove("hidden");
        }
        updateParamSummary();
      });
    });

    const btnSaveParams = document.getElementById("btn-save-parameters");
    btnSaveParams?.addEventListener("click", async () => {
      const emptyParams = localParams.filter(
        (p) => !p.isDeleted && !p.name.trim(),
      );
      if (emptyParams.length > 0) {
        alert("Por favor, complete el nombre de todos los criterios activos.");
        return;
      }

      // Validar si el peso no suma 100% en la sección activa
      const currentActive = localParams.filter(
        (p) => !p.isDeleted && isMatchingChannel(p) && (activeParamTab === "s1" ? isS1(p) : isS2(p)),
      );
      const totalWeight = Math.round(currentActive.reduce((sum, p) => sum + (parseFloat(p.weight) || 0), 0) * 10) / 10;
      if (currentActive.length > 0 && Math.abs(totalWeight - 100) > 0.05) {
        const proceed = confirm(
          `Atención: El peso total de los criterios en esta sección es ${totalWeight}%, lo cual difiere del 100% recomendado.\n\n¿Deseas guardar los cambios de todas formas?`
        );
        if (!proceed) return;
      }

      const originalText = btnSaveParams.innerHTML;
      btnSaveParams.setAttribute("disabled", "true");
      btnSaveParams.innerHTML =
        '<span class="loading loading-spinner loading-xs"></span> Guardando…';

      try {
        const payload = {
          parameters: localParams.map((p) => ({
            id: p.id,
            name: p.name.trim(),
            weight: p.weight,
            category: p.category || (p.section === "items" ? "Items" : "MDA"),
            channel: p.channel || "wise_call",
            section: p.section || (p.category === "Interacción con Usuario" || p.category === "Items" ? "items" : "ticket"),
            isDeleted: p.isDeleted,
          })),
        };

        const result = await actions.saveParameters(payload);
        if (result.error) {
          console.error(result.error);
          alert("Error al guardar los parámetros: " + result.error.message);
        } else if (result.data?.success) {
          window.location.reload();
        } else {
          alert("Error al guardar los parámetros.");
        }
      } catch (err) {
        console.error(err);
        alert("Ocurrió un error inesperado al guardar los parámetros.");
      } finally {
        btnSaveParams.removeAttribute("disabled");
        btnSaveParams.innerHTML = originalText;
      }
    });

    // --- EXPORT TO EXCEL (.xlsx) ---
    const btnExportExcel = document.getElementById("btn-export-excel");
    if (btnExportExcel) {
      btnExportExcel.addEventListener("click", () => {
        const el = document.getElementById("operators-data");
        const cleanBase = el?.getAttribute("data-clean-base") || "/";
        const monthSelector = document.getElementById(
          "month-selector",
        ) as HTMLSelectElement;
        const monthStr = monthSelector ? monthSelector.value : "";

        const params = new URLSearchParams();
        if (monthStr) params.set("month", monthStr);

        const exportUrl = `${cleanBase}api/calidad/export-excel?${params.toString()}`;
        window.location.href = exportUrl;
      });
    }

    // --- EXPORT OPERATOR REPORT TO EXCEL (.xlsx) ---
    const btnExportExcelOp = document.getElementById("btn-export-excel-operator");
    if (btnExportExcelOp) {
      btnExportExcelOp.addEventListener("click", () => {
        const el = document.getElementById("operators-data");
        const cleanBase = el?.getAttribute("data-clean-base") || "/";
        const monthSelector = document.getElementById(
          "month-selector",
        ) as HTMLSelectElement;
        const monthStr = monthSelector ? monthSelector.value : "";
        const operatorsData = JSON.parse(
          el?.getAttribute("data-operators") || "{}",
        );
        const selectedOp = activeAgentId ? operatorsData[activeAgentId] : null;

        if (!selectedOp || !selectedOp.calls || selectedOp.calls.length === 0) {
          alert("No hay auditorías registradas para exportar en este período.");
          return;
        }

        const params = new URLSearchParams();
        if (monthStr) params.set("month", monthStr);
        if (activeAgentId) params.set("agentId", activeAgentId);

        const exportUrl = `${cleanBase}api/calidad/export-excel?${params.toString()}`;
        window.location.href = exportUrl;
      });
    }


    // Auto-select operator on page load if agentId is in URL or if user is an agent
    const urlParams = new URLSearchParams(window.location.search);
    const urlAgentId = urlParams.get("agentId");
    const rbacContainer = document.querySelector("[data-is-agent]");
    const isUserAgent =
      rbacContainer?.getAttribute("data-is-agent") === "true";

    if (isUserAgent) {
      const operatorsDataEl = document.getElementById("operators-data");
      try {
        const map = JSON.parse(
          operatorsDataEl?.getAttribute("data-operators") || "{}",
        );
        const firstId = Object.keys(map)[0];
        if (firstId) {
          displayOperatorDetails(firstId);
        }
      } catch (e) {}
    } else if (urlAgentId) {
      displayOperatorDetails(urlAgentId);
      if (detailsModal) {
        detailsModal.showModal();
        const currentUrl = new URL(window.location.href);
        currentUrl.searchParams.delete("agentId");
        window.history.replaceState({}, "", currentUrl.toString());
      }
    }
    return true;
  }

  function setupQualityObserver() {
    if (initQualityMasterDetail()) return;

    const observer = new MutationObserver((_, obs) => {
      if (initQualityMasterDetail()) {
        obs.disconnect();
      }
    });

    observer.observe(document.body, { childList: true, subtree: true });
  }

  setupQualityObserver();
  document.addEventListener("astro:page-load", setupQualityObserver);
</script>
