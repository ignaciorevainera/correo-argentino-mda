---
import { Icon } from "astro-icon/components";
import Modal from "@components/ui/Modal.astro";
import FormField from "@components/ui/forms/FormField.astro";
import FormLegend from "@components/ui/forms/FormLegend.astro";
import MonthSelect from "@components/ui/MonthSelect.astro";
import CriterionRow from "@components/supervision/calidad/CriterionRow.astro";
import type { AuditParameter, QualityCall } from "@/types/quality";
import { getCleanBase } from "@lib/baseUrl";

interface Props {
  allAgents: Array<{ id: number; name: string; username: string | null }>;
  allParameters: AuditParameter[];
  selectedMonth: string;
  preselectedAgentId?: number;
  approvedTitles: string[];
  initialAudit?: QualityCall;
}

const {
  allAgents,
  allParameters,
  selectedMonth,
  preselectedAgentId,
  approvedTitles,
  initialAudit,
} = Astro.props;

const cleanBase = getCleanBase();
const invgateWebBase = (import.meta.env.INVGATE_BASE_URL || "")
  .replace(/\/api\/v1\/?$/, "")
  .replace(/\/$/, "");

// Group parameters by channel and section
const wiseCallParams = allParameters.filter(
  (p) =>
    (p.channel === "wise_call" || !p.channel) &&
    p.code !== "call_ticket_reclamo_novedad",
);
const wiseCallS1Params = wiseCallParams.filter(
  (p) =>
    p.section === "items" ||
    p.category === "Items" ||
    p.category === "Interacción con Usuario",
);
const wiseCallS2Params = wiseCallParams.filter(
  (p) =>
    (p.section === "ticket" ||
      p.category === "Ticket" ||
      p.category === "Gestión del Ticket") &&
    p.code !== "call_ticket_reclamo_novedad",
);

const wiseEmailParams = allParameters.filter(
  (p) =>
    p.channel === "wise_email" &&
    p.code !== "email_mda_reclamo_novedad",
);
const wiseEmailS1Params = wiseEmailParams.filter(
  (p) =>
    p.section === "items" ||
    p.category === "Items" ||
    p.category === "Interacción con Usuario",
);
const wiseEmailS2Params = wiseEmailParams.filter(
  (p) =>
    (p.section === "mda" || p.category === "MDA") &&
    p.code !== "email_mda_reclamo_novedad",
);

const invgateAgParams = allParameters.filter(
  (p) => p.channel === "invgate_ticket",
);
const invgateAgS1Params = invgateAgParams.filter((p) => p.section === "items");
const invgateAgS2Params = invgateAgParams.filter((p) => p.section === "mda");

const sumWeight = (list: AuditParameter[]) =>
  list.reduce((acc, p) => acc + (p.weight ?? 0), 0);

// 14 meses hacia atrás: el supervisor puede cargar auditorías de un periodo anterior.
const monthOptions = (() => {
  const names = [
    "enero",
    "febrero",
    "marzo",
    "abril",
    "mayo",
    "junio",
    "julio",
    "agosto",
    "septiembre",
    "octubre",
    "noviembre",
    "diciembre",
  ];
  const now = new Date();
  return Array.from({ length: 14 }, (_, i) => {
    const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
    return {
      value: `${String(d.getMonth() + 1).padStart(2, "0")}-${d.getFullYear()}`,
      label: `${names[d.getMonth()]} ${d.getFullYear()}`,
    };
  });
})();

const effectiveAgentId = preselectedAgentId ?? (initialAudit as any)?.agentId;
const returnUrl = `${cleanBase}supervision/calidad-operadores?month=${encodeURIComponent(selectedMonth)}${effectiveAgentId ? `&agentId=${encodeURIComponent(String(effectiveAgentId))}` : ""}`;
---

<div
  id="new-audit-form-container"
  class="mx-auto w-full max-w-[1440px] pb-4 [--audit-bar-top:6rem] [--audit-aside-max:32rem]"
  data-approved-titles={JSON.stringify(approvedTitles)}
  data-clean-base={cleanBase}
  data-invgate-web-base={invgateWebBase}
  data-initial-audit={JSON.stringify(initialAudit || null)}
>
  <form id="audit-form" method="POST">
    <input
      type="hidden"
      name="id"
      id="form-audit-id"
      value={initialAudit ? String(initialAudit.id) : ""}
    />
    <input type="hidden" name="month" id="form-month" value={selectedMonth} />
    <input
      type="hidden"
      name="channelType"
      id="form-channel-type"
      value={initialAudit?.channelType || "wise_call"}
    />
    <input
      type="hidden"
      name="recordingUrl"
      id="form-recording-url"
      value={initialAudit?.recordingUrl || ""}
    />

    <!-- 
      Cabecera superior: única fila compacta con navegación, título, badge y acciones.
      Fondo opaco y sticky al ras del scroller (sin pestañas aquí adentro).
    -->
    <header
      id="audit-top-header"
      class="audit-sticky-stack sticky -top-4 z-30 -mx-4 -mt-4 border-b border-base-200 bg-base-100 px-4 py-2.5 md:-top-6 md:-mx-6 md:-mt-6 md:px-6"
    >
      <div
        class="mx-auto flex max-w-[1440px] items-center gap-3"
      >
        <a
          href={returnUrl}
          id="btn-back-evaluations"
          class="btn btn-ghost btn-sm btn-square shrink-0 text-base-content/70 hover:text-base-content focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/60"
          title="Volver a evaluaciones"
          aria-label="Volver a evaluaciones"
        >
          <Icon name="boxicons:arrow-left" size={18} aria-hidden="true" />
        </a>

        <div class="hidden h-5 w-px shrink-0 bg-base-300 sm:block"></div>

        <div class="min-w-0 flex-1">
          <h1
            class="text-sm leading-tight font-bold tracking-tight text-balance text-base-content sm:text-lg"
          >
            {initialAudit ? "Editar auditoría de calidad" : "Nueva auditoría de calidad"}
          </h1>
          <p
            class="hidden truncate text-xs text-base-content/60 md:block"
          >
            {
              initialAudit
                ? "Modificación de evaluación y recálculo de puntaje en vivo."
                : "Evaluación asistida con puntaje en vivo sobre los criterios del periodo."
            }
          </p>
        </div>

        <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
          <button
            type="button"
            id="btn-header-help"
            class="btn btn-circle btn-ghost btn-sm text-base-content/60 hover:bg-base-200 hover:text-base-content focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/50"
            title="Guía de evaluación"
            aria-label="Guía de evaluación"
          >
            <Icon name="boxicons:help-circle" size={18} aria-hidden="true" />
          </button>
          <div class="hidden h-5 w-px shrink-0 bg-base-300 sm:block"></div>
          {
            /*
             * Orden deliberado: la ayuda ( neutra) queda a la izquierda y el
             * bloque de acciones a la derecha: [destructivo] [primaria], que es
             * la convención del repo (ver `FormShell.astro:52-63`, que usa
             * `justify-end` con Cancelar `variant="error"` antes de Guardar).
             * Pegar "Eliminar" entre el ? y "Guardar" lo acercaba a la acción
             * primaria y lo separaba de su contexto.
             */
            initialAudit && (
              <button
                type="button"
                id="btn-delete-audit"
                class="btn btn-sm btn-error btn-outline shrink-0 gap-1.5 rounded-lg px-3 text-xs font-bold hover:scale-98 transition-transform focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-error/60 sm:text-sm"
                title="Eliminar auditoría"
                aria-label="Eliminar auditoría"
              >
                <Icon name="boxicons:trash" size={16} aria-hidden="true" />
                <span>Eliminar</span>
              </button>
            )
          }
          <button
            type="submit"
            id="btn-header-save"
            class="btn btn-sm shrink-0 gap-1.5 rounded-lg border border-transparent bg-secondary text-secondary-content px-3.5 text-xs font-bold shadow-xs hover:border-transparent hover:bg-secondary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/60 sm:text-sm"
            title="Guardar auditoría"
            aria-label="Guardar auditoría"
          >
            <Icon name="boxicons:save-filled" size={16} aria-hidden="true" />
            <span>Guardar auditoría</span>
          </button>
        </div>
      </div>
    </header>

    <!-- 2. BARRA DE CONFIGURACIÓN: QUIÉN, CUÁNDO, QUÉ CANAL Y CON QUÉ CASO -->
    <section
      id="audit-config-bar"
      class="mt-4 rounded-2xl border border-base-200 bg-base-100 p-4 shadow-xs sm:p-5"
      aria-label="Configuración de la evaluación"
    >
      <div id="card-attention-data" class="grid grid-cols-12 items-start gap-x-4 gap-y-3.5">
        {/*
          Operador a evaluar. El `grid-cols-[minmax(0,1fr)]` es obligatorio: sin él
          la columna 1fr usa min-content y el <select> con options largos empuja
          la fila y se superpone con Periodo y Canal.
        */}
        <fieldset
          class="fieldset col-span-12 grid-cols-[minmax(0,1fr)] md:col-span-5"
        >
          <FormLegend>
            <Icon name="boxicons:user-filled" size={15} class="text-secondary" aria-hidden="true" />
            Operador a evaluar
            <span class="text-error" aria-hidden="true">*</span>
          </FormLegend>
          {/*
            Select nativo (no la clase `select` de daisyUI): aquella pinta el
            option largo por fuera de su caja y el texto invade "Periodo". Acá
            el `truncate` + `overflow-hidden` sí recortan.
          */}
          <div class="relative min-w-0">
            <select
              name="agentId"
              id="form-agent-id"
              aria-label="Operador a evaluar"
              class="w-full min-w-0 appearance-none truncate rounded-lg border border-base-200 bg-base-200/40 py-2 pr-9 pl-3 text-sm text-base-content focus-visible:border-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/40"
              required
            >
            <option value="" disabled selected={!preselectedAgentId}>
              Seleccionar operador…
            </option>
            {
              allAgents.map((agent) => (
                <option
                  value={agent.id}
                  selected={agent.id === preselectedAgentId}
                  data-username={agent.username || ""}
                >
                  {agent.name} {agent.username ? `(@${agent.username})` : ""}
                </option>
              ))
            }
            </select>
            <Icon
              name="boxicons:chevron-down"
              size={18}
              class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-base-content/50"
              aria-hidden="true"
            />
          </div>
        </fieldset>

        <!-- Periodo evaluado -->
        <fieldset class="fieldset col-span-12 min-w-0 sm:col-span-6 md:col-span-3">
          <FormLegend>
            <Icon name="boxicons:calendar-filled" size={15} class="text-secondary" aria-hidden="true" />
            Periodo
          </FormLegend>
          <MonthSelect
            id="form-month-select"
            options={monthOptions}
            selected={selectedMonth}
            aria-label="Periodo a evaluar"
            class="w-full min-w-0 border-base-200 bg-base-100 font-medium"
          />
        </fieldset>

        <!-- Canal de atención -->
        <fieldset class="fieldset col-span-12 min-w-0 md:col-span-4">
          <FormLegend id="channel-selector-label">
            <Icon name="boxicons:broadcast" size={15} class="text-secondary" aria-hidden="true" />
            Canal de atención
          </FormLegend>
          <div
            id="channel-selector-join"
            role="group"
            aria-labelledby="channel-selector-label"
            class="grid grid-cols-3 gap-1 rounded-xl border border-secondary/20 bg-secondary/5 p-1"
          >
            <button
              type="button"
              class="channel-btn btn btn-sm btn-active gap-1.5 rounded-lg border border-transparent bg-secondary px-2 text-xs font-bold text-secondary-content shadow-2xs hover:bg-secondary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/60"
              data-channel="wise_call"
            >
              <Icon name="boxicons:phone-ring" size={15} aria-hidden="true" />
              <span class="truncate">Llamada Wise</span>
            </button>
            <button
              type="button"
              class="channel-btn btn btn-sm gap-1.5 rounded-lg border border-transparent px-2 text-xs font-medium text-base-content/70 hover:bg-base-100/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/60"
              data-channel="wise_email"
            >
              <Icon name="boxicons:envelope" size={15} aria-hidden="true" />
              <span class="truncate">Mail Wise</span>
            </button>
            <button
              type="button"
              class="channel-btn btn btn-sm gap-1.5 rounded-lg border border-transparent px-2 text-xs font-medium text-base-content/70 hover:bg-base-100/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/60"
              data-channel="invgate_ticket"
            >
              <Icon name="boxicons:handshake" size={15} aria-hidden="true" />
              <span class="truncate">Autogestión</span>
            </button>
          </div>
        </fieldset>

        <!-- Nro Caso / Llamada -->
        <fieldset class="fieldset col-span-12 min-w-0 md:col-span-4">
          <FormLegend>Nro caso / llamada</FormLegend>
          <div class="join w-full">
            <input
              type="text"
              id="form-call-id"
              name="callId"
              value={initialAudit?.callId || ""}
              aria-label="Nro de caso o llamada"
              autocomplete="off"
              spellcheck="false"
              inputmode="numeric"
              placeholder="Ej: 534787…"
              class="input input-sm join-item w-full min-w-0 border-base-200 bg-base-200/40 font-mono text-sm focus:outline-none focus-visible:border-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/40"
            />
            <button
              type="button"
              id="btn-fetch-wise-api"
              class="btn btn-square btn-sm join-item btn-secondary shrink-0 shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/60"
              title="Buscar caso en Wise CX"
              aria-label="Buscar caso en Wise CX"
            >
              <Icon name="boxicons:search" size={16} is:inline aria-hidden="true" />
            </button>
          </div>
        </fieldset>

        <!-- Nro Ticket InvGate -->
        <fieldset class="fieldset col-span-12 min-w-0 md:col-span-4">
          <FormLegend>Nro ticket InvGate</FormLegend>
          <div class="join w-full">
            <input
              type="text"
              id="form-ticket-id"
              name="ticketId"
              value={initialAudit?.ticketId || ""}
              aria-label="Nro ticket InvGate"
              autocomplete="off"
              spellcheck="false"
              inputmode="numeric"
              placeholder="Ej: 88442…"
              class="input input-sm join-item w-full min-w-0 border-base-200 bg-base-200/40 font-mono text-sm focus:outline-none focus-visible:border-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/40"
            />
            <button
              type="button"
              id="btn-fetch-invgate-api"
              class="btn btn-square btn-sm join-item btn-secondary shrink-0 shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/60"
              title="Buscar ticket en InvGate"
              aria-label="Buscar ticket en InvGate"
            >
              <Icon name="boxicons:search" size={16} is:inline aria-hidden="true" />
              <span id="btn-fetch-invgate-label" class="sr-only">Buscar</span>
            </button>
          </div>
        </fieldset>

        <!-- Fecha de atención -->
        <div class="col-span-12 min-w-0 md:col-span-4">
          <FormField
            id="form-date"
            name="date"
            value={initialAudit?.date?.substring(0, 10)}
            label="Fecha de atención"
            type="date"
            required
            size="sm"
            inputClass="border-base-200 bg-base-200/40 font-medium"
          />
        </div>
      </div>

      <!-- Resumen + leyenda de los 3 estados -->
      <div
        class="mt-3.5 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-base-200/70 pt-2.5"
      >
        <p
          id="config-summary-text"
          class="flex items-center gap-1.5 text-xs font-medium text-base-content/60"
        >
          <Icon name="boxicons:info-circle" size={14} class="shrink-0 text-secondary" aria-hidden="true" />
          Configuración aplicada: {wiseCallParams.length} criterios
        </p>
        <ul
          class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xxs font-medium text-base-content/60"
          aria-label="Estados posibles de un criterio"
        >
          <li class="flex items-center gap-1.5">
            <span
              class="inline-block size-2 rounded-full bg-base-300"
              aria-hidden="true"
            ></span>
            Cumple (sin descuento)
          </li>
          <li class="flex items-center gap-1.5">
            <span
              class="inline-block size-2 rounded-full bg-error"
              aria-hidden="true"
            ></span>
            No cumple (descuenta el peso)
          </li>
          <li class="flex items-center gap-1.5">
            <span
              class="inline-block size-2 rounded-full bg-base-content/25"
              aria-hidden="true"
            ></span>
            N/A (no penaliza)
          </li>
        </ul>
      </div>
    </section>

    <!-- 3. CUERPO: CRITERIOS A LA IZQUIERDA, PUNTAJE Y CONTEXTO SIEMPRE A LA VISTA -->
    <div
      id="audit-workspace-grid"
      class="mt-4 grid grid-cols-1 items-start gap-4 pb-14 lg:grid-cols-[minmax(0,1fr)_24rem] lg:gap-5 lg:pb-2 xl:grid-cols-[minmax(0,1fr)_27rem] 2xl:grid-cols-[minmax(0,1fr)_30rem]"
    >
      <div
        id="audit-col-left"
        aria-label="Criterios de evaluación"
        class="min-w-0 space-y-3.5"
      >
        <!-- Pestañas de navegación de secciones de criterios -->
        <nav
          id="audit-section-tabs"
          aria-label="Secciones de la evaluación"
          class="scrollbar-hide flex items-center gap-1.5 overflow-x-auto rounded-2xl border border-base-200 bg-base-100 p-2 shadow-2xs"
        >
          {
            [
              { tab: "1", label: "1. Interacción en llamada" },
              { tab: "2", label: "2. Gestión del Ticket" },
            ].map((s, i) => (
              <button
                type="button"
                data-section-tab={s.tab}
                aria-current={i === 0 ? "true" : undefined}
                class="btn btn-sm shrink-0 gap-2 rounded-xl border border-base-300 bg-base-200/60 px-3 font-semibold text-base-content shadow-2xs cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-base-content/20"
              >
                <span data-section-label class="truncate text-base-content/90 font-medium">
                  {s.label}
                </span>
                <span
                  data-section-badge
                  class="badge badge-sm border-0 bg-base-100 font-mono font-bold tabular-nums text-base-content/70"
                >
                  --
                </span>
              </button>
            ))
          }
        </nav>

        <!-- CANAL 1: LLAMADAS WISE -->
        <div id="channel-checklist-wise_call" class="channel-checklist space-y-3.5">
          <section
            id="section-wise-call-1"
            data-section-card="1"
            data-section-label="1. Interacción en llamada"
            data-section-weight={sumWeight(wiseCallS1Params)}
            class="scroll-mt-28 rounded-2xl border border-base-200 bg-base-100 p-4 shadow-2xs sm:p-5"
          >
            <header
              class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2.5 border-b border-base-200 pb-3"
            >
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h2 class="text-base font-bold text-base-content text-balance">
                    1. Interacción en llamada
                  </h2>
                  <span
                    class="badge badge-sm border-0 bg-base-200/70 font-mono font-bold tabular-nums text-base-content/60"
                  >
                    Hasta −{sumWeight(wiseCallS1Params)}&nbsp;pts
                  </span>
                </div>
                <p class="mt-0.5 text-xs text-base-content/60">
                  Cortesía, saludo, escucha atenta, sondeo y control de la
                  conversación.
                </p>
              </div>

              <div
                class="inline-flex shrink-0 items-center gap-0.5 rounded-lg border border-base-200 bg-base-200/50 p-0.5"
                role="group"
                aria-label="Acciones masivas de la sección"
              >
                <button
                  type="button"
                  class="toggle-all-section-btn btn btn-xs gap-1 rounded-md px-2 font-semibold text-base-content/70 hover:bg-base-100 hover:text-success focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50"
                  data-target-group="wise-call-s1"
                  data-action="check-all"
                  title="Marcar todos como Cumple"
                >
                  <Icon name="boxicons:checkbox-checked" size={14} class="shrink-0" aria-hidden="true" />
                  <span>Todos</span>
                </button>
                <div class="mx-0.5 h-3 w-px bg-base-300"></div>
                <button
                  type="button"
                  class="toggle-all-section-btn btn btn-xs gap-1 rounded-md px-2 font-semibold text-base-content/70 hover:bg-base-100 hover:text-error focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-error/50"
                  data-target-group="wise-call-s1"
                  data-action="uncheck-all"
                  title="Marcar todos como No cumple"
                >
                  <Icon name="boxicons:checkbox" size={14} class="shrink-0" aria-hidden="true" />
                  <span>Ninguno</span>
                </button>
              </div>
            </header>

            <div data-checklist-group="wise-call-s1" class="divide-y divide-base-200/70">
              {
                wiseCallS1Params.map((p) => (
                  <CriterionRow param={p} section="items" />
                ))
              }
            </div>
          </section>

          <section
            id="section-wise-call-2"
            data-section-card="2"
            data-section-label="2. Gestión del Ticket"
            data-section-weight={sumWeight(wiseCallS2Params)}
            class="scroll-mt-28 rounded-2xl border border-base-200 bg-base-100 p-4 shadow-2xs sm:p-5"
          >
            <header
              class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2.5 border-b border-base-200 pb-3"
            >
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h2 class="text-base font-bold text-base-content text-balance">
                    2. Gestión del Ticket
                  </h2>
                  <span
                    class="badge badge-sm border-0 bg-base-200/70 font-mono font-bold tabular-nums text-base-content/60"
                  >
                    Hasta −{sumWeight(wiseCallS2Params)}&nbsp;pts
                  </span>
                </div>
                <p class="mt-0.5 text-xs text-base-content/60">
                  Calidad del registro, clasificación, tipificación y exactitud
                  del ticket en InvGate.
                </p>
              </div>

              <!-- Modo de la sección: ticket generado o consulta sobre uno previo -->
              <div
                id="ticket-mode-join"
                role="group"
                aria-label="Origen del ticket"
                class="inline-flex shrink-0 items-center gap-0.5 rounded-lg border border-base-200 bg-base-200/50 p-0.5"
              >
                <button
                  type="button"
                  class="ticket-mode-btn btn btn-xs btn-active gap-1.5 rounded-md border border-transparent bg-secondary px-2.5 text-xxs font-bold text-secondary-content shadow-xs hover:bg-secondary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/60"
                  data-mode="nuevo"
                  title="Evaluar los parámetros del ticket generado"
                >
                  <Icon name="boxicons:file-plus" size={13} aria-hidden="true" />
                  <span>Ticket nuevo</span>
                </button>
                <button
                  type="button"
