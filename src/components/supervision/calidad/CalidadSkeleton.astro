---
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
---

<PageContainer class="mx-auto max-w-7xl">
  <div class="skeleton-debounced">
    <div
      class="btn btn-ghost btn-sm pointer-events-none mb-2 w-fit pl-2 opacity-50"
    >
      <div class="skeleton size-6 rounded"></div>
      <div class="skeleton ml-2 h-4 w-28 rounded"></div>
    </div>

    <PageHeader
      description="Evaluación de llamadas, métricas y validaciones de la calidad de atención del equipo de operaciones de Mesa de Ayuda."
    />

    <!-- Selector de Período Skeleton -->
    <div
      class="bg-base-200/50 border-base-300 mt-4 mb-6 flex flex-col rounded-xl border p-4 shadow-md sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="text-base-content/80 mb-3 flex items-center gap-2 sm:mb-0">
        <div class="skeleton size-6 rounded"></div>
        <div class="skeleton h-5 w-40 rounded"></div>
      </div>
      <div class="flex items-center gap-2">
        <div class="skeleton size-8 rounded"></div>
        <div class="skeleton h-8 w-36 rounded sm:w-48"></div>
        <div class="skeleton size-8 rounded"></div>
        <div class="divider divider-horizontal mx-1 hidden sm:flex"></div>
        <div class="skeleton h-8 w-28 rounded"></div>
      </div>
    </div>

    <div
      class="relative mt-2 grid grid-cols-1 items-start gap-6 lg:grid-cols-12"
    >
      <!-- Panel Izquierdo: Lista Navegable Skeleton -->
      <aside
        class="flex flex-col gap-4 lg:sticky lg:top-6 lg:col-span-4 lg:h-[calc(100vh-8rem)]"
      >
        <div
          class="card border-base-300 bg-base-100 flex flex-1 flex-col overflow-hidden border shadow-md"
        >
          <div
            class="border-base-200 bg-base-200/30 flex flex-col gap-3 border-b p-4"
          >
            <div class="flex items-center gap-2">
              <div class="skeleton size-6 rounded"></div>
              <div class="skeleton h-5 w-44 rounded"></div>
            </div>
            <div class="flex flex-col gap-2">
              <div class="skeleton h-10 w-full rounded-lg"></div>
              <div class="skeleton h-8 w-full rounded-lg"></div>
            </div>
          </div>

          <div class="flex-1 space-y-2 overflow-y-auto p-2">
            {
              Array.from({ length: 6 }).map(() => (
                <div class="border-base-200 flex w-full items-center justify-between rounded-xl border p-4">
                  <div class="flex items-center gap-4">
                    <div class="skeleton size-10 rounded-full" />
                    <div class="space-y-2">
                      <div class="skeleton h-4 w-28 rounded" />
                      <div class="skeleton h-3 w-16 rounded" />
                    </div>
                  </div>
                  <div class="skeleton h-4 w-10 rounded" />
                </div>
              ))
            }
          </div>
        </div>
      </aside>

      <!-- Panel Derecho: Información / Detalle Skeleton -->
      <main class="h-full lg:col-span-8">
        <div class="space-y-6">
          <!-- Stats Grid -->
          <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
            <!-- Hero Stat: Promedio General (Takes 2 cols/2 rows) -->
            <div
              class="bg-base-300/30 border-base-300 relative col-span-2 row-span-2 flex h-75 flex-col justify-between overflow-hidden rounded-3xl border p-8 shadow-sm"
            >
              <div class="flex items-start justify-between">
                <div class="skeleton h-4 w-24 rounded"></div>
                <div class="skeleton size-6 rounded"></div>
              </div>
              <div class="mt-12 space-y-4">
                <div class="skeleton h-20 w-36 rounded"></div>
                <div class="skeleton h-4 w-64 rounded"></div>
              </div>
            </div>

            <!-- Evaluados -->
            <div
              class="bg-base-100 border-base-200 col-span-1 flex h-35.5 flex-col justify-between rounded-3xl border p-6 shadow-sm"
            >
              <div class="skeleton h-3 w-16 rounded"></div>
              <div class="space-y-2">
                <div class="skeleton h-8 w-12 rounded"></div>
                <div class="skeleton h-3 w-20 rounded"></div>
              </div>
            </div>

            <!-- Llamadas Auditadas -->
            <div
              class="bg-base-100 border-base-200 col-span-1 flex h-35.5 flex-col justify-between rounded-3xl border p-6 shadow-sm"
            >
              <div class="skeleton h-3 w-16 rounded"></div>
              <div class="space-y-2">
                <div class="skeleton h-8 w-12 rounded"></div>
                <div class="skeleton h-3 w-20 rounded"></div>
              </div>
            </div>

            <!-- Excelente -->
            <div
              class="bg-base-100 border-base-200 col-span-1 flex h-35.5 flex-col justify-between rounded-3xl border p-6 shadow-sm"
            >
              <div class="skeleton h-3 w-16 rounded"></div>
              <div class="space-y-2">
                <div class="skeleton h-8 w-12 rounded"></div>
                <div class="skeleton h-3 w-20 rounded"></div>
              </div>
            </div>

            <!-- Bajo Rendimiento -->
            <div
              class="bg-base-100 border-base-200 col-span-1 flex h-35.5 flex-col justify-between rounded-3xl border p-6 shadow-sm"
            >
              <div class="skeleton h-3 w-16 rounded"></div>
              <div class="space-y-2">
                <div class="skeleton h-8 w-12 rounded"></div>
                <div class="skeleton h-3 w-20 rounded"></div>
              </div>
            </div>

            <!-- Promedio Interacción -->
            <div
              class="bg-base-100 border-base-200 col-span-2 flex h-35.5 flex-col justify-between rounded-3xl border p-6 shadow-sm"
            >
              <div class="skeleton h-3 w-20 rounded"></div>
              <div class="space-y-2">
                <div class="skeleton h-8 w-12 rounded"></div>
                <div class="skeleton h-3 w-44 rounded"></div>
              </div>
            </div>

            <!-- Promedio Gestión -->
            <div
              class="bg-base-100 border-base-200 col-span-2 flex h-35.5 flex-col justify-between rounded-3xl border p-6 shadow-sm"
            >
              <div class="skeleton h-3 w-20 rounded"></div>
              <div class="space-y-2">
                <div class="skeleton h-8 w-12 rounded"></div>
                <div class="skeleton h-3 w-44 rounded"></div>
              </div>
            </div>
          </div>

          <!-- Empty State CTA Skeleton -->
          <div
            class="bg-base-200/50 border-base-300 mt-4 flex min-h-64 flex-1 flex-col items-center justify-center rounded-3xl border p-8 text-center shadow-inner"
          >
            <div
              class="bg-base-100 border-base-200 skeleton mb-6 size-20 rounded-full border p-6 shadow-sm"
            >
            </div>
            <div class="skeleton mb-3 h-6 w-40 rounded"></div>
            <div class="skeleton h-4 w-72 rounded"></div>
          </div>
        </div>
      </main>
    </div>
  </div>
</PageContainer>
