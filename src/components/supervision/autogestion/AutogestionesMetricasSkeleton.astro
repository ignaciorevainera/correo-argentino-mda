---
import SkeletonMetric from "@components/ui/skeletons/SkeletonMetric.astro";
---

<div class="skeleton-debounced flex w-full flex-col gap-6 pb-24">
  <!-- Header Skeleton -->
  <div class="flex flex-col gap-4">
    <div class="flex items-center justify-between">
      <div class="skeleton h-8 w-36 rounded-lg"></div>
      <div class="skeleton h-9 w-32 rounded-xl"></div>
    </div>
    <div class="space-y-2">
      <div class="skeleton h-8 w-64 rounded-lg"></div>
      <div class="skeleton h-4 w-96 rounded"></div>
    </div>
  </div>

  <!-- Controls & Filters Bar Skeleton -->
  <div
    class="bg-base-100 border-base-300 flex flex-col gap-4 rounded-2xl border p-4 shadow-sm lg:flex-row lg:items-center lg:justify-between"
  >
    <div class="flex flex-wrap items-center gap-2">
      <div class="skeleton h-6 w-14 rounded-lg"></div>
      <div class="skeleton h-6 w-14 rounded-lg"></div>
      <div class="skeleton h-6 w-24 rounded-lg"></div>
      <div class="skeleton h-6 w-24 rounded-lg"></div>
      <div class="skeleton h-6 w-24 rounded-lg"></div>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <div class="skeleton h-6 w-44 rounded-lg"></div>
      <div class="skeleton h-6 w-24 rounded-lg"></div>
    </div>
  </div>

  <!-- KPI Cards Skeleton -->
  <SkeletonMetric count={4} />

  <!-- Charts Grid Row 1 Skeleton -->
  <div class="grid w-full grid-cols-1 gap-6 lg:grid-cols-3">
    <!-- Doughnut Modalidades Skeleton -->
    <div
      class="bg-base-100 border-base-300 flex flex-col gap-4 rounded-2xl border p-5 shadow-sm"
    >
      <div class="skeleton h-4 w-44 rounded"></div>
      <div class="relative flex h-64 w-full items-center justify-center">
        <div class="skeleton size-48 rounded-full"></div>
      </div>
    </div>
    <!-- Bar Temporal Skeleton -->
    <div
      class="bg-base-100 border-base-300 flex flex-col gap-4 rounded-2xl border p-5 shadow-sm lg:col-span-2"
    >
      <div class="skeleton h-4 w-52 rounded"></div>
      <div class="skeleton h-64 w-full rounded-xl"></div>
    </div>
  </div>

  <!-- Charts Grid Row 2 Skeleton -->
  <div class="grid w-full grid-cols-1 gap-6 lg:grid-cols-3">
    <!-- Horizontal Bar Operadores Skeleton -->
    <div
      class="bg-base-100 border-base-300 flex flex-col gap-4 rounded-2xl border p-5 shadow-sm lg:col-span-2"
    >
      <div class="skeleton h-4 w-48 rounded"></div>
      <div class="skeleton h-64 w-full rounded-xl"></div>
    </div>
    <!-- Doughnut / Bar Categorías Cola Skeleton -->
    <div
      class="bg-base-100 border-base-300 flex flex-col gap-4 rounded-2xl border p-5 shadow-sm"
    >
      <div class="skeleton h-4 w-44 rounded"></div>
      <div class="relative flex h-64 w-full items-center justify-center">
        <div class="skeleton size-48 rounded-full"></div>
      </div>
    </div>
  </div>

  <!-- Table Skeleton -->
  <div
    class="bg-base-100 border-base-300 flex flex-col gap-4 rounded-2xl border p-5 shadow-sm"
  >
    <div class="skeleton h-5 w-48 rounded"></div>
    <div class="space-y-3">
      <div class="skeleton h-10 w-full rounded-lg"></div>
      <div class="skeleton h-10 w-full rounded-lg"></div>
      <div class="skeleton h-10 w-full rounded-lg"></div>
    </div>
  </div>
</div>
