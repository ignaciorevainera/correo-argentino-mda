---
import SkeletonMetric from "@components/ui/skeletons/SkeletonMetric.astro";
---

<div class="skeleton-debounced flex w-full flex-col gap-6 pb-24">
  <!-- Controls & Filters Bar Skeleton -->
  <div
    class="bg-base-100 border-base-300 flex flex-col justify-between gap-4 rounded-2xl border p-4 shadow-sm md:flex-row md:items-center"
  >
    <div class="flex items-center gap-3">
      <div class="skeleton h-4 w-32 rounded"></div>
      <div class="skeleton h-9 w-40 rounded-xl"></div>
    </div>
  </div>

  <!-- KPI Cards Skeleton -->
  <SkeletonMetric count={4} />

  <!-- Charts Grid Skeleton -->
  <div class="grid w-full grid-cols-1 gap-6 lg:grid-cols-3">
    <!-- Doughnut Chart Skeleton -->
    <div
      class="bg-base-100 border-base-300 flex flex-col gap-4 rounded-2xl border p-5 shadow-sm"
    >
      <div class="skeleton h-4 w-44 rounded"></div>
      <div class="relative flex h-55 w-full items-center justify-center">
        <div class="skeleton size-44 rounded-full"></div>
      </div>
    </div>
    <!-- Bar Chart Skeleton -->
    <div
      class="bg-base-100 border-base-300 flex flex-col gap-4 rounded-2xl border p-5 shadow-sm lg:col-span-2"
    >
      <div class="skeleton h-4 w-52 rounded"></div>
      <div class="skeleton h-55 w-full rounded-xl"></div>
    </div>
  </div>

  <!-- Ranking and Operator Profile Grid Skeleton -->
  <div class="grid w-full grid-cols-1 gap-6 lg:grid-cols-3">
    <!-- Podio / Rankings Skeleton -->
    <div
      class="bg-base-100 border-base-300 flex flex-col gap-4 rounded-2xl border p-5 shadow-sm"
    >
      <div class="skeleton h-4 w-40 rounded"></div>
      <div class="space-y-4">
        <div class="space-y-2">
          <div class="skeleton h-3 w-32 rounded"></div>
          <div class="skeleton h-4 w-full rounded"></div>
          <div class="skeleton h-4 w-full rounded"></div>
        </div>
        <div class="border-base-200 space-y-2 border-t pt-3">
          <div class="skeleton h-3 w-36 rounded"></div>
          <div class="skeleton h-4 w-full rounded"></div>
          <div class="skeleton h-4 w-full rounded"></div>
        </div>
      </div>
    </div>

    <!-- Operator Details Sheet Skeleton -->
    <div
      class="bg-base-100 border-base-300 flex flex-col gap-4 rounded-2xl border p-5 shadow-sm lg:col-span-2"
    >
      <div
        class="border-base-200 flex items-center justify-between border-b pb-3"
      >
        <div class="skeleton h-4 w-32 rounded"></div>
        <div class="skeleton h-8 w-44 rounded-xl"></div>
      </div>
      <div class="text-base-content/40 py-12 text-center font-medium">
        <div class="skeleton mx-auto h-4 w-72 rounded"></div>
      </div>
    </div>
  </div>
</div>
