---
import { Icon } from "astro-icon/components";
import { getAttendanceData } from "@lib/attendance";

const todayStr = new Date().toLocaleDateString("en-CA", {
  timeZone: "America/Argentina/Buenos_Aires",
});
const [y, m] = todayStr.split("-");
const defaultMonth = `${y}-${m}`;

const totalDays = new Date(parseInt(y), parseInt(m), 0).getDate();
const startDate = `${y}-${m}-01`;
const endDate = `${y}-${m}-${String(totalDays).padStart(2, "0")}`;

const initialData = await getAttendanceData(startDate, endDate);
---

<script define:vars={{ initialData, defaultMonth }}>
  window.__STATS_INITIAL_DATA__ = initialData;
  window.__STATS_INITIAL_DATA_MONTH__ = defaultMonth;
</script>

<div class="animate-in fade-in flex w-full flex-col gap-6 pb-24 duration-500">
  <!-- Controls & Filters Bar -->
  <div
    class="bg-base-100 border-base-300 flex flex-col justify-between gap-4 rounded-2xl border p-4 shadow-sm md:flex-row md:items-center"
  >
    <div class="flex items-center gap-3">
      <span class="text-base-content/70 text-sm font-bold"
        >Seleccionar Mes:</span
      >
      <input
        type="month"
        id="analytics-month"
        value={defaultMonth}
        class="bg-base-200 border-base-300 text-base-content focus:ring-secondary/20 focus:border-secondary cursor-pointer rounded-xl border px-4 py-2 text-sm font-bold transition-all outline-none focus:ring-2"
        onclick="this.showPicker()"
      />
    </div>
  </div>

  <!-- KPI Cards -->
  <div
    class="grid w-full grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4"
    id="kpi-container"
  >
    <div
      class="bg-base-100 border-base-300 flex flex-col gap-1 rounded-2xl border p-4 shadow-sm"
    >
      <span
        class="text-xxs text-base-content/40 font-black tracking-wider uppercase"
        >Tasa Puntualidad</span
      >
      <span class="text-secondary text-2xl font-black" id="kpi-punctuality"
        >--%</span
      >
    </div>
    <div
      class="bg-base-100 border-base-300 flex flex-col gap-1 rounded-2xl border p-4 shadow-sm"
    >
      <span
        class="text-xxs text-base-content/40 font-black tracking-wider uppercase"
        >Asistencias Totales</span
      >
      <span class="text-2xl font-black text-emerald-500" id="kpi-total">--</span
      >
    </div>
    <div
      class="bg-base-100 border-base-300 flex flex-col gap-1 rounded-2xl border p-4 shadow-sm"
    >
      <span
        class="text-xxs text-base-content/40 font-black tracking-wider uppercase"
        >Total Ausencias</span
      >
      <span class="text-error text-2xl font-black" id="kpi-absences">--</span>
    </div>
    <div
      class="bg-base-100 border-base-300 flex flex-col gap-1 rounded-2xl border p-4 shadow-sm"
    >
      <span
        class="text-xxs text-base-content/40 font-black tracking-wider uppercase"
        >Mayor Ausencia</span
      >
      <span
        class="text-base-content truncate text-lg font-black"
        id="kpi-top-reason">--</span
      >
    </div>
  </div>

  <!-- Charts Grid -->
  <div class="grid w-full grid-cols-1 gap-6 lg:grid-cols-3">
    <!-- Doughnut Chart -->
    <div
      class="bg-base-100 border-base-300 flex flex-col gap-4 rounded-2xl border p-5 shadow-sm"
    >
      <h3
        class="text-base-content/70 text-xs font-black tracking-wider uppercase"
      >
        Distribución de Incidencias
      </h3>
      <div class="relative flex h-55 w-full items-center justify-center">
        <canvas id="doughnut-chart"></canvas>
      </div>
    </div>
    <!-- Bar Chart & Details Panel Container -->
    <div
      class="bg-base-100 border-base-300 relative overflow-hidden rounded-2xl border shadow-sm lg:col-span-2"
    >
      <div
        id="slide-wrapper"
        class="flex w-[200%] transition-transform duration-500 ease-in-out"
      >
        <!-- Panel A: Bar Chart -->
        <div class="flex w-1/2 shrink-0 flex-col gap-4 p-5">
          <h3
            class="text-base-content/70 text-xs font-black tracking-wider uppercase"
          >
            Tendencia Semanal de Puntualidad
          </h3>
          <div class="relative h-55 w-full">
            <canvas id="bar-chart"></canvas>
          </div>
        </div>
        <!-- Panel B: Eventuality Details -->
        <div class="bg-base-50/50 flex w-1/2 shrink-0 flex-col gap-4 p-5">
          <div
            class="border-base-200 flex items-center justify-between border-b pb-2"
          >
            <div class="flex items-center gap-2">
              <span id="detail-color-indicator" class="h-3 w-3 rounded-full"
              ></span>
              <h3
                id="detail-title"
                class="text-base-content/80 text-xs font-black tracking-wider uppercase"
              >
                Detalle de Eventualidad
              </h3>
            </div>
            <button
              id="close-detail-btn"
              class="btn btn-xs btn-ghost text-base-content/60 hover:text-base-content hover:bg-base-200 gap-1 font-bold"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-arrow-left"
                ><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg
              >
              Volver al Gráfico
            </button>
          </div>
          <div
            id="detail-content"
            class="text-base-content/85 max-h-55 space-y-2 overflow-y-auto pr-2 text-xs font-semibold"
          >
            <!-- Dynamically populated list of operators & dates -->
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Operator Section: Master-Detail -->
  <div
    class="bg-base-100 border-base-300 flex w-full flex-col gap-4 rounded-2xl border p-5 shadow-sm"
    id="operator-section"
  >
    <!-- Section Header: Dynamic based on view -->
    <div
      class="border-base-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b pb-3"
    >
      <div class="flex items-center gap-2">
        <h3
          id="operator-section-title"
          class="text-base-content/70 text-xs font-black tracking-wider uppercase"
        >
          Fichas Individuales de Operadores
        </h3>
        <span
          id="operator-count-badge"
          class="badge badge-sm badge-ghost text-base-content/60 font-bold"
        >
          0 operadores
        </span>
      </div>

      <!-- Controls in Grid Mode -->
      <div id="operator-grid-controls" class="flex items-center gap-2 w-full sm:w-auto">
        <div class="relative w-full sm:w-64">
          <Icon
            name="boxicons:search"
            class="text-base-content/40 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"
            size={16}
          />
          <input
            type="text"
            id="operator-search-input"
            placeholder="Filtrar por nombre..."
            class="input input-sm input-bordered bg-base-200/50 border-base-300 w-full pl-9 pr-8 rounded-xl text-xs font-bold outline-none focus:border-secondary transition-all"
          />
          <button
            type="button"
            id="operator-search-clear"
            class="text-base-content/40 hover:text-base-content absolute right-2.5 top-1/2 -translate-y-1/2 hidden cursor-pointer text-xs font-bold"
            title="Limpiar filtro"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Controls in Detail Mode (Hidden initially) -->
      <div id="operator-detail-controls" class="hidden flex items-center gap-2">
        <button
          type="button"
          id="op-back-to-grid-btn"
          class="btn btn-sm btn-ghost hover:bg-base-200 gap-1.5 font-bold text-xs"
        >
          <Icon name="boxicons:chevron-left" size={16} />
          Cambiar Operador
        </button>
        <a
          id="op-history-btn"
          class="btn btn-sm btn-outline btn-secondary gap-1.5 font-bold text-xs"
          target="_self"
        >
          <Icon name="boxicons:history" size={16} />
          Historial Detallado
        </a>
      </div>
    </div>

    <!-- Master View: Grid of Quick Cards -->
    <div id="operator-grid-view" class="flex flex-col gap-3">
      <div
        id="operator-cards-container"
        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 max-h-[260px] overflow-y-auto p-0.5"
      >
        <!-- Cards generated dynamically via JavaScript -->
      </div>
      <div
        id="operator-grid-empty"
        class="text-base-content/40 hidden py-12 text-center text-xs font-bold"
      >
        No se encontraron operadores con ese criterio de búsqueda.
      </div>
    </div>

    <!-- Detail View: Operator Stats Block -->
    <div
      id="operator-detail-view"
      class="animate-in fade-in flex hidden flex-col gap-4 duration-300"
    >
      <!-- Operator Selected Banner -->
      <div class="flex items-center gap-3 bg-base-200/40 border border-base-300/40 rounded-xl p-3">
        <div
          id="op-detail-avatar"
          class="w-10 h-10 rounded-xl bg-secondary/10 text-secondary flex items-center justify-center font-black text-sm shrink-0 shadow-xs"
        >
          --
        </div>
        <div class="flex flex-col min-w-0">
          <span id="op-detail-name" class="font-black text-sm text-base-content truncate">
            --
          </span>
          <span id="op-detail-month-label" class="text-xxs text-base-content/50 font-bold uppercase tracking-wider">
            Métricas del período
          </span>
        </div>
      </div>

      <!-- 5 KPIs -->
      <div class="grid grid-cols-2 gap-3 min-[640px]:grid-cols-5">
        <div class="bg-base-200/50 border-base-300/40 rounded-xl border p-3 text-center">
          <span class="text-micro text-base-content/40 block font-black tracking-wider uppercase">Puntualidad</span>
          <span class="text-secondary text-base font-black" id="op-kpi-punctuality">--%</span>
        </div>
        <div class="bg-base-200/50 border-base-300/40 rounded-xl border p-3 text-center">
          <span class="text-micro text-base-content/40 block font-black tracking-wider uppercase">Cumplió</span>
          <span class="text-base font-black text-emerald-500" id="op-kpi-worked">--</span>
        </div>
        <div class="bg-base-200/50 border-base-300/40 rounded-xl border p-3 text-center">
          <span class="text-micro text-base-content/40 block font-black tracking-wider uppercase">Tarde / Retiro</span>
          <span class="text-warning text-base font-black" id="op-kpi-lates">--</span>
        </div>
        <div class="bg-base-200/50 border-base-300/40 rounded-xl border p-3 text-center">
          <span class="text-micro text-base-content/40 block font-black tracking-wider uppercase">Incumplió</span>
          <span class="text-error/80 text-base font-black" id="op-kpi-failed">--</span>
        </div>
        <div class="bg-base-200/50 border-base-300/40 rounded-xl border p-3 text-center">
          <span class="text-micro text-base-content/40 block font-black tracking-wider uppercase">Ausencias / Eventualidades</span>
          <span class="text-base font-black text-violet-500 dark:text-violet-400" id="op-kpi-absences">--</span>
        </div>
      </div>

      <!-- GitHub-Style Contribution Calendar -->
      <div>
        <h4 class="text-xxs text-base-content/40 mb-2 font-bold tracking-wider uppercase">
          Cuadrícula Mensual de Asistencia
        </h4>
        <div
          class="bg-base-200/30 border-base-300/40 flex flex-wrap justify-start gap-1.5 rounded-xl border p-3"
          id="op-calendar-grid"
        >
          <!-- Casillas 1..31 -->
        </div>
        <!-- Grid Legend -->
        <div class="text-tiny text-base-content/40 mt-3 flex items-center gap-3 font-bold select-none">
          <div class="flex items-center gap-1">
            <span class="h-2.5 w-2.5 rounded border border-emerald-500/30 bg-emerald-500/20"></span> Cumplió
          </div>
          <div class="flex items-center gap-1">
            <span class="h-2.5 w-2.5 rounded border border-amber-500/30 bg-amber-500/20"></span> Tarde / Retiro
          </div>
          <div class="flex items-center gap-1">
            <span class="bg-error/15 border-error/30 h-2.5 w-2.5 rounded border"></span> Incumplió
          </div>
          <div class="flex items-center gap-1">
            <span class="h-2.5 w-2.5 rounded border border-violet-500/30 bg-violet-500/20"></span> Ausencia / Eventualidad
          </div>
          <div class="flex items-center gap-1">
            <span class="bg-base-200/50 border-base-300/40 h-2.5 w-2.5 rounded border"></span> Franco
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Chart.js CDN Link -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js" defer></script>
</div>

<script>
  import { getCleanBase } from "@lib/baseUrl";

  let rawLogs: any[] = [];
  let doughnutChartInstance: any = null;
  let barChartInstance: any = null;
  let activeCategory: { label: string; color: string } | null = null;

  const FIXED_EVENTUALITY_COLORS: Record<string, string> = {
    // Cumplimientos
    "Llegada Tarde": "rgba(245, 158, 11, 0.65)", // amber-500
    "Incumplió": "rgba(239, 68, 68, 0.65)", // red-500

    // Ausencias y eventualidades
    "Demorado": "rgba(249, 115, 22, 0.65)", // orange-500
    "Se reporta enfermo": "rgba(168, 85, 247, 0.65)", // purple-500
    "Lic. Medica": "rgba(139, 92, 246, 0.65)", // violet-500
    "Ausencia sin aviso": "rgba(244, 63, 94, 0.65)", // rose-500
    "Lic. Anual": "rgba(14, 165, 233, 0.65)", // sky-500
    "Lic. Estudio": "rgba(20, 184, 166, 0.65)", // teal-500
    "Ausente Justificado": "rgba(99, 102, 241, 0.65)", // indigo-500
    "Lic. Gremial": "rgba(217, 70, 239, 0.65)", // fuchsia-500
    "Ausente con Permiso": "rgba(236, 72, 153, 0.65)", // pink-500
    "Tramite": "rgba(100, 116, 139, 0.65)", // slate-500
    "Lic. UI": "rgba(71, 85, 105, 0.65)", // slate-600
  };

  const FIXED_EVENTUALITY_ORDER = [
    "Llegada Tarde",       // amber-500
    "Se reporta enfermo",  // purple-500
    "Demorado",            // orange-500
    "Lic. Anual",          // sky-500
    "Lic. Medica",         // violet-500
    "Lic. Estudio",        // teal-500
    "Incumplió",           // red-500
    "Ausente Justificado", // indigo-500
    "Ausencia sin aviso",  // rose-500
    "Lic. Gremial",        // fuchsia-500
    "Ausente con Permiso", // pink-500
    "Tramite",             // slate-500
    "Lic. UI",             // slate-600
  ];

  function getEventualityColor(label: string): string {
    if (FIXED_EVENTUALITY_COLORS[label]) {
      return FIXED_EVENTUALITY_COLORS[label];
    }
    const fallbackPalette = [
      "rgba(99, 102, 241, 0.65)",
      "rgba(20, 184, 166, 0.65)",
      "rgba(236, 72, 153, 0.65)",
      "rgba(14, 165, 233, 0.65)",
      "rgba(168, 85, 247, 0.65)",
      "rgba(217, 70, 239, 0.65)",
      "rgba(244, 63, 94, 0.65)",
      "rgba(100, 116, 139, 0.65)",
    ];
    let hash = 0;
    for (let i = 0; i < label.length; i++) {
      hash = (hash << 5) - hash + label.charCodeAt(i);
      hash |= 0;
    }
    return fallbackPalette[Math.abs(hash) % fallbackPalette.length];
  }

  const monthInput = document.getElementById(
    "analytics-month",
  ) as HTMLInputElement;
  let currentSelectedAgentId: number | null = null;

  function processGlobalMetrics() {
    const schedulesWithTime = rawLogs.filter(
      (log) =>
        log.horarioEstipulado &&
        log.horarioEstipulado !== "Franco" &&
        log.cumplimiento &&
        log.cumplimiento !== "Sin Registro",
    );
    const totalSchedules = schedulesWithTime.length;

    const punctuals = schedulesWithTime.filter(
      (log) => log.cumplimiento === "Cumplió",
    ).length;
    const totalAsistencias = rawLogs.filter((log) => log.asistenciaId).length;
    const totalAusencias = rawLogs.filter(
      (log) => log.ausencia && log.ausencia !== "",
    ).length;

    const absenceReasons: Record<string, number> = {};
    rawLogs.forEach((log) => {
      if (log.ausencia && log.ausencia !== "") {
        absenceReasons[log.ausencia] = (absenceReasons[log.ausencia] || 0) + 1;
      }
    });
    let topReason = "Ninguna";
    let maxCount = 0;
    Object.entries(absenceReasons).forEach(([reason, count]) => {
      if (count > maxCount) {
        maxCount = count;
        topReason = reason;
      }
    });

    const kpiPunctuality = document.getElementById("kpi-punctuality");
    const kpiTotal = document.getElementById("kpi-total");
    const kpiAbsences = document.getElementById("kpi-absences");
    const kpiTopReason = document.getElementById("kpi-top-reason");

    if (kpiPunctuality)
      kpiPunctuality.textContent =
        totalSchedules > 0
          ? `${Math.round((punctuals / totalSchedules) * 100)}%`
          : "0%";
    if (kpiTotal) kpiTotal.textContent = String(totalAsistencias);
    if (kpiAbsences) kpiAbsences.textContent = String(totalAusencias);
    if (kpiTopReason) kpiTopReason.textContent = topReason;

    const agentStats: Record<
      number,
      { name: string; total: number; punctuals: number; lates: number }
    > = {};
    rawLogs.forEach((log) => {
      if (!log.horarioEstipulado || log.horarioEstipulado === "Franco") return;
      if (!log.cumplimiento || log.cumplimiento === "Sin Registro") return;
      if (!agentStats[log.agentId]) {
        agentStats[log.agentId] = {
          name: log.nombre,
          total: 0,
          punctuals: 0,
          lates: 0,
        };
      }
      const stats = agentStats[log.agentId];
      stats.total++;
      if (log.cumplimiento === "Cumplió") stats.punctuals++;
      if (
        log.cumplimiento &&
        log.cumplimiento !== "Cumplió" &&
        log.cumplimiento !== "Sin Registro"
      ) {
        stats.lates++;
      }
    });
  }

  function updateCharts() {
    const incidenceData: Record<string, number> = {};
    rawLogs.forEach((log) => {
      if (log.ausencia && log.ausencia !== "") {
        incidenceData[log.ausencia] = (incidenceData[log.ausencia] || 0) + 1;
      }
      if (
        log.cumplimiento === "Llegada Tarde" ||
        log.cumplimiento === "Incumplió"
      ) {
        incidenceData[log.cumplimiento] =
          (incidenceData[log.cumplimiento] || 0) + 1;
      }
    });
    const doughnutLabels = Object.keys(incidenceData).sort((a, b) => {
      const idxA = FIXED_EVENTUALITY_ORDER.indexOf(a);
      const idxB = FIXED_EVENTUALITY_ORDER.indexOf(b);
      if (idxA !== -1 && idxB !== -1) return idxA - idxB;
      if (idxA !== -1) return -1;
      if (idxB !== -1) return 1;
      return a.localeCompare(b);
    });
    const doughnutValues = doughnutLabels.map((k) => incidenceData[k]);

    const doughnutCtx = (
      document.getElementById("doughnut-chart") as HTMLCanvasElement
    ).getContext("2d");
    if (doughnutChartInstance) doughnutChartInstance.destroy();

    if (doughnutLabels.length > 0 && doughnutCtx) {
      doughnutChartInstance = new (window as any).Chart(doughnutCtx, {
        type: "doughnut",
        data: {
          labels: doughnutLabels,
          datasets: [
            {
              data: doughnutValues,
              backgroundColor: doughnutLabels.map((label) =>
                getEventualityColor(label),
              ),
              borderColor: "rgba(150, 150, 150, 0.1)",
              borderWidth: 1.5,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          onClick: (event: any, elements: any[], chart: any) => {
            if (elements.length > 0) {
              const elementIndex = elements[0].index;
              const label = chart.data.labels[elementIndex];
              const color =
                chart.data.datasets[0].backgroundColor[elementIndex];
              showEventualityDetail(label, color, elementIndex);
            }
          },
          onHover: (event: any, chartElement: any[]) => {
            if (event && event.native && event.native.target) {
              (event.native.target as HTMLElement).style.cursor =
                chartElement.length ? "pointer" : "default";
            }
          },
          plugins: {
            legend: {
              position: "bottom",
              labels: {
                boxWidth: 13,
                font: { family: "Geist", size: 12, weight: "bold" },
                color: "gray",
              },
            },
          },
        },
      });
    }

    const weeklySchedules: Record<
      string,
      { total: number; punctuals: number }
    > = {
      "Semana 1": { total: 0, punctuals: 0 },
      "Semana 2": { total: 0, punctuals: 0 },
      "Semana 3": { total: 0, punctuals: 0 },
      "Semana 4": { total: 0, punctuals: 0 },
    };

    rawLogs.forEach((log) => {
      if (!log.horarioEstipulado || log.horarioEstipulado === "Franco") return;
      if (!log.cumplimiento || log.cumplimiento === "Sin Registro") return;
      const day = parseInt(log.date.substring(8, 10));
      let weekKey = "Semana 4";
      if (day <= 7) weekKey = "Semana 1";
      else if (day <= 14) weekKey = "Semana 2";
      else if (day <= 21) weekKey = "Semana 3";

      weeklySchedules[weekKey].total++;
      if (log.cumplimiento === "Cumplió") {
        weeklySchedules[weekKey].punctuals++;
      }
    });

    const barLabels = Object.keys(weeklySchedules);
    const barValues = Object.values(weeklySchedules).map((w) =>
      w.total > 0 ? Math.round((w.punctuals / w.total) * 100) : 0,
    );

    const barCtx = (
      document.getElementById("bar-chart") as HTMLCanvasElement
    ).getContext("2d");
    if (barChartInstance) barChartInstance.destroy();

    if (barCtx) {
      barChartInstance = new (window as any).Chart(barCtx, {
        type: "bar",
        data: {
          labels: barLabels,
          datasets: [
            {
              label: "% Puntualidad",
              data: barValues,
              backgroundColor: "rgba(59, 130, 246, 0.7)",
              borderColor: "rgba(59, 130, 246, 0.9)",
              borderWidth: 1,
              borderRadius: 6,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: {
              beginAtZero: true,
              max: 100,
              grid: { color: "rgba(150, 150, 150, 0.05)" },
              ticks: { font: { family: "Geist", size: 9 } },
            },
            x: {
              grid: { display: false },
              ticks: { font: { family: "Geist", size: 9, weight: "bold" } },
            },
          },
          plugins: {
            legend: { display: false },
          },
        },
      });
    }
  }

  function rgbaToRgbStr(rgba: string): string {
    const m = rgba.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
    if (!m) return "";
    return `${m[1]}, ${m[2]}, ${m[3]}`;
  }

  function renderGroupedCard(
    nombre: string,
    dateGroups: string[][],
    logs: any[],
    baseUrl: string,
    sliceColor: string,
  ) {
    const initials = nombre
      .split(" ")
      .map((n: string) => n[0])
      .join("")
      .substring(0, 2)
      .toUpperCase();
    const totalDays = dateGroups.reduce((sum, g) => sum + g.length, 0);
    const allDates = dateGroups.flat().sort();
    const rgb = rgbaToRgbStr(sliceColor);

    const dateToComment: Record<string, string> = {};
    logs.forEach((log) => {
      if (log.detalle) dateToComment[log.date] = log.detalle;
    });

    return `
      <div class="eventuality-detail-card flex flex-col p-3.5 bg-base-100 dark:bg-base-200/50 rounded-xl border border-base-300/40 shadow-sm transition-all duration-200">
        <div class="flex items-center justify-between w-full">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="w-8 h-8 rounded-lg bg-secondary/10 flex items-center justify-center font-black text-xs text-secondary animate-in fade-in zoom-in duration-200 shrink-0">
              ${initials}
            </div>
            <span class="font-bold text-sm text-base-content truncate">${nombre}</span>
          </div>
          <span class="text-xs font-bold bg-base-200/80 px-3 py-1.5 rounded-lg text-base-content/80 tracking-wider shadow-sm shrink-0 whitespace-nowrap">
            ${totalDays} ${totalDays === 1 ? "día" : "días"}
          </span>
        </div>
        <div class="flex flex-wrap gap-1.5 mt-2.5">
          ${allDates
            .map((date) => {
              const parts = date.split("-");
              const display = `${parts[2]}/${parts[1]}`;
              const comment = dateToComment[date];
              const hasComment = !!comment;
              const tipText = hasComment
                ? comment.replace(/"/g, "&quot;")
                : `Ir a ${display}`;
              return `
              <div class="js-portal-tooltip" data-tip="${tipText}">
                <a href="${baseUrl}supervision/asistencia?date=${date}"
                   class="relative px-2.5 py-1 rounded-lg text-xs font-bold transition-all duration-150 cursor-pointer block"
                   style="background:rgba(${rgb},0.12);color:rgba(${rgb},0.95);border:1px solid rgba(${rgb},0.28)"
                   onmouseover="this.style.background='rgba(${rgb},0.22)';this.style.borderColor='rgba(${rgb},0.5)'"
                   onmouseout="this.style.background='rgba(${rgb},0.12)';this.style.borderColor='rgba(${rgb},0.28)'">
                  ${display}
                  ${hasComment ? '<span class="absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-amber-400 border-2 border-base-100 shadow-sm"></span>' : ""}
                </a>
              </div>
            `;
            })
            .join("")}
        </div>
      </div>
    `;
  }

  function groupConsecutiveDates(dates: string[]): string[][] {
    const sorted = [...dates].sort();
    const groups: string[][] = [];
    let current: string[] = [sorted[0]];
    for (let i = 1; i < sorted.length; i++) {
      const prev = new Date(sorted[i - 1] + "T12:00:00");
      const curr = new Date(sorted[i] + "T12:00:00");
      const diffDays =
        (curr.getTime() - prev.getTime()) / (1000 * 60 * 60 * 24);
      if (diffDays === 1) {
        current.push(sorted[i]);
      } else {
        groups.push(current);
        current = [sorted[i]];
      }
    }
    groups.push(current);
    return groups;
  }

  const complianceLabelsSet = new Set(["Llegada Tarde", "Incumplió"]);

  function showEventualityDetail(
    label: string,
    color?: string,
    index?: number,
  ) {
    let finalColor = color;
    if (doughnutChartInstance) {
      if (index === undefined || index === -1) {
        const foundIdx = doughnutChartInstance.data.labels.indexOf(label);
        if (foundIdx !== -1) {
          index = foundIdx;
        }
      }
      if (
        index !== undefined &&
        index !== -1 &&
        doughnutChartInstance.data.datasets[0].backgroundColor[index]
      ) {
        finalColor =
          doughnutChartInstance.data.datasets[0].backgroundColor[index];
      }
      const activeBorderColors =
        doughnutChartInstance.data.datasets[0].data.map((_: any, i: number) =>
          i === index
            ? (finalColor ? finalColor.replace("0.65", "1") : "rgba(150, 150, 150, 1)")
            : "rgba(150, 150, 150, 0.1)",
        );
      const activeBorderWidths =
        doughnutChartInstance.data.datasets[0].data.map((_: any, i: number) =>
          i === index ? 4 : 1.5,
        );
      doughnutChartInstance.data.datasets[0].borderColor = activeBorderColors;
      doughnutChartInstance.data.datasets[0].borderWidth = activeBorderWidths;
      doughnutChartInstance.update();
    }

    if (!finalColor) {
      finalColor = getEventualityColor(label);
    }

    activeCategory = { label, color: finalColor };

    const titleEl = document.getElementById("detail-title");
    const colorEl = document.getElementById("detail-color-indicator");
    if (titleEl) titleEl.textContent = `Detalle: ${label}`;
    if (colorEl) {
      colorEl.style.backgroundColor = finalColor;
      colorEl.style.boxShadow = `0 0 12px ${finalColor}`;
    }

    const isComplianceSlice = complianceLabelsSet.has(label);
    const filterField = isComplianceSlice ? "cumplimiento" : "ausencia";

    const matchingLogs = rawLogs
      .filter((log) => log[filterField] === label)
      .sort((a, b) => a.date.localeCompare(b.date));

    const contentEl = document.getElementById("detail-content");
    if (contentEl) {
      if (matchingLogs.length === 0) {
        contentEl.innerHTML =
          '<div class="text-center py-12 text-base-content/40 font-bold">No hay registros de esta incidencia en este mes.</div>';
      } else {
        const baseUrl = import.meta.env.BASE_URL || "/";
        const finalBase = baseUrl.endsWith("/") ? baseUrl : baseUrl + "/";

        const groupedByOperator: Record<
          string,
          { logs: any[]; dates: string[] }
        > = {};
        matchingLogs.forEach((log) => {
          if (!groupedByOperator[log.nombre]) {
            groupedByOperator[log.nombre] = { logs: [], dates: [] };
          }
          groupedByOperator[log.nombre].logs.push(log);
          groupedByOperator[log.nombre].dates.push(log.date);
        });

        const sortedOperators = Object.keys(groupedByOperator).sort();
        contentEl.innerHTML = sortedOperators
          .map((nombre) => {
            const group = groupedByOperator[nombre];
            const uniqueDates = [...new Set(group.dates)].sort();
            const dateGroups = groupConsecutiveDates(uniqueDates);
            return renderGroupedCard(
              nombre,
              dateGroups,
              group.logs,
              finalBase,
              finalColor!,
            );
          })
          .join("");
      }
    }

    const wrapper = document.getElementById("slide-wrapper");
    if (wrapper) {
      wrapper.style.transform = "translateX(-50%)";
    }
  }

  function showOperatorDetails(agentId: number) {
    const opLogs = rawLogs.filter((log) => log.agentId === agentId);
    if (opLogs.length === 0) return;

    const opName = opLogs[0]?.nombre || "Operador";
    const initials = opName
      .split(" ")
      .map((n: string) => n[0])
      .join("")
      .substring(0, 2)
      .toUpperCase();

    const nameEl = document.getElementById("op-detail-name");
    const avatarEl = document.getElementById("op-detail-avatar");
    const monthLabel = document.getElementById("op-detail-month-label");
    const historyBtn = document.getElementById(
      "op-history-btn",
    ) as HTMLAnchorElement | null;

    if (nameEl) nameEl.textContent = opName;
    if (avatarEl) avatarEl.textContent = initials;
    if (monthLabel && monthInput && monthInput.value) {
      const [y, m] = monthInput.value.split("-");
      monthLabel.textContent = `Métricas del período: ${m}/${y}`;
    }
    if (historyBtn) {
      historyBtn.href = `${getCleanBase()}supervision/asistencia/operador/${agentId}`;
    }

    const schedulesWithTime = opLogs.filter(
      (log) =>
        (log.horarioEstipulado &&
          log.horarioEstipulado !== "Franco" &&
          log.cumplimiento &&
          log.cumplimiento !== "Sin Registro") ||
        (log.cumplimientoForzado &&
          log.cumplimiento &&
          log.cumplimiento !== "Sin Registro"),
    );
    const totalSchedules = schedulesWithTime.length;

    const punctuals = schedulesWithTime.filter(
      (log) => log.cumplimiento === "Cumplió",
    ).length;
    const complied = opLogs.filter(
      (log) => log.cumplimiento === "Cumplió",
    ).length;
    const lates = opLogs.filter(
      (log) => log.cumplimiento === "Llegada Tarde",
    ).length;
    const failed = opLogs.filter(
      (log) => log.cumplimiento === "Incumplió",
    ).length;
    const absences = opLogs.filter(
      (log) => log.ausencia && log.ausencia !== "",
    ).length;

    const opKpiPunctuality = document.getElementById("op-kpi-punctuality");
    const opKpiWorked = document.getElementById("op-kpi-worked");
    const opKpiLates = document.getElementById("op-kpi-lates");
    const opKpiFailed = document.getElementById("op-kpi-failed");
    const opKpiAbsences = document.getElementById("op-kpi-absences");

    if (opKpiPunctuality)
      opKpiPunctuality.textContent =
        totalSchedules > 0
          ? `${Math.round((punctuals / totalSchedules) * 100)}%`
          : "100%";
    if (opKpiWorked) opKpiWorked.textContent = String(complied);
    if (opKpiLates) opKpiLates.textContent = String(lates);
    if (opKpiFailed) opKpiFailed.textContent = String(failed);
    if (opKpiAbsences) opKpiAbsences.textContent = String(absences);

    const grid = document.getElementById("op-calendar-grid");
    if (grid) {
      grid.innerHTML = "";
      const sortedLogs = [...opLogs].sort((a, b) =>
        a.date.localeCompare(b.date),
      );

      const consolidatedMap = new Map();
      sortedLogs.forEach((log) => {
        const existing = consolidatedMap.get(log.date);
        if (!existing) {
          consolidatedMap.set(log.date, { ...log });
        } else {
          const getComplianceRank = (c: string) => {
            if (c === "Incumplió") return 4;
            if (c === "Llegada Tarde") return 3;
            if (c === "Cumplió") return 2;
            return 1;
          };
          const rNew = getComplianceRank(log.cumplimiento);
          const rOld = getComplianceRank(existing.cumplimiento);
          if (rNew > rOld) {
            existing.cumplimiento = log.cumplimiento;
          }
          if (log.entradaReal) {
            existing.entradaReal = existing.entradaReal
              ? `${existing.entradaReal} / ${log.entradaReal}`
              : log.entradaReal;
          }
          if (log.horarioEstipulado) {
            existing.horarioEstipulado = existing.horarioEstipulado
              ? `${existing.horarioEstipulado} / ${log.horarioEstipulado}`
              : log.horarioEstipulado;
          }
          if (log.asistencia) {
            existing.asistencia = existing.asistencia
              ? `${existing.asistencia} / ${log.asistencia}`
              : log.asistencia;
          }
          if (log.ausencia) {
            existing.ausencia = existing.ausencia
              ? `${existing.ausencia} / ${log.ausencia}`
              : log.ausencia;
          }
          if (log.detalle) {
            existing.detalle = existing.detalle
              ? `${existing.detalle} | ${log.detalle}`
              : log.detalle;
          }
        }
      });

      const consolidatedLogs = Array.from(consolidatedMap.values());

      consolidatedLogs.forEach((log) => {
        const day = parseInt(log.date.substring(8, 10));
        const cell = document.createElement("div");

        let colorClass =
          "bg-base-200/50 border border-base-300/40 text-base-content/40";
        if (log.cumplimiento && log.cumplimiento !== "Sin Registro") {
          if (log.cumplimiento === "Cumplió") {
            colorClass =
              "bg-emerald-500/20 text-emerald-600 border border-emerald-500/30";
          } else if (log.cumplimiento === "Llegada Tarde") {
            colorClass =
              "bg-amber-500/20 text-amber-600 border border-amber-500/30";
          } else if (log.cumplimiento === "Incumplió") {
            colorClass = "bg-error/15 text-error border border-error/30";
          }
        }

        cell.className = `w-8 h-8 rounded-lg flex items-center justify-center text-xxs font-black cursor-pointer shadow-sm transition-transform duration-200 hover:scale-110 hover:z-10 relative ${colorClass}`;
        cell.textContent = String(day);

        // Highlight absences with a indicator
        const validAusencias = [
          "Tramite",
          "Demorado",
          "Se reporta enfermo",
          "Ausente Justificado",
          "Ausente con Permiso",
          "Ausente No Justificado",
          "Ausencia sin aviso",
          "Lic. Estudio",
          "Lic. Medica",
          "Lic. Anual",
          "Lic. UI",
          "Lic. Gremial",
          "Lic. Paternidad",
          "Lic. Maternidad",
          "Lic. Fallecimiento",
          "ART",
        ];
        if (log.ausencia && validAusencias.includes(log.ausencia)) {
          const dot = document.createElement("span");
          dot.className =
            "absolute top-0.5 right-0.5 w-2.5 h-2.5 rounded-full bg-violet-500 border-2 border-base-100";
          cell.appendChild(dot);
        }

        // Click redirects to attendance control with date
        cell.addEventListener("click", () => {
          window.location.href = `${getCleanBase()}supervision/asistencia?date=${log.date}`;
        });

        const tooltipParts = [
          `Fecha: ${log.date}`,
          `Planificado: ${log.horarioEstipulado || "Franco"}`,
          `Asistencia: ${log.asistencia || "Sin registro"}`,
          `Cumplimiento: ${log.cumplimiento || "Sin registro"}`,
        ];
        if (log.entradaReal)
          tooltipParts.push(`Entrada Real: ${log.entradaReal}`);
        if (log.ausencia) tooltipParts.push(`Ausencia: ${log.ausencia}`);
        if (log.detalle) tooltipParts.push(`Comentario: ${log.detalle}`);

        cell.title = tooltipParts.join("\n");
        grid.appendChild(cell);
      });
    }
  }

  function selectOperator(agentId: number) {
    currentSelectedAgentId = agentId;
    const gridView = document.getElementById("operator-grid-view");
    const gridControls = document.getElementById("operator-grid-controls");
    const detailView = document.getElementById("operator-detail-view");
    const detailControls = document.getElementById("operator-detail-controls");
    const title = document.getElementById("operator-section-title");
    const countBadge = document.getElementById("operator-count-badge");

    if (gridView) gridView.classList.add("hidden");
    if (gridControls) gridControls.classList.add("hidden");
    if (countBadge) countBadge.classList.add("hidden");
    if (detailView) detailView.classList.remove("hidden");
    if (detailControls) detailControls.classList.remove("hidden");
    if (title) title.textContent = "Ficha del Operador";

    showOperatorDetails(agentId);
  }

  function returnToGrid() {
    currentSelectedAgentId = null;
    const gridView = document.getElementById("operator-grid-view");
    const gridControls = document.getElementById("operator-grid-controls");
    const detailView = document.getElementById("operator-detail-view");
    const detailControls = document.getElementById("operator-detail-controls");
    const title = document.getElementById("operator-section-title");
    const countBadge = document.getElementById("operator-count-badge");

    if (detailView) detailView.classList.add("hidden");
    if (detailControls) detailControls.classList.add("hidden");
    if (gridView) gridView.classList.remove("hidden");
    if (gridControls) gridControls.classList.remove("hidden");
    if (countBadge) countBadge.classList.remove("hidden");
    if (title) title.textContent = "Fichas Individuales de Operadores";

    const input = document.getElementById(
      "operator-search-input",
    ) as HTMLInputElement | null;
    if (input) input.focus();
  }

  function renderOperatorGrid() {
    const container = document.getElementById("operator-cards-container");
    const countBadge = document.getElementById("operator-count-badge");
    const emptyEl = document.getElementById("operator-grid-empty");
    if (!container) return;

    // Agrupar logs por operador
    const operatorLogsMap = new Map<number, { name: string; logs: any[] }>();
    rawLogs.forEach((log) => {
      if (!operatorLogsMap.has(log.agentId)) {
        operatorLogsMap.set(log.agentId, { name: log.nombre, logs: [] });
      }
      operatorLogsMap.get(log.agentId)!.logs.push(log);
    });

    const sortedOps = Array.from(operatorLogsMap.entries()).sort((a, b) =>
      a[1].name.localeCompare(b[1].name),
    );

    if (countBadge) {
      countBadge.textContent = `${sortedOps.length} ${sortedOps.length === 1 ? "operador" : "operadores"}`;
    }

    container.innerHTML = "";
    if (sortedOps.length === 0) {
      if (emptyEl) {
        emptyEl.textContent =
          "No hay registros de operadores para el mes seleccionado.";
        emptyEl.classList.remove("hidden");
      }
      return;
    }

    sortedOps.forEach(([agentId, data]) => {
      const { name, logs } = data;
      const initials = name
        .split(" ")
        .map((n: string) => n[0])
        .join("")
        .substring(0, 2)
        .toUpperCase();

      const schedulesWithTime = logs.filter(
        (log) =>
          (log.horarioEstipulado &&
            log.horarioEstipulado !== "Franco" &&
            log.cumplimiento &&
            log.cumplimiento !== "Sin Registro") ||
          (log.cumplimientoForzado &&
            log.cumplimiento &&
            log.cumplimiento !== "Sin Registro"),
      );
      const totalSchedules = schedulesWithTime.length;
      const punctuals = schedulesWithTime.filter(
        (log) => log.cumplimiento === "Cumplió",
      ).length;
      const punctualityRate =
        totalSchedules > 0
          ? Math.round((punctuals / totalSchedules) * 100)
          : 100;
      const worked = logs.filter(
        (log) => log.cumplimiento === "Cumplió",
      ).length;

      let badgeBg =
        "bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border-emerald-500/30";
      if (punctualityRate < 75) {
        badgeBg =
          "bg-rose-500/15 text-rose-600 dark:text-rose-400 border-rose-500/30";
      } else if (punctualityRate < 90) {
        badgeBg =
          "bg-amber-500/15 text-amber-600 dark:text-amber-400 border-amber-500/30";
      }

      const card = document.createElement("button");
      card.type = "button";
      card.className =
        "operator-mini-card group flex items-center justify-between gap-2.5 p-3 rounded-xl border border-base-200/80 bg-base-100 hover:border-secondary/50 hover:bg-base-200/50 transition-all text-left cursor-pointer shadow-xs";
      card.setAttribute("data-agent-id", String(agentId));
      card.setAttribute("data-name", name.toLowerCase());

      card.innerHTML = `
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="w-8 h-8 rounded-lg bg-secondary/10 text-secondary flex items-center justify-center font-black text-xs shrink-0 group-hover:bg-secondary group-hover:text-secondary-content transition-colors">
            ${initials}
          </div>
          <div class="flex flex-col min-w-0">
            <span class="text-xs font-bold text-base-content truncate group-hover:text-secondary transition-colors" title="${name}">
              ${name}
            </span>
            <span class="text-micro text-base-content/50 font-semibold">
              ${worked} asistencias
            </span>
          </div>
        </div>
        <div class="flex items-center gap-1 shrink-0">
          <span class="px-1.5 py-0.5 rounded-md text-micro font-black border ${badgeBg}">
            ${punctualityRate}%
          </span>
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-base-content/30 group-hover:text-secondary group-hover:translate-x-0.5 transition-all">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </div>
      `;

      card.addEventListener("click", () => {
        selectOperator(agentId);
      });

      container.appendChild(card);
    });

    filterOperatorGrid();
  }

  function filterOperatorGrid() {
    const input = document.getElementById(
      "operator-search-input",
    ) as HTMLInputElement | null;
    const clearBtn = document.getElementById("operator-search-clear");
    const container = document.getElementById("operator-cards-container");
    const emptyEl = document.getElementById("operator-grid-empty");
    if (!container) return;

    const query = (input?.value || "").trim().toLowerCase();
    if (clearBtn) {
      if (query) clearBtn.classList.remove("hidden");
      else clearBtn.classList.add("hidden");
    }

    const cards =
      container.querySelectorAll<HTMLElement>(".operator-mini-card");
    let visibleCount = 0;
    cards.forEach((card) => {
      const name = card.getAttribute("data-name") || "";
      if (!query || name.includes(query)) {
        card.classList.remove("hidden");
        visibleCount++;
      } else {
        card.classList.add("hidden");
      }
    });

    if (emptyEl) {
      if (visibleCount === 0 && cards.length > 0) {
        emptyEl.textContent =
          "No se encontraron operadores con ese criterio de búsqueda.";
        emptyEl.classList.remove("hidden");
      } else if (cards.length > 0) {
        emptyEl.classList.add("hidden");
      }
    }
  }

  const searchInput = document.getElementById("operator-search-input");
  searchInput?.addEventListener("input", filterOperatorGrid);

  const searchClearBtn = document.getElementById("operator-search-clear");
  searchClearBtn?.addEventListener("click", () => {
    const input = document.getElementById(
      "operator-search-input",
    ) as HTMLInputElement | null;
    if (input) {
      input.value = "";
      filterOperatorGrid();
      input.focus();
    }
  });

  const backToGridBtn = document.getElementById("op-back-to-grid-btn");
  backToGridBtn?.addEventListener("click", returnToGrid);

  function getDaysInMonth(year: number, month: number): number {
    return new Date(year, month, 0).getDate();
  }

  async function loadData() {
    if (!monthInput || !monthInput.value) return;
    const [yearStr, monthStr] = monthInput.value.split("-");
    const year = parseInt(yearStr);
    const month = parseInt(monthStr);
    const totalDays = getDaysInMonth(year, month);

    const startDate = `${yearStr}-${monthStr}-01`;
    const endDate = `${yearStr}-${monthStr}-${String(totalDays).padStart(2, "0")}`;

    const punctualityKPI = document.getElementById("kpi-punctuality");
    if (punctualityKPI) punctualityKPI.textContent = "...";

    if (activeCategory) {
      const contentEl = document.getElementById("detail-content");
      if (contentEl) {
        contentEl.innerHTML =
          '<div class="text-center py-12 text-base-content/40 font-bold animate-pulse">Cargando registros...</div>';
      }
    }

    const statsWindow = window as any;
    if (
      statsWindow.__STATS_INITIAL_DATA__ &&
      statsWindow.__STATS_INITIAL_DATA_MONTH__ === monthInput.value
    ) {
      rawLogs = statsWindow.__STATS_INITIAL_DATA__;
      delete statsWindow.__STATS_INITIAL_DATA__;
      delete statsWindow.__STATS_INITIAL_DATA_MONTH__;
      processGlobalMetrics();
      renderOperatorGrid();
      updateCharts();
      if (activeCategory) {
        showEventualityDetail(activeCategory.label, activeCategory.color);
      }
      if (currentSelectedAgentId) {
        const stillExists = rawLogs.some(
          (l) => l.agentId === currentSelectedAgentId,
        );
        if (stillExists) {
          selectOperator(currentSelectedAgentId);
        } else {
          returnToGrid();
        }
      }
      return;
    }

    try {
      const response = await fetch(
        `${import.meta.env.BASE_URL || "/"}api/asistencia?startDate=${startDate}&endDate=${endDate}`,
      );
      if (!response.ok) throw new Error("Failed to fetch statistics data");
      rawLogs = await response.json();

      processGlobalMetrics();
      renderOperatorGrid();
      updateCharts();

      if (activeCategory) {
        showEventualityDetail(activeCategory.label, activeCategory.color);
      }

      if (currentSelectedAgentId) {
        const stillExists = rawLogs.some(
          (l) => l.agentId === currentSelectedAgentId,
        );
        if (stillExists) {
          selectOperator(currentSelectedAgentId);
        } else {
          returnToGrid();
        }
      }
    } catch (err) {
      console.error(err);
    }
  }

  monthInput?.addEventListener("change", loadData);

  document.getElementById("close-detail-btn")?.addEventListener("click", () => {
    activeCategory = null;
    const wrapper = document.getElementById("slide-wrapper");
    if (wrapper) {
      wrapper.style.transform = "translateX(0)";
    }
    if (doughnutChartInstance) {
      doughnutChartInstance.data.datasets[0].borderColor =
        "rgba(150, 150, 150, 0.1)";
      doughnutChartInstance.data.datasets[0].borderWidth = 1.5;
      doughnutChartInstance.update();
    }
    const portal = document.getElementById("daisy-tooltip-portal");
    if (portal) {
      portal.style.display = "none";
      portal.className = "";
    }
  });

  document
    .getElementById("detail-content")
    ?.addEventListener("click", (event) => {
      const card = (event.target as HTMLElement).closest(
        ".eventuality-detail-card",
      );
      if (!card) return;

      // If click is on a link, don't toggle expansion
      if ((event.target as HTMLElement).closest("a")) return;

      card.classList.toggle("is-expanded");
    });

  // Wait for Chart.js to load via CDN before running the data processing
  function safeInit() {
    if ((window as any).Chart) {
      loadData();
    } else {
      setTimeout(safeInit, 50);
    }
  }

  safeInit();

  // Tooltip Portal Logic to fix clipping inside overflow containers
  const portal = document.createElement("div");
  portal.id = "daisy-tooltip-portal";
  portal.style.display = "none";
  document.body.appendChild(portal);

  document.addEventListener("mouseover", (e) => {
    const target = (e.target as HTMLElement).closest(".js-portal-tooltip");
    if (target) {
      const rect = target.getBoundingClientRect();
      const tipText = target.getAttribute("data-tip");
      portal.style.display = "block";
      portal.style.top = rect.top + "px";
      portal.style.left = rect.left + "px";
      portal.style.width = rect.width + "px";
      portal.style.height = rect.height + "px";
      portal.setAttribute("data-tip", tipText || "");

      // Prevent hiding below browser viewport
      const spaceAbove = rect.top;
      const posClass = spaceAbove < 80 ? "tooltip-bottom" : "tooltip-top";

      portal.className = `tooltip tooltip-open fixed z-[99999] pointer-events-none ${posClass}`;
    }
  });

  document.addEventListener("mouseout", (e) => {
    const target = (e.target as HTMLElement).closest(".js-portal-tooltip");
    const related = (e.relatedTarget as HTMLElement)?.closest(
      ".js-portal-tooltip",
    );
    if (target && target !== related) {
      portal.style.display = "none";
      portal.className = "";
    }
  });

  document.addEventListener(
    "scroll",
    () => {
      portal.style.display = "none";
    },
    { capture: true },
  );
</script>

<style is:global>
  .eventuality-detail-card .comment-text {
    display: block;
    max-width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .eventuality-detail-card.is-expanded .comment-text {
    white-space: normal;
    max-width: 100%;
    overflow: visible;
    text-overflow: clip;
  }
</style>
