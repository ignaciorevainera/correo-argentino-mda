---
import SkeletonTable from "@components/ui/skeletons/SkeletonTable.astro";
---

<div class="skeleton-debounced flex w-full flex-col gap-6 pb-24">
  <!-- Filters bar Skeleton -->
  <div
    class="bg-base-100 border-base-300 flex flex-col justify-between gap-4 rounded-2xl border p-4 shadow-sm md:flex-row md:items-center"
  >
    <div class="flex items-center gap-3">
      <div class="skeleton h-10 w-40 rounded-xl"></div>
      <div class="skeleton h-4 w-16 rounded"></div>
    </div>
    <div class="flex w-full flex-col items-center gap-3 sm:flex-row md:w-auto">
      <div class="skeleton size-10 rounded-xl"></div>
      <div class="skeleton h-10 w-28 rounded-xl"></div>
      <div class="skeleton h-10 w-44 rounded-xl"></div>
      <div class="skeleton h-10 w-full rounded-xl sm:w-64"></div>
    </div>
  </div>

  <!-- Main table Skeleton -->
  <SkeletonTable rows={6} columns={7} />
</div>
