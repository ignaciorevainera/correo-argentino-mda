---
import SkeletonTable from "@components/ui/skeletons/SkeletonTable.astro";
---

<div class="skeleton-debounced flex w-full flex-col gap-6">
  <div class="flex flex-col justify-between gap-4 md:flex-row md:items-center">
    <div
      class="bg-base-200/60 border-base-300 flex h-9 w-36 shrink-0 rounded-xl border p-1 shadow-sm"
    >
      <div class="skeleton h-full w-full rounded-lg"></div>
    </div>
    <div class="skeleton border-base-300 h-9 w-40 rounded-xl border"></div>
  </div>

  <SkeletonTable rows={6} columns={3} />
</div>
