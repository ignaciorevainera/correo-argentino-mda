---
import StatsCard from "@components/ui/StatsCard.astro";
import StatsGrid from "@components/ui/StatsGrid.astro";
import ChartCard from "@components/ui/ChartCard.astro";
import type { HelpdesksReportData } from "@/types/helpdesks";

interface Props {
  data: HelpdesksReportData;
}

const { data } = Astro.props;
const { overview, items } = data;

// 1. Top 10 mesas por volumen mensual total (Ingresos)
const topByVolume = [...items]
  .sort((a, b) => b.incomingTicketsMonth - a.incomingTicketsMonth)
  .slice(0, 10);
const volumeLabels = topByVolume.map((item) => item.displayName || item.name);

// 2. Distribución del Backlog: Top 5 + Acumulado "Otras Mesas"
const sortedByBacklog = [...items].sort((a, b) => {
  const bTotal = b.backlog.active + b.backlog.waiting;
  const aTotal = a.backlog.active + a.backlog.waiting;
  return bTotal - aTotal;
});
const top5Backlog = sortedByBacklog.slice(0, 5);
const otherBacklogSum = sortedByBacklog
  .slice(5)
  .reduce((acc, curr) => acc + (curr.backlog.active + curr.backlog.waiting), 0);

const backlogLabels = top5Backlog.map((item) => item.displayName || item.name);
const backlogData = top5Backlog.map(
  (item) => item.backlog.active + item.backlog.waiting,
);

if (otherBacklogSum > 0) {
  backlogLabels.push(`Otras (${items.length - 5} mesas)`);
  backlogData.push(otherBacklogSum);
}

// 3. Cumplimiento de SLA: Top 10 mesas por actividad representativa (horizontal para legibilidad)
const topSlaItems = [...topByVolume];
const slaLabels = topSlaItems.map((item) => item.displayName || item.name);

// 4. CSAT: Top 10 mesas de mayor representatividad (más volumen y respuestas)
const csatLabels = topSlaItems.map((item) => item.displayName || item.name);
---

<div class="space-y-6" aria-label="Métricas y estadísticas de mesas de ayuda">
  <StatsGrid base={2} md={5}>
    <StatsCard
      icon="headphone-mic"
      label="Mesas Monitoreadas"
      value={overview.totalHelpdesks}
      subtitle="Colas operativas activas"
      color="secondary"
      size="lg"
    />
    <StatsCard
      icon="clock"
      label="Tickets Activos"
      value={overview.totalActiveTickets}
      subtitle={`${overview.totalWaitingTickets} en espera`}
      color="info"
      size="lg"
    />
    <StatsCard
      icon="check-circle"
      label="Resueltos del Mes"
      value={overview.totalResolvedMonth.toLocaleString("es-AR")}
      subtitle={`Ratio E/S: ${overview.globalInOutRatio}`}
      color="success"
      size="lg"
    />
    <StatsCard
      icon="shield-quarter"
      label="Cumplimiento SLA"
      value={`${overview.globalSlaCompliancePercent}%`}
      subtitle="Meta corporativa: ≥90%"
      color="info"
      size="lg"
    />
    <StatsCard
      icon="star"
      label="CSAT Global"
      value={`${overview.globalAvgCsat} / 5`}
      subtitle="Satisfacción de usuario"
      color="secondary"
      size="lg"
    />
  </StatsGrid>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <ChartCard
      type="bar"
      title="Volumen Mensual: Top 10 Mesas"
      subtitle="Ingresos vs Resoluciones en las colas con mayor demanda"
      labels={volumeLabels}
      series={[
        {
          label: "Ingresados",
          data: topByVolume.map((item) => item.incomingTicketsMonth),
        },
        {
          label: "Resueltos",
          data: topByVolume.map((item) => item.resolvedTicketsMonth),
        },
      ]}
      class="lg:col-span-2"
    />

    <ChartCard
      type="doughnut"
      title="Distribución del Backlog Pendiente"
      subtitle="Top 5 mesas con mayor cola + resto consolidado"
      labels={backlogLabels}
      series={[
        {
          label: "Tickets Pendientes",
          data: backlogData,
        },
      ]}
    />

    <ChartCard
      type="bar"
      indexAxis="y"
      title="Cumplimiento de SLA de Resolución (%)"
      subtitle="Porcentaje de SLA en las 10 mesas con mayor volumen"
      labels={slaLabels}
      series={[
        {
          label: "% Cumplimiento SLA",
          data: topSlaItems.map(
            (item) => item.serviceTimes.slaResolutionCompliancePercent,
          ),
        },
      ]}
      class="lg:col-span-2"
    />

    <ChartCard
      type="bar"
      indexAxis="y"
      title="Índice de Satisfacción (CSAT)"
      subtitle="Puntaje promedio (1 a 5) en colas principales"
      labels={csatLabels}
      series={[
        {
          label: "Puntaje CSAT",
          data: topSlaItems.map((item) => item.csat.averageRating),
        },
      ]}
    />
  </div>
</div>
