---
import TableShell from "@components/ui/TableShell.astro";
import ActionButton from "@components/ui/ActionButton.astro";
import type {
  WorkflowProcessInstance,
  WorkflowStatus,
} from "@/types/workflows";

interface Props {
  instances: WorkflowProcessInstance[];
}

const { instances } = Astro.props;

function getStatusBadgeClass(status: WorkflowStatus): string {
  switch (status) {
    case "completed":
      return "badge-success";
    case "in_progress":
      return "badge-warning";
    case "waiting_approval":
      return "badge-secondary";
    case "approved":
      return "badge-info";
    case "rejected":
      return "badge-error";
    case "cancelled":
    default:
      return "badge-neutral";
  }
}
---

<TableShell
  label="Instancias monitoreadas del proceso"
  fullscreen
  stackOnMobile
  maxHeightClass="max-h-none"
>
  <table class="table table-md w-full">
    <caption class="sr-only">Instancias de workflows monitoreadas</caption>
    <thead class="bg-base-200 text-base-content border-base-300 border-b">
      <tr>
        <th scope="col" class="w-32 font-mono uppercase">Ticket</th>
        <th scope="col" class="min-w-[220px] font-mono uppercase">Título</th>
        <th scope="col" class="w-36 font-mono uppercase">Estado</th>
        <th scope="col" class="min-w-[160px] font-mono uppercase">Grupo Asignado</th>
        <th scope="col" class="min-w-[150px] font-mono uppercase">Creador</th>
        <th scope="col" class="w-40 text-right font-mono uppercase">Progreso</th>
        <th scope="col" class="w-32 text-right font-mono uppercase">SLA</th>
        <th scope="col" class="w-48 text-right font-mono uppercase">Acción</th>
      </tr>
    </thead>
    <tbody>
      {
        instances.length === 0 ? (
          <tr>
            <td colspan="8" class="text-center py-8 text-base-content/60">
              No hay procesos para mostrar.
            </td>
          </tr>
        ) : (
          instances.map((instance) => {
            const statusBadge = getStatusBadgeClass(instance.status);
            const slaBadge = instance.slaBreached ? "badge-error" : "badge-success";

            return (
              <tr
                class="hover:bg-base-200/50 transition-colors duration-200"
                data-workflow-row={JSON.stringify(instance)}
              >
                <th scope="row" class="font-mono font-bold text-primary" data-label="Ticket">
                  {instance.prettyId}
                </th>
                <td data-label="Título" class="font-medium text-base-content">
                  <span title={instance.title} class="line-clamp-2">
                    {instance.title}
                  </span>
                </td>
                <td data-label="Estado">
                  <span
                    class:list={[
                      "badge h-auto min-h-6 py-1 px-2.5 text-center leading-tight whitespace-normal text-xs font-semibold",
                      statusBadge,
                    ]}
                  >
                    {instance.statusLabel || instance.status}
                  </span>
                </td>
                <td data-label="Grupo asignado" class="text-base-content font-normal">
                  {instance.assignedGroup}
                </td>
                <td data-label="Creador" class="text-base-content font-normal">
                  {instance.creatorName}
                </td>
                <td data-label="Progreso" class="text-right">
                  <div class="inline-flex items-center gap-2">
                    <progress
                      class="progress progress-primary w-16"
                      value={instance.progressPercent}
                      max="100"
                    />
                    <span class="font-mono text-xs font-semibold">
                      {instance.progressPercent}%
                    </span>
                  </div>
                </td>
                <td data-label="SLA" class="text-right">
                  <span
                    class:list={[
                      "badge h-auto min-h-6 py-1 px-2.5 text-center leading-tight whitespace-normal text-xs font-semibold",
                      slaBadge,
                    ]}
                  >
                    {instance.slaBreached ? "Incumplido" : "En Término"}
                  </span>
                </td>
                <td data-label="Acción" class="text-right">
                  <ActionButton
                    type="button"
                    variant="soft"
                    size="md"
                    icon="boxicons:eye"
                    label="Inspeccionar"
                    title={`Inspeccionar proceso ${instance.prettyId}`}
                    class="btn-inspect-workflow"
                  />
                </td>
              </tr>
            );
          })
        )
      }
    </tbody>
  </table>
</TableShell>
