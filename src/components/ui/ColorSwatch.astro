---
interface Props {
  name: string;
  role: string;
  value: string;
  sampleClass: string;
  description?: string;
}

const { name, role, value, sampleClass, description } = Astro.props;
---

<article
  class="border-base-300 bg-base-100 hover:border-base-content/25 overflow-hidden rounded-lg border shadow-sm transition-colors"
>
  <div
    class:list={[
      "border-base-300 flex min-h-24 items-end justify-start border-b p-3",
      sampleClass,
    ]}
    aria-hidden="true"
  >
    <span
      class="bg-base-100/90 text-base-content rounded-md px-2 py-1 font-mono text-xs shadow-sm"
    >
      {value}
    </span>
  </div>

  <div class="space-y-2 p-4">
    <div class="space-y-1">
      <p class="text-base-content text-sm font-semibold">{name}</p>
      <p class="text-base-content/60 font-mono text-xs">{role}</p>
    </div>

    {description && <p class="text-base-content/70 text-sm">{description}</p>}
  </div>
</article>
