---
import { Icon } from "astro-icon/components";

interface Props {
  id?: string;
  title?: string;
  description?: string;
  icon?: string;
  showClearButton?: boolean;
  clearButtonText?: string;
  clearButtonId?: string;
  clearButtonHref?: string;
  class?: string;
  useDualIcons?: boolean;
  notFoundIcon?: string;
}

const {
  id,
  title = "Sin resultados",
  description = "No se encontraron coincidencias para tu búsqueda. Probá de nuevo con otros términos.",
  icon = "boxicons:search",
  showClearButton = false,
  clearButtonText = "Restablecer búsqueda",
  clearButtonId,
  clearButtonHref,
  class: className = "",
  useDualIcons = false,
  notFoundIcon = "boxicons:user-minus-filled",
} = Astro.props;
---

<div
  id={id}
  class:list={[
    "border-base-300 bg-base-200/40 animate-in fade-in slide-in-from-bottom-4 min-h-80 flex-col items-center justify-center rounded-2xl border border-dashed p-8 text-center shadow-inner duration-500",
    !className.includes("flex") && !className.includes("hidden") && "hidden",
    className,
  ]}
  role="status"
  aria-live="polite"
  data-table-empty-state-root
>
  <div
    class="group relative mb-6 size-20"
    id={id ? `${id}-icon-container` : undefined}
  >
    <!-- Ecos de fondo del ícono con gradientes suaves -->
    <div
      id={id ? `${id}-icon-glow-1` : undefined}
      class="bg-primary/10 group-hover:bg-primary/20 absolute inset-0 rounded-3xl blur-md transition-all duration-300"
    >
    </div>
    <div
      id={id ? `${id}-icon-glow-2` : undefined}
      class="bg-secondary/15 absolute inset-1.5 rounded-2xl blur-sm transition-all duration-300 group-hover:scale-105"
    >
    </div>
    <div
      id={id ? `${id}-icon-bg` : undefined}
      class="bg-base-100/90 border-base-300/80 relative flex h-full w-full items-center justify-center rounded-2xl border shadow-lg backdrop-blur-sm transition-all duration-300 group-hover:-translate-y-1"
    >
      {
        useDualIcons ? (
          <>
            <div id={id ? `${id}-icon-search` : "empty-icon-search"}>
              <Icon
                name={icon}
                class="text-base-content/40 group-hover:text-primary size-9 transition-colors duration-300"
              />
            </div>
            <div
              id={id ? `${id}-icon-notfound` : "empty-icon-notfound"}
              class="hidden"
            >
              <Icon
                name={notFoundIcon}
                class="text-error/60 group-hover:text-error size-9 transition-colors duration-300"
              />
            </div>
          </>
        ) : (
          <Icon
            name={icon}
            class="text-base-content/40 group-hover:text-primary size-9 transition-colors duration-300"
          />
        )
      }
    </div>
  </div>

  <h3
    class="text-base-content mb-2 font-mono text-xl font-bold tracking-tight"
    id={id ? `${id}-title` : undefined}
  >
    {title}
  </h3>
  <p
    class="text-base-content/60 mb-6 max-w-sm text-sm"
    id={id ? `${id}-desc` : undefined}
  >
    {description}
  </p>

  {
    showClearButton &&
      (clearButtonHref ? (
        <a
          href={clearButtonHref}
          id={clearButtonId}
          class="btn btn-primary shadow-primary/20 hover:shadow-primary/30 rounded-full px-6 py-2 shadow-lg transition-all duration-300 hover:-translate-y-0.5"
        >
          <Icon name="boxicons:refresh-ccw-filled" class="mr-2 size-4" />
          {clearButtonText}
        </a>
      ) : (
        <button
          id={clearButtonId}
          type="button"
          class="btn btn-primary shadow-primary/20 hover:shadow-primary/30 rounded-full px-6 py-2 shadow-lg transition-all duration-300 hover:-translate-y-0.5"
        >
          <Icon name="boxicons:refresh-ccw-filled" class="mr-2 size-4" />
          {clearButtonText}
        </button>
      ))
  }
</div>
