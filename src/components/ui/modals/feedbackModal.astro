---
import { Icon } from "astro-icon/components";
import FormField from "@components/ui/forms/FormField.astro";
import FormTextarea from "@components/ui/forms/FormTextarea.astro";
import SelectField from "@components/ui/forms/SelectField.astro";
import Modal from "@components/ui/Modal.astro";
import ActionCancelButton from "@components/ui/ActionCancelButton.astro";
import ActionConfirmButton from "@components/ui/ActionConfirmButton.astro";

const user = Astro.locals.user || { username: "Invitado" };
---

<Modal id="feedback_modal">
  <Fragment slot="content">
    {/* Botón de cerrar (X) en la esquina superior derecha */}
    <button
      type="button"
      class="btn btn-sm btn-circle btn-ghost absolute top-4 right-4"
      aria-label="Cerrar modal"
      data-close-feedback-modal
    >
      <Icon name="boxicons:x-filled" size={20} />
    </button>

    <h3
      class="text-base-content mb-4 flex items-center gap-2 text-lg font-bold"
    >
      <Icon name="boxicons:mail-open-filled" size={24} class="text-primary" />
      <span>Enviar Comentarios o Reportes</span>
    </h3>

    {/* Pestañas de Navegación del Modal */}
    <div
      class="tabs tabs-boxed bg-base-200 mb-6 grid grid-cols-2 rounded-md p-1"
    >
      <button
        type="button"
        id="tab-sugerencia"
        class="tab tab-active bg-base-100 flex items-center justify-center gap-2 rounded-md py-2 text-sm font-semibold shadow-sm transition-all"
      >
        <Icon name="boxicons:light-bulb-filled" size={18} />
        <span>Sugerir Idea</span>
      </button>
      <button
        type="button"
        id="tab-bug"
        class="tab text-base-content/60 flex items-center justify-center gap-2 rounded-md py-2 text-sm font-medium transition-all"
      >
        <Icon name="boxicons:bug-filled" size={18} />
        <span>Reportar Bug</span>
      </button>
    </div>

    {/* Formulario de Sugerir Idea */}
    <form id="suggestion-form" class="space-y-4">
      <FormField
        id="sug-asunto"
        name="sug-asunto"
        label="Asunto"
        placeholder="Ej: Agregar exportación a Excel en terminales"
        inputClass="text-sm"
        required
      />

      <SelectField
        id="sug-categoria"
        name="sug-categoria"
        label="Área o Categoría"
        required
      >
        <option value="" disabled selected>Selecciona una opción</option>
        <option value="cronograma">Cronograma</option>
        <option value="asistencia">Asistencia</option>
        <option value="calidad">Calidad</option>
        <option value="autogesitones">Autogestiones</option>
        <option value="titulos">Títulos</option>
        <option value="mesas-de-ayuda">Mesas de Ayuda</option>
        <option value="buscador-usuarios">Buscador de Usuarios</option>
        <option value="contactos">Contactos</option>
        <option value="enlaces">Enlaces/Recursos</option>
        <option value="oficinas">Oficinas</option>
        <option value="inventario">Inventario de Terminales</option>
        <option value="otros">Otros</option>
      </SelectField>

      <FormTextarea
        id="sug-mensaje"
        name="sug-mensaje"
        label="Tu Propuesta"
        placeholder="Describe detalladamente tu propuesta o idea..."
        rows={4}
        required
      />
    </form>

    {/* Formulario de Reportar Bug */}
    <form id="bug-form" class="hidden space-y-4">
      <FormField
        id="bug-asunto"
        name="bug-asunto"
        label="Asunto"
        placeholder="Ej: El buscador no funciona"
        inputClass="text-sm"
        required
      />

      <SelectField id="bug-categoria" name="bug-categoria" label="Área o Categoría" required>
        <option value="" disabled selected>Selecciona una opción</option>
        <option value="cronograma">Cronograma</option>
        <option value="asistencia">Asistencia</option>
        <option value="calidad">Calidad</option>
        <option value="autogesitones">Autogestiones</option>
        <option value="titulos">Títulos</option>
        <option value="mesas-de-ayuda">Mesas de Ayuda</option>
        <option value="buscador-usuarios">Buscador de Usuarios</option>
        <option value="contactos">Contactos</option>
        <option value="enlaces">Enlaces/Recursos</option>
        <option value="oficinas">Oficinas</option>
        <option value="inventario">Inventario de Terminales</option>
        <option value="otros">Otros</option>
      </SelectField>

      <SelectField
        id="bug-gravedad"
        name="bug-gravedad"
        label="Gravedad"
        required
      >
        <option value="" disabled selected>Selecciona una opción</option>
        <option value="leve">Leve (Visual / Estético)</option>
        <option value="moderado"
          >Moderado (Funcionalidad con alternativa)</option
        >
        <option value="critico">Crítico (Fallo bloqueante)</option>
      </SelectField>

      <FormTextarea
        id="bug-descripcion"
        name="bug-descripcion"
        label="Descripción del Fallo"
        placeholder="Describe detalladamente qué ocurrió..."
        rows={3}
        required
      />

      <FormTextarea
        id="bug-pasos"
        name="bug-pasos"
        label="Pasos para Reproducir"
        placeholder="1. Ingresar a /mapa-sucursales
2. Cambiar a vista móvil
3. Observar que..."
        rows={4}
        required
      />
    </form>
  </Fragment>
  <Fragment slot="actions">
    <div class="modal-action mt-6 flex items-center justify-between">
      <div class="text-xxs text-base-content/50">
        Enviando como: <span class="text-base-content font-semibold"
          >{user.username}</span
        >
      </div>
      <div class="flex gap-2">
        <ActionCancelButton
          type="button"
          variant="error"
          icon="boxicons:x-filled"
          label="Cancelar"
          data-close-feedback-modal
        />
        <ActionConfirmButton
          type="submit"
          id="btn-submit-sugerencia"
          color="btn-primary"
          form="suggestion-form"
          label="Enviar sugerencia"
          icon="boxicons:send-filled"
        />
        <ActionConfirmButton
          type="submit"
          id="btn-submit-bug"
          color="btn-primary"
          class="hidden"
          form="bug-form"
          label="Reportar bug"
          icon="boxicons:send-filled"
        />
      </div>
    </div>
  </Fragment>
</Modal>

<script>
  import { actions, isInputError } from "astro:actions";
  import { showToast } from "@/lib/toastClient";

  // Variables y Elementos del DOM
  const modal = document.getElementById("feedback_modal") as HTMLDialogElement;
  const tabSugerencia = document.getElementById("tab-sugerencia");
  const tabBug = document.getElementById("tab-bug");
  const formSugerencia = document.getElementById(
    "suggestion-form",
  ) as HTMLFormElement;
  const formBug = document.getElementById("bug-form") as HTMLFormElement;
  const closeButtons = document.querySelectorAll("[data-close-feedback-modal]");
  const openButtons = document.querySelectorAll("[data-open-feedback-modal]");
  const btnSubmitSugerencia = document.getElementById("btn-submit-sugerencia");
  const btnSubmitBug = document.getElementById("btn-submit-bug");

  let activeType: "sugerencia" | "bug" = "sugerencia";

  // 1. Manejo del cambio de pestañas
  function switchTab(
    activeTab: HTMLElement,
    inactiveTab: HTMLElement,
    showForm: HTMLFormElement,
    hideForm: HTMLFormElement,
    type: "sugerencia" | "bug",
  ) {
    activeTab.classList.add(
      "tab-active",
      "bg-base-100",
      "shadow-sm",
      "font-semibold",
    );
    activeTab.classList.remove("text-base-content/60", "font-medium");
    inactiveTab.classList.remove(
      "tab-active",
      "bg-base-100",
      "shadow-sm",
      "font-semibold",
    );
    inactiveTab.classList.add("text-base-content/60", "font-medium");
    showForm.classList.remove("hidden");
    hideForm.classList.add("hidden");
    activeType = type;

    if (type === "sugerencia") {
      btnSubmitSugerencia?.classList.remove("hidden");
      btnSubmitBug?.classList.add("hidden");
    } else {
      btnSubmitSugerencia?.classList.add("hidden");
      btnSubmitBug?.classList.remove("hidden");
    }
  }

  tabSugerencia?.addEventListener("click", () => {
    if (tabSugerencia && tabBug && formSugerencia && formBug) {
      switchTab(tabSugerencia, tabBug, formSugerencia, formBug, "sugerencia");
    }
  });

  tabBug?.addEventListener("click", () => {
    if (tabBug && tabSugerencia && formBug && formSugerencia) {
      switchTab(tabBug, tabSugerencia, formBug, formSugerencia, "bug");
    }
  });

  // Función de mapeo para preseleccionar la categoría según la ruta activa
  function getCategoryFromPath(path: string): string {
    const normalized = path.toLowerCase().replace(/\/$/, "");

    if (normalized.includes("/supervision/cronograma")) return "cronograma";
    if (normalized.includes("/supervision/asistencia")) return "asistencia";
    if (normalized.includes("/supervision/calidad")) return "calidad";
    if (normalized.includes("/supervision/asignacion")) return "autogesitones";
    if (normalized.includes("/supervision")) return "cronograma"; // default fallback

    if (normalized.includes("/titulos")) return "titulos";
    if (normalized.includes("/mesas-de-ayuda")) return "mesas-de-ayuda";
    if (normalized.includes("/buscador-usuarios")) return "buscador-usuarios";
    if (normalized.includes("/contactos")) return "contactos";
    if (
      normalized.includes("/enlaces-recursos") ||
      normalized.includes("/recursos")
    )
      return "enlaces";
    if (
      normalized.includes("/directorio-oficinas") ||
      normalized.includes("/oficinas")
    )
      return "oficinas";
    if (
      normalized.includes("/inventario-equipos") ||
      normalized.includes("/inventario-terminales")
    )
      return "inventario";

    return "otros";
  }

  function autoSelectCategory() {
    const category = getCategoryFromPath(window.location.pathname);
    const sugSelect = document.getElementById(
      "sug-categoria",
    ) as HTMLSelectElement | null;
    const bugSelect = document.getElementById(
      "bug-categoria",
    ) as HTMLSelectElement | null;

    if (sugSelect) sugSelect.value = category;
    if (bugSelect) bugSelect.value = category;
  }

  // 2. Controladores de abrir y cerrar
  openButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      if (modal) {
        autoSelectCategory();
        modal.showModal();
      }
    });
  });

  closeButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      if (modal) {
        modal.close();
      }
    });
  });

  // 3. Manejo de envío asíncrono
  async function handleFormSubmit(
    e: SubmitEvent,
    type: "sugerencia" | "bug",
    form: HTMLFormElement,
  ) {
    e.preventDefault();
    const submitBtn = form.querySelector(
      'button[type="submit"]',
    ) as HTMLButtonElement;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.classList.add("loading");
    }

    try {
      const userAgent = `Ruta: ${window.location.pathname} | ${navigator.userAgent}`;
      let payload: any = {
        type,
        userAgent,
      };

      if (type === "sugerencia") {
        payload.subject = (
          document.getElementById("sug-asunto") as HTMLInputElement
        ).value;
        payload.category = (
          document.getElementById("sug-categoria") as HTMLSelectElement
        ).value;
        payload.description = (
          document.getElementById("sug-mensaje") as HTMLTextAreaElement
        ).value;
      } else {
        payload.subject = (
          document.getElementById("bug-asunto") as HTMLInputElement
        ).value;
        payload.category = (
          document.getElementById("bug-categoria") as HTMLSelectElement
        ).value;
        payload.severity = (
          document.getElementById("bug-gravedad") as HTMLSelectElement
        ).value;
        payload.description = (
          document.getElementById("bug-descripcion") as HTMLTextAreaElement
        ).value;
        payload.steps = (
          document.getElementById("bug-pasos") as HTMLTextAreaElement
        ).value;
      }

      const { data, error } = await actions.submitFeedback(payload);

      if (error) {
        if (isInputError(error)) {
          const messages = Object.values(error.fields).flat().join(". ");
          showToast(`Error de validación: ${messages}`, "alert-error");
        } else {
          showToast(`Error al enviar: ${error.message}`, "alert-error");
        }
      } else if (data?.success) {
        showToast(
          type === "sugerencia"
            ? "¡Sugerencia enviada correctamente!"
            : "¡Reporte de bug enviado con éxito!",
          "alert-success",
        );
        form.reset();
        modal.close();
      }
    } catch (err: any) {
      showToast("Ocurrió un error inesperado al enviar.", "alert-error");
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.classList.remove("loading");
      }
    }
  }

  formSugerencia?.addEventListener("submit", (e) =>
    handleFormSubmit(e, "sugerencia", formSugerencia),
  );
  formBug?.addEventListener("submit", (e) =>
    handleFormSubmit(e, "bug", formBug),
  );
</script>
