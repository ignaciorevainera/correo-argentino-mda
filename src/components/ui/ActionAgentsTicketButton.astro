---
import { Icon } from "astro-icon/components";

interface Props {
  officeName: string;
  officeCode: string;
  ariaLabel?: string;
  class?: string;
  size?: "xs" | "default";
  [key: string]: any;
}

const {
  officeName,
  officeCode,
  ariaLabel = `Crear ticket por agentes caídos en ${officeName} (${officeCode})`,
  class: className = "",
  size = "default",
  ...attrs
} = Astro.props;

const isXs = size === "xs";
const btnClasses = isXs
  ? "btn btn-xs btn-soft btn-success gap-2"
  : "btn btn-sm md:btn-md btn-soft btn-success gap-2";
const iconName = "boxicons:alert-triangle-filled";
const iconSize = isXs ? 14 : 18;
---

<div
  class="tooltip tooltip-neutral tooltip-left z-50"
  data-tip="Reportar agentes caídos"
>
  <button
    type="button"
    class:list={[btnClasses, className]}
    data-agents-ticket-trigger
    data-office-name={officeName}
    data-office-code={officeCode}
    aria-label={ariaLabel}
    {...attrs}
  >
    <Icon name={iconName} size={iconSize} aria-hidden="true" />
  </button>
</div>
