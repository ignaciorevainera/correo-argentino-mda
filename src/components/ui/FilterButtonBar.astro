---
export interface FilterOption {
  value: string;
  label: string;
  color?:
    | "primary"
    | "secondary"
    | "accent"
    | "info"
    | "success"
    | "warning"
    | "error";
  dotColor?: string;
}

interface Props {
  id: string;
  options: FilterOption[];
  prefix: string;
  allLabel: string;
  attribute: string;
  showDots?: boolean;
}

const {
  id,
  options,
  prefix,
  allLabel,
  attribute,
  showDots = false,
} = Astro.props;

const sanitize = (v: string) => v.replace(/\s+/g, "-").toLowerCase();
---

<div class="flex flex-wrap items-center gap-1">
  <span class="label-xxs text-base-content/40 px-2 select-none">{prefix}</span>

  <button
    type="button"
    id={`${id}-all`}
    data-filter-value="all"
    data-filter-attribute={attribute}
    class="btn btn-xs btn-soft text-tiny font-bold tracking-wider uppercase"
  >
    {allLabel}
  </button>

  {
    options.map((opt) => (
      <button
        type="button"
        id={`${id}-${sanitize(opt.value)}`}
        data-filter-value={opt.value}
        data-filter-attribute={attribute}
        class="btn btn-xs btn-soft text-tiny gap-1.5 font-bold tracking-wider uppercase"
      >
        {showDots && opt.dotColor && (
          <span class:list={["h-1.5 w-1.5 rounded-full", opt.dotColor]} />
        )}
        {opt.label}
      </button>
    ))
  }
</div>
