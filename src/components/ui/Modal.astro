---
import { Icon } from "astro-icon/components";

interface Props {
  id: string;
  title?: string;
  icon?: string;
  size?: "sm" | "md" | "lg" | "xl" | "full" | "2xl" | "3xl";
  zIndex?: string;
  titleClass?: string;
  class?: string;
}

const {
  id,
  title,
  icon,
  size = "md",
  zIndex,
  titleClass,
  class: className,
} = Astro.props;

const sizeClasses: Record<string, string> = {
  sm: "max-w-sm",
  md: "max-w-md",
  lg: "max-w-lg",
  xl: "max-w-xl",
  xxl: "max-w-5xl",
  full: "max-w-6xl",
  "2xl": "max-w-2xl",
  "3xl": "max-w-3xl",
};
---

<dialog {id} class:list={["modal modal-bottom sm:modal-middle", zIndex]}>
  <div
    class:list={["modal-box w-11/12 sm:w-full", sizeClasses[size], className]}
  >
    {
      title && (
        <h3
          class:list={[
            "text-base-content mb-3 flex items-center gap-2 text-pretty",
            titleClass || "text-lg font-bold",
          ]}
        >
          {icon && (
            <Icon name={icon} class="text-secondary shrink-0" size={22} />
          )}
          {title}
        </h3>
      )
    }
    <slot name="content" />
    <slot name="actions" />
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>
