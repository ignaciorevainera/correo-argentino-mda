---
import { Icon } from "astro-icon/components";
import MonthSelect from "@components/ui/MonthSelect.astro";

interface Props {
  selectId: string;
  prevId?: string;
  nextId?: string;
  class?: string;
}

const {
  selectId,
  prevId = `${selectId}-prev`,
  nextId = `${selectId}-next`,
  class: className = "",
} = Astro.props;
---

<div class:list={["flex items-center gap-1", className]}>
  <button
    type="button"
    id={prevId}
    data-month-nav="prev"
    class="btn btn-sm btn-ghost btn-square"
    title="Mes anterior"
    aria-label="Mes anterior"
  >
    <Icon name="boxicons:chevron-left-filled" size={18} />
  </button>
  <MonthSelect id={selectId} />
  <button
    type="button"
    id={nextId}
    data-month-nav="next"
    class="btn btn-sm btn-ghost btn-square"
    title="Mes siguiente"
    aria-label="Mes siguiente"
  >
    <Icon name="boxicons:chevron-right-filled" size={18} />
  </button>
</div>
