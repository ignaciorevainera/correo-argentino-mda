---
interface Props {
  id: string;
  title: string;
  description?: string;
  class?: string;
}

const { id, title, description, class: className = "" } = Astro.props;
---

<section
  id={id}
  aria-labelledby={`${id}-title`}
  class:list={["scroll-mt-24 space-y-4", className]}
>
  <div class="border-base-300 flex flex-col gap-2 border-b pb-3">
    <p
      class="text-secondary font-mono text-xs font-semibold tracking-wide uppercase"
    >
      {id}
    </p>
    <h2 id={`${id}-title`} class="text-base-content text-xl font-bold">
      {title}
    </h2>
    {
      description && (
        <p class="text-base-content/70 max-w-3xl text-sm">{description}</p>
      )
    }
  </div>

  <slot />
</section>
