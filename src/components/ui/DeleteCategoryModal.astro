---
import { Icon } from "astro-icon/components";
import Modal from "@components/ui/Modal.astro";
import ActionCancelButton from "@components/ui/ActionCancelButton.astro";
import ActionConfirmButton from "@components/ui/ActionConfirmButton.astro";

interface Props {
  entityType: "aplicativos" | "contactos" | "recursos";
}

const { entityType } = Astro.props;

const config = {
  aplicativos: {
    title: "Eliminar Categoría de Aplicativos",
    entityPlural: "aplicativos",
    deletePath: "admin/aplicativos/categorias/edit",
  },
  contactos: {
    title: "Eliminar Categoría",
    entityPlural: "contactos",
    deletePath: "admin/contactos/categoria/edit",
  },
  recursos: {
    title: "Eliminar Categoría",
    entityPlural: "enlaces",
    deletePath: "admin/recursos/categoria/edit",
  },
}[entityType];
---

<Modal id="delete-category-modal" title={config.title} size="lg" class="w-full">
  <Fragment slot="content">
    <p class="text-base-content/80 py-4 text-sm">
      ¿Qué deseas hacer con los {config.entityPlural} que están asignados a esta categoría?
    </p>
    <form
      id="delete-category-form"
      method="POST"
      action=""
      data-delete-prefix={config.deletePath}
    >
      <div class="mt-2 flex flex-col gap-3">
        <label
          class="label border-base-300 hover:bg-base-200 cursor-pointer flex-row items-start justify-start gap-4 rounded-lg border p-4 transition-colors"
        >
          <input
            type="radio"
            name="deleteOption"
            value="unassign"
            class="radio radio-primary mt-0.5 shrink-0"
            checked
          />
          <div class="flex min-w-0 flex-1 flex-col gap-1">
            <span class="label-text text-base font-bold whitespace-normal"
              >Desvincular y conservar {config.entityPlural}</span
            >
            <span class="text-base-content/60 text-xs whitespace-normal"
              >La categoría será eliminada, pero los {config.entityPlural} se conservarán
              y se moverán a "Sin categoría".</span
            >
          </div>
        </label>
        <label
          class="label border-base-300 hover:bg-base-200 cursor-pointer flex-row items-start justify-start gap-4 rounded-lg border p-4 transition-colors"
        >
          <input
            type="radio"
            name="deleteOption"
            value="cascade"
            class="radio radio-error mt-0.5 shrink-0"
          />
          <div class="flex min-w-0 flex-1 flex-col gap-1">
            <span
              class="label-text text-error text-base font-bold whitespace-normal"
              >Eliminar todo en Cascada</span
            >
            <span class="text-base-content/60 text-xs whitespace-normal"
              >La categoría y todos los {config.entityPlural} que contenga serán eliminados
              permanentemente. Esta acción no se puede deshacer.</span
            >
          </div>
        </label>
      </div>
      <div class="modal-action mt-6 flex-col gap-3 sm:flex-row">
        <ActionCancelButton
          type="button"
          class="w-full sm:w-auto"
          variant="error"
          icon="boxicons:x-filled"
          onclick="document.getElementById('delete-category-modal').close()"
        />
        <ActionConfirmButton
          type="submit"
          color="btn-error"
          class="w-full sm:w-auto"
          label="Confirmar Eliminación"
          icon="boxicons:trash-filled"
        />
      </div>
    </form>
  </Fragment>
</Modal>

<script>
  import { getCleanBase } from "@lib/baseUrl";
  const cleanBase = getCleanBase();

  (window as any).openDeleteCategoryModal = (categoryId: string) => {
    const modal = document.getElementById("delete-category-modal") as
      (HTMLDialogElement & { showModal(): void }) | null;
    const form = document.getElementById(
      "delete-category-form",
    ) as HTMLFormElement | null;
    if (modal && form) {
      const prefix = form.dataset.deletePrefix!;
      form.action = `${cleanBase}${prefix}/${categoryId}/eliminar`;
      modal.showModal();
    }
  };
</script>
