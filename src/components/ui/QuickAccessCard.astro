---
import { getCleanBase } from "@lib/baseUrl";
import { Icon } from "astro-icon/components";

interface Props {
  href: string;
  title: string;
  description: string;
  icon: string;
  iconTone?: string;
  locked?: boolean;
  comingSoon?: boolean;
  layout?: "horizontal" | "vertical" | "compact" | "mini";
}

const {
  href,
  title,
  description,
  icon,
  iconTone = "bg-secondary/10 text-secondary",
  locked = false,
  comingSoon = false,
  layout = "vertical",
} = Astro.props;

const cleanBase = getCleanBase();
const isWebUrl = (value: string): boolean => /^https?:\/\//i.test(value);
const resolvedHref =
  isWebUrl(href) ||
  href.startsWith("mailto:") ||
  href.startsWith("tel:") ||
  href.startsWith(cleanBase)
    ? href
    : `${cleanBase}${href.startsWith("/") ? href.slice(1) : href}`;

const Wrapper = locked || comingSoon ? "div" : "a";

// Escala por variante: `compact` y `mini` comparten la fila (ícono + título,
// sin descripción); `mini` baja las dimensiones interiores y el padding.
const isRow = layout === "compact" || layout === "mini";
const isMini = layout === "mini";
const rowPaddingClass = isMini ? "p-3" : "p-6";
const rowGapClass = isMini ? "gap-3" : "gap-4";
const iconBoxClass = isMini
  ? "flex h-8 w-8 shrink-0 items-center justify-center rounded-lg transition-transform duration-300"
  : "flex h-12 w-12 shrink-0 items-center justify-center rounded-xl transition-transform duration-300";
const iconGlyphSize = isMini ? 20 : 32;
const titleClass = isMini
  ? "text-base-content text-sm font-bold truncate"
  : "text-base-content text-lg font-bold truncate";
---

{
  isRow ? (
    <Wrapper
      {...(!(locked || comingSoon)
        ? {
            href: resolvedHref,
            "aria-label": `Abrir ${title}`,
            title: description || title,
          }
        : {
            "aria-label": `${title} (${comingSoon ? "Próximamente" : "Restringido"})`,
          })}
      data-layout={layout}
      class:list={[
        "rounded-box bg-base-100 border-base-200 relative flex h-full items-center gap-3 border shadow-sm transition-all duration-300",
        rowPaddingClass,
        locked || comingSoon
          ? "cursor-not-allowed opacity-40 grayscale select-none"
          : "hover:border-base-300 group focus:ring-primary cursor-pointer hover:-translate-y-1 hover:shadow-md focus:ring-2 focus:ring-offset-2 focus:outline-none",
      ]}
    >
      <div class={`flex min-w-0 flex-1 items-center ${rowGapClass}`}>
        <div class:list={[iconBoxClass, iconTone]} aria-hidden="true">
          <Icon
            name={icon}
            size={iconGlyphSize}
            is:inline
            class={
              locked || comingSoon
                ? ""
                : "transition-transform duration-300 group-hover:scale-110"
            }
          />
        </div>
        <div class="min-w-0 flex-1">
          <h3 class={titleClass}>{title}</h3>
        </div>
      </div>
      <div class="flex shrink-0 items-center" aria-hidden="true">
        {locked || comingSoon ? (
          <Icon
            name="boxicons:lock-filled"
            size={24}
            is:inline
            class="text-base-content/40"
          />
        ) : (
          <Icon
            name="boxicons:chevron-right"
            size={24}
            is:inline
            class="text-base-content/30 transition-transform duration-300 group-hover:translate-x-1"
          />
        )}
      </div>
    </Wrapper>
  ) : layout === "horizontal" ? (
    <Wrapper
      {...(!(locked || comingSoon)
        ? { href: resolvedHref, "aria-label": `Abrir ${title}` }
        : {
            "aria-label": `${title} (${comingSoon ? "Próximamente" : "Restringido"})`,
          })}
      data-layout={layout}
      class:list={[
        "rounded-box border-base-200 bg-base-100 relative flex h-full w-full items-center justify-between overflow-hidden border p-5 shadow-sm transition-all duration-300",
        locked || comingSoon
          ? "cursor-not-allowed opacity-40 grayscale select-none"
          : "hover:border-base-300 group focus:ring-primary cursor-pointer hover:-translate-y-1 hover:shadow-md focus:ring-2 focus:ring-offset-2 focus:outline-none",
      ]}
    >
      <div class="flex items-center gap-4">
        <div class:list={[iconBoxClass, iconTone]}>
          <Icon
            name={icon}
            size={iconGlyphSize}
            is:inline
            class={
              locked || comingSoon
                ? ""
                : "transition-transform duration-300 group-hover:scale-110"
            }
            aria-hidden="true"
          />
        </div>
        <div>
          <h3 class={titleClass}>{title}</h3>
          <p class="text-base-content/70 text-xs">{description}</p>
        </div>
      </div>
      <div class="flex items-center" aria-hidden="true">
        {locked || comingSoon ? (
          <Icon
            name="boxicons:lock-filled"
            size={24}
            is:inline
            class="text-base-content/40"
          />
        ) : (
          <Icon
            name="boxicons:chevron-right"
            size={24}
            is:inline
            class="text-base-content/30 transition-transform duration-300 group-hover:translate-x-1"
          />
        )}
      </div>
    </Wrapper>
  ) : (
    <Wrapper
      {...(!(locked || comingSoon)
        ? { href: resolvedHref, "aria-label": `Abrir ${title}` }
        : {
            "aria-label": `${title} (${comingSoon ? "Próximamente" : "Restringido"})`,
          })}
      data-layout={layout}
      class:list={[
        "card bg-base-100 border-base-200 h-full border shadow-sm",
        locked || comingSoon
          ? "cursor-not-allowed opacity-40 grayscale select-none"
          : "hover:border-base-300 group focus:ring-primary transition-all duration-300 hover:-translate-y-1 hover:shadow-md focus:ring-2 focus:ring-offset-2 focus:outline-none",
      ]}
    >
      <div class="card-body flex h-full flex-col gap-3">
        <div aria-hidden="true" class:list={[iconBoxClass, iconTone]}>
          <Icon
            name={icon}
            size={iconGlyphSize}
            is:inline
            class={
              locked || comingSoon
                ? ""
                : "transition-transform duration-300 group-hover:scale-110"
            }
          />
        </div>
        <h3 class={titleClass}>{title}</h3>
        <p class="text-base-content/70 text-xs">{description}</p>
        <!-- La card entera es el link: sin footer de "Ver más" (redundante). -->
        {
          (comingSoon || locked) && (
            <div class="card-actions justify-end">
              {comingSoon ? (
                <span class="badge badge-warning font-bold">Próximamente</span>
              ) : (
                <Icon
                  name="boxicons:lock-filled"
                  size={24}
                  is:inline
                  class="text-base-content/40"
                  aria-hidden="true"
                />
              )}
            </div>
          )
        }
      </div>
    </Wrapper>
  )
}
