---
import { Icon } from "astro-icon/components";

export interface Props {
  id: string;
  placeholder?: string;
  ariaLabel?: string;
  class?: string;
}

const {
  id,
  placeholder = "Buscar...",
  ariaLabel,
  class: wrapperClass = "",
} = Astro.props;
---

<div class:list={["group relative", wrapperClass]}>
  <div
    class="join border-base-300 group-focus-within:border-base-content/30 group-focus-within:ring-base-content/5 bg-base-100 w-full overflow-hidden rounded-xl border shadow-md transition-[border-color,box-shadow] duration-300 group-focus-within:ring-2"
  >
    <label class="input input-lg w-full border-0 bg-transparent" for={id}>
      <Icon
        name="boxicons:search"
        size={24}
        class="text-base-content/50 group-focus-within:text-primary opacity-70 transition-all duration-300 group-focus-within:opacity-100"
      />
      <input
        type="text"
        {id}
        {placeholder}
        aria-label={ariaLabel ?? placeholder}
        class="grow text-base sm:text-lg"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd
        class="kbd kbd-sm text-base-content/50 font-sans font-bold transition-opacity duration-300 group-focus-within:opacity-0"
      >
        /
      </kbd>
    </label>
  </div>
</div>
