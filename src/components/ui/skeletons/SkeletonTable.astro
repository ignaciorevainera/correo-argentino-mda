---
interface Props {
  rows?: number;
  columns?: number;
  class?: string;
}

const { rows = 5, columns = 4, class: className = "" } = Astro.props;
---

<div
  class:list={[
    "skeleton-debounced",
    "bg-base-100 border-base-300 overflow-hidden rounded-2xl border shadow-md",
    className,
  ]}
>
  <div class="min-h-[300px] overflow-x-auto">
    <table class="w-full border-collapse text-left text-sm">
      <thead class="bg-base-200/80 border-base-300 border-b">
        <tr>
          {
            Array.from({ length: columns }).map(() => (
              <th class="px-4 py-3.5">
                <div class="skeleton h-4 w-20 rounded" />
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody class="divide-base-200 divide-y">
        {
          Array.from({ length: rows }).map(() => (
            <tr>
              {Array.from({ length: columns }).map((_, colIndex) => (
                <td class="px-4 py-4">
                  {colIndex === 0 ? (
                    <div class="flex items-center gap-3">
                      <div class="skeleton size-8 shrink-0 rounded-full" />
                      <div class="w-full space-y-1.5">
                        <div class="skeleton h-4 w-28 rounded" />
                        <div class="skeleton h-3 w-20 rounded" />
                      </div>
                    </div>
                  ) : colIndex === columns - 1 ? (
                    <div class="flex justify-end">
                      <div class="skeleton h-8 w-16 rounded-lg" />
                    </div>
                  ) : (
                    <div class="skeleton h-4 w-24 rounded" />
                  )}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>
