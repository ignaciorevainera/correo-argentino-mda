---
interface Props {
  count?: number;
  class?: string;
}

const { count = 1, class: className = "" } = Astro.props;
---

<div
  class:list={[
    "skeleton-debounced",
    "grid w-full grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4",
    className,
  ]}
>
  {
    Array.from({ length: count }).map(() => (
      <div class="bg-base-100 border-base-300 flex flex-col gap-3 rounded-2xl border p-4 shadow-sm">
        <div class="skeleton h-3 w-24 rounded" />
        <div class="skeleton h-8 w-20 rounded-lg" />
      </div>
    ))
  }
</div>
