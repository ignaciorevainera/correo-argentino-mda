---
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";

const linksGridCols =
  "grid-cols-[40px_40px_minmax(0,1.5fr)_minmax(0,2fr)_minmax(0,1.5fr)_80px] gap-4";
---

<PageContainer>
  <div class="skeleton-debounced">
    <div
      class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <PageHeader
        title="Gestión de Enlaces y Recursos"
        description="Refactorizá, reordená y organizá los accesos rápidos de soporte técnico."
      />
      <div class="flex shrink-0 gap-2">
        <div class="skeleton h-9 w-36 rounded-lg"></div>
        <div class="skeleton h-9 w-40 rounded-lg"></div>
      </div>
    </div>

    <!-- Contenedor Principal Split View Skeleton -->
    <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-4">
      <!-- Panel Izquierdo: Categorías Sidebar -->
      <aside
        class="bg-base-100 border-base-300 rounded-box flex flex-col gap-3 border p-4 shadow-sm lg:col-span-1"
      >
        <div
          class="border-base-200 flex items-center justify-between border-b pb-2"
        >
          <span
            class="text-base-content/60 text-xs font-bold tracking-wider uppercase"
            >Categorías</span
          >
        </div>

        <div class="flex flex-col gap-1">
          {
            Array.from({ length: 5 }).map(() => (
              <div class="flex items-center justify-between rounded-lg border border-transparent px-3 py-2.5">
                <div class="flex min-w-0 grow items-center gap-2.5">
                  <div class="border-base-300 skeleton size-8 shrink-0 rounded-md border" />
                  <div class="skeleton h-4 w-24 rounded" />
                </div>
                <div class="skeleton ml-2 h-5 w-8 rounded" />
              </div>
            ))
          }
        </div>
      </aside>

      <!-- Panel Derecho: Enlaces DataTable -->
      <main class="flex flex-col gap-4 lg:col-span-3">
        <div
          class="bg-base-100 border-base-300 rounded-box border p-4 shadow-sm"
        >
          <!-- Cabecera de Categoría Seleccionada y Buscador -->
          <div
            class="border-base-200 mb-4 flex flex-col items-center justify-between gap-4 border-b pb-4 sm:flex-row"
          >
            <div class="flex items-center gap-3">
              <div class="border-base-300 skeleton size-9 rounded-lg border">
              </div>
              <div class="space-y-1.5">
                <div class="skeleton h-5 w-32 rounded"></div>
                <div class="skeleton h-3.5 w-60 rounded"></div>
              </div>
            </div>
            <div class="w-full shrink-0 sm:max-w-xs">
              <div class="skeleton h-10 w-full rounded-lg"></div>
            </div>
          </div>

          <!-- Tabla Única de Enlaces -->
          <div
            class="border-base-300 bg-base-100 overflow-hidden rounded-xl border shadow-sm"
          >
            <div
              class={`grid ${linksGridCols} border-b border-base-300 px-4 py-3 bg-base-200/50`}
            >
              <div></div>
              <!-- Grab Handle placeholder -->
              <div><div class="skeleton h-5 w-10 rounded"></div></div>
              <div><div class="skeleton h-5 w-16 rounded"></div></div>
              <div><div class="skeleton h-5 w-24 rounded"></div></div>
              <div><div class="skeleton h-5 w-12 rounded"></div></div>
              <div>
                <div class="skeleton h-5 w-16 justify-self-end rounded"></div>
              </div>
            </div>

            <div class="divide-base-200 divide-y">
              {
                Array.from({ length: 6 }).map(() => (
                  <div class={`grid ${linksGridCols} items-center px-4 py-3`}>
                    <div class="flex justify-center">
                      <div class="skeleton h-5 w-5 rounded" />
                    </div>
                    <div>
                      <div class="skeleton size-8 rounded-md" />
                    </div>
                    <div>
                      <div class="skeleton h-4 w-32 rounded" />
                    </div>
                    <div>
                      <div class="skeleton h-4 w-44 rounded" />
                    </div>
                    <div>
                      <div class="skeleton h-4 w-40 rounded font-mono" />
                    </div>
                    <div class="flex justify-end gap-1">
                      <div class="skeleton h-6 w-16 rounded" />
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
</PageContainer>
