---
interface Props {
  html: string;
}

const { html } = Astro.props;
---

<article
  class="doc-article-body border-base-300 bg-base-100 rounded-box min-w-0 border p-5 shadow-sm sm:p-8"
  set:html={html}
/>

<style is:global>
  .doc-article-body {
    color: var(--color-base-content);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .doc-article-body > :first-child {
    margin-top: 0;
  }

  .doc-article-body > :last-child {
    margin-bottom: 0;
  }

  .doc-article-body h1,
  .doc-article-body h2,
  .doc-article-body h3,
  .doc-article-body h4,
  .doc-article-body h5,
  .doc-article-body h6 {
    color: var(--color-base-content);
    font-weight: 700;
    line-height: 1.25;
    margin: 1.75rem 0 0.5rem;
    scroll-margin-top: 6rem;
  }

  .doc-article-body h1 {
    font-size: 1.875rem;
  }

  .doc-article-body h2 {
    border-bottom: 1px solid var(--color-base-300);
    font-size: 1.4rem;
    padding-bottom: 0.35rem;
  }

  .doc-article-body h3 {
    font-size: 1.15rem;
  }

  .doc-article-body h4 {
    font-size: 1rem;
  }

  .doc-article-body p {
    margin: 0 0 0.875rem;
  }

  .doc-article-body ul,
  .doc-article-body ol {
    margin: 0.75rem 0 1rem;
    padding-left: 1.5rem;
  }

  .doc-article-body ul {
    list-style: disc;
  }

  .doc-article-body ol {
    list-style: decimal;
  }

  .doc-article-body li {
    margin: 0.2rem 0;
  }

  .doc-article-body li > ul,
  .doc-article-body li > ol {
    margin: 0.25rem 0;
  }

  .doc-article-body ul:has(> li > input[type="checkbox"]) {
    list-style: none;
    padding-left: 0.25rem;
  }

  .doc-article-body li > input[type="checkbox"] {
    margin-right: 0.5rem;
    vertical-align: middle;
  }

  .doc-article-body a {
    color: var(--color-secondary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .doc-article-body strong {
    font-weight: 700;
  }

  .doc-article-body blockquote {
    border-left: 3px solid var(--color-secondary);
    color: color-mix(in oklab, var(--color-base-content) 75%, transparent);
    margin: 1rem 0;
    padding: 0.25rem 0 0.25rem 1rem;
  }

  .doc-article-body blockquote p {
    margin: 0.35rem 0;
  }

  .doc-article-body hr {
    border-color: var(--color-base-300);
    margin: 1.75rem 0;
  }

  .doc-article-body code {
    background: var(--color-base-200);
    border-radius: 0.25rem;
    font-family: var(
      --font-mono,
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace
    );
    font-size: 0.85em;
    padding: 0.1rem 0.3rem;
  }

  .doc-article-body pre {
    background: var(--color-base-200);
    border: 1px solid var(--color-base-300);
    border-radius: 0.5rem;
    margin: 1rem 0;
    overflow-x: auto;
    padding: 1rem;
  }

  .doc-article-body pre code {
    background: transparent;
    border-radius: 0;
    font-size: 0.82rem;
    padding: 0;
    white-space: pre;
  }

  .doc-article-body table {
    border-collapse: collapse;
    display: block;
    font-size: 0.82rem;
    margin: 1rem 0;
    max-width: 100%;
    overflow-x: auto;
    width: 100%;
  }

  .doc-article-body thead {
    background: var(--color-base-200);
  }

  .doc-article-body th,
  .doc-article-body td {
    border: 1px solid var(--color-base-300);
    padding: 0.45rem 0.55rem;
    text-align: left;
    vertical-align: top;
  }

  .doc-article-body th {
    font-weight: 700;
    white-space: nowrap;
  }

  .doc-article-body del {
    opacity: 0.7;
  }
</style>
