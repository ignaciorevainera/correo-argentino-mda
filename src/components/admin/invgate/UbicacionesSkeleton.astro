---
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import DataTable from "@components/ui/DataTable.astro";
import DataTableHeaderCell from "@components/ui/DataTableHeaderCell.astro";

const headerGridClass =
  "grid-cols-[120px_1fr_100px_120px_100px_1fr_120px_1.5fr] gap-4";
const rowGridClass =
  "grid grid-cols-[120px_1fr_100px_120px_100px_1fr_120px_1.5fr] items-center gap-4";
---

<PageContainer width="xl">
  <div class="skeleton-debounced">
    <PageHeader
      title="Ubicaciones InvGate"
      description="Comparativa de ubicaciones reportadas por InvGate contra las oficinas registradas en la base de datos de MDA."
    />

    <!-- Stats Grid Skeleton -->
    <div class="my-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        Array.from({ length: 4 }).map(() => (
          <div class="card bg-base-100 border-base-200 space-y-3 border p-4 shadow">
            <div class="skeleton bg-base-200/50 h-4 w-28 rounded" />
            <div class="skeleton bg-base-200/50 h-8 w-16 rounded-lg" />
          </div>
        ))
      }
    </div>

    <!-- Search & Filters skeleton -->
    <div
      class="mb-6 flex flex-col items-stretch justify-between gap-4 md:flex-row md:items-center"
    >
      <!-- Filter tabs skeleton -->
      <div class="flex gap-2">
        <div class="skeleton bg-base-200/50 h-10 w-24 rounded"></div>
        <div class="skeleton bg-base-200/50 h-10 w-32 rounded"></div>
        <div class="skeleton bg-base-200/50 h-10 w-28 rounded"></div>
      </div>

      <!-- Search input skeleton -->
      <div class="skeleton bg-base-200/50 h-10 w-full rounded md:w-80"></div>
    </div>

    <!-- Table Skeleton -->
    <div class="space-y-4">
      <DataTable
        ariaLabel="Cargando comparación de ubicaciones..."
        minWidthClass="min-w-[1000px]"
        headerGridClass={headerGridClass}
        rowGridClass={rowGridClass}
      >
        <div slot="header">
          <DataTableHeaderCell>Estado</DataTableHeaderCell>
        </div>
        <div slot="header">
          <DataTableHeaderCell>Ubicación InvGate</DataTableHeaderCell>
        </div>
        <div slot="header"><DataTableHeaderCell>NIS</DataTableHeaderCell></div>
        <div slot="header"><DataTableHeaderCell>CP</DataTableHeaderCell></div>
        <div slot="header"><DataTableHeaderCell>CC</DataTableHeaderCell></div>
        <div slot="header">
          <DataTableHeaderCell>Oficina MDA</DataTableHeaderCell>
        </div>
        <div slot="header">
          <DataTableHeaderCell>Código MDA</DataTableHeaderCell>
        </div>
        <div slot="header">
          <DataTableHeaderCell>Dirección MDA</DataTableHeaderCell>
        </div>

        {
          Array.from({ length: 10 }).map(() => (
            <div
              class:list={[
                rowGridClass,
                "border-base-200 animate-pulse border-b px-4 py-4 last:border-b-0",
              ]}
            >
              <div class="skeleton bg-base-200/50 h-6 w-20 rounded-full" />
              <div class="skeleton bg-base-200/50 h-4 w-40 rounded" />
              <div class="skeleton bg-base-200/50 h-4 w-12 rounded" />
              <div class="skeleton bg-base-200/50 h-4 w-20 rounded" />
              <div class="skeleton bg-base-200/50 h-4 w-16 rounded" />
              <div class="skeleton bg-base-200/50 h-4 w-32 rounded" />
              <div class="skeleton bg-base-200/50 h-4 w-14 rounded" />
              <div class="skeleton bg-base-200/50 h-4 w-48 rounded" />
            </div>
          ))
        }
      </DataTable>
    </div>
  </div>
</PageContainer>
