---
import { db } from "@db/index";
import { routes, modules, mesas, routeAccess, moduleAccess } from "@db/schema";
import { EDITABLE_ROLES } from "@lib/permissions/types";

const [routeRows, moduleRows, mesaRows, routeAccessRows, moduleAccessRows] =
  await Promise.all([
    db.select().from(routes),
    db.select().from(modules),
    db.select().from(mesas),
    db.select().from(routeAccess),
    db.select().from(moduleAccess),
  ]);

const routeList = routeRows.sort((a, b) => a.sortOrder - b.sortOrder);
const moduleList = moduleRows.sort((a, b) => a.sortOrder - b.sortOrder);
const mesaList = [...mesaRows].sort((a, b) => a.name.localeCompare(b.name));
const activeMesas = mesaList.filter((m) => m.active);
const inactiveMesas = mesaList.filter((m) => !m.active);

// Initial state for client-side diff. Escape "<" so mesa names can't break out
// of the JSON script tag.
const initialJson = JSON.stringify({
  mesas: mesaList,
  routeAccess: routeAccessRows,
  moduleAccess: moduleAccessRows,
}).replace(/</g, "\\u003c");

// Route overrides: key "routeId:role:mesaId" -> allowed
const routeAllowed = new Map(
  routeAccessRows.map((r) => [`${r.routeId}:${r.role}:${r.mesaId}`, r.allowed]),
);

// Module overrides: key "moduleId:role:mesaId" -> flags object
const moduleFlags = new Map(
  moduleAccessRows.map((r) => [`${r.moduleId}:${r.role}:${r.mesaId}`, r]),
);

const MODULE_DEFAULTS: Record<string, boolean> = {
  canRead: false,
  canWrite: false,
  canViewAll: true,
  canViewComments: true,
  canViewTotals: true,
};

const ROLE_LABELS: Record<string, string> = {
  agent: "Agente",
  referent: "Referente",
  team_leader: "Líder de equipo",
  supervisor: "Supervisor",
};
---

<div id="permisos-root" data-mesa-count={mesaList.length} class="space-y-4">
  <script type="application/json" id="permisos-initial" set:html={initialJson} />

  <div role="tablist" class="tabs tabs-bordered">
    <button type="button" role="tab" data-tab-btn="rutas" class="tab tab-active">Rutas</button>
    <button type="button" role="tab" data-tab-btn="modulos" class="tab">Módulos</button>
    <button type="button" role="tab" data-tab-btn="mesas" class="tab">Mesas</button>
  </div>

  <div data-tab-panel="rutas">
    <div class="bg-base-100/95 border-base-300 sticky top-0 z-10 flex flex-wrap items-center gap-2 border-b py-2">
      <input
        type="search"
        placeholder="Buscar ruta..."
        class="input input-bordered input-sm min-w-48 grow"
        data-matrix-search
      />
      <button type="button" class="btn btn-ghost btn-sm" data-expand-all="rutas">Expandir todo</button>
      <button type="button" class="btn btn-ghost btn-sm" data-collapse-all="rutas">Contraer todo</button>
      <button type="button" id="save-routes" class="btn btn-primary btn-sm" disabled>
        Guardar (<span data-diff-count="routes">0</span>)
      </button>
    </div>
    <div class="alert alert-info mt-2 py-1 text-xs">
      <span>Los permisos de admin no se editan: acceso completo solo en MDA TI.</span>
    </div>

    <div class="mt-3 space-y-3">
      {routeList.length === 0 && (
        <div class="text-base-content/60 text-sm">No hay rutas registradas.</div>
      )}
      {routeList.map((route) => (
        <section class="border-base-300 rounded-lg border" data-search={route.path.toLowerCase() + " " + route.label.toLowerCase()}>
          <button
            type="button"
            class="hover:bg-base-200 flex w-full items-center justify-between px-3 py-2 text-left"
            data-section-toggle
          >
            <span class="font-mono text-sm">{route.path}</span>
            <span class="text-base-content/70 text-sm">{route.label}</span>
          </button>
          <div data-section-body class="overflow-x-auto px-3 pb-3">
            <table class="table table-sm">
              <thead>
                <tr>
                  <th class="font-mono">Rol</th>
                  {activeMesas.map((m) => (
                    <th class="font-mono text-center">{m.name}</th>
                  ))}
                  {inactiveMesas.map((m) => (
                    <th class="font-mono text-center opacity-50" title={`Inactiva desde ${m.lastSyncedAt}`}>
                      {m.name} (inactiva)
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {EDITABLE_ROLES.map((role) => (
                  <tr>
                    <td class="font-mono">{ROLE_LABELS[role] ?? role}</td>
                    {activeMesas.map((m) => (
                      <td class="text-center" data-cell-wrap={route.id + ":" + role + ":" + m.id}>
                        <input
                          type="checkbox"
                          class="checkbox checkbox-sm"
                          data-kind="route"
                          data-route-id={route.id}
                          data-role={role}
                          data-mesa-id={m.id}
                          checked={routeAllowed.get(route.id + ":" + role + ":" + m.id) === true}
                        />
                      </td>
                    ))}
                    {inactiveMesas.map(() => (
                      <td class="opacity-40 text-center">—</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))}
    </div>
  </div>

  <div data-tab-panel="modulos" class="hidden">
    <div class="bg-base-100/95 border-base-300 sticky top-0 z-10 flex flex-wrap items-center gap-2 border-b py-2">
      <input
        type="search"
        placeholder="Buscar módulo..."
        class="input input-bordered input-sm min-w-48 grow"
        data-matrix-search
      />
      <button type="button" class="btn btn-ghost btn-sm" data-expand-all="modulos">Expandir todo</button>
      <button type="button" class="btn btn-ghost btn-sm" data-collapse-all="modulos">Contraer todo</button>
      <button type="button" id="save-modules" class="btn btn-primary btn-sm" disabled>
        Guardar (<span data-diff-count="modules">0</span>)
      </button>
    </div>

    <div class="mt-3 space-y-3">
      {moduleList.length === 0 && (
        <div class="text-base-content/60 text-sm">No hay módulos registrados.</div>
      )}
      {moduleList.map((mod) => (
        <section class="border-base-300 rounded-lg border" data-search={mod.name.toLowerCase() + " " + mod.label.toLowerCase()}>
          <button
            type="button"
            class="hover:bg-base-200 flex w-full items-center justify-between px-3 py-2 text-left"
            data-section-toggle
          >
            <span class="font-mono text-sm">{mod.name}</span>
            <span class="text-base-content/70 text-sm">{mod.label}</span>
          </button>
          <div data-section-body class="overflow-x-auto px-3 pb-3">
            <table class="table table-sm">
              <thead>
                <tr>
                  <th class="font-mono">Rol</th>
                  {activeMesas.map((m) => (
                    <th class="font-mono text-center">{m.name}</th>
                  ))}
                  {inactiveMesas.map(() => (
                    <th class="font-mono text-center opacity-50">(inactiva)</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {EDITABLE_ROLES.map((role) => (
                  <tr>
                    <td class="font-mono">{ROLE_LABELS[role] ?? role}</td>
                    {activeMesas.map((m) => {
                      const row = moduleFlags.get(mod.id + ":" + role + ":" + m.id);
                      return (
                        <td class="text-center">
                          <div class="flex flex-wrap justify-center gap-1">
                            {mod.flags.map((flag) => (
                              <label class="cursor-pointer" title={flag}>
                                <input
                                  type="checkbox"
                                  class="checkbox checkbox-xs"
                                  data-kind="module"
                                  data-module-id={mod.id}
                                  data-role={role}
                                  data-mesa-id={m.id}
                                  data-flag={flag}
                                  checked={row ? (row as any)[flag] === true : MODULE_DEFAULTS[flag]}
                                />
                              </label>
                            ))}
                          </div>
                        </td>
                      );
                    })}
                    {inactiveMesas.map(() => (
                      <td class="opacity-40 text-center">—</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))}
    </div>
  </div>

  <div data-tab-panel="mesas" class="hidden">
    <div class="flex flex-wrap items-center gap-3">
      <button type="button" id="mesas-sync" class="btn btn-primary btn-sm">
        Sincronizar desde InvGate
      </button>
      {mesaList.length > 0 && (
        <span class="text-base-content/60 text-xs">
          Última sincronización: {mesaList[0]?.lastSyncedAt ?? "—"}
        </span>
      )}
    </div>

    <div class="overflow-x-auto mt-3">
      <table class="table table-zebra table-sm">
        <thead>
          <tr>
            <th>Nombre</th>
            <th>InvGate ID</th>
            <th>Activa</th>
            <th>Sincronizado</th>
          </tr>
        </thead>
        <tbody>
          {mesaList.length === 0 && (
            <tr>
              <td colspan="4" class="text-base-content/50 text-center">
                No hay mesas. Usá "Sincronizar desde InvGate" para traerlas.
              </td>
            </tr>
          )}
          {mesaList.map((m) => (
            <tr class:list={[!m.active && "opacity-50"]}>
              <td class="font-mono">{m.name}</td>
              <td>{m.invgateId}</td>
              <td>{m.active ? "Sí" : "No"}</td>
              <td>{m.lastSyncedAt ?? "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <script>
    import { showToast } from "@lib/toastClient";
    import { getCleanBase } from "@lib/baseUrl";

    const root = document.getElementById("permisos-root");
    if (root) {
      const initial = JSON.parse(
        (document.getElementById("permisos-initial") as HTMLScriptElement).text,
      ) as {
        mesas: Array<{ id: number; name: string; active: boolean }>;
        routeAccess: Array<{ routeId: number; role: string; mesaId: number; allowed: boolean }>;
        moduleAccess: Array<{
          moduleId: number;
          role: string;
          mesaId: number;
          canRead: boolean;
          canWrite: boolean;
          canViewAll: boolean;
          canViewComments: boolean;
          canViewTotals: boolean;
        }>;
      };

      const routeInitial = new Map(
        initial.routeAccess.map((r) => [`${r.routeId}:${r.role}:${r.mesaId}`, r.allowed]),
      );
      const moduleInitial = new Map(
        initial.moduleAccess.map((r) => [`${r.moduleId}:${r.role}:${r.mesaId}`, r]),
      );
      const MODULE_DEFAULTS = {
        canRead: false,
        canWrite: false,
        canViewAll: true,
        canViewComments: true,
        canViewTotals: true,
      };

      // --- Tabs ---
      const tabButtons = root.querySelectorAll<HTMLButtonElement>("[data-tab-btn]");
      const panels = root.querySelectorAll<HTMLElement>("[data-tab-panel]");
      tabButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const target = btn.dataset.tabBtn;
          tabButtons.forEach((b) => b.classList.toggle("tab-active", b === btn));
          panels.forEach((p) => p.classList.toggle("hidden", p.dataset.tabPanel !== target));
        });
      });

      // --- Sections: expand / collapse / search ---
      root.querySelectorAll<HTMLButtonElement>("[data-section-toggle]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const body = btn.nextElementSibling as HTMLElement | null;
          if (body) body.classList.toggle("hidden");
        });
      });
      root.querySelectorAll<HTMLButtonElement>("[data-expand-all]").forEach((btn) => {
        btn.addEventListener("click", () => {
          panelOf(btn)
            .querySelectorAll<HTMLElement>("[data-section-body]")
            .forEach((b) => b.classList.remove("hidden"));
        });
      });
      root.querySelectorAll<HTMLButtonElement>("[data-collapse-all]").forEach((btn) => {
        btn.addEventListener("click", () => {
          panelOf(btn)
            .querySelectorAll<HTMLElement>("[data-section-body]")
            .forEach((b) => b.classList.add("hidden"));
        });
      });
      root.querySelectorAll<HTMLInputElement>("[data-matrix-search]").forEach((input) => {
        input.addEventListener("input", () => {
          const q = input.value.trim().toLowerCase();
          panelOf(input)
            .querySelectorAll<HTMLElement>("section[data-search]")
            .forEach((s) => {
              s.classList.toggle("hidden", q !== "" && !s.dataset.search?.includes(q));
            });
        });
      });
      function panelOf(el: Element): HTMLElement {
        return el.closest("[data-tab-panel]") as HTMLElement;
      }

      // --- Diff computation (full re-scan on any change; matrices are small) ---
      function computeRoutesDiff(): HTMLInputElement[] {
        const changed: HTMLInputElement[] = [];
        root.querySelectorAll<HTMLInputElement>('input[data-kind="route"]').forEach((cb) => {
          const key = `${cb.dataset.routeId}:${cb.dataset.role}:${cb.dataset.mesaId}`;
          if (cb.checked !== (routeInitial.get(key) ?? false)) changed.push(cb);
        });
        return changed;
      }
      function computeModuleDiff(): Map<string, HTMLInputElement[]> {
        const changed = new Map<string, HTMLInputElement[]>();
        root.querySelectorAll<HTMLInputElement>('input[data-kind="module"]').forEach((cb) => {
          const key = `${cb.dataset.moduleId}:${cb.dataset.role}:${cb.dataset.mesaId}`;
          const snap = moduleInitial.get(key);
          const defaultValue = MODULE_DEFAULTS[cb.dataset.flag as keyof typeof MODULE_DEFAULTS];
          const ref = snap ? snap[cb.dataset.flag as keyof typeof MODULE_DEFAULTS] : defaultValue;
          if (cb.checked !== ref) {
            const list = changed.get(key) ?? [];
            list.push(cb);
            changed.set(key, list);
          }
        });
        return changed;
      }
      function refreshCounts(): void {
        const routesBtn = document.getElementById("save-routes") as HTMLButtonElement | null;
        const modulesBtn = document.getElementById("save-modules") as HTMLButtonElement | null;
        const routesCount = computeRoutesDiff().length;
        const modulesCount = computeModuleDiff().size;
        if (routesBtn) {
          routesBtn.disabled = routesCount === 0;
          routesBtn.querySelector("[data-diff-count]")!.textContent = String(routesCount);
        }
        if (modulesBtn) {
          modulesBtn.disabled = modulesCount === 0;
          modulesBtn.querySelector("[data-diff-count]")!.textContent = String(modulesCount);
        }
      }
      root.addEventListener("change", (e) => {
        const t = e.target as HTMLElement;
        if (t instanceof HTMLInputElement && (t.dataset.kind === "route" || t.dataset.kind === "module")) {
          refreshCounts();
        }
      });

      // --- Save ---
      async function postJson(url: string, body: unknown): Promise<any> {
        const res = await fetch(getCleanBase() + url, {
          method: "POST",
          credentials: "same-origin",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(json?.error ?? `Error ${res.status}`);
        return json;
      }

      const saveRoutes = document.getElementById("save-routes");
      saveRoutes?.addEventListener("click", async () => {
        const btn = saveRoutes as HTMLButtonElement;
        btn.disabled = true;
        const changes = computeRoutesDiff().map((cb) => ({
          routeId: Number(cb.dataset.routeId),
          role: cb.dataset.role,
          mesaId: Number(cb.dataset.mesaId),
          allowed: cb.checked,
        }));
        try {
          const out = await postJson("api/admin/permisos/routes", { changes });
          showToast(`${out.changedCells ?? changes.length} cambios guardados`, "alert-success");
          window.location.reload();
        } catch (err) {
          showToast(err instanceof Error ? err.message : "Error al guardar", "alert-error");
          btn.disabled = false;
          refreshCounts();
        }
      });

      const saveModules = document.getElementById("save-modules");
      saveModules?.addEventListener("click", async () => {
        const btn = saveModules as HTMLButtonElement;
        btn.disabled = true;
        const changes = Array.from(computeModuleDiff().keys()).map((key) => {
          const [moduleId, role, mesaId] = key.split(":");
          const cellInputs = Array.from(
            root.querySelectorAll<HTMLInputElement>(
              `input[data-kind="module"][data-module-id="${moduleId}"][data-role="${role}"][data-mesa-id="${mesaId}"]`,
            ),
          );
          const flags: Record<string, boolean> = {};
          cellInputs.forEach((cb) => (flags[cb.dataset.flag as string] = cb.checked));
          return { moduleId: Number(moduleId), role, mesaId: Number(mesaId), flags };
        });
        try {
          const out = await postJson("api/admin/permisos/modules", { changes });
          showToast(`${out.changedCells ?? changes.length} cambios guardados`, "alert-success");
          window.location.reload();
        } catch (err) {
          showToast(err instanceof Error ? err.message : "Error al guardar", "alert-error");
          btn.disabled = false;
          refreshCounts();
        }
      });

      // --- Mesas sync (manual + auto-on-empty) ---
      async function syncMesas(): Promise<void> {
        await postJson("api/admin/permisos/mesas/sync", {});
        showToast("Mesas sincronizadas desde InvGate", "alert-success");
        window.location.reload();
      }
      document.getElementById("mesas-sync")?.addEventListener("click", async () => {
        try {
          await syncMesas();
        } catch (err) {
          showToast(err instanceof Error ? err.message : "No se pudo contactar InvGate", "alert-error");
        }
      });
      if (initial.mesas.length === 0) {
        syncMesas().catch(() => {
          /* non-fatal: admin retries from the Mesas tab */
        });
      }

      refreshCounts();
    }
  </script>
</div>
