---
import { db } from "@db/index";
import { mesas, users } from "@db/schema";
import { sql, isNotNull } from "drizzle-orm";
import { getCsrfTokenForSession } from "@lib/csrf";
import { getModulePermissions } from "@lib/rbac";
import { ALLOWED_HELPDESK_NAMES, isSectionVisibleSync } from "@lib/helpdeskAccess";

const [mesaRows, userCountRows] = await Promise.all([
  db.select().from(mesas),
  db
    .select({ helpdeskId: users.helpdeskId, total: sql<number>`count(*)` })
    .from(users)
    .where(isNotNull(users.helpdeskId))
    .groupBy(users.helpdeskId),
]);

const mesaList = [...mesaRows].sort((a, b) => a.name.localeCompare(b.name));

// users.helpdeskId referencia mesas.invgateId; normalizamos el conteo a mesas.id.
const countByInvgateId = new Map<number, number>();
for (const row of userCountRows) {
  if (row.helpdeskId != null) {
    countByInvgateId.set(row.helpdeskId, Number(row.total));
  }
}
const mesaUserCount = new Map<number, number>();
for (const m of mesaList) {
  mesaUserCount.set(m.id, countByInvgateId.get(m.invgateId) ?? 0);
}

// Resumen read-only: qué ve cada mesa curada (derivado del hardcode, no editable).
const SECTION_LABELS: Array<{ label: string; href: string }> = [
  { label: "Supervisión (cronograma, calidad, AGS)", href: "/supervision" },
  { label: "Control de asistencia", href: "/supervision/asistencia" },
  { label: "Terminales (cubics)", href: "/inventario-terminales/cubics" },
  { label: "Títulos", href: "/titulos" },
  { label: "Base de conocimiento", href: "/base-conocimiento" },
  { label: "Panel de administración", href: "/admin" },
];

const user = Astro.locals.user;
const permisosPerms = getModulePermissions("permisos", user.role);
const canWrite = permisosPerms.canWrite;

// El más reciente entre todas las mesas sincronizadas.
const lastSyncedAt = mesaList.reduce<string | null>((acc, m) => {
  const t = m.lastSyncedAt ?? null;
  return !t || (acc && Date.parse(acc) >= Date.parse(t)) ? acc : t;
}, null);
---

<div
  id="permisos-root"
  data-can-write={canWrite ? "1" : "0"}
  data-csrf-token={getCsrfTokenForSession(Astro.locals.sessionId)}
  class="space-y-4"
>
  <div class="flex flex-wrap items-center gap-3">
    {canWrite && (
      <button type="button" id="mesas-sync" class="btn btn-primary btn-sm">
        <span class="sync-label">Sincronizar desde InvGate</span>
        <span class="loading loading-spinner loading-xs hidden" aria-hidden="true"></span>
      </button>
    )}
    {mesaList.length > 0 && (
      <span class="text-base-content/60 text-xs">
        Última sincronización: {lastSyncedAt ?? "—"}
      </span>
    )}
  </div>

  <div class="overflow-x-auto mt-3">
    <table class="table table-zebra table-sm">
      <thead>
        <tr>
          <th>Nombre</th>
          <th>InvGate ID</th>
          <th>Usuarios</th>
          <th>Activa</th>
          <th>Sincronizado</th>
          <th>Lista curada</th>
        </tr>
      </thead>
      <tbody>
        {mesaList.length === 0 && (
          <tr>
            <td colspan="6" class="text-base-content/50 text-center">
              No hay mesas. Usá "Sincronizar desde InvGate" para traerlas.
            </td>
          </tr>
        )}
        {mesaList.map((m) => (
          <tr class:list={[!m.active && "opacity-50"]}>
            <td class="font-mono">{m.name}</td>
            <td>{m.invgateId}</td>
            <td>
              <span
                class:list={[
                  "badge badge-sm",
                  (mesaUserCount.get(m.id) ?? 0) > 0 ? "badge-success" : "badge-ghost",
                ]}
              >
                {mesaUserCount.get(m.id) ?? 0}
              </span>
            </td>
            <td>{m.active ? "Sí" : "No"}</td>
            <td>{m.lastSyncedAt ?? "—"}</td>
            <td>
              {ALLOWED_HELPDESK_NAMES.includes(m.name) ? (
                <span class="badge badge-ghost badge-sm">sí</span>
              ) : (
                <span class="badge badge-ghost badge-sm">—</span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="mt-6 space-y-3">
    <h3 class="text-base-content text-sm font-semibold">
      Visibilidad por mesa (configurada en código — requiere deploy para cambiar)
    </h3>
    {ALLOWED_HELPDESK_NAMES.map((mesaName) => (
      <div class="border-base-300 rounded-lg border p-3">
        <div class="font-mono mb-2 text-sm font-semibold">{mesaName}</div>
        <ul class="text-base-content/70 text-xs space-y-1">
          {SECTION_LABELS.map((s) => {
            const visible = isSectionVisibleSync(mesaName, "agent", s.href);
            return (
              <li class="flex items-center gap-2">
                <span class:list={["badge badge-xs", visible ? "badge-success" : "badge-error"]}>
                  {visible ? "✓" : "✗"}
                </span>
                {s.label}
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
</div>

<script>
  import { showToast } from "@lib/toastClient";
  import { getCleanBase } from "@lib/baseUrl";

  const root = document.getElementById("permisos-root");
  if (root) {
    async function postJson(url: string, body: unknown): Promise<any> {
      const csrfToken = root!.getAttribute("data-csrf-token") || "";
      let res: Response;
      try {
        res = await fetch(getCleanBase() + url, {
          method: "POST",
          credentials: "same-origin",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ ...(body as object), csrf_token: csrfToken }),
        });
      } catch {
        throw new Error("Error de conexión. Verifica tu red e intenta nuevamente.");
      }
      const json = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(json?.error ?? `Error ${res.status}`);
      return json;
    }

    async function syncMesas(): Promise<void> {
      const out = await postJson("api/admin/permisos/mesas/sync", {});
      const affected = Array.isArray(out?.affectedUsers) ? out.affectedUsers : [];
      if (affected.length > 0) {
        showToast(
          `Mesas sincronizadas. ${affected.length} usuario(s) con mesa desactivada requieren reasignación en /admin/usuarios`,
          "alert-warning",
        );
      } else {
        showToast("Mesas sincronizadas desde InvGate", "alert-success");
      }
      window.location.reload();
    }

    document.getElementById("mesas-sync")?.addEventListener("click", async () => {
      if (!confirm("¿Sincronizar mesas desde InvGate? Esta operación puede tardar varios segundos.")) {
        return;
      }
      const btn = document.getElementById("mesas-sync") as HTMLButtonElement | null;
      const label = btn?.querySelector(".sync-label") as HTMLSpanElement | null;
      const spinner = btn?.querySelector(".loading-spinner") as HTMLSpanElement | null;
      if (btn) btn.disabled = true;
      label?.classList.add("hidden");
      spinner?.classList.remove("hidden");
      try {
        await syncMesas();
      } catch (err) {
        showToast(err instanceof Error ? err.message : "No se pudo contactar InvGate", "alert-error");
      } finally {
        if (btn) btn.disabled = false;
        label?.classList.remove("hidden");
        spinner?.classList.add("hidden");
      }
    });
  }
</script>
