---
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import DataTable from "@components/ui/DataTable.astro";
import DataTableHeaderCell from "@components/ui/DataTableHeaderCell.astro";
import SectionCard from "@components/ui/SectionCard.astro";

const headerGridClass = "grid-cols-[1fr_140px_320px] gap-4";
const rowGridClass = "grid grid-cols-[1fr_140px_320px] items-center gap-4";
---

<PageContainer width="xl">
  <div class="skeleton-debounced">
    <PageHeader
      title="Gestión de usuarios"
      description="Alta de operadores, asignación de roles y revisión de accesos activos en el portal."
    />

    <div class="mb-6 flex justify-start">
      <div class="skeleton h-12 w-96 rounded-xl"></div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      <!-- Form Skeleton -->
      <div class="lg:order-2">
        <SectionCard class="shadow-md">
          <div class="skeleton h-6 w-32 rounded"></div>
          <div class="space-y-4">
            <div class="space-y-2">
              <div class="skeleton h-3 w-24 rounded"></div>
              <div class="skeleton h-10 w-full rounded-lg"></div>
            </div>
            <div class="space-y-2">
              <div class="skeleton h-3 w-24 rounded"></div>
              <div class="skeleton h-10 w-full rounded-lg"></div>
            </div>
            <div class="space-y-2">
              <div class="skeleton h-3 w-24 rounded"></div>
              <div class="skeleton h-10 w-full rounded-lg"></div>
            </div>
            <div class="skeleton mt-2 h-10 w-full rounded-lg"></div>
          </div>
        </SectionCard>
      </div>

      <!-- Table Skeleton -->
      <div class="space-y-3 lg:order-1 lg:col-span-2">
        <div class="flex items-center justify-between gap-4">
          <h2 class="text-base-content text-lg font-semibold">
            Usuarios registrados
          </h2>
          <div class="skeleton h-5 w-8 rounded-full"></div>
        </div>

        <DataTable
          ariaLabel="Cargando usuarios..."
          minWidthClass="min-w-200"
          headerGridClass={headerGridClass}
          rowGridClass={rowGridClass}
        >
          <div slot="header">
            <DataTableHeaderCell sortKey="username">Usuario</DataTableHeaderCell
            >
          </div>
          <div slot="header">
            <DataTableHeaderCell sortKey="role">Rol</DataTableHeaderCell>
          </div>
          <div slot="header" class="text-right">
            <DataTableHeaderCell align="right">Acciones</DataTableHeaderCell>
          </div>

          {
            Array.from({ length: 4 }).map(() => (
              <div
                class:list={[
                  rowGridClass,
                  "border-base-300 border-b px-4 py-4 last:border-b-0",
                ]}
              >
                <div class="flex items-center gap-3">
                  <div class="skeleton size-8 rounded-full" />
                  <div class="skeleton h-4 w-28 rounded" />
                </div>
                <div class="skeleton h-5 w-20 rounded-full" />
                <div class="flex justify-end gap-2">
                  <div class="skeleton h-8 w-14 rounded-lg" />
                  <div class="skeleton h-8 w-20 rounded-lg" />
                  <div class="skeleton h-8 w-20 rounded-lg" />
                </div>
              </div>
            ))
          }
        </DataTable>
      </div>
    </div>
  </div>
</PageContainer>
