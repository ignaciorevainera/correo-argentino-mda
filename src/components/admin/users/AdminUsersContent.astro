---
import { db } from "@db/index";
import { users, agents, mesas } from "@db/schema";
import { sql, eq } from "drizzle-orm";
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import DataTable from "@components/ui/DataTable.astro";
import DataTableHeaderCell from "@components/ui/DataTableHeaderCell.astro";
import { Icon } from "astro-icon/components";
import ActionEditButton from "@components/ui/ActionEditButton.astro";
import ActionRoleButton from "@components/ui/ActionRoleButton.astro";
import ActionPasswordButton from "@components/ui/ActionPasswordButton.astro";
import { invgateGet } from "@lib/invgateClient";
import type { InvgateHelpdeskAndLevel } from "@/types/invgate";
import { ALLOWED_HELPDESK_NAMES, PARTICIPATION_HELPDESK_NAMES, MDA_TI_HELPDESK, mesaHasParticipaciones } from "@lib/helpdeskAccess";
import { rolesMatrix } from "@lib/rolesMatrix";
import { normalizeRole } from "@lib/rbac";
import FormField from "@components/ui/forms/FormField.astro";
import SelectField from "@components/ui/forms/SelectField.astro";
import PasswordField from "@components/ui/forms/PasswordField.astro";
import AsyncFormScript from "@components/admin/ui/AsyncFormScript.astro";
import SectionCard from "@components/ui/SectionCard.astro";
import Modal from "@components/ui/Modal.astro";
import ActionCancelButton from "@components/ui/ActionCancelButton.astro";
import ActionConfirmButton from "@components/ui/ActionConfirmButton.astro";
import ActionButton from "@components/ui/ActionButton.astro";

interface Props {
  successMsg?: string;
  errorMsg?: string;
}

const { successMsg = "", errorMsg = "" } = Astro.props;

const allUsers = await db
  .select({
    id: users.id,
    username: users.username,
    role: users.role,
    helpdeskName: users.helpdeskName,
    // Nombre canonico via join: users.helpdeskName puede quedar stale cuando
    // mesaSync renombra una mesa. Se usa para el gating de participaciones;
    // el badge/banner siguen mostrando el denormalizado (informativo).
    mesaName: mesas.name,
    agentId: agents.id,
    agentName: agents.name,
    enCronograma: agents.enCronograma,
    asignableCubic: agents.asignableCubic,
    incluidoCalidad: agents.incluidoCalidad,
    asignableAgs: agents.asignableAgs,
  })
  .from(users)
  .leftJoin(
    agents,
    sql`lower(coalesce(${agents.username}, '')) = ${users.username}`,
  )
  .leftJoin(mesas, eq(users.helpdeskId, mesas.invgateId));

const usersConMesaInactiva = await db
  .select({ username: users.username, mesaName: mesas.name })
  .from(users)
  .innerJoin(mesas, eq(users.helpdeskId, mesas.invgateId))
  .where(eq(mesas.active, false));

// Mismo cap para el banner de mesa inactiva (evita overflow del listado).
const MESA_INACTIVA_PREVIEW = 20;
const usersConMesaInactivaMostrados = usersConMesaInactiva.slice(
  0,
  MESA_INACTIVA_PREVIEW,
);
const usersConMesaInactivaRestantes =
  usersConMesaInactiva.length - usersConMesaInactivaMostrados.length;

const hdResult =
  await invgateGet<InvgateHelpdeskAndLevel[]>("helpdesksandlevels");
const helpdeskOptions = (
  hdResult.ok && Array.isArray(hdResult.data) ? hdResult.data : []
)
  .filter((h) => !h.level_order && ALLOWED_HELPDESK_NAMES.includes(h.name ?? ""))
  .map((h) => ({ id: h.id, name: h.name ?? `Helpdesk #${h.id}` }));

const headerGridClass = "grid-cols-[1fr_140px_180px_320px] gap-4";
const rowGridClass = "grid grid-cols-[1fr_140px_180px_320px] items-center gap-4";

// Normaliza variantes legacy ("Supervisor ", "Team Leader") en la UI; el
// enforcement real vive server-side (normalizeRole en usuarios.astro).
const isSupervisorRole = (role: string): boolean =>
  normalizeRole(role) === "supervisor";
---

<PageContainer width="xl">
  <div data-participation-mesas={JSON.stringify(PARTICIPATION_HELPDESK_NAMES)}>
  <PageHeader
    title="Gestión de usuarios"
    description="Alta de operadores, asignación de roles y revisión de accesos activos en el portal."
  />


  {usersConMesaInactiva.length > 0 && (
    <div role="alert" class="alert alert-warning mb-4">
      <Icon name="boxicons:x-circle" size={24} />
      <span class="min-w-0 break-words">
        <strong>{usersConMesaInactiva.length}</strong> usuario(s) tienen una mesa
        de ayuda desactivada y requieren reasignación:
        {usersConMesaInactivaMostrados.map((u) => `${u.username} (${u.mesaName})`).join(", ")}{usersConMesaInactivaRestantes > 0
          ? ` y ${usersConMesaInactivaRestantes} más`
          : ""}.
      </span>
    </div>
  )}

  <div class="mb-6 flex justify-start">
    <button
      type="button"
      class="btn btn-soft btn-lg btn-accent gap-2"
      onclick="document.getElementById('modal-permissions-matrix').showModal()"
    >
      <Icon name="boxicons:universal-access-filled" size={24} />
      Ver tabla comparativa de permisos por rol
    </button>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1fr_400px]">
    <!-- ─── Table: Usuarios registrados ─── -->
    <section class="lg:order-1" aria-labelledby="tabla-usuarios">
      <div class="flex flex-col gap-3">
        <div class="flex items-center justify-between gap-4">
          <h2
            id="tabla-usuarios"
            class="text-base-content text-lg font-semibold"
          >
            Usuarios registrados
          </h2>
          {
            allUsers.length > 0 && (
              <span class="badge badge-neutral badge-sm font-mono">
                {allUsers.length}
              </span>
            )
          }
        </div>

        <DataTable
          ariaLabel="Listado de usuarios registrados"
          minWidthClass="min-w-160"
          headerGridClass={headerGridClass}
          rowGridClass={rowGridClass}
        >
          <div slot="header">
            <DataTableHeaderCell sortKey="username">Usuario</DataTableHeaderCell
            >
          </div>
          <div slot="header">
            <DataTableHeaderCell sortKey="role">Rol</DataTableHeaderCell>
          </div>
          <div slot="header">
            <DataTableHeaderCell sortKey="helpdesk">Mesa</DataTableHeaderCell
            >
          </div>
          <div slot="header" class="text-right">
            <DataTableHeaderCell align="right">Acciones</DataTableHeaderCell>
          </div>

          {
            allUsers.length === 0 ? (
              <div class="text-base-content/50 flex flex-col items-center gap-3 py-16">
                <div class="bg-base-200 rounded-full p-4">
                  <Icon
                    name="boxicons:group-filled"
                    size={32}
                    class="opacity-30"
                    aria-hidden="true"
                  />
                </div>
                <div class="space-y-1 text-center">
                  <p class="text-sm font-semibold">
                    No hay usuarios registrados
                  </p>
                  <p class="text-xs">
                    Creá el primer usuario desde el formulario.
                  </p>
                </div>
              </div>
            ) : (
              allUsers.map((u) => (
                <article
                  data-table-row
                  data-sort-username={u.username}
                  data-sort-role={u.role}
                  data-sort-helpdesk={u.helpdeskName ?? ""}
                  class:list={[
                    rowGridClass,
                    "border-base-300 hover:bg-base-200/50 border-b px-4 py-3 transition-colors last:border-b-0",
                  ]}
                >
                  <div class="min-w-0">
                    <div class="flex items-center gap-3">
                      <div
                        class:list={[
                          "flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-bold shadow-sm",
                          u.role === "admin"
                            ? "bg-error text-error-content"
                            : isSupervisorRole(u.role)
                              ? "bg-info text-info-content"
                              : u.role === "team_leader" ||
                                  u.role === "team-leader" ||
                                  u.role === "team leader"
                                ? "bg-accent text-accent-content"
                                : u.role === "referent"
                                  ? "bg-warning text-warning-content"
                                  : "bg-neutral text-neutral-content",
                        ]}
                        aria-hidden="true"
                      >
                        {u.username.slice(0, 2).toUpperCase()}
                      </div>
                      <span class="text-base-content truncate font-mono font-medium">
                        {u.username}
                      </span>
                    </div>
                  </div>

                  <div class="flex min-w-0 items-center gap-2">
                    <span
                      class:list={[
                        "badge badge-sm font-bold tracking-wide whitespace-nowrap uppercase",
                        u.role === "admin"
                          ? "badge-error"
                          : isSupervisorRole(u.role)
                            ? "badge-info"
                            : u.role === "team_leader" ||
                                u.role === "team-leader" ||
                                u.role === "team leader"
                              ? "badge-accent"
                              : u.role === "referent"
                                ? "badge-warning"
                                : "badge-neutral",
                      ]}
                    >
                      {u.role === "admin"
                        ? "Admin"
                        : isSupervisorRole(u.role)
                          ? "Supervisor"
                          : u.role === "team_leader" ||
                              u.role === "team-leader" ||
                              u.role === "team leader"
                            ? "Team Leader"
                            : u.role === "referent"
                              ? "Referente"
                              : "Agente"}
                    </span>
                  </div>

                  <div class="flex min-w-0 items-center gap-2">
                    {u.helpdeskName ? (
                      <span
                        class:list={[
                          "badge badge-sm font-bold tracking-wide whitespace-nowrap uppercase",
                          u.helpdeskName === MDA_TI_HELPDESK
                            ? "badge-primary"
                            : "badge-secondary",
                        ]}
                      >
                        {u.helpdeskName}
                      </span>
                    ) : (
                      <span class="text-base-content/40 text-xs italic">
                        Sin mesa de ayuda
                      </span>
                    )}
                  </div>

                  <div class="flex items-center justify-end gap-2">
                    {u.agentId && mesaHasParticipaciones(u.mesaName ?? u.helpdeskName) && (
                      <button
                        type="button"
                        class="btn btn-ghost btn-xs"
                        onclick={`document.getElementById('modal-participaciones-${u.id}').showModal()`}
                        aria-label={`Participaciones de ${u.username}`}
                      >
                        <Icon name="boxicons:checklist" size={16} />
                      </button>
                    )}
                    {u.agentId && (
                      <button
                        type="button"
                        class="btn btn-ghost btn-xs"
                        onclick={`document.getElementById('modal-nombre-${u.id}').showModal()`}
                        aria-label={`Editar nombre de ${u.username}`}
                      >
                        <Icon name="boxicons:user-circle" size={16} />
                      </button>
                    )}
                    <ActionRoleButton
                      data-action="change-role-btn"
                      data-user-id={u.id}
                      data-user-role={u.role}
                      data-user-helpdesk={u.helpdeskName ?? ""}
                      data-user-username={u.username}
                      ariaLabel={`Cambiar rol y mesa de ayuda de ${u.username}`}
                    />

                    <ActionEditButton
                      onclick={`document.getElementById('modal-rename-${u.id}').showModal()`}
                      ariaLabel={`Renombrar usuario ${u.username}`}
                    />

                    <ActionPasswordButton
                      onclick={`document.getElementById('modal-reset-${u.id}').showModal()`}
                      ariaLabel={`Blanquear contraseña de ${u.username}`}
                    />
                  </div>

                  {u.agentId && mesaHasParticipaciones(u.mesaName ?? u.helpdeskName) && (
                    <Modal id={`modal-participaciones-${u.id}`}>
                      <Fragment slot="content">
                        <h3 class="text-base-content mb-1 text-base font-semibold">
                          Participaciones
                        </h3>
                        <p class="text-base-content/60 mb-4 text-xs">
                          Define dónde aparece{" "}
                          <span class="font-mono font-semibold">{u.username}</span>.
                          Desmarcar no borra historial.
                        </p>
                        <form method="POST" class="space-y-3" data-async-form>
                          <input type="hidden" name="action" value="update-participaciones" />
                          <input type="hidden" name="userId" value={u.id} />
                          <label class="label cursor-pointer justify-start gap-3 py-1">
                            <input
                              type="checkbox"
                              name="enCronograma"
                              class="toggle toggle-sm toggle-secondary"
                              checked={!!u.enCronograma}
                              disabled={isSupervisorRole(u.role)}
                              title="Un supervisor no figura en el cronograma como operador"
                            />
                            <span class="text-base-content text-sm">Cronograma</span>
                          </label>
                          <label class="label cursor-pointer justify-start gap-3 py-1">
                            <input type="checkbox" name="asignableCubic" class="toggle toggle-sm toggle-secondary" checked={!!u.asignableCubic} />
                            <span class="text-base-content text-sm">Asignación de PCs (cubics)</span>
                          </label>
                          <label class="label cursor-pointer justify-start gap-3 py-1">
                            <input type="checkbox" name="incluidoCalidad" class="toggle toggle-sm toggle-secondary" checked={!!u.incluidoCalidad} />
                            <span class="text-base-content text-sm">Auditorías de calidad</span>
                          </label>
                          <label class="label cursor-pointer justify-start gap-3 py-1">
                            <input type="checkbox" name="asignableAgs" class="toggle toggle-sm toggle-secondary" checked={!!u.asignableAgs} />
                            <span class="text-base-content text-sm">Asignación AGS</span>
                          </label>
                          <div class="border-base-200 mt-4 flex items-center justify-end gap-2 border-t pt-3">
                            <ActionCancelButton type="button" label="Cancelar" icon="boxicons:x-filled" variant="error" onclick="this.closest('dialog').close()" />
                            <ActionConfirmButton type="submit" color="btn-primary" label="Guardar" icon="boxicons:check-filled" />
                          </div>
                        </form>
                      </Fragment>
                    </Modal>
                  )}
                  <Modal id={`modal-nombre-${u.id}`}>
                    <Fragment slot="content">
                      <h3 class="text-base-content mb-1 text-base font-semibold">
                        Nombre visible del agente
                      </h3>
                      <form method="POST" class="space-y-3" data-async-form>
                        <input type="hidden" name="action" value="update-name" />
                        <input type="hidden" name="userId" value={u.id} />
                        <FormField
                          id={`agent-name-${u.id}`}
                          name="newName"
                          required
                          label="Nombre completo"
                          placeholder={u.agentName || u.username}
                          value={u.agentName || ""}
                          autocomplete="off"
                          inputClass="input-sm"
                          helpText="Se propaga a los cronogramas guardados."
                        />
                        <div class="border-base-200 mt-4 flex items-center justify-end gap-2 border-t pt-3">
                          <ActionCancelButton type="button" label="Cancelar" icon="boxicons:x-filled" variant="error" onclick="this.closest('dialog').close()" />
                          <ActionConfirmButton type="submit" color="btn-secondary" label="Guardar" icon="boxicons:check-filled" />
                        </div>
                      </form>
                    </Fragment>
                  </Modal>
                  {/* ── Modales (Fuera del flujo visual de la fila) ── */}
                  <Modal id={`modal-rename-${u.id}`}>
                    <Fragment slot="content">
                      <h3 class="text-base-content mb-1 text-base font-semibold">
                        Renombrar usuario
                      </h3>
                      <p class="text-base-content/60 mb-4 text-xs">
                        Usuario actual:{" "}
                        <span class="font-mono font-semibold">
                          {u.username}
                        </span>
                      </p>
                      <form method="POST" class="space-y-3" data-async-form>
                        <input
                          type="hidden"
                          name="action"
                          value="rename-username"
                        />
                        <input type="hidden" name="userId" value={u.id} />
                        <FormField
                          id={`new-username-${u.id}`}
                          name="newUsername"
                          required
                          label="Nuevo nombre de red"
                          placeholder={u.username}
                          autocomplete="off"
                          inputClass="input-sm"
                        />
                        <div class="border-base-200 mt-4 flex items-center justify-end gap-2 border-t pt-3">
                          <ActionCancelButton
                            type="button"
                            label="Cancelar"
                            icon="boxicons:x-filled"
                            variant="error"
                            onclick="this.closest('dialog').close()"
                          />
                          <ActionConfirmButton
                            type="submit"
                            color="btn-secondary"
                            label="Guardar"
                            icon="boxicons:check-filled"
                          />
                        </div>
                      </form>
                    </Fragment>
                  </Modal>
                  <Modal id={`modal-reset-${u.id}`}>
                    <Fragment slot="content">
                      <h3 class="text-base-content mb-1 text-base font-semibold">
                        Blanquear contraseña
                      </h3>
                      <p class="text-base-content/60 mb-4 text-xs">
                        Establece una nueva contraseña para{" "}
                        <span class="font-mono font-semibold">
                          {u.username}
                        </span>
                        .
                      </p>
                      <form method="POST" class="space-y-3" data-async-form>
                        <input
                          type="hidden"
                          name="action"
                          value="reset-password"
                        />
                        <input type="hidden" name="userId" value={u.id} />
                        <PasswordField
                          id={`reset-password-${u.id}`}
                          name="newPassword"
                          required
                          label="Nueva contraseña"
                          confirmPassword={true}
                          confirmLabel="Repetir nueva contraseña"
                          autocomplete="new-password"
                          inputClass="input-sm"
                        />
                        <div class="border-base-200 mt-4 flex items-center justify-end gap-2 border-t pt-3">
                          <ActionCancelButton
                            type="button"
                            label="Cancelar"
                            icon="boxicons:x-filled"
                            variant="error"
                            onclick="this.closest('dialog').close()"
                          />
                          <ActionConfirmButton
                            type="submit"
                            color="btn-warning"
                            label="Blanquear"
                            icon="boxicons:lock-open-filled"
                          />
                        </div>
                      </form>
                    </Fragment>
                  </Modal>
                </article>
              ))
            )
          }
        </DataTable>
      </div>
    </section>

    <!-- ─── Form: Nuevo usuario ─── -->
    <section class="lg:order-2" aria-labelledby="form-nuevo-usuario">
      <SectionCard class="shadow-md lg:sticky lg:top-24">
        <h2 id="form-nuevo-usuario" class="card-title gap-2 text-base">
          <div
            aria-hidden="true"
            class="bg-secondary/10 text-secondary inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg"
          >
            <Icon name="boxicons:user-plus-filled" size={18} />
          </div>
          Nuevo usuario
        </h2>

        <script is:inline define:vars={{ successMsg, errorMsg }}>
          // La isla server:defer se inyecta después del evento load del documento:
          // mostrar el toast de inmediato si load ya pasó.
          const showToastMsg = () => {
            if (successMsg) window.showToast?.(successMsg, "alert-success");
            if (errorMsg) window.showToast?.(errorMsg, "alert-error");
          };
          if (document.readyState === "complete") {
            showToastMsg();
          } else {
            window.addEventListener("load", showToastMsg);
          }
        </script>

        <form method="POST" class="space-y-4" data-async-form id="nuevo-usuario-form">
          <FormField
            id="admin-username"
            name="username"
            required
            label="Nombre de red"
            placeholder="ej: jgonzalez"
            autocomplete="off"
            helpText="Credencial de dominio del operador."
          />

          <PasswordField
            id="admin-password"
            name="password"
            required
            label="Contraseña inicial"
            confirmPassword={true}
            confirmLabel="Repetir contraseña"
            autocomplete="new-password"
          />

          <FormField
            id="admin-fullname"
            name="name"
            required
            label="Nombre completo"
            placeholder="ej: Juan González"
            autocomplete="off"
            helpText="Se muestra en cronograma, asistencia y reportes."
          />

          <SelectField
            id="admin-role"
            name="role"
            label="Rol en sistema"
            options={[
              { value: "agent", label: "Agente" },
              { value: "referent", label: "Referente" },
              { value: "team_leader", label: "Team Leader" },
              { value: "supervisor", label: "Supervisor" },
              { value: "admin", label: "Administrador" },
            ]}
            helpText="Define el nivel de acceso a módulos del portal."
          />

          <div id="participaciones-fields" class="space-y-2">
            <p class="text-base-content/70 text-xs font-semibold uppercase">
              Participaciones
            </p>
            <label class="label cursor-pointer justify-start gap-3 py-1">
              <input type="checkbox" name="enCronograma" class="toggle toggle-sm toggle-secondary" />
              <span class="text-base-content text-sm">Cronograma</span>
            </label>
            <label class="label cursor-pointer justify-start gap-3 py-1">
              <input type="checkbox" name="asignableCubic" class="toggle toggle-sm toggle-secondary" />
              <span class="text-base-content text-sm">Asignación de PCs (cubics)</span>
            </label>
            <label class="label cursor-pointer justify-start gap-3 py-1">
              <input type="checkbox" name="incluidoCalidad" class="toggle toggle-sm toggle-secondary" />
              <span class="text-base-content text-sm">Auditorías de calidad</span>
            </label>
            <label class="label cursor-pointer justify-start gap-3 py-1">
              <input type="checkbox" name="asignableAgs" class="toggle toggle-sm toggle-secondary" />
              <span class="text-base-content text-sm">Asignación AGS</span>
            </label>
            <p class="text-base-content/50 text-xs">
              Se preseleccionan según el rol elegido. Ajustables luego.
            </p>
          </div>

          <SelectField
            id="admin-helpdesk"
            name="helpdesk"
            label="Mesa de ayuda"
            options={[
              { value: "", label: "Seleccioná una mesa (obligatorio)" },
              ...helpdeskOptions.map((hd) => ({
                value: `${hd.id}|${hd.name}`,
                label: hd.name,
              })),
            ]}
            helpText="Mesa de InvGate que gobierna qué secciones ve el usuario. Obligatoria."
          />

          <input type="hidden" name="action" value="create" />
          <ActionConfirmButton
            type="submit"
            color="btn-secondary"
            label="Dar de alta"
            icon="boxicons:user-check-filled"
            class="mt-2 w-full"
          />
        </form>
      </SectionCard>
    </section>
  </div>
  </div>
</PageContainer>

<Modal id="modal-change-role">
  <Fragment slot="content">
    <h3 class="text-base-content mb-1 text-base font-semibold">
      Cambiar rol de usuario
    </h3>
    <p class="text-base-content/60 mb-4 text-xs">
      Modifica el rol del usuario en el sistema.
    </p>
    <form method="POST" class="space-y-4" data-async-form>
      <input type="hidden" name="action" value="change-role" />
      <input type="hidden" name="userId" id="change-role-user-id" />
      <div class="flex items-end gap-2">
        <div class="grow">
          <SelectField
          id="change-role-helpdesk-select"
          name="helpdesk"
          label="Mesa de ayuda"
          selectClass="select-sm"
          options={[
          ...helpdeskOptions.map((hd) => ({
          value: `${hd.id}|${hd.name}`,
          label: hd.name,
          })),
          { value: "", label: "Sin mesa de ayuda" },
          ]}
          />
        </div>
        <ActionButton
          id="suggest-helpdesk-btn"
          icon="boxicons:magic-wand"
          label="Sugerir"
          size="sm"
          color="btn-secondary"
          title="Sugerir mesa según el usuario en InvGate"
          class="mb-1"
        />
      </div>
      <SelectField
        id="change-role-select"
        name="newRole"
        label="Nuevo rol"
        selectClass="select-sm"
        options={[
          { value: "agent", label: "Agente" },
          { value: "referent", label: "Referente" },
          { value: "team_leader", label: "Team Leader" },
          { value: "supervisor", label: "Supervisor" },
          { value: "admin", label: "Administrador" },
        ]}
      />

      <div
        id="role-desc-container"
        class="bg-base-200 border-base-300 space-y-1 rounded-lg border p-3 text-xs transition-all duration-300"
      >
        <span class="text-base-content block font-bold">Permisos del rol:</span>
        <p id="role-permissions-desc" class="text-base-content/70">
          Selecciona un rol para ver sus permisos.
        </p>
      </div>

      <div
        class="border-base-200 mt-4 flex items-center justify-end gap-2 border-t pt-3"
      >
        <ActionCancelButton
          type="button"
          label="Cancelar"
          icon="boxicons:x-filled"
          variant="error"
          onclick="this.closest('dialog').close()"
        />
        <ActionConfirmButton
          type="submit"
          color="btn-primary"
          label="Guardar"
          icon="boxicons:check-filled"
        />
      </div>
    </form>
  </Fragment>
</Modal>

<Modal
  id="modal-permissions-matrix"
  title="Matriz de permisos por rol"
  icon="boxicons:universal-access-filled"
  size="full"
  class="!w-fit max-w-[calc(100vw-1rem)] !p-3 sm:!p-4"
>
  <Fragment slot="content">
    <p class="text-base-content/60 mb-4 text-xs">
      Detalle comparativo de las acciones y accesos permitidos para cada rol en
      la plataforma.
    </p>
    <div>
      <table class="table-xs md:table-sm table w-full">
        <thead>
          <tr class="text-base-content/70">
            <th class="bg-base-200/30">Funcionalidad / Ruta</th>
            <th class="bg-neutral text-neutral-content text-center font-bold"
              >Agente</th
            >
            <th class="bg-warning text-warning-content text-center font-bold"
              >Referente</th
            >
            <th class="bg-accent text-accent-content text-center font-bold"
              >Team Leader</th
            >
            <th class="bg-info text-info-content text-center font-bold"
              >Supervisor</th
            >
            <th class="bg-error text-error-content text-center font-bold"
              >Admin</th
            >
          </tr>
        </thead>
        <tbody>
          {
            rolesMatrix.map((row) => (
              <tr class="hover:bg-base-200/20 transition-colors">
                <td class="text-base-content/80 flex items-center gap-2 py-3 text-xs font-medium whitespace-nowrap md:text-sm">
                  <Icon
                    name={row.icon}
                    size={16}
                    class="text-base-content/65 shrink-0"
                  />
                  <span>{row.feature}</span>
                </td>
                <td class="bg-base-200/5 text-center">
                  {row.agent ? (
                    <Icon
                      name="boxicons:check-filled"
                      class="text-success inline-block"
                      size={24}
                    />
                  ) : (
                    <Icon
                      name="boxicons:x-filled"
                      class="text-error inline-block"
                      size={24}
                    />
                  )}
                </td>
                <td class="bg-warning/5 text-center">
                  {row.referent ? (
                    <Icon
                      name="boxicons:check-filled"
                      class="text-success inline-block"
                      size={24}
                    />
                  ) : (
                    <Icon
                      name="boxicons:x-filled"
                      class="text-error inline-block"
                      size={24}
                    />
                  )}
                </td>
                <td class="bg-accent/5 text-center">
                  {row.team_leader ? (
                    <Icon
                      name="boxicons:check-filled"
                      class="text-success inline-block"
                      size={24}
                    />
                  ) : (
                    <Icon
                      name="boxicons:x-filled"
                      class="text-error inline-block"
                      size={24}
                    />
                  )}
                </td>
                <td class="bg-info/5 text-center">
                  {row.supervisor ? (
                    <Icon
                      name="boxicons:check-filled"
                      class="text-success inline-block"
                      size={24}
                    />
                  ) : (
                    <Icon
                      name="boxicons:x-filled"
                      class="text-error inline-block"
                      size={24}
                    />
                  )}
                </td>
                <td class="bg-error/5 text-center">
                  {row.admin ? (
                    <Icon
                      name="boxicons:check-filled"
                      class="text-success inline-block"
                      size={24}
                    />
                  ) : (
                    <Icon
                      name="boxicons:x-filled"
                      class="text-error inline-block"
                      size={24}
                    />
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </Fragment>
</Modal>

<AsyncFormScript />

<script>
import { getCleanBase } from "@lib/baseUrl";
import { showToast } from "@lib/toastClient";
  // La validación de contraseñas es gestionada internamente por el componente PasswordField

  function initUsersAdmin() {
    const roleSelect = document.getElementById(
      "change-role-select",
    ) as HTMLSelectElement | null;
    if (!roleSelect) return false;

    let lastSeenUsername = "";
    const adminUsernameInput = document.getElementById(
      "admin-username",
    ) as HTMLInputElement | null;
    const adminHelpdeskSelect = document.getElementById(
      "admin-helpdesk",
    ) as HTMLSelectElement | null;

    type SuggestResult =
      | { ok: true; helpdesk: { invgateId: number; name: string } | null }
      | { ok: false; message: string };

    async function suggestMesaForUsername(
      username: string,
    ): Promise<SuggestResult> {
      try {
        const res = await fetch(
          `${getCleanBase()}api/admin/suggest-helpdesk?username=${encodeURIComponent(username)}`,
          { credentials: "same-origin" },
        );
        if (!res.ok) {
          return {
            ok: false,
            message:
              res.status === 401 || res.status === 403
                ? "No tenés permiso para consultar mesas."
                : "No se pudo consultar InvGate.",
          };
        }
        const json = await res.json();
        return { ok: true, helpdesk: json?.helpdesk ?? null };
      } catch {
        return { ok: false, message: "Error de conexión al consultar InvGate." };
      }
    }

    function selectOrAddHelpdeskOption(
      select: HTMLSelectElement,
      invgateId: number,
      name: string,
    ): void {
      const value = `${invgateId}|${name}`;
      const existing = Array.from(select.options).find((o) => o.value === value);
      if (existing) {
        select.value = value;
        return;
      }
      const opt = document.createElement("option");
      opt.value = value;
      opt.textContent = `${name} (sugerida)`;
      select.appendChild(opt);
      select.value = value;
    }

    adminUsernameInput?.addEventListener("blur", async () => {
      const username = adminUsernameInput.value.trim();
      if (!username) return;
      if (adminHelpdeskSelect && !adminHelpdeskSelect.value) {
        const result = await suggestMesaForUsername(username);
        if (result.ok && result.helpdesk) {
          selectOrAddHelpdeskOption(adminHelpdeskSelect, result.helpdesk.invgateId, result.helpdesk.name);
          refreshParticipacionesVisibility();
        }
      }
    });

    const suggestBtn = document.getElementById("suggest-helpdesk-btn") as HTMLButtonElement | null;
    suggestBtn?.addEventListener("click", async () => {
      // Leer el username desde el hidden input del modal (change-role-user-id)
      // no alcanza; usamos el último username visto via change-role-btn.
      if (!lastSeenUsername) return;

      const originalHtml = suggestBtn.innerHTML;
      suggestBtn.disabled = true;
      suggestBtn.innerHTML =
        '<span class="loading loading-spinner loading-sm"></span> Buscando…';

      const result = await suggestMesaForUsername(lastSeenUsername);

      suggestBtn.disabled = false;
      suggestBtn.innerHTML = originalHtml;

      if (!result.ok) {
        showToast(result.message, "alert-error");
        return;
      }
      if (!result.helpdesk) {
        showToast(
          "No se encontró una mesa para ese usuario en InvGate.",
          "alert-warning",
        );
        return;
      }
      if (helpdeskSelect) {
        selectOrAddHelpdeskOption(helpdeskSelect, result.helpdesk.invgateId, result.helpdesk.name);
        showToast(`Mesa sugerida: ${result.helpdesk.name}`, "alert-success");
      }
    });

    const roleDescriptions = {
      admin:
        "Acceso total al sistema. Puede gestionar usuarios, configuraciones generales, ver el sistema de diseño y acceder a todas las herramientas de supervisión.",
      supervisor:
        "Acceso completo a la sección de Supervisión. Puede ingresar a Cronograma, Auditorías de Calidad y Asignación de Autogestiones. Acceso general al panel de administración excepto la creación de usuarios.",
      team_leader:
        "Acceso intermedio. Puede modificar cronogramas, controlar la asistencia del equipo, auditar la calidad y realizar asignaciones de autogestión. Acceso general al panel de administración excepto la creación de usuarios.",
      referent:
        "Acceso limitado a la sección de Supervisión. Únicamente tiene permisos para ingresar a la pantalla de Asignación de Autogestiones.",
      agent:
        "Acceso operativo básico. Consulta de catálogos y herramientas comunes. No tiene acceso a pantallas de Supervisión ni de Administración.",
    };

    const ROLE_OPTIONS_FULL = [
      { value: "agent", label: "Agente" },
      { value: "referent", label: "Referente" },
      { value: "team_leader", label: "Team Leader" },
      { value: "supervisor", label: "Supervisor" },
      { value: "admin", label: "Administrador" },
    ];

    const helpdeskSelect = document.getElementById(
      "change-role-helpdesk-select",
    ) as HTMLSelectElement | null;

    const rebuildRoleOptions = (
      _helpdeskName: string | undefined,
      preferredRole?: string,
    ) => {
      if (!roleSelect) return;
      // Politica: cualquier rol en cualquier mesa. El rol define permisos,
      // la mesa no restringe roles. El rol actual siempre se preserva.
      const opts = ROLE_OPTIONS_FULL;
      roleSelect.innerHTML = "";
      for (const o of opts) {
        const opt = document.createElement("option");
        opt.value = o.value;
        opt.textContent = o.label;
        roleSelect.appendChild(opt);
      }
      roleSelect.value =
        preferredRole && opts.some((o) => o.value === preferredRole)
          ? preferredRole
          : opts[0].value;
      updateDesc(roleSelect.value as keyof typeof roleDescriptions);
    };

    helpdeskSelect?.addEventListener("change", () => {
      const selected =
        helpdeskSelect.selectedOptions[0]?.textContent ?? undefined;
      rebuildRoleOptions(
        selected?.replace(" (genérica)", "").trim() || undefined,
        roleSelect?.value,
      );
    });

    const modal = document.getElementById(
      "modal-change-role",
    ) as HTMLDialogElement | null;
    const userIdInput = document.getElementById(
      "change-role-user-id",
    ) as HTMLInputElement | null;
    const descEl = document.getElementById("role-permissions-desc");
    const containerEl = document.getElementById("role-desc-container");

    const updateDesc = (role: keyof typeof roleDescriptions) => {
      if (descEl) {
        descEl.textContent =
          roleDescriptions[role] || "Sin descripción disponible.";
      }
      if (containerEl) {
        containerEl.className =
          "p-3 border rounded-lg text-xs space-y-1 transition-all duration-300";
        if (role === "admin") {
          containerEl.classList.add("bg-error/5", "border-error/30");
        } else if (role === "supervisor") {
          containerEl.classList.add("bg-info/5", "border-info/30");
        } else if (role === "team_leader") {
          containerEl.classList.add("bg-accent/5", "border-accent/30");
        } else if (role === "referent") {
          containerEl.classList.add("bg-warning/5", "border-warning/30");
        } else {
          containerEl.classList.add("bg-base-200", "border-base-300");
        }
      }
    };

    roleSelect?.addEventListener("change", (e) => {
      const val = (e.target as HTMLSelectElement)
        .value as keyof typeof roleDescriptions;
      updateDesc(val);
    });

    document
      .querySelectorAll('[data-action="change-role-btn"]')
      .forEach((btn) => {
        btn.addEventListener("click", () => {
          const userId = btn.getAttribute("data-user-id");
          const userRole = btn.getAttribute("data-user-role") || "agent";
          const userHelpdesk = btn.getAttribute("data-user-helpdesk") || "";
          const userUsername = btn.getAttribute("data-user-username") || "";
          lastSeenUsername = userUsername;

          if (userIdInput && roleSelect && modal && helpdeskSelect) {
            userIdInput.value = userId || "";
            const targetName = userHelpdesk.trim();
            helpdeskSelect.value = "";
            if (targetName) {
              const match = Array.from(helpdeskSelect.options).find(
                (o) => (o.textContent ?? "").trim() === targetName,
              );
              if (match) helpdeskSelect.value = match.value;
            }
            const selectedName =
              helpdeskSelect.selectedOptions[0]?.textContent ?? undefined;
            rebuildRoleOptions(
              selectedName?.replace(" (genérica)", "").trim() || undefined,
              userRole,
            );
            modal.showModal();
            // Sugerencia: al abrir con usuario sin mesa, llenar si InvGate lo resuelve.
            if (!targetName && userUsername) {
              suggestMesaForUsername(userUsername).then((result) => {
                if (result.ok && result.helpdesk && !helpdeskSelect.value) {
                  selectOrAddHelpdeskOption(helpdeskSelect, result.helpdesk.invgateId, result.helpdesk.name);
                }
              });
            }
          }
        });
      });

    const PARTICIPATION_PRESETS: Record<string, Record<string, boolean>> = {
      agent: { enCronograma: true, asignableCubic: true, incluidoCalidad: true, asignableAgs: true },
      referent: { enCronograma: true, asignableCubic: true, incluidoCalidad: true, asignableAgs: true },
      team_leader: { enCronograma: true, asignableCubic: true, incluidoCalidad: false, asignableAgs: false },
      supervisor: { enCronograma: false, asignableCubic: false, incluidoCalidad: false, asignableAgs: false },
      admin: { enCronograma: false, asignableCubic: false, incluidoCalidad: false, asignableAgs: false },
    };

    function applyPresets(role: string) {
      const preset = PARTICIPATION_PRESETS[role];
      if (!preset) return;
      const form = document.getElementById("nuevo-usuario-form");
      if (!form) return;
      for (const [flagName, checked] of Object.entries(preset)) {
        const cb = form.querySelector<HTMLInputElement>(`input[name="${flagName}"]`);
        if (!cb) continue;
        cb.checked = checked;
        cb.disabled = role === "supervisor" && flagName === "enCronograma";
      }
    }

    const altaRoleSelect = document.getElementById("admin-role") as HTMLSelectElement | null;
    altaRoleSelect?.addEventListener("change", (e) => {
      applyPresets((e.target as HTMLSelectElement).value);
    });
    applyPresets(altaRoleSelect?.value || "agent");

    // Participaciones solo visibles para mesas con secciones participativas.
    let participationMesas: string[] = [];
    try {
      participationMesas = JSON.parse(
        (document.querySelector<HTMLElement>("[data-participation-mesas]")?.dataset.participationMesas as string) || "[]",
      );
    } catch {
      participationMesas = [];
    }    const altaHelpdeskSelect = document.getElementById("admin-helpdesk") as HTMLSelectElement | null;
    const participacionesFields = document.getElementById("participaciones-fields");
    function refreshParticipacionesVisibility(): void {
      const name = altaHelpdeskSelect?.value?.split("|")[1]?.trim() ?? "";
      participacionesFields?.classList.toggle("hidden", !participationMesas.includes(name));
    }
    altaHelpdeskSelect?.addEventListener("change", refreshParticipacionesVisibility);
    refreshParticipacionesVisibility();

    return true;
  }

  function setupUsersObserver() {
    if (initUsersAdmin()) return;

    const observer = new MutationObserver((_, obs) => {
      if (initUsersAdmin()) {
        obs.disconnect();
      }
    });

    observer.observe(document.body, { childList: true, subtree: true });
  }

  setupUsersObserver();

  document.addEventListener("astro:page-load", () => {
    setupUsersObserver();
  });
</script>
