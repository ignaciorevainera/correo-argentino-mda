---
import { db } from "@db/index";
import { users, agents, mesas } from "@db/schema";
import { sql, eq } from "drizzle-orm";
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import DataTable from "@components/ui/DataTable.astro";
import DataTableHeaderCell from "@components/ui/DataTableHeaderCell.astro";
import { Icon } from "astro-icon/components";
import ActionEditButton from "@components/ui/ActionEditButton.astro";
import ActionPasswordButton from "@components/ui/ActionPasswordButton.astro";
import ActionButton from "@components/ui/ActionButton.astro";
import { invgateGet } from "@lib/invgateClient";
import type { InvgateHelpdeskAndLevel } from "@/types/invgate";
import { ALLOWED_HELPDESK_NAMES, PARTICIPATION_HELPDESK_NAMES, MDA_TI_HELPDESK, mesaHasParticipaciones } from "@lib/helpdeskAccess";
import { rolesMatrix } from "@lib/rolesMatrix";
import { normalizeRole } from "@lib/rbac";
import FormField from "@components/ui/forms/FormField.astro";
import FormLegend from "@components/ui/forms/FormLegend.astro";
import SelectField from "@components/ui/forms/SelectField.astro";
import PasswordField from "@components/ui/forms/PasswordField.astro";
import AsyncFormScript from "@components/admin/ui/AsyncFormScript.astro";
import Modal from "@components/ui/Modal.astro";
import UserCreateModal from "@components/admin/users/UserCreateModal.astro";
import ActionCancelButton from "@components/ui/ActionCancelButton.astro";
import ActionConfirmButton from "@components/ui/ActionConfirmButton.astro";
import SearchBar from "@components/ui/SearchBar.astro";

const currentUserId = Astro.locals.user?.id ?? 0;

const allUsers = await db
  .select({
    id: users.id,
    username: users.username,
    role: users.role,
    helpdeskName: users.helpdeskName,
    helpdeskId: users.helpdeskId,
    // Nombre canonico via join: users.helpdeskName puede quedar stale cuando
    // mesaSync renombra una mesa. Se usa para el gating de participaciones;
    // el badge/banner siguen mostrando el denormalizado (informativo).
    mesaName: mesas.name,
    agentName: agents.name,
    enCronograma: agents.enCronograma,
    asignableCubic: agents.asignableCubic,
    incluidoCalidad: agents.incluidoCalidad,
    asignableAgs: agents.asignableAgs,
  })
  .from(users)
  .leftJoin(
    agents,
    sql`lower(coalesce(${agents.username}, '')) = ${users.username}`,
  )
  .leftJoin(mesas, eq(users.helpdeskId, mesas.invgateId));

const usersConMesaInactiva = await db
  .select({ username: users.username, mesaName: mesas.name })
  .from(users)
  .innerJoin(mesas, eq(users.helpdeskId, mesas.invgateId))
  .where(eq(mesas.active, false));

// Mismo cap para el banner de mesa inactiva (evita overflow del listado).
const MESA_INACTIVA_PREVIEW = 20;
const usersConMesaInactivaMostrados = usersConMesaInactiva.slice(
  0,
  MESA_INACTIVA_PREVIEW,
);
const usersConMesaInactivaRestantes =
  usersConMesaInactiva.length - usersConMesaInactivaMostrados.length;

const hdResult =
  await invgateGet<InvgateHelpdeskAndLevel[]>("helpdesksandlevels");
const helpdeskOptions = (
  hdResult.ok && Array.isArray(hdResult.data) ? hdResult.data : []
)
  .filter((h) => !h.level_order && ALLOWED_HELPDESK_NAMES.includes(h.name ?? ""))
  .map((h) => ({ id: h.id, name: h.name ?? `Helpdesk #${h.id}` }));

const headerGridClass = "grid-cols-[1fr_104px_170px_180px_88px] gap-4";
const rowGridClass =
  "grid grid-cols-[1fr_104px_170px_180px_88px] items-center gap-4";

// Normaliza variantes legacy ("Supervisor ", "Team Leader") en la UI; el
// enforcement real vive server-side (normalizeRole en usuarios.astro).
const isSupervisorRole = (role: string): boolean =>
  normalizeRole(role) === "supervisor";
---

<PageContainer width="xl">
  <div data-participation-mesas={JSON.stringify(PARTICIPATION_HELPDESK_NAMES)}>
  <PageHeader
    title="Gestión de usuarios"
    description="Alta de operadores, asignación de roles y revisión de accesos activos en el portal."
  />


  {usersConMesaInactiva.length > 0 && (
    <div role="alert" class="alert alert-warning mb-4">
      <Icon name="boxicons:x-circle" size={24} />
      <span class="min-w-0 break-words">
        <strong>{usersConMesaInactiva.length}</strong> usuario(s) tienen una mesa
        de ayuda desactivada y requieren reasignación:
        {usersConMesaInactivaMostrados.map((u) => `${u.username} (${u.mesaName})`).join(", ")}{usersConMesaInactivaRestantes > 0
          ? ` y ${usersConMesaInactivaRestantes} más`
          : ""}.
      </span>
    </div>
  )}

  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <button
      type="button"
      class="btn btn-soft btn-lg btn-accent gap-2"
      onclick="document.getElementById('modal-permissions-matrix').showModal()"
    >
      <Icon name="boxicons:universal-access-filled" size={24} />
      Ver tabla comparativa de permisos por rol
    </button>
    <ActionButton
      id="btn-nuevo-usuario"
      icon="boxicons:user-plus-filled"
      label="Nuevo usuario"
      size="default"
      color="btn-secondary"
      title="Dar de alta un nuevo usuario"
      ariaLabel="Dar de alta un nuevo usuario"
    />
  </div>

  <div>
    <!-- ─── Table: Usuarios registrados ─── -->
    <section aria-labelledby="tabla-usuarios">
      <div class="flex flex-col gap-4">
        <div class="flex items-center justify-between gap-4">
          <h2
            id="tabla-usuarios"
            class="text-base-content text-lg font-semibold"
          >
            Usuarios registrados
          </h2>
          {
            allUsers.length > 0 && (
              <span class="badge badge-neutral badge-sm font-mono">
                {allUsers.length}
              </span>
            )
          }
        </div>

        <SearchBar
          id="admin-users-search"
          placeholder="Buscar por usuario..."
          ariaLabel="Buscar usuarios por nombre de red"
          size="sm"
          class="max-w-md"
        />

        <DataTable
          id="usuarios-table"
          ariaLabel="Listado de usuarios registrados"
          minWidthClass="min-w-200"
          headerGridClass={headerGridClass}
          rowGridClass={rowGridClass}
          emptyStateTitle="Sin usuarios que coincidan"
          emptyStateDescription="No encontramos usuarios ni mesas de ayuda para esa búsqueda. Probá con otro nombre, rol o mesa."
          showClearButton
          clearButtonText="Limpiar búsqueda"
          clearButtonId="admin-users-search-clear"
        >
          <div slot="header">
            <DataTableHeaderCell sortKey="username">Usuario</DataTableHeaderCell
            >
          </div>
          <div slot="header">
            <DataTableHeaderCell sortKey="role">Rol</DataTableHeaderCell>
          </div>
          <div slot="header">
            <DataTableHeaderCell sortKey="helpdesk">Mesa</DataTableHeaderCell
            >
          </div>
          <div slot="header">
            <DataTableHeaderCell>Participaciones</DataTableHeaderCell>
          </div>
          <div slot="header" class="text-right">
            <DataTableHeaderCell align="right">Acciones</DataTableHeaderCell>
          </div>

          {
            allUsers.length === 0 ? (
              <div class="text-base-content/50 flex flex-col items-center gap-3 py-16">
                <div class="bg-base-200 rounded-full p-4">
                  <Icon
                    name="boxicons:group-filled"
                    size={32}
                    class="opacity-30"
                    aria-hidden="true"
                  />
                </div>
                <div class="space-y-1 text-center">
                  <p class="text-sm font-semibold">
                    No hay usuarios registrados
                  </p>
                  <p class="text-xs">
                    Creá el primer usuario desde el formulario.
                  </p>
                </div>
              </div>
            ) : (
              allUsers.map((u) => (
                <article
                  data-table-row
                  data-sort-username={u.username}
                  data-sort-role={u.role}
                  data-sort-helpdesk={u.helpdeskName ?? ""}
                  data-search-text={`${u.username} ${u.role.replace(/_/g, " ")} ${u.helpdeskName ?? ""}`}
                  class:list={[
                    rowGridClass,
                    "border-base-300 hover:bg-base-200/50 border-b px-5 py-4 transition-colors last:border-b-0",
                  ]}
                >
                  <div class="min-w-0">
                    <div class="flex items-center gap-4">
                      <div
                        class:list={[
                          "flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-bold shadow-sm",
                          u.role === "admin"
                            ? "bg-error text-error-content"
                            : isSupervisorRole(u.role)
                              ? "bg-info text-info-content"
                              : u.role === "team_leader" ||
                                  u.role === "team-leader" ||
                                  u.role === "team leader"
                                ? "bg-accent text-accent-content"
                                : u.role === "referent"
                                  ? "bg-warning text-warning-content"
                                  : "bg-neutral text-neutral-content",
                        ]}
                        aria-hidden="true"
                      >
                        {u.username.slice(0, 2).toUpperCase()}
                      </div>
                      <span
                        class="text-base-content truncate font-mono text-sm font-medium"
                        data-highlight-target
                      >
                        {u.username}
                      </span>
                    </div>
                  </div>

                  <div class="flex min-w-0 items-center gap-2">
                    <span
                      class:list={[
                        "badge badge-xs font-bold tracking-wide whitespace-nowrap uppercase",
                        u.role === "admin"
                          ? "badge-error"
                          : isSupervisorRole(u.role)
                            ? "badge-info"
                            : u.role === "team_leader" ||
                                u.role === "team-leader" ||
                                u.role === "team leader"
                              ? "badge-accent"
                              : u.role === "referent"
                                ? "badge-warning"
                                : "badge-neutral",
                      ]}
                      data-highlight-target
                    >
                      {u.role === "admin"
                        ? "Admin"
                        : isSupervisorRole(u.role)
                          ? "Supervisor"
                          : u.role === "team_leader" ||
                              u.role === "team-leader" ||
                              u.role === "team leader"
                            ? "Team Leader"
                            : u.role === "referent"
                              ? "Referente"
                              : "Agente"}
                    </span>
                  </div>

                  <div class="flex min-w-0 items-center gap-2">
                    {u.helpdeskName ? (
                      <span
                        class:list={[
                          "badge badge-xs font-bold tracking-wide whitespace-nowrap uppercase",
                          u.helpdeskName === MDA_TI_HELPDESK
                            ? "badge-primary"
                            : "badge-secondary",
                        ]}
                        data-highlight-target
                      >
                        {u.helpdeskName}
                      </span>
                    ) : (
                      <span
                        class="text-base-content/40 text-xs italic"
                        data-highlight-target
                      >
                        Sin mesa de ayuda
                      </span>
                    )}
                  </div>

                  <div class="flex min-w-0 flex-wrap items-center gap-1.5">
                    {mesaHasParticipaciones(u.mesaName ?? u.helpdeskName) && (
                      <>
                        {u.enCronograma && (
                          <span
                            class="badge badge-xs badge-primary"
                            data-chip="cronograma"
                            title="Figura en cronograma"
                          >
                            <Icon name="boxicons:calendar-filled" size={12} />
                            <span class="sr-only">Cronograma</span>
                          </span>
                        )}
                        {u.asignableCubic && (
                          <span
                            class="badge badge-xs badge-info"
                            data-chip="cubics"
                            title="Asignable a cubics"
                          >
                            <Icon name="boxicons:desktop-filled" size={12} />
                            <span class="sr-only">Cubics</span>
                          </span>
                        )}
                        {u.incluidoCalidad && (
                          <span
                            class="badge badge-xs badge-warning"
                            data-chip="calidad"
                            title="Incluido en calidad"
                          >
                            <Icon
                              name="boxicons:bar-chart-big-filled"
                              size={12}
                            />
                            <span class="sr-only">Calidad</span>
                          </span>
                        )}
                        {u.asignableAgs && (
                          <span
                            class="badge badge-xs badge-accent"
                            data-chip="ags"
                            title="Asignable AGS"
                          >
                            <Icon name="boxicons:git-branch-filled" size={12} />
                            <span class="sr-only">AGS</span>
                          </span>
                        )}
                        {!u.enCronograma &&
                          !u.asignableCubic &&
                          !u.incluidoCalidad &&
                          !u.asignableAgs && (
                            <span
                              class="badge badge-xs badge-ghost text-base-content/60"
                            >
                              Sin participaciones
                            </span>
                          )}
                      </>
                    )}
                  </div>

                  <div class="flex items-center justify-end gap-3">
                    <ActionEditButton
                      data-edit-user-btn
                      data-user-id={u.id}
                      data-user-role={normalizeRole(u.role)}
                      data-user-username={u.username}
                      data-user-name={u.agentName ?? ""}
                      data-user-helpdesk={u.helpdeskName ?? ""}
                      data-user-helpdesk-id={u.helpdeskId ?? ""}
                      data-user-flags={JSON.stringify({
                        enCronograma: !!u.enCronograma,
                        asignableCubic: !!u.asignableCubic,
                        incluidoCalidad: !!u.incluidoCalidad,
                        asignableAgs: !!u.asignableAgs,
                      })}
                      class={u.id === currentUserId ? "btn-disabled" : undefined}
                      disabled={u.id === currentUserId}
                      title={
                        u.id === currentUserId
                          ? "No podés modificar tu propia cuenta"
                          : undefined
                      }
                      onclick={`document.getElementById('modal-edit-user-${u.id}').showModal()`}
                      ariaLabel={`Editar usuario ${u.username}`}
                    />

                    <ActionPasswordButton
                      class={u.id === currentUserId ? "btn-disabled" : undefined}
                      disabled={u.id === currentUserId}
                      title={
                        u.id === currentUserId
                          ? "No podés blanquear tu propia contraseña acá"
                          : undefined
                      }
                      onclick={`document.getElementById('modal-reset-${u.id}').showModal()`}
                      ariaLabel={`Blanquear contraseña de ${u.username}`}
                    />
                  </div>

                  <Modal id={`modal-edit-user-${u.id}`}>
                    <Fragment slot="content">
                      <h3 class="text-base-content mb-1 text-base font-semibold">
                        Editar usuario
                      </h3>
                      <p class="text-base-content/60 mb-4 text-xs">
                        Actualizá el rol, la mesa de ayuda, el nombre de red,
                        el nombre visible y las participaciones de{" "}
                        <span class="font-mono font-semibold">{u.username}</span>.
                      </p>
                      <form method="POST" class="space-y-3" data-async-form>
                        <input type="hidden" name="action" value="update-user" />
                        <input type="hidden" name="userId" value={u.id} />
                        <FormField
                          id={`edit-user-username-${u.id}`}
                          name="username"
                          required
                          label="Nombre de red"
                          value={u.username}
                          autocomplete="off"
                          inputClass="input-sm"
                        />
                        <FormField
                          id={`edit-user-name-${u.id}`}
                          name="name"
                          required
                          label="Nombre completo"
                          placeholder={u.agentName || u.username}
                          value={u.agentName || ""}
                          autocomplete="off"
                          inputClass="input-sm"
                          helpText="Se propaga a los cronogramas guardados."
                        />
                        <SelectField
                          id={`edit-user-role-${u.id}`}
                          name="newRole"
                          label="Rol en sistema"
                          selectClass="select-sm"
                          options={[
                            { value: "agent", label: "Agente" },
                            { value: "referent", label: "Referente" },
                            { value: "team_leader", label: "Team Leader" },
                            { value: "supervisor", label: "Supervisor" },
                            { value: "admin", label: "Administrador" },
                          ]}
                          value={normalizeRole(u.role)}
                        />

                        <SelectField
                          id={`edit-user-helpdesk-${u.id}`}
                          name="helpdesk"
                          label="Mesa de ayuda"
                          selectClass="select-sm"
                          options={[
                            { value: "", label: "Sin mesa de ayuda" },
                            ...helpdeskOptions.map((hd) => ({
                              value: `${hd.id}|${hd.name}`,
                              label: hd.name,
                            })),
                          ]}
                          value={`${u.helpdeskId ?? ""}|${u.helpdeskName ?? ""}`}
                        />
                        {
                          mesaHasParticipaciones(u.mesaName ?? u.helpdeskName) ? (
                            <fieldset
                              class="fieldset"
                              data-testid="participaciones-block"
                            >
                              <FormLegend class="text-base-content/70">
                                Participaciones
                              </FormLegend>
                              <label class="label cursor-pointer justify-start gap-3 py-1">
                                <input
                                  type="checkbox"
                                  name="enCronograma"
                                  class="toggle toggle-sm toggle-secondary"
                                  checked={!isSupervisorRole(u.role) && !!u.enCronograma}
                                  disabled={isSupervisorRole(u.role)}
                                  title="Un supervisor no figura en el cronograma como operador"
                                />
                                <span class="text-base-content text-sm">Cronograma</span>
                              </label>
                              <label class="label cursor-pointer justify-start gap-3 py-1">
                                <input
                                  type="checkbox"
                                  name="asignableCubic"
                                  class="toggle toggle-sm toggle-secondary"
                                  checked={!!u.asignableCubic}
                                />
                                <span class="text-base-content text-sm">Asignación de PCs (cubics)</span>
                              </label>
                              <label class="label cursor-pointer justify-start gap-3 py-1">
                                <input
                                  type="checkbox"
                                  name="incluidoCalidad"
                                  class="toggle toggle-sm toggle-secondary"
                                  checked={!!u.incluidoCalidad}
                                />
                                <span class="text-base-content text-sm">Auditorías de calidad</span>
                              </label>
                              <label class="label cursor-pointer justify-start gap-3 py-1">
                                <input
                                  type="checkbox"
                                  name="asignableAgs"
                                  class="toggle toggle-sm toggle-secondary"
                                  checked={!!u.asignableAgs}
                                />
                                <span class="text-base-content text-sm">Asignación AGS</span>
                              </label>
                            </fieldset>
                          ) : (
                            <div
                              class="alert alert-ghost items-start gap-2 py-2"
                              data-testid="participaciones-block"
                            >
                              <Icon name="boxicons:info-circle" size={18} />
                              <span class="text-base-content/70 text-xs">
                                Esta mesa no tiene secciones con participaciones.
                              </span>
                            </div>
                          )
                        }
                        <div class="border-base-200 mt-4 flex items-center justify-end gap-2 border-t pt-3">
                          <ActionCancelButton type="button" label="Cancelar" icon="boxicons:x-filled" variant="error" onclick="this.closest('dialog').close()" />
                          <ActionConfirmButton type="submit" color="btn-primary" label="Guardar" icon="boxicons:check-filled" />
                        </div>
                      </form>
                    </Fragment>
                  </Modal>
                  {/* ── Modales (Fuera del flujo visual de la fila) ── */}
                  <Modal id={`modal-reset-${u.id}`}>
                    <Fragment slot="content">
                      <h3 class="text-base-content mb-1 text-base font-semibold">
                        Blanquear contraseña
                      </h3>
                      <p class="text-base-content/60 mb-4 text-xs">
                        Establece una nueva contraseña para{" "}
                        <span class="font-mono font-semibold">
                          {u.username}
                        </span>
                        .
                      </p>
                      <form method="POST" class="space-y-3" data-async-form>
                        <input
                          type="hidden"
                          name="action"
                          value="reset-password"
                        />
                        <input type="hidden" name="userId" value={u.id} />
                        <PasswordField
                          id={`reset-password-${u.id}`}
                          name="newPassword"
                          required
                          label="Nueva contraseña"
                          confirmPassword={true}
                          confirmLabel="Repetir nueva contraseña"
                          autocomplete="new-password"
                          inputClass="input-sm"
                        />
                        <div class="border-base-200 mt-4 flex items-center justify-end gap-2 border-t pt-3">
                          <ActionCancelButton
                            type="button"
                            label="Cancelar"
                            icon="boxicons:x-filled"
                            variant="error"
                            onclick="this.closest('dialog').close()"
                          />
                          <ActionConfirmButton
                            type="submit"
                            color="btn-warning"
                            label="Blanquear"
                            icon="boxicons:lock-open-filled"
                          />
                        </div>
                      </form>
                    </Fragment>
                  </Modal>
                </article>
              ))
            )
          }
        </DataTable>
      </div>
    </section>
  </div>
  </div>
</PageContainer>

<UserCreateModal helpdeskOptions={helpdeskOptions} />

<Modal
  id="modal-permissions-matrix"
  title="Matriz de permisos por rol"
  icon="boxicons:universal-access-filled"
  size="full"
  class="!w-fit max-w-[calc(100vw-1rem)] !p-3 sm:!p-4"
>
  <Fragment slot="content">
    <p class="text-base-content/60 mb-4 text-xs">
      Detalle comparativo de las acciones y accesos permitidos para cada rol en
      la plataforma.
    </p>
    <div>
      <table class="table-xs md:table-sm table w-full">
        <thead>
          <tr class="text-base-content/70">
            <th class="bg-base-200/30">Funcionalidad / Ruta</th>
            <th class="bg-neutral text-neutral-content text-center font-bold"
              >Agente</th
            >
            <th class="bg-warning text-warning-content text-center font-bold"
              >Referente</th
            >
            <th class="bg-accent text-accent-content text-center font-bold"
              >Team Leader</th
            >
            <th class="bg-info text-info-content text-center font-bold"
              >Supervisor</th
            >
            <th class="bg-error text-error-content text-center font-bold"
              >Admin</th
            >
          </tr>
        </thead>
        <tbody>
          {
            rolesMatrix.map((row) => (
              <tr class="hover:bg-base-200/20 transition-colors">
                <td class="text-base-content/80 flex items-center gap-2 py-3 text-xs font-medium whitespace-nowrap md:text-sm">
                  <Icon
                    name={row.icon}
                    size={16}
                    class="text-base-content/65 shrink-0"
                  />
                  <span>{row.feature}</span>
                </td>
                <td class="bg-base-200/5 text-center">
                  {row.agent ? (
                    <Icon
                      name="boxicons:check-filled"
                      class="text-success inline-block"
                      size={24}
                    />
                  ) : (
                    <Icon
                      name="boxicons:x-filled"
                      class="text-error inline-block"
                      size={24}
                    />
                  )}
                </td>
                <td class="bg-warning/5 text-center">
                  {row.referent ? (
                    <Icon
                      name="boxicons:check-filled"
                      class="text-success inline-block"
                      size={24}
                    />
                  ) : (
                    <Icon
                      name="boxicons:x-filled"
                      class="text-error inline-block"
                      size={24}
                    />
                  )}
                </td>
                <td class="bg-accent/5 text-center">
                  {row.team_leader ? (
                    <Icon
                      name="boxicons:check-filled"
                      class="text-success inline-block"
                      size={24}
                    />
                  ) : (
                    <Icon
                      name="boxicons:x-filled"
                      class="text-error inline-block"
                      size={24}
                    />
                  )}
                </td>
                <td class="bg-info/5 text-center">
                  {row.supervisor ? (
                    <Icon
                      name="boxicons:check-filled"
                      class="text-success inline-block"
                      size={24}
                    />
                  ) : (
                    <Icon
                      name="boxicons:x-filled"
                      class="text-error inline-block"
                      size={24}
                    />
                  )}
                </td>
                <td class="bg-error/5 text-center">
                  {row.admin ? (
                    <Icon
                      name="boxicons:check-filled"
                      class="text-success inline-block"
                      size={24}
                    />
                  ) : (
                    <Icon
                      name="boxicons:x-filled"
                      class="text-error inline-block"
                      size={24}
                    />
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </Fragment>
</Modal>

<AsyncFormScript />

<script>
import { getCleanBase } from "@lib/baseUrl";
import { normalizeRole } from "@lib/rbac";
  // La validación de contraseñas es gestionada internamente por el componente PasswordField

  function initUsersAdmin() {
    const createBtn = document.getElementById("btn-nuevo-usuario");
    if (createBtn?.dataset.usersAdminBound === "true") return true;
    if (!document.querySelector("[data-edit-user-btn]") && !createBtn) return false;

    const adminUsernameInput = document.getElementById(
      "admin-username",
    ) as HTMLInputElement | null;
    const adminHelpdeskSelect = document.getElementById(
      "admin-helpdesk",
    ) as HTMLSelectElement | null;

    type SuggestResult =
      | { ok: true; helpdesk: { invgateId: number; name: string } | null }
      | { ok: false; message: string };

    async function suggestMesaForUsername(
      username: string,
    ): Promise<SuggestResult> {
      try {
        const res = await fetch(
          `${getCleanBase()}api/admin/suggest-helpdesk?username=${encodeURIComponent(username)}`,
          { credentials: "same-origin" },
        );
        if (!res.ok) {
          return {
            ok: false,
            message:
              res.status === 401 || res.status === 403
                ? "No tenés permiso para consultar mesas."
                : "No se pudo consultar InvGate.",
          };
        }
        const json = await res.json();
        return { ok: true, helpdesk: json?.helpdesk ?? null };
      } catch {
        return { ok: false, message: "Error de conexión al consultar InvGate." };
      }
    }

    function selectOrAddHelpdeskOption(
      select: HTMLSelectElement,
      invgateId: number,
      name: string,
    ): void {
      const value = `${invgateId}|${name}`;
      const existing = Array.from(select.options).find((o) => o.value === value);
      if (existing) {
        select.value = value;
        return;
      }
      const opt = document.createElement("option");
      opt.value = value;
      opt.textContent = `${name} (sugerida)`;
      select.appendChild(opt);
      select.value = value;
    }

    adminUsernameInput?.addEventListener("blur", async () => {
      const username = adminUsernameInput.value.trim();
      if (!username) return;
      if (adminHelpdeskSelect && !adminHelpdeskSelect.value) {
        const result = await suggestMesaForUsername(username);
        if (result.ok && result.helpdesk) {
          selectOrAddHelpdeskOption(adminHelpdeskSelect, result.helpdesk.invgateId, result.helpdesk.name);
          refreshParticipacionesVisibility();
        }
      }
    });

    // Prefill del modal unificado por fila (rol, mesa, username, nombre, flags).
    document.querySelectorAll<HTMLButtonElement>("[data-edit-user-btn]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const userId = btn.getAttribute("data-user-id") || "";
        const role = btn.getAttribute("data-user-role") || "agent";
        const username = btn.getAttribute("data-user-username") || "";
        const name = btn.getAttribute("data-user-name") || "";
        const helpdesk = (btn.getAttribute("data-user-helpdesk") || "").trim();
        const helpdeskId = (btn.getAttribute("data-user-helpdesk-id") || "").trim();
        let flags: Record<string, boolean> = {};
        try {
          flags = JSON.parse(btn.getAttribute("data-user-flags") || "{}");
        } catch {
          flags = {};
        }

        const roleSel = document.getElementById(`edit-user-role-${userId}`) as HTMLSelectElement | null;
        const hdSel = document.getElementById(`edit-user-helpdesk-${userId}`) as HTMLSelectElement | null;
        const unameInput = document.getElementById(`edit-user-username-${userId}`) as HTMLInputElement | null;
        const nameInput = document.getElementById(`edit-user-name-${userId}`) as HTMLInputElement | null;

        if (roleSel) {
          const canonical = normalizeRole(role);
          const hasOption = Array.from(roleSel.options).some((o) => o.value === role);
          roleSel.value = hasOption ? role : canonical;
        }
        if (unameInput) unameInput.value = username;
        if (nameInput) nameInput.value = name;
        if (hdSel) {
          hdSel.value = "";
          if (helpdeskId) {
            // Match por id (prefijo del value "id|nombre"): robusto ante
            // renombres de mesa y labels duplicados/"(sugerida)".
            const byId = Array.from(hdSel.options).find(
              (o) => o.value.split("|")[0] === helpdeskId,
            );
            if (byId) hdSel.value = byId.value;
          } else if (helpdesk) {
            const match = Array.from(hdSel.options).find(
              (o) => (o.textContent ?? "").trim() === helpdesk,
            );
            if (match) hdSel.value = match.value;
          }
        }
        for (const [flag, checked] of Object.entries(flags)) {
          const cb = document.querySelector<HTMLInputElement>(
            `#modal-edit-user-${userId} input[name="${flag}"]`,
          );
          if (cb) cb.checked = checked;
        }
      });
    });

    const PARTICIPATION_PRESETS: Record<string, Record<string, boolean>> = {
      agent: { enCronograma: true, asignableCubic: true, incluidoCalidad: true, asignableAgs: true },
      referent: { enCronograma: true, asignableCubic: true, incluidoCalidad: true, asignableAgs: true },
      team_leader: { enCronograma: true, asignableCubic: true, incluidoCalidad: false, asignableAgs: false },
      supervisor: { enCronograma: false, asignableCubic: false, incluidoCalidad: false, asignableAgs: false },
      admin: { enCronograma: false, asignableCubic: false, incluidoCalidad: false, asignableAgs: false },
    };

    function applyPresets(role: string) {
      const preset = PARTICIPATION_PRESETS[role];
      if (!preset) return;
      const form = document.getElementById("nuevo-usuario-form");
      if (!form) return;
      for (const [flagName, checked] of Object.entries(preset)) {
        const cb = form.querySelector<HTMLInputElement>(`input[name="${flagName}"]`);
        if (!cb) continue;
        cb.checked = checked;
        cb.disabled = role === "supervisor" && flagName === "enCronograma";
      }
    }

    const altaRoleSelect = document.getElementById("admin-role") as HTMLSelectElement | null;
    altaRoleSelect?.addEventListener("change", (e) => {
      applyPresets((e.target as HTMLSelectElement).value);
    });
    applyPresets(altaRoleSelect?.value || "agent");

    // Participaciones solo visibles para mesas con secciones participativas.
    let participationMesas: string[] = [];
    try {
      participationMesas = JSON.parse(
        (document.querySelector<HTMLElement>("[data-participation-mesas]")?.dataset.participationMesas as string) || "[]",
      );
    } catch {
      participationMesas = [];
    }    const altaHelpdeskSelect = document.getElementById("admin-helpdesk") as HTMLSelectElement | null;
    const participacionesFields = document.getElementById("participaciones-fields");
    function refreshParticipacionesVisibility(): void {
      const name = altaHelpdeskSelect?.value?.split("|")[1]?.trim() ?? "";
      participacionesFields?.classList.toggle("hidden", !participationMesas.includes(name));
    }
    altaHelpdeskSelect?.addEventListener("change", refreshParticipacionesVisibility);
    refreshParticipacionesVisibility();

    const createDialog = document.getElementById("modal-create-user") as HTMLDialogElement | null;
    const createForm = document.getElementById("nuevo-usuario-form") as HTMLFormElement | null;
    if (createBtn && createDialog && createForm) {
      createBtn.addEventListener("click", () => {
        createForm.querySelectorAll(".pwd-error").forEach((el) => el.classList.add("hidden"));
        createForm.reset();
        applyPresets(altaRoleSelect?.value || "agent");
        refreshParticipacionesVisibility();
        createDialog.showModal();
      });
      createBtn.dataset.usersAdminBound = "true";
    }

    return true;
  }

  function setupUsersObserver() {
    if (initUsersAdmin()) return;

    const observer = new MutationObserver((_, obs) => {
      if (initUsersAdmin()) {
        obs.disconnect();
      }
    });

    observer.observe(document.body, { childList: true, subtree: true });
  }

  setupUsersObserver();

  document.addEventListener("astro:page-load", () => {
    setupUsersObserver();
  });
</script>

<script>
  import { matchesSearchQuery, highlightSearchTargets } from "@lib/clientSearch";

  function initUsersSearch() {
    const searchInput =
      document.querySelector<HTMLInputElement>("#admin-users-search");
    if (!searchInput) return false;
    if (searchInput.dataset.usersSearchBound === "true") return true;

    function applyFilters() {
      const query = searchInput?.value.trim() ?? "";
      const rows = document.querySelectorAll<HTMLElement>(
        "#usuarios-table [data-table-row]",
      );
      rows.forEach((row) => {
        const searchText = row.dataset.searchText || "";
        const isVisible = matchesSearchQuery(query, [searchText]);
        row.classList.toggle("hidden", !isVisible);
        highlightSearchTargets(row, isVisible ? query : "");
      });
    }

    searchInput.addEventListener("input", applyFilters);
    const clearButton = document.getElementById("admin-users-search-clear");
    clearButton?.addEventListener("click", () => {
      searchInput.value = "";
      applyFilters();
      searchInput.focus();
    });
    searchInput.dataset.usersSearchBound = "true";
    return true;
  }

  function setupUsersSearchObserver() {
    if (initUsersSearch()) return;

    const observer = new MutationObserver((_, obs) => {
      if (initUsersSearch()) {
        obs.disconnect();
      }
    });

    observer.observe(document.body, { childList: true, subtree: true });
  }

  setupUsersSearchObserver();

  document.addEventListener("astro:page-load", () => {
    setupUsersSearchObserver();
  });
</script>
