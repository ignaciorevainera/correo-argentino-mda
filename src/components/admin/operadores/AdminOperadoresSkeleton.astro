---
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import DataTable from "@components/ui/DataTable.astro";
import DataTableHeaderCell from "@components/ui/DataTableHeaderCell.astro";

const headerGridClass = "grid-cols-[90px_1.2fr_1fr_140px_120px] gap-4";
const rowGridClass =
  "grid grid-cols-[90px_1.2fr_1fr_140px_120px] items-center gap-4";
---

<PageContainer>
  <div class="skeleton-debounced">
    <PageHeader
      title="Gestión de operadores"
      description="Administración de la plantilla de operadores, ubicaciones y estados."
    />

    {/* ── Toolbar Skeleton ── */}
    <div
      class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center"
    >
      <div class="flex items-center gap-3">
        <h2 class="text-base-content text-lg font-semibold">
          Operadores registrados
        </h2>
        <div class="skeleton h-5 w-8 rounded-full"></div>
      </div>

      <div
        class="flex w-full flex-col items-center gap-3 sm:w-auto sm:flex-row"
      >
        <div class="skeleton h-10 w-full rounded-lg sm:w-64"></div>
        <div class="skeleton h-10 w-full rounded-lg sm:w-36"></div>
      </div>
    </div>

    {/* ── Tabla Skeleton ── */}
    <DataTable
      ariaLabel="Cargando operadores..."
      minWidthClass="min-w-200"
      headerGridClass={headerGridClass}
      rowGridClass={rowGridClass}
      class="mt-4"
    >
      <div slot="header">
        <DataTableHeaderCell sortKey="id">ID</DataTableHeaderCell>
      </div>
      <div slot="header">
        <DataTableHeaderCell sortKey="name">Nombre</DataTableHeaderCell>
      </div>
      <div slot="header">
        <DataTableHeaderCell sortKey="location"
          >Ubicación presencial</DataTableHeaderCell
        >
      </div>
      <div slot="header">
        <DataTableHeaderCell sortKey="status">Estado</DataTableHeaderCell>
      </div>
      <div slot="header" class="text-right">
        <DataTableHeaderCell align="right">Acciones</DataTableHeaderCell>
      </div>

      {
        Array.from({ length: 5 }).map(() => (
          <div
            class:list={[
              rowGridClass,
              "border-base-300 border-b px-4 py-4 last:border-b-0",
            ]}
          >
            <div class="skeleton h-6 w-16 rounded-md" />
            <div class="skeleton h-4 w-32 rounded" />
            <div class="skeleton h-4 w-28 rounded" />
            <div class="skeleton h-5 w-20 rounded-full" />
            <div class="flex justify-end gap-2">
              <div class="skeleton h-7 w-16 rounded-lg" />
              <div class="skeleton h-7 w-16 rounded-lg" />
            </div>
          </div>
        ))
      }
    </DataTable>
  </div>
</PageContainer>
