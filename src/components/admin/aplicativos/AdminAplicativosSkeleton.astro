---
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";

const headerGridClass = "grid-cols-[1.5fr_1fr_80px_1.5fr_120px] gap-4";
---

<PageContainer>
  <div class="skeleton-debounced">
    <PageHeader
      description="Gestión de los aplicativos disponibles para descarga y distribución interna."
    />

    <div class="flex flex-col gap-4">
      <!-- Toolbar Skeleton -->
      <div
        class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center"
      >
        <div class="flex items-center gap-3">
          <div class="skeleton h-6 w-48 rounded"></div>
          <div class="skeleton h-5 w-8 rounded font-mono"></div>
        </div>
        <div
          class="flex w-full flex-col items-center gap-3 sm:w-auto sm:flex-row"
        >
          <div class="skeleton h-10 w-full rounded-lg sm:w-64"></div>
          <div class="skeleton h-10 w-full rounded-lg sm:w-36"></div>
        </div>
      </div>

      <!-- Table Skeleton -->
      <div
        class="border-base-300 bg-base-100 overflow-hidden rounded-xl border"
      >
        <div
          class={`grid ${headerGridClass} border-b border-base-300 px-4 py-3 bg-base-200/50`}
        >
          <div><div class="skeleton h-5 w-16 rounded"></div></div>
          <div><div class="skeleton h-5 w-20 rounded"></div></div>
          <div><div class="skeleton h-5 w-16 rounded"></div></div>
          <div><div class="skeleton h-5 w-32 rounded"></div></div>
          <div>
            <div class="skeleton h-5 w-16 justify-self-end rounded"></div>
          </div>
        </div>

        <div class="divide-base-300 divide-y">
          {
            Array.from({ length: 8 }).map(() => (
              <div class={`grid ${headerGridClass} items-center px-4 py-4`}>
                <div>
                  <div class="skeleton h-4 w-44 rounded" />
                </div>
                <div>
                  <div class="skeleton h-5 w-24 rounded-full" />
                </div>
                <div>
                  <div class="skeleton h-4 w-12 rounded font-mono" />
                </div>
                <div>
                  <div class="skeleton h-4 w-48 rounded font-mono" />
                </div>
                <div class="flex justify-end">
                  <div class="skeleton h-6 w-20 rounded" />
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="flex justify-start pt-2">
        <div class="skeleton h-8 w-44 rounded"></div>
      </div>
    </div>
  </div>
</PageContainer>
