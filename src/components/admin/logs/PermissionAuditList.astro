---
interface Props {
  batches: Array<{
    id: number;
    adminUsername: string;
    editedAt: string;
    changedCells: number;
    summary: string;
  }>;
}

const { batches } = Astro.props;
---

<section class="mt-8">
  <div class="mb-4 flex items-center gap-2">
    <h2 class="text-lg font-semibold text-base-content">Lotes de permisos</h2>
    <span class="badge badge-primary">Permisos</span>
  </div>

  {
    batches.length === 0 ? (
      <p class="text-sm text-base-content/60">No hay lotes de permisos registrados.</p>
    ) : (
      <ul class="flex flex-col gap-3">
        {batches.map((batch) => (
          <li class="rounded-lg border border-base-300 bg-base-100 p-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <span class="font-medium text-base-content">{batch.adminUsername}</span>
                <span class="badge badge-ghost">{batch.changedCells} celdas</span>
              </div>
              <span class="text-sm text-base-content/60">{new Date(batch.editedAt).toLocaleString()}</span>
            </div>
            <details class="mt-2">
              <summary class="cursor-pointer text-sm text-primary">Ver detalle</summary>
              <pre class="mt-2 overflow-auto rounded-lg bg-base-200 p-3 text-xs">{JSON.parse(batch.summary)}</pre>
            </details>
          </li>
        ))}
      </ul>
    )
  }
</section>
