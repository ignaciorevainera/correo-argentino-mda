---
import { db } from "@db/index";
import { deletedRecords } from "@db/schema";
import { isNull, desc } from "drizzle-orm";
import { getCleanBase } from "@lib/baseUrl";
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import DataTable from "@components/ui/DataTable.astro";
import DataTableHeaderCell from "@components/ui/DataTableHeaderCell.astro";
import SearchBar from "@components/ui/SearchBar.astro";
import SearchEmptyState from "@components/ui/SearchEmptyState.astro";
import EntityBadge from "@components/admin/papelera/EntityBadge.astro";
import { Icon } from "astro-icon/components";

const cleanBase = getCleanBase();

const registros = await db
  .select()
  .from(deletedRecords)
  .where(isNull(deletedRecords.purgedAt))
  .orderBy(desc(deletedRecords.deletedAt), desc(deletedRecords.id));

const headerGridClass =
  "grid-cols-[minmax(0,1.4fr)_120px_140px_150px_110px_110px] gap-3";
const rowGridClass =
  "grid grid-cols-[minmax(0,1.4fr)_120px_140px_150px_110px_110px] items-center gap-3";
---

<PageContainer>
  <PageHeader
    title="Papelera"
    description={`Registros eliminados con snapshot recuperable. Si el identificador único ya fue recreado, se renombra con el sufijo ' (restaurado)'.`}
  />

  <SearchBar
    id="papelera-search"
    placeholder="Buscar por etiqueta, entidad o usuario..."
  />

  {
    registros.length === 0 ? (
      <SearchEmptyState
        title="La papelera está vacía"
        description="Los registros eliminados aparecerán aquí y podrán restaurarse."
        icon="boxicons:trash"
        class="flex"
      />
    ) : (
      <DataTable
        id="papelera-table"
        ariaLabel="Registros en papelera"
        headerGridClass={headerGridClass}
        rowGridClass={rowGridClass}
        minWidthClass="min-w-max"
        emptyStateTitle="Sin resultados"
        emptyStateDescription="No se encontraron coincidencias para tu búsqueda. Probá con otros términos."
        defaultSortKey="deletedat"
        defaultSortDirection="descending"
      >
        <div slot="header">
          <DataTableHeaderCell sortKey="label">Registro</DataTableHeaderCell>
        </div>
        <div slot="header">
          <DataTableHeaderCell sortKey="entity">Entidad</DataTableHeaderCell>
        </div>
        <div slot="header">
          <DataTableHeaderCell sortKey="deletedby">
            Borrado por
          </DataTableHeaderCell>
        </div>
        <div slot="header">
          <DataTableHeaderCell sortKey="deletedat">Fecha</DataTableHeaderCell>
        </div>
        <div slot="header">
          <DataTableHeaderCell sortKey="estado">Estado</DataTableHeaderCell>
        </div>
        <div slot="header" class="text-right">
          <DataTableHeaderCell align="right">Acciones</DataTableHeaderCell>
        </div>

        {registros.map((r) => (
          <div
            data-table-row
            data-sort-id={r.id}
            data-sort-label={(r.label ?? "").toLowerCase()}
            data-sort-entity={r.entity}
            data-sort-deletedby={r.deletedBy}
            data-sort-deletedat={r.deletedAt}
            data-sort-estado={r.restoredAt ? "restaurado" : "en-papelera"}
            data-search-text={`${r.label} ${r.entity} ${r.deletedBy}`.toLowerCase()}
            class:list={[
              rowGridClass,
              "border-base-300 hover:bg-base-200/50 border-b px-4 py-3 transition-colors last:border-b-0",
            ]}
          >
            <div class="min-w-0">
              <span
                data-highlight-target
                class="text-base-content block truncate text-sm font-medium"
                title={r.label}
              >
                {r.label}
              </span>
            </div>

            <div class="min-w-0">
              <EntityBadge entity={r.entity} />
            </div>

            <div class="min-w-0">
              <span
                class="text-base-content/70 block truncate font-mono text-xs"
                title={r.deletedBy}
              >
                {r.deletedBy}
              </span>
            </div>

            <div class="min-w-0">
              <span class="text-base-content/70 block truncate font-mono text-xs">
                {new Date(r.deletedAt).toLocaleString("es-AR")}
              </span>
            </div>

            <div>
              <span
                class:list={[
                  "badge badge-sm uppercase",
                  r.restoredAt ? "badge-success" : "badge-warning",
                ]}
              >
                {r.restoredAt ? "restaurado" : "en papelera"}
              </span>
            </div>

            <div class="text-right">
              <form
                method="POST"
                action={`${cleanBase}admin/papelera/${r.id}/restaurar`}
                class="inline"
                onsubmit="return confirm('¿Restaurar este registro?')"
              >
                <button
                  type="submit"
                  class="btn btn-xs btn-soft btn-secondary gap-2"
                  disabled={!!r.restoredAt}
                  aria-label={`Restaurar ${r.label}`}
                >
                  <Icon name="boxicons:undo-stroke" size={14} />
                  Restaurar
                </button>
              </form>
            </div>
          </div>
        ))}
      </DataTable>
    )
  }
</PageContainer>

<script>
  import {
    matchesSearchQuery,
    highlightSearchTargets,
  } from "@lib/clientSearch";

  function initSearch() {
    const searchInput =
      document.querySelector<HTMLInputElement>("#papelera-search");
    if (!searchInput) return false;

    const rows = document.querySelectorAll<HTMLElement>("[data-table-row]");

    function applyFilters() {
      const query = searchInput?.value.trim();
      rows.forEach((row) => {
        const searchText = row.dataset.searchText || "";
        const isVisible = matchesSearchQuery(query, [searchText]);

        row.classList.toggle("hidden", !isVisible);
        highlightSearchTargets(row, isVisible ? query : "");
      });
    }

    searchInput.addEventListener("input", applyFilters);
    return true;
  }

  function setupSearchObserver() {
    if (initSearch()) return;

    const observer = new MutationObserver((_, obs) => {
      if (initSearch()) {
        obs.disconnect();
      }
    });

    observer.observe(document.body, { childList: true, subtree: true });
  }

  setupSearchObserver();

  document.addEventListener("astro:page-load", () => {
    setupSearchObserver();
  });
</script>
