---
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import DataTable from "@components/ui/DataTable.astro";
import SearchBar from "@components/ui/SearchBar.astro";

const headerGridClass =
  "grid-cols-[minmax(0,2fr)_110px_130px_170px_130px_110px]";
const rowGridClass = "grid-cols-[minmax(0,2fr)_110px_130px_170px_130px_110px]";
---

<PageContainer>
  <div class="mb-6">
    <PageHeader
      title="Papelera"
      description="Registros eliminados con snapshot recuperable."
    />
  </div>

  <SearchBar id="papelera-search-skeleton" placeholder="Buscar..." class="mb-4" />

  <DataTable
    id="papelera-table-skeleton"
    ariaLabel="Cargando papelera"
    headerGridClass={headerGridClass}
    rowGridClass={rowGridClass}
    minWidthClass="min-w-max"
  >
    <div slot="header">
      <div class="skeleton h-4 w-20"></div>
    </div>
    <div slot="header">
      <div class="skeleton h-4 w-16"></div>
    </div>
    <div slot="header">
      <div class="skeleton h-4 w-20"></div>
    </div>
    <div slot="header">
      <div class="skeleton h-4 w-14"></div>
    </div>
    <div slot="header">
      <div class="skeleton h-4 w-16"></div>
    </div>
    <div slot="header">
      <div class="skeleton h-4 w-16"></div>
    </div>

    {
      Array.from({ length: 5 }).map(() => (
        <div
          data-table-row
          class:list={[
            rowGridClass,
            "border-base-300 border-b px-4 py-3 last:border-b-0",
          ]}
        >
          <div class="skeleton h-4 w-full"></div>
          <div class="skeleton h-4 w-full"></div>
          <div class="skeleton h-4 w-full"></div>
          <div class="skeleton h-4 w-full"></div>
          <div class="skeleton h-4 w-full"></div>
          <div class="flex justify-end">
            <div class="skeleton h-6 w-20"></div>
          </div>
        </div>
      ))
    }
  </DataTable>
</PageContainer>
