---
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import DataTable from "@components/ui/DataTable.astro";
import DataTableHeaderCell from "@components/ui/DataTableHeaderCell.astro";

const headerGridClass = "grid-cols-[80px_1fr_90px_150px_1fr_140px] gap-4";
const rowGridClass =
  "grid grid-cols-[80px_1fr_90px_150px_1fr_140px] items-center gap-4";
---

<PageContainer>
  <div class="skeleton-debounced">
    <PageHeader
      description="Administración del directorio operativo de oficinas, contactos y activos tecnológicos."
    />

    {/* ── Filtros Skeleton ── */}
    <div
      class="rounded-box border-base-300 bg-base-100 flex flex-col gap-4 border p-4 shadow-md"
    >
      <div class="w-full">
        <div class="skeleton h-12 w-full rounded-lg"></div>
      </div>
      <div class="flex w-full flex-wrap items-center gap-3">
        <div class="skeleton h-10 min-w-40 flex-1 rounded-lg"></div>
        <div class="skeleton h-10 min-w-40 flex-1 rounded-lg"></div>
        <div class="skeleton h-10 min-w-40 flex-1 rounded-lg"></div>
        <div class="skeleton h-10 min-w-40 flex-1 rounded-lg"></div>
        <div class="skeleton h-10 min-w-70 flex-2 rounded-lg"></div>
      </div>
    </div>

    {/* ── Toolbar Superior Skeleton ── */}
    <div class="mt-6 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <h2 class="text-base-content text-lg font-semibold">
          Oficinas registradas
        </h2>
        <div class="skeleton h-5 w-12 rounded-full"></div>
      </div>
      <div class="skeleton h-10 w-36 rounded-lg"></div>
    </div>

    {/* ── Tabla Skeleton ── */}
    <DataTable
      ariaLabel="Cargando oficinas..."
      minWidthClass="min-w-200"
      headerGridClass={headerGridClass}
      rowGridClass={rowGridClass}
      class="mt-4"
    >
      <div slot="header">
        <DataTableHeaderCell sortKey="code">Código</DataTableHeaderCell>
      </div>
      <div slot="header">
        <DataTableHeaderCell sortKey="name">Nombre</DataTableHeaderCell>
      </div>
      <div slot="header">
        <DataTableHeaderCell sortKey="parent-nis">NIS Padre</DataTableHeaderCell
        >
      </div>
      <div slot="header">
        <DataTableHeaderCell sortKey="type">Tipo</DataTableHeaderCell>
      </div>
      <div slot="header">
        <DataTableHeaderCell sortKey="region"
          >Provincia / Región</DataTableHeaderCell
        >
      </div>
      <div slot="header" class="text-right">
        <DataTableHeaderCell align="right">Acciones</DataTableHeaderCell>
      </div>

      {
        Array.from({ length: 5 }).map(() => (
          <div
            class:list={[
              rowGridClass,
              "border-base-300 border-b px-4 py-4 last:border-b-0",
            ]}
          >
            <div class="skeleton h-4 w-12 rounded" />
            <div class="skeleton h-4 w-40 rounded" />
            <div class="skeleton h-4 w-16 rounded" />
            <div class="skeleton h-6 w-24 rounded-lg" />
            <div class="skeleton h-4 w-32 rounded" />
            <div class="flex justify-end gap-2">
              <div class="skeleton h-7 w-16 rounded-lg" />
              <div class="skeleton h-7 w-16 rounded-lg" />
            </div>
          </div>
        ))
      }
    </DataTable>
  </div>
</PageContainer>
