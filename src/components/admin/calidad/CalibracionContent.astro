<script>
  import {
    validateRubricBlock,
    computeSimpleDiff,
    formatCalibrationComment,
    checkCausalHint,
    insertRuleIntoBlock,
  } from "@lib/calidad/rubricValidator";

  // Sincronización de Filtros
  const selectMonth = document.getElementById("filter-month") as HTMLSelectElement | null;
  const selectChannel = document.getElementById("filter-channel") as HTMLSelectElement | null;

  function updateQuery() {
    const url = new URL(window.location.href);
    if (selectMonth?.value) url.searchParams.set("month", selectMonth.value);
    if (selectChannel?.value) url.searchParams.set("channel", selectChannel.value);
    window.location.href = url.toString();
  }

  selectMonth?.addEventListener("change", updateQuery);
  selectChannel?.addEventListener("change", updateQuery);

  // Copiado rápido de caso en formato Markdown
  document.querySelectorAll<HTMLButtonElement>(".btn-copy-case").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const rawData = btn.getAttribute("data-case");
      if (!rawData) return;
      try {
        const d = JSON.parse(rawData);
        const md = [
          `### Caso de Discrepancia: ${d.nombre} (\`${d.criterio}\`)`,
          `- **Ticket / Caso:** #${d.ticket || "N/A"}`,
          `- **Clasificación:** ${d.clasificacion}`,
          `- **IA (${d.ia}):** "${d.evidenciaIa}"`,
          `- **Supervisor (${d.humano}):** "${d.comentarioHumano}"`,
          "",
          `*Propuesta de ajuste de rúbrica:*`,
        ].join("\n");

        await navigator.clipboard.writeText(md);
        const originalText = btn.innerHTML;
        btn.innerHTML = `<span>¡Copiado!</span>`;
        setTimeout(() => {
          btn.innerHTML = originalText;
        }, 2000);
      } catch (err) {
        console.error("Error al copiar caso:", err);
      }
    });
  });

  // --- FILTRADO DE TABLA DE DISCREPANCIAS (Live Search + Pills) ---
  const searchDiscrepancies = document.getElementById("search-discrepancies") as HTMLInputElement | null;
  const filterPillBtns = document.querySelectorAll<HTMLButtonElement>(".filter-pill-btn");
  const visibleCountBadge = document.getElementById("discrepancies-visible-count");
  const discrepancyRows = document.querySelectorAll<HTMLTableRowElement>(".discrepancy-row");

  let currentFilter = "discrepancias";
  let currentSearchQuery = "";

  function applyDiscrepancyFilters() {
    let visibleCount = 0;
    const totalCount = discrepancyRows.length;

    discrepancyRows.forEach((row) => {
      const classification = row.getAttribute("data-classification") || "";
      const searchText = row.getAttribute("data-search-text") || "";

      // Filtro de píldora
      let matchesPill = false;
      if (currentFilter === "all") {
        matchesPill = true;
      } else if (currentFilter === "discrepancias") {
        matchesPill = classification === "falso_positivo" || classification === "falso_negativo";
      } else {
        matchesPill = classification === currentFilter;
      }

      // Filtro de búsqueda
      const matchesSearch = !currentSearchQuery || searchText.includes(currentSearchQuery);

      if (matchesPill && matchesSearch) {
        row.classList.remove("hidden");
        visibleCount++;
      } else {
        row.classList.add("hidden");
      }
    });

    if (visibleCountBadge) {
      if (currentFilter === "all" && !currentSearchQuery) {
        visibleCountBadge.textContent = `Mostrando todos (${visibleCount} casos)`;
      } else {
        visibleCountBadge.textContent = `Mostrando ${visibleCount} de ${totalCount} casos`;
      }
    }
  }

  filterPillBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterPillBtns.forEach((b) => {
        b.classList.remove("btn-secondary", "btn-active", "bg-error/15", "border-error/30", "bg-warning/15", "border-warning/30", "bg-base-200", "border-base-300");
        b.classList.add("btn-ghost");
      });
      btn.classList.remove("btn-ghost");
      btn.classList.add("btn-active");

      const filter = btn.getAttribute("data-filter") || "discrepancias";
      if (filter === "falso_positivo") {
        btn.classList.add("bg-error/15", "border-error/30");
      } else if (filter === "falso_negativo") {
        btn.classList.add("bg-warning/15", "border-warning/30");
      } else if (filter === "acuerdo" || filter === "all") {
        btn.classList.add("bg-base-200", "border-base-300");
      } else {
        btn.classList.add("btn-secondary");
      }

      currentFilter = filter;
      applyDiscrepancyFilters();
    });
  });

  searchDiscrepancies?.addEventListener("input", () => {
    currentSearchQuery = (searchDiscrepancies.value || "").trim().toLowerCase();
    applyDiscrepancyFilters();
  });

  // Ejecutar filtro inicial
  applyDiscrepancyFilters();

  // --- INICIALIZAR ORDENAMIENTO DE TABLA (clientTableSort) ---
  const matrixSortRoot = document.getElementById("matrix-sort-root");
  if (matrixSortRoot) {
    import("@lib/clientTableSort").then(({ bindClientTableSort }) => {
      bindClientTableSort(document);
    });
  }

  // --- BUSCADOR EN VIVO DE LA MATRIZ DE RESUMEN ---
  const searchMatrix = document.getElementById("search-matrix") as HTMLInputElement | null;
  const matrixRows = document.querySelectorAll<HTMLTableRowElement>(".matrix-row");
  const matrixSectionHeaders = document.querySelectorAll<HTMLTableRowElement>(".matrix-section-header");

  searchMatrix?.addEventListener("input", () => {
    const q = (searchMatrix.value || "").trim().toLowerCase();

    matrixRows.forEach((row) => {
      const text = row.getAttribute("data-search-text") || "";
      const matches = !q || text.includes(q);
      row.classList.toggle("hidden", !matches);
    });

    // Ocultar cabeceras de sección si todas sus filas quedaron filtradas
    matrixSectionHeaders.forEach((header) => {
      let next = header.nextElementSibling;
      let hasVisibleChild = false;
      while (next && !next.classList.contains("matrix-section-header")) {
        if (!next.classList.contains("hidden")) {
          hasVisibleChild = true;
          break;
        }
        next = next.nextElementSibling;
      }
      header.classList.toggle("hidden", !hasVisibleChild);
    });
  });

  // --- LÓGICA DE CALIBRACIÓN CANÓNICA DE RÚBRICAS (Z1, Z3, Z6, Z7, W1) ---
  const rawCacheScript = document.getElementById("rubrics-canonical-cache")?.textContent;
  let rubricsCanonicalCache: Record<string, { block: string; lastCalibrated?: string; calibrationInfo?: string }> = {};
  if (rawCacheScript) {
    try {
      rubricsCanonicalCache = JSON.parse(rawCacheScript);
    } catch (e) {
      console.error("[CalibracionContent] Error al parsear cache de rúbricas:", e);
    }
  }

  const rawMetricsScript = document.getElementById("metrics-by-code-cache")?.textContent;
  let metricsByCodeCache: Record<string, { fp: number; fn: number; total: number; rate: number | null }> = {};
  if (rawMetricsScript) {
    try {
      metricsByCodeCache = JSON.parse(rawMetricsScript);
    } catch (e) {
      console.error("[CalibracionContent] Error al parsear cache de métricas:", e);
    }
  }

  const modalCalib = document.getElementById("modal-calibrar-criterio") as HTMLDialogElement | null;
  const btnCloseModal = document.getElementById("btn-close-calib-modal");

  // Metadatos y contexto modal
  const badgeClassification = document.getElementById("calib-badge-classification");
  const metaCriterionName = document.getElementById("calib-meta-criterion-name");
  const metaCriterionCode = document.getElementById("calib-meta-criterion-code");
  const metaTicketWrap = document.getElementById("calib-meta-ticket-wrap");

  const contextAiVerdict = document.getElementById("calib-context-ai-verdict");
  const contextAiEvidence = document.getElementById("calib-context-ai-evidence");
  const contextHumanVerdict = document.getElementById("calib-context-human-verdict");
  const contextHumanComment = document.getElementById("calib-context-human-comment");

  // Formulario asistente
  const inputDiagnosis = document.getElementById("calib-input-diagnosis") as HTMLSelectElement | null;
  const inputRule = document.getElementById("calib-input-rule") as HTMLTextAreaElement | null;
  const inputEvidence = document.getElementById("calib-input-evidence") as HTMLTextAreaElement | null;
  const inputReasoning = document.getElementById("calib-input-reasoning") as HTMLTextAreaElement | null;
  const counterEvidence = document.getElementById("calib-counter-evidence");
  const counterReasoning = document.getElementById("calib-counter-reasoning");
  const btnInsertSuggestion = document.getElementById("btn-insert-suggestion");

  // Textarea canónico y diff
  const blockTextarea = document.getElementById("calib-block-textarea") as HTMLTextAreaElement | null;
  const validationBadge = document.getElementById("calib-validation-badge");
  const validationAlert = document.getElementById("calib-validation-alert");
  const validationErrorsList = document.getElementById("calib-validation-errors-list");
  const diffContainer = document.getElementById("calib-diff-container");
  const diffSummary = document.getElementById("calib-diff-summary");
  const protocolTextarea = document.getElementById("calib-protocol-textarea") as HTMLTextAreaElement | null;

  // Botones de copiado y tabs
  const tabBtnBlock = document.getElementById("tab-btn-block");
  const tabBtnDiff = document.getElementById("tab-btn-diff");
  const tabBtnProtocol = document.getElementById("tab-btn-protocol");

  const viewPaneBlock = document.getElementById("view-pane-block");
  const viewPaneDiff = document.getElementById("view-pane-diff");
  const viewPaneProtocol = document.getElementById("view-pane-protocol");

  const btnCopyBlock = document.getElementById("btn-copy-block");
  const btnCopyDiff = document.getElementById("btn-copy-diff");
  const btnCopyProtocol = document.getElementById("btn-copy-protocol");

  let currentCriterion = "";
  let currentOriginalBlock = "";
  let currentCaseData: any = null;

  // Contadores reactivos Few-Shot (Z6)
  function updateCounters() {
    if (inputEvidence && counterEvidence) {
      const len = inputEvidence.value.length;
      counterEvidence.textContent = `${len}/160`;
      if (len > 160) {
        counterEvidence.className = "font-mono tabular-nums text-error font-bold";
      } else {
        counterEvidence.className = "font-mono tabular-nums text-base-content/60";
      }
    }

    if (inputReasoning && counterReasoning) {
      const len = inputReasoning.value.length;
      counterReasoning.textContent = `${len}/180`;
      if (len > 180) {
        counterReasoning.className = "font-mono tabular-nums text-error font-bold";
      } else {
        counterReasoning.className = "font-mono tabular-nums text-base-content/60";
      }
    }
  }

  inputEvidence?.addEventListener("input", updateCounters);
  inputReasoning?.addEventListener("input", updateCounters);

  // Validación y recálculo de Diff en vivo (W1, W3)
  function refreshValidationAndDiff() {
    if (!blockTextarea || !currentCriterion) return;
    const content = blockTextarea.value;
    const res = validateRubricBlock(content, currentCriterion);

    // 1. Badge y alerta de validación
    if (validationBadge) {
      if (res.valid) {
        validationBadge.className = "badge badge-sm font-semibold badge-success";
        validationBadge.textContent = "Válido (7 claves OK)";
        validationAlert?.classList.add("hidden");
      } else {
        validationBadge.className = "badge badge-sm font-semibold badge-error";
        validationBadge.textContent = `${res.errors.length} error(es)`;
        if (validationAlert && validationErrorsList) {
          validationAlert.classList.remove("hidden");
          validationErrorsList.innerHTML = res.errors.map((e) => `<li>${e}</li>`).join("");
        }
      }
    }

    // 2. Diff contra el original precargado
    const diff = computeSimpleDiff(currentOriginalBlock, content);
    if (diffContainer) {
      if (!diff.hasChanges) {
        diffContainer.innerHTML = `<p class="text-base-content/50 italic py-4 text-center">Sin cambios respecto al bloque vigente en rubricas-calidad.md.</p>`;
        if (diffSummary) diffSummary.textContent = "Sin modificaciones.";
      } else {
        const escapeHtml = (s: string) =>
          s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

        const html = diff.diffLines
          .map((dl) => {
            if (dl.type === "same") {
              return `<div class="text-base-content/70 whitespace-pre">  ${escapeHtml(dl.line)}</div>`;
            } else if (dl.type === "del") {
              return `<div class="bg-error/15 text-error px-1 rounded whitespace-pre">- ${escapeHtml(dl.line)}</div>`;
            } else {
              return `<div class="bg-success/15 text-success px-1 rounded whitespace-pre">+ ${escapeHtml(dl.line)}</div>`;
            }
          })
          .join("");

        diffContainer.innerHTML = html;
        const adds = diff.diffLines.filter((l) => l.type === "add").length;
        const dels = diff.diffLines.filter((l) => l.type === "del").length;
        if (diffSummary) diffSummary.textContent = `${adds} línea(s) agregada(s), ${dels} línea(s) eliminada(s).`;
      }
    }

    // 3. Generar Solicitud de Modificación §1
    if (protocolTextarea && currentCaseData) {
      const d = currentCaseData;
      protocolTextarea.value = [
        `### Solicitud de Modificación de Rúbrica — Protocolo §1`,
        `- **Parámetro afectado (\`codigo\`):** \`${d.criterio}\` (${d.nombre || d.criterio})`,
        `- **Input evaluado (Contexto del caso):** ${d.ticket ? `Ticket #${d.ticket}` : "Auditorías consolidadas"}`,
        `- **Resultado arrojado por la IA:**`,
        `  - Veredicto: ${d.aiVerdict || "—"}`,
        `  - Evidencia citada: "${d.aiEvidence || "Sin evidencia"}"`,
        `- **Resultado esperado (Ground Truth Humano):**`,
        `  - Veredicto esperado: ${d.humanVerdict || "—"}`,
        `  - Evidencia real determinante: "${d.humanComment || "Convalidado por supervisor"}"`,
        `- **Justificación de la discrepancia (Causa Raíz):** ${d.classification || "A determinar"}. Se calibra regla canónica para evitar reincidencia.`,
      ].join("\n");
    }
  }

  const ruleHint = document.getElementById("calib-rule-hint");
  const ruleError = document.getElementById("calib-rule-error");

  // Hint orientativo no bloqueante y sugerencia de destino automática
  inputRule?.addEventListener("input", () => {
    const text = inputRule.value.trim();
    if (ruleError) {
      ruleError.classList.add("hidden");
      ruleError.textContent = "";
    }

    if (!text) {
      if (ruleHint) {
        ruleHint.classList.add("hidden");
        ruleHint.textContent = "";
      }
      return;
    }

    // Evaluar hint pedagógico (no bloquea)
    const hintRes = checkCausalHint(text);
    if (ruleHint) {
      if (hintRes.isCausal) {
        ruleHint.classList.remove("hidden");
        ruleHint.className = "text-3xs text-success/80 font-medium italic pt-0.5";
        ruleHint.textContent = "✓ Estructura causal detectada (SI / PERO / ENTONCES).";
      } else if (hintRes.hint) {
        ruleHint.classList.remove("hidden");
        ruleHint.className = "text-3xs text-base-content/60 italic pt-0.5";
        ruleHint.textContent = hintRes.hint;
      } else {
        ruleHint.classList.add("hidden");
      }
    }

    // Preseleccionar sugerencia de destino (sin forzar, permitiendo override del supervisor)
    if (/\b(?:NO\s+penalizar|cumple:\s*true|aprobar|excepción|excepcion)\b/i.test(text)) {
      const radioCumple = document.querySelector<HTMLInputElement>(
        'input[name="calib-rule-target"][value="cumple"]',
      );
      if (radioCumple && !radioCumple.dataset.userOverridden) {
        radioCumple.checked = true;
      }
    } else if (/\b(?:cumple:\s*false|penalizar|rechazar|descuento)\b/i.test(text)) {
      const radioNoCumple = document.querySelector<HTMLInputElement>(
        'input[name="calib-rule-target"][value="no_cumple"]',
      );
      if (radioNoCumple && !radioNoCumple.dataset.userOverridden) {
        radioNoCumple.checked = true;
      }
    }
  });

  // Marcar si el usuario seleccionó manualmente el radio de destino
  document.querySelectorAll<HTMLInputElement>('input[name="calib-rule-target"]').forEach((radio) => {
    radio.addEventListener("change", () => {
      radio.dataset.userOverridden = "true";
    });
  });

  // Inyección no destructiva de sugerencia estructurada en el textarea (W1)
  btnInsertSuggestion?.addEventListener("click", () => {
    if (!blockTextarea) return;
    let text = blockTextarea.value;
    const ruleText = inputRule?.value.trim() || "";
    const evidenceText = (inputEvidence?.value.trim() || "").slice(0, 160);
    const reasoningText = (inputReasoning?.value.trim() || "").slice(0, 180);

    if (!ruleText && (!evidenceText || !reasoningText)) {
      if (ruleError) {
        ruleError.classList.remove("hidden");
        ruleError.textContent = "Completá al menos una regla o un contraejemplo antes de inyectar.";
      }
      return;
    }

    // 1. Inyectar regla de forma no destructiva si se proveyó
    if (ruleText) {
      const selectedTarget = (
        document.querySelector<HTMLInputElement>('input[name="calib-rule-target"]:checked')?.value ||
        "no_cumple"
      ) as "cumple" | "no_cumple";

      const insertRes = insertRuleIntoBlock(text, ruleText, selectedTarget, currentCriterion);
      if (!insertRes.success) {
        if (ruleError) {
          ruleError.classList.remove("hidden");
          ruleError.textContent = insertRes.errors.join(" ");
        }
        return;
      }

      text = insertRes.newBlock;
    }

    // 2. Si hay contraejemplo Few-Shot, actualizar o agregar bajo Ejemplo No Cumple
    if (evidenceText && reasoningText) {
      const targetExampleHeader = `- **Ejemplo No Cumple:**`;
      if (text.includes(targetExampleHeader)) {
        const newExampleBlock = [
          `- **Ejemplo No Cumple:**`,
          `  - Evidencia: "${evidenceText}"`,
          `  - Razonamiento: "${reasoningText}"`,
        ].join("\n");

        text = text.replace(
          /- \*\*Ejemplo No Cumple:\*\*\n(?:\s+- Evidencia:[^\n]+\n\s+- Razonamiento:[^\n]+)/,
          newExampleBlock,
        );
      }
    }

    // 3. Validar el bloque resultante completo
    const finalVal = validateRubricBlock(text, currentCriterion);
    if (!finalVal.valid) {
      if (ruleError) {
        ruleError.classList.remove("hidden");
        ruleError.textContent = `La inyección rompería el bloque canónico: ${finalVal.errors.join("; ")}`;
      }
      return;
    }

    if (ruleError) {
      ruleError.classList.add("hidden");
      ruleError.textContent = "";
    }

    blockTextarea.value = text;
    refreshValidationAndDiff();

    // Feedback visual en el botón
    if (btnInsertSuggestion) {
      const originalHtml = btnInsertSuggestion.innerHTML;
      btnInsertSuggestion.innerHTML = `<span>✓ Inyectado en bloque</span>`;
      setTimeout(() => {
        btnInsertSuggestion.innerHTML = originalHtml;
      }, 1500);
    }
  });

  // Switch de Tabs
  function setTab(tab: "block" | "diff" | "protocol") {
    tabBtnBlock?.classList.toggle("tab-active", tab === "block");
    tabBtnDiff?.classList.toggle("tab-active", tab === "diff");
    tabBtnProtocol?.classList.toggle("tab-active", tab === "protocol");

    viewPaneBlock?.classList.toggle("hidden", tab !== "block");
    viewPaneDiff?.classList.toggle("hidden", tab !== "diff");
    viewPaneProtocol?.classList.toggle("hidden", tab !== "protocol");
  }

  tabBtnBlock?.addEventListener("click", () => setTab("block"));
  tabBtnDiff?.addEventListener("click", () => setTab("diff"));
  tabBtnProtocol?.addEventListener("click", () => setTab("protocol"));

  interface OpenModalParams {
    criterion: string;
    criterionName?: string;
    ticket?: string;
    classification?: string;
    aiVerdict?: string;
    aiEvidence?: string;
    humanVerdict?: string;
    humanComment?: string;
  }

  function openModalForCriterion(params: OpenModalParams) {
    const criterion = params.criterion;
    const cachedItem = rubricsCanonicalCache[criterion];
    if (!cachedItem?.block) {
      alert("El criterio seleccionado no cuenta con rúbrica canónica en rubricas-calidad.md.");
      return;
    }

    currentCriterion = criterion;
    currentOriginalBlock = cachedItem.block;
    currentCaseData = {
      criterio: criterion,
      nombre: params.criterionName,
      ticket: params.ticket,
      classification: params.classification,
      aiVerdict: params.aiVerdict,
      aiEvidence: params.aiEvidence,
      humanVerdict: params.humanVerdict,
      humanComment: params.humanComment,
    };

    // Metadatos y contexto modal
    if (metaCriterionName) metaCriterionName.textContent = params.criterionName || criterion;
    if (metaCriterionCode) metaCriterionCode.textContent = criterion;
    if (metaTicketWrap) metaTicketWrap.textContent = params.ticket ? `(Ticket #${params.ticket})` : "";

    if (badgeClassification) {
      badgeClassification.textContent = params.classification || "Calibración";
      badgeClassification.className = `badge badge-sm font-semibold whitespace-nowrap shrink-0 leading-none h-auto min-h-5 py-1 px-2.5 ${
        params.classification?.includes("Positivo")
          ? "badge-error"
          : params.classification?.includes("Negativo")
          ? "badge-warning"
          : "badge-secondary"
      }`;
    }

    if (contextAiVerdict) contextAiVerdict.textContent = params.aiVerdict || "—";
    if (contextAiEvidence) {
      contextAiEvidence.textContent = params.aiEvidence
        ? `"${params.aiEvidence}"`
        : params.ticket
        ? "Sin evidencia textual"
        : "Consolidado de auditorías del período";
    }
    if (contextHumanVerdict) contextHumanVerdict.textContent = params.humanVerdict || "—";
    if (contextHumanComment) {
      contextHumanComment.textContent = params.humanComment
        ? `"${params.humanComment}"`
        : params.ticket
        ? "Sin comentario registrado"
        : "Ajuste preventivo/correctivo de rúbrica";
    }

    // Contexto de tendencia (Q3: Desvío acumulado FP/FN al lado del selector neutral)
    const trendBadge = document.getElementById("calib-meta-trend-context");
    const trend = metricsByCodeCache[criterion];
    if (trendBadge) {
      if (trend && trend.total > 0) {
        trendBadge.textContent = `Tendencia: ${trend.fp} FP / ${trend.fn} FN (N=${trend.total})`;
        trendBadge.classList.remove("hidden");
      } else {
        trendBadge.textContent = "Sin desvíos acumulados";
        trendBadge.classList.remove("hidden");
      }
    }

    // Q3: Diagnóstico neutral, sin pre-asignar
    if (inputDiagnosis) {
      inputDiagnosis.value = "";
    }

    // Formatear e insertar marcador de calibración (W2)
    const todayIso = new Date().toISOString().substring(0, 10);
    const calibComment = formatCalibrationComment(
      todayIso,
      params.classification || "Calibración",
      params.ticket,
    );

    let initialBlockWithComment = currentOriginalBlock;
    if (initialBlockWithComment.includes("<" + "!-- calibrado:")) {
      initialBlockWithComment = initialBlockWithComment.replace(
        new RegExp("<" + "!--\\s*calibrado:[^->]*-->"),
        calibComment,
      );
    } else {
      initialBlockWithComment = initialBlockWithComment.replace(
        new RegExp(`(## criterio:\\s*${criterion}\\s*\n)`),
        `$1${calibComment}\n`,
      );
    }

    if (blockTextarea) blockTextarea.value = initialBlockWithComment;

    // Asistente con regla y contraejemplo sugeridos si hay evidencia
    if (inputRule) {
      inputRule.value = params.aiEvidence
        ? `SI se detecta "${params.aiEvidence.slice(0, 80)}" PERO ${params.humanComment || "corresponde excepción operativa"}, ENTONCES cumple: false.`
        : "";
    }
    if (inputEvidence) {
      inputEvidence.value = (params.aiEvidence || "").slice(0, 160);
    }
    if (inputReasoning) {
      inputReasoning.value = (params.humanComment || "").slice(0, 180);
    }
    updateCounters();

    setTab("block");
    refreshValidationAndDiff();
    modalCalib?.showModal();
  }

  // Cambio de diagnóstico (Q3: Actualiza justificación y comentario canónico reactivamente)
  inputDiagnosis?.addEventListener("change", () => {
    if (!currentCaseData) return;
    const val = inputDiagnosis.value;
    const label =
      val === "falso_positivo"
        ? "Falso Positivo"
        : val === "falso_negativo"
        ? "Falso Negativo"
        : "Malinterpretación léxica / ambigüedad";
    currentCaseData.classification = label;

    if (blockTextarea) {
      const todayIso = new Date().toISOString().substring(0, 10);
      const updatedComment = formatCalibrationComment(todayIso, label, currentCaseData.ticket);
      blockTextarea.value = blockTextarea.value.replace(new RegExp("<" + "!--\\s*calibrado:[^->]*-->"), updatedComment);
    }
    refreshValidationAndDiff();
  });

  // Apertura desde Sección 1 (Discrepancias caso por caso)
  document.querySelectorAll<HTMLButtonElement>(".btn-calibrate-criterio").forEach((btn) => {
    btn.addEventListener("click", () => {
      const ds = btn.dataset;
      const criterion = ds.criterion;
      if (!criterion) return;

      openModalForCriterion({
        criterion,
        criterionName: ds.criterionName,
        ticket: ds.ticket,
        classification: ds.classification,
        aiVerdict: ds.aiVerdict,
        aiEvidence: ds.aiEvidence,
        humanVerdict: ds.humanVerdict,
        humanComment: ds.humanComment,
      });
    });
  });

  // Apertura desde Sección 2 (Matriz de Resumen y Acuerdo por Criterio)
  document.querySelectorAll<HTMLButtonElement>(".btn-calibrate-from-summary").forEach((btn) => {
    btn.addEventListener("click", () => {
      const ds = btn.dataset;
      const criterion = ds.criterion;
      if (!criterion) return;

      openModalForCriterion({
        criterion,
        criterionName: ds.criterionName,
        classification: "Calibración de Criterio",
        aiVerdict: "Consolidado",
        aiEvidence: `Evaluación consolidada del período. Acumulado: ${ds.fpCount || 0} FP, ${ds.fnCount || 0} FN.`,
        humanVerdict: "Revisión Canónica",
        humanComment: "Ajuste preventivo o correctivo de la rúbrica",
      });
    });
  });

  btnCloseModal?.addEventListener("click", () => {
    modalCalib?.close();
  });

  // Copiado con feedback en botones del modal
  function wireCopyButton(button: HTMLElement | null, getText: () => string) {
    button?.addEventListener("click", async () => {
      const text = getText();
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const originalHtml = button.innerHTML;
        button.innerHTML = `<span>✓ ¡Copiado!</span>`;
        setTimeout(() => {
          button.innerHTML = originalHtml;
        }, 2000);
      } catch (err) {
        console.error("Error al copiar:", err);
      }
    });
  }

  wireCopyButton(btnCopyBlock, () => blockTextarea?.value || "");
  wireCopyButton(btnCopyDiff, () => {
    if (!blockTextarea || !currentOriginalBlock) return "";
    const diff = computeSimpleDiff(currentOriginalBlock, blockTextarea.value);
    return diff.unifiedText;
  });
  wireCopyButton(btnCopyProtocol, () => protocolTextarea?.value || "");
</script>
