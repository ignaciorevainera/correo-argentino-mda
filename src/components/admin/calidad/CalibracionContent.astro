---
import { db } from "@db/index";
import { qualityAudits, auditScores, auditParameters, agents } from "@db/schema";
import { eq, desc } from "drizzle-orm";
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import DataTableHeaderCell from "@components/ui/DataTableHeaderCell.astro";
import { Icon } from "astro-icon/components";
import {
  evaluateGroundTruth,
  calculateCalibrationMetrics,
  type AuditEvaluationInput,
  type AuditScoreRow,
  type AuditParameterRow,
} from "@lib/calidad/groundTruthComparator";
import { getResolvedSearchParams } from "@lib/navigation";
import { getCleanBase } from "@lib/baseUrl";
import { summarizeCalibration } from "@lib/calidad/calibrationSummary";
import type { QualityAiSnapshot } from "@/types/quality";
import { parseRubricsMap } from "@lib/ai/rubricsLoader";
import { extractCalibrationMetadata } from "@lib/calidad/rubricValidator";
import { cleanModelName } from "@lib/calidad/coachingFormatter";

const searchParams = getResolvedSearchParams(Astro.request, Astro.url);
const currentMonthParam = searchParams.get("month");
const channelFilter = searchParams.get("channel") || "all";
const cleanBase = getCleanBase();

// 1. Obtener meses disponibles
const allMonthsQuery = await db
  .selectDistinct({ month: qualityAudits.month })
  .from(qualityAudits)
  .orderBy(desc(qualityAudits.month));

const availableMonths = allMonthsQuery.map((m) => m.month).filter(Boolean);
const selectedMonth = currentMonthParam || availableMonths[0] || "10-2026";

// 2. Cargar parámetros activos de la DB (Fuente de verdad)
const rawParameters = await db.select().from(auditParameters);
const parameters: AuditParameterRow[] = rawParameters.map((p) => ({
  id: p.id,
  code: p.code,
  name: p.name,
  section: p.section,
  channel: p.channel,
}));

// 3. Consultar auditorías con snapshot del mes
const rawAudits = await db
  .select({
    id: qualityAudits.id,
    date: qualityAudits.date,
    channelType: qualityAudits.channelType,
    ticketId: qualityAudits.ticketId,
    callId: qualityAudits.callId,
    isReclamoNovedad: qualityAudits.isReclamoNovedad,
    appliesMda: qualityAudits.appliesMda,
    aiSnapshot: qualityAudits.aiSnapshot,
    operatorName: agents.name,
  })
  .from(qualityAudits)
  .leftJoin(agents, eq(qualityAudits.agentId, agents.id))
  .where(eq(qualityAudits.month, selectedMonth));

// Filtrar canal si aplica
const filteredAudits = channelFilter === "all"
  ? rawAudits
  : rawAudits.filter((a) => a.channelType === channelFilter);

const auditInputs: AuditEvaluationInput[] = filteredAudits.map((a) => {
  let parsedSnap: QualityAiSnapshot | null = null;
  if (a.aiSnapshot) {
    try {
      parsedSnap = JSON.parse(a.aiSnapshot);
    } catch {}
  }
  return {
    id: a.id,
    date: a.date,
    channelType: a.channelType,
    ticketId: a.ticketId,
    callId: a.callId,
    operatorName: a.operatorName || `ID ${a.id}`,
    isReclamoNovedad: Boolean(a.isReclamoNovedad),
    appliesMda: Boolean(a.appliesMda),
    aiSnapshot: parsedSnap,
  };
});

// 4. Cargar scores para las auditorías recuperadas
const auditIds = auditInputs.map((a) => a.id);
let rawScores: AuditScoreRow[] = [];
if (auditIds.length > 0) {
  const scoresDb = await db.select().from(auditScores);
  const auditIdSet = new Set(auditIds);
  rawScores = scoresDb
    .filter((s) => auditIdSet.has(s.auditId))
    .map((s) => ({
      auditId: s.auditId,
      parameterId: s.parameterId,
      score: Boolean(s.score),
      comment: s.comment,
    }));
}

// 5. Ejecutar comparador determinista
const discrepancies = evaluateGroundTruth(auditInputs, rawScores, parameters);
const metrics = calculateCalibrationMetrics(discrepancies);

const totalAuditsWithAi = auditInputs.filter((a) => a.aiSnapshot).length;
const totalDiscrepancies = discrepancies.filter(
  (d) => d.classification === "falso_positivo" || d.classification === "falso_negativo",
).length;

// 6. Cargar mapa canónico de rúbricas server-side (Fuente única en rubricas-calidad.md) (Z4)
const rubricsMap = parseRubricsMap();
const rubricsCache: Record<string, { block: string; lastCalibrated?: string; calibrationInfo?: string }> = {};

for (const [code, block] of rubricsMap.entries()) {
  const meta = extractCalibrationMetadata(block);
  rubricsCache[code] = {
    block,
    lastCalibrated: meta?.date,
    calibrationInfo: meta?.info,
  };
}

const calibratedCriteriaCount = Object.values(rubricsCache).filter((r) => r.lastCalibrated).length;

// Resumen estadístico puro Macro vs Micro (Q1, Q2, Q5, Q6)
const summary = summarizeCalibration(metrics, totalAuditsWithAi, calibratedCriteriaCount);

// Cache de métricas por código para contexto de desvío FP/FN en modal (Q3)
const metricsByCode: Record<string, { fp: number; fn: number; total: number; rate: number | null }> = {};
for (const m of metrics) {
  metricsByCode[m.criterionCode] = {
    fp: m.falsePositiveCount,
    fn: m.falseNegativeCount,
    total: m.totalEvaluated,
    rate: m.agreementRate,
  };
}
// Mapeo de canal y sección por código de parámetro
const paramMetaMap = new Map<string, { channel: string; section: string }>();
for (const p of parameters) {
  paramMetaMap.set(p.code, { channel: p.channel, section: p.section });
}

// Grupos jerárquicos de canales y secciones para la matriz
const channelDisplayOrder = [
  {
    key: "wise_call",
    label: "Llamadas Wise",
    icon: "boxicons:phone",
    sections: [
      { key: "items", label: "1. Interacción en llamada", badge: "Sección 1" },
      { key: "ticket", label: "2. Gestión del Ticket", badge: "Sección 2" },
    ],
  },
  {
    key: "wise_email",
    label: "Mails Wise",
    icon: "boxicons:envelope",
    sections: [
      { key: "items", label: "1. Gestión del correo y respuesta", badge: "Sección 1" },
      { key: "mda", label: "2. Registro del ticket en MDA", badge: "Sección 2" },
    ],
  },
  {
    key: "invgate_ticket",
    label: "Autogestiones",
    icon: "boxicons:ticket",
    sections: [
      { key: "items", label: "1. Gestión de la solicitud", badge: "Sección 1" },
      { key: "mda", label: "2. Ítems de categoría MDA", badge: "Sección 2" },
    ],
  },
];

// Indexar métricas por canal y sección
const metricsByChannelAndSection: Record<string, Record<string, typeof metrics>> = {};
for (const ch of channelDisplayOrder) {
  metricsByChannelAndSection[ch.key] = {};
  for (const sec of ch.sections) {
    metricsByChannelAndSection[ch.key][sec.key] = [];
  }
}

for (const m of metrics) {
  const meta = paramMetaMap.get(m.criterionCode);
  const ch = meta?.channel || "wise_call";
  const sec = meta?.section || "items";

  if (!metricsByChannelAndSection[ch]) {
    metricsByChannelAndSection[ch] = {};
  }
  if (!metricsByChannelAndSection[ch][sec]) {
    metricsByChannelAndSection[ch][sec] = [];
  }
  metricsByChannelAndSection[ch][sec].push(m);
}

// Cache de métricas y rúbricas serializado para cliente
const safeMetricsJson = JSON.stringify(metricsByCode).replace(/</g, "\\u003c");
const safeRubricsJson = JSON.stringify(rubricsCache).replace(/</g, "\\u003c");
---

<PageContainer width="xxl">
  <div class="mb-1">
    <a
      href={`${cleanBase}supervision/calidad-operadores?month=${selectedMonth}`}
      class="btn btn-ghost btn-xs text-base-content/70 hover:text-base-content gap-1.5 -ml-2"
    >
      <Icon name="boxicons:arrow-left" size={16} />
      <span>Volver a Calidad de Operadores</span>
    </a>
  </div>

  <PageHeader
    title="Calibración de Calidad IA (Ground Truth)"
    description="Cotejo empírico entre veredictos generados por IA y las decisiones convalidadas por supervisores humanos para calibrar rúbricas y detectar desvíos."
  />

  <!-- Tarjetas KPI de Resumen Ejecutivo (Q1, Q2, Q6) -->
  <div class="mt-4 grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
    <!-- Card 1: Macro-Promedio (Por Rúbrica) -->
    <div class="rounded-2xl border border-base-200 bg-base-100 p-4 shadow-xs">
      <div class="flex items-center justify-between text-base-content/80 text-xs font-bold">
        <span>Acuerdo Macro</span>
        <span class="badge badge-xs badge-ghost font-medium">Por Rúbrica</span>
      </div>
      <div class="mt-2 flex items-baseline gap-2">
        <span class:list={[
          "text-2xl font-bold font-mono tabular-nums",
          summary.macroHealthStatus === "healthy" ? "text-success" :
          summary.macroHealthStatus === "warning" ? "text-warning" :
          summary.macroHealthStatus === "critical" ? "text-error" : "text-base-content/50",
        ]}>
          {summary.macroAgreementRate !== null ? `${summary.macroAgreementRate} %` : "—"}
        </span>
      </div>
      <p class="mt-1 text-xs text-base-content/75 font-medium">
        {summary.macroAgreementRate !== null ? "Promedio no ponderado de criterios" : "Sin evaluaciones en scope"}
      </p>
    </div>

    <!-- Card 2: Micro-Promedio (Ponderado por Casos) -->
    <div class="rounded-2xl border border-base-200 bg-base-100 p-4 shadow-xs">
      <div class="flex items-center justify-between text-base-content/80 text-xs font-bold">
        <span>Acuerdo Micro</span>
        <span class="badge badge-xs badge-ghost font-medium">Ponderado</span>
      </div>
      <div class="mt-2 flex items-baseline gap-2">
        <span class:list={[
          "text-2xl font-bold font-mono tabular-nums",
          summary.microHealthStatus === "healthy" ? "text-success" :
          summary.microHealthStatus === "warning" ? "text-warning" :
          summary.microHealthStatus === "critical" ? "text-error" : "text-base-content/50",
        ]}>
          {summary.microAgreementRate !== null ? `${summary.microAgreementRate} %` : "—"}
        </span>
      </div>
      <p class="mt-1 text-xs text-base-content/75 font-medium">
        {summary.totalEvaluatedCases > 0 ? `${summary.totalAgreements} de ${summary.totalEvaluatedCases} casos coincidentes` : "Sin casos evaluables"}
      </p>
    </div>

    <!-- Card 3: Desvíos Detectados (FP y FN) -->
    <div class="rounded-2xl border border-base-200 bg-base-100 p-4 shadow-xs">
      <div class="flex items-center justify-between text-base-content/80 text-xs font-bold">
        <span>Desvíos Totales</span>
        <span class="badge badge-xs badge-ghost font-medium">Riesgo IA</span>
      </div>
      <div class="mt-2 flex items-baseline gap-3">
        <div class="flex items-baseline gap-1" title="Falsos Positivos (IA aprobó erróneamente)">
          <span class="text-2xl font-bold font-mono tabular-nums text-error">{summary.totalFalsePositives}</span>
          <span class="text-xs font-bold text-error">FP</span>
        </div>
        <span class="text-base-content/50 font-mono">/</span>
        <div class="flex items-baseline gap-1" title="Falsos Negativos (IA penalizó indebidamente)">
          <span class="text-2xl font-bold font-mono tabular-nums text-warning">{summary.totalFalseNegatives}</span>
          <span class="text-xs font-bold text-warning">FN</span>
        </div>
      </div>
      <p class="mt-1 text-xs text-base-content/75 font-medium">
        Discrepancias activas en el período
      </p>
    </div>

    <!-- Card 4: Criterios Calibrados (Q6) -->
    <div class="rounded-2xl border border-base-200 bg-base-100 p-4 shadow-xs">
      <div class="flex items-center justify-between text-base-content/80 text-xs font-bold">
        <span>Criterios Calibrados</span>
        <span class="badge badge-xs badge-ghost font-medium">Canónico</span>
      </div>
      <div class="mt-2 flex items-baseline gap-1.5">
        <span class="text-2xl font-bold font-mono tabular-nums text-secondary">
          {summary.calibratedCriteriaCount}
        </span>
        <span class="text-base-content/70 font-mono text-sm font-semibold">/ {summary.totalCriteriaCount}</span>
      </div>
      <p class="mt-1 text-xs text-base-content/75 font-medium">
        Con marcador canónico vigente
      </p>
    </div>
  </div>

  <!-- Barra de Filtros de Período y Canal -->
  <div class="mt-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-base-200 bg-base-100 p-4 shadow-xs">
    <div class="flex flex-wrap items-center gap-3">
      <div class="flex items-center gap-2">
        <label for="filter-month" class="text-xs font-bold text-base-content/70">Período:</label>
        <select
          id="filter-month"
          class="select select-sm select-bordered rounded-xl font-mono font-medium text-xs"
        >
          {availableMonths.map((m) => (
            <option value={m} selected={m === selectedMonth}>{m}</option>
          ))}
        </select>
      </div>

      <div class="flex items-center gap-2">
        <label for="filter-channel" class="text-xs font-bold text-base-content/70">Canal:</label>
        <select
          id="filter-channel"
          class="select select-sm select-bordered rounded-xl text-xs"
        >
          <option value="all" selected={channelFilter === "all"}>Todos los canales</option>
          <option value="wise_call" selected={channelFilter === "wise_call"}>Llamadas Wise CX</option>
          <option value="wise_email" selected={channelFilter === "wise_email"}>Mails Wise CX</option>
          <option value="invgate_ticket" selected={channelFilter === "invgate_ticket"}>Autogestiones InvGate</option>
        </select>
      </div>
    </div>

    <div class="flex items-center gap-3 text-xs">
      <span class="badge badge-secondary/15 font-semibold text-secondary border-0">
        {totalAuditsWithAi} auditorías con IA
      </span>
      <span class="badge badge-warning/15 font-semibold text-warning border-0">
        {totalDiscrepancies} discrepancias registradas
      </span>
    </div>
  </div>

  <!-- SECCIÓN 1: DRILL-DOWN DE DISCREPANCIAS (Valor Clave para Gobernanza) -->
  <section class="mt-8 space-y-4">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-lg font-bold text-base-content">Drill-Down de Discrepancias</h2>
        <p class="text-xs text-base-content/60">
          Casos donde la IA y el supervisor discreparon. Usá estos registros como evidencia para justificar cambios en <code>rubricas-calidad.md</code>.
        </p>
      </div>

      <!-- Buscador en Vivo -->
      <div class="w-full sm:w-72 shrink-0">
        <input
          id="search-discrepancies"
          type="search"
          placeholder="Buscar ticket, criterio u operador..."
          class="input input-sm input-bordered w-full rounded-xl text-xs"
        />
      </div>
    </div>

    <!-- Barra de Filtros por Clasificación -->
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-base-200 pb-2">
      <div class="flex flex-wrap items-center gap-1.5" id="discrepancy-filter-pills">
        <button
          type="button"
          class="filter-pill-btn btn btn-xs btn-secondary btn-active rounded-lg font-semibold"
          data-filter="discrepancias"
        >
          <span>Solo Discrepancias</span>
          <span class="badge badge-xs bg-base-100 text-secondary border-0 font-bold tabular-nums ml-1">
            {totalDiscrepancies}
          </span>
        </button>
        <button
          type="button"
          class="filter-pill-btn btn btn-xs btn-ghost text-error hover:bg-error/15 rounded-lg font-semibold"
          data-filter="falso_positivo"
        >
          <span>Falsos Positivos ({summary.totalFalsePositives})</span>
        </button>
        <button
          type="button"
          class="filter-pill-btn btn btn-xs btn-ghost text-warning hover:bg-warning/15 rounded-lg font-semibold"
          data-filter="falso_negativo"
        >
          <span>Falsos Negativos ({summary.totalFalseNegatives})</span>
        </button>
        <button
          type="button"
          class="filter-pill-btn btn btn-xs btn-ghost text-base-content/70 hover:bg-base-200 rounded-lg font-semibold"
          data-filter="acuerdo"
        >
          <span>Acuerdos ({summary.totalAgreements})</span>
        </button>
        <button
          type="button"
          class="filter-pill-btn btn btn-xs btn-ghost text-base-content/70 hover:bg-base-200 rounded-lg font-semibold"
          data-filter="all"
        >
          <span>Todos ({discrepancies.length})</span>
        </button>
      </div>

      <span id="discrepancies-visible-count" class="text-xs font-mono font-medium text-base-content/75">
        Mostrando discrepancias
      </span>
    </div>

    {discrepancies.length === 0 ? (
      <div class="rounded-2xl border border-dashed border-base-300 bg-base-100 p-8 text-center text-base-content/75">
        <Icon name="boxicons:info-circle" size={32} class="mx-auto text-base-content/50 mb-2" />
        <p class="text-sm font-semibold">No se encontraron auditorías con snapshot IA para el período seleccionado.</p>
        <p class="text-xs mt-1">Asegurate de haber evaluado y guardado auditorías utilizando el Asistente IA.</p>
      </div>
    ) : (
      <div class="overflow-x-auto rounded-2xl border border-base-200 bg-base-100 shadow-xs">
        <table class="table table-sm">
          <thead>
            <tr class="border-b border-base-200 text-xs font-bold uppercase tracking-wider text-base-content/75">
              <th>Fecha / Caso</th>
              <th>Operador</th>
              <th>Criterio</th>
              <th>Veredicto IA</th>
              <th>Decisión Supervisor</th>
              <th>Clasificación</th>
              <th class="text-right">Acción</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-base-200 text-xs">
            {discrepancies.map((d) => {
              const isFp = d.classification === "falso_positivo";
              const isFn = d.classification === "falso_negativo";
              const isAcuerdo = d.classification === "acuerdo";
              const isSinEv = d.classification === "sin_evidencia";
              const isScope = d.classification === "fuera_de_scope";

              let badgeClass = "badge-neutral";
              let label = "Acuerdo";
              if (isFp) {
                badgeClass = "badge-error";
                label = "Falso Positivo (FP)";
              } else if (isFn) {
                badgeClass = "badge-warning";
                label = "Falso Negativo (FN)";
              } else if (isSinEv) {
                badgeClass = "badge-ghost";
                label = "Sin Evidencia";
              } else if (isScope) {
                badgeClass = "badge-ghost opacity-60";
                label = "Fuera de Scope";
              }

              return (
                <tr
                  class={`discrepancy-row ${isFp ? "bg-error/5" : isFn ? "bg-warning/5" : ""}`}
                  data-classification={d.classification}
                  data-search-text={`${d.date} ${d.ticketId || ""} ${d.callId || ""} ${d.operatorName} ${d.criterionName} ${d.criterionCode}`.toLowerCase()}
                >
                  <td class="font-mono whitespace-nowrap">
                    <div class="font-semibold text-base-content">{d.date}</div>
                    <div class="text-xs text-base-content/80 font-medium">
                      {d.ticketId ? `Ticket #${d.ticketId}` : `Call ${d.callId}`}
                    </div>
                  </td>
                  <td class="font-medium whitespace-nowrap text-base-content">{d.operatorName}</td>
                  <td>
                    <div class="font-semibold text-base-content">{d.criterionName}</div>
                  </td>
                  <td class="max-w-xs">
                    <div class="flex items-center gap-1.5 font-bold">
                      <span class={d.aiVerdict === true ? "text-success" : d.aiVerdict === false ? "text-error" : "text-base-content/70"}>
                        {d.aiVerdict === true ? "Cumple" : d.aiVerdict === false ? "No cumple" : "Sin evidencia"}
                      </span>
                      <span class="font-mono text-xs opacity-80">({Math.round(d.aiConfidence * 100)}%)</span>
                    </div>
                    {d.aiEvidence && (
                      <p class="mt-1 text-xs italic text-base-content/85 line-clamp-2">
                        “{d.aiEvidence}”
                      </p>
                    )}
                  </td>
                  <td class="max-w-xs">
                    {d.humanScore === null ? (
                      <span class="text-base-content/50 italic font-medium">No aplicó</span>
                    ) : (
                      <div>
                        <span class={`font-bold ${d.humanScore ? "text-success" : "text-error"}`}>
                          {d.humanScore ? "Cumple" : "No cumple"}
                        </span>
                        {d.humanComment && (
                          <p class="mt-1 text-xs text-base-content/85 line-clamp-2">
                            {d.humanComment}
                          </p>
                        )}
                      </div>
                    )}
                  </td>
                  <td class="whitespace-nowrap">
                    <span class={`badge badge-sm font-semibold whitespace-nowrap leading-none h-auto min-h-5 py-1 px-2.5 ${badgeClass}`}>
                      {label}
                    </span>
                  </td>
                  <td class="text-right whitespace-nowrap">
                    <div class="flex items-center justify-end gap-1.5">
                      <button
                        type="button"
                        class="btn-copy-case btn btn-ghost btn-xs text-secondary hover:bg-secondary/10"
                        data-case={JSON.stringify({
                          criterio: d.criterionCode,
                          nombre: d.criterionName,
                          ia: d.aiVerdict ? "Cumple" : d.aiVerdict === false ? "No cumple" : "Sin evidencia",
                          evidenciaIa: d.aiEvidence,
                          humano: d.humanScore ? "Cumple" : "No cumple",
                          comentarioHumano: d.humanComment || "Sin comentario",
                          clasificacion: label,
                          ticket: d.ticketId,
                        })}
                        title="Copiar evidencia para portapapeles rápido"
                      >
                        <Icon name="boxicons:copy" size={15} aria-hidden="true" />
                        <span>Copiar</span>
                      </button>

                      <button
                        type="button"
                        class="btn-calibrate-criterio btn btn-outline btn-secondary btn-xs font-medium"
                        data-criterion={d.criterionCode}
                        data-criterion-name={d.criterionName}
                        data-ticket={d.ticketId || ""}
                        data-classification={label}
                        data-ai-verdict={d.aiVerdict ? "Cumple" : d.aiVerdict === false ? "No cumple" : "Sin evidencia"}
                        data-ai-evidence={d.aiEvidence || ""}
                        data-human-verdict={d.humanScore ? "Cumple" : "No cumple"}
                        data-human-comment={d.humanComment || ""}
                        disabled={!rubricsCache[d.criterionCode]?.block}
                        title={rubricsCache[d.criterionCode]?.block ? "Calibrar rúbrica de este criterio y ver diff" : "Rúbrica no registrada en rubricas-calidad.md"}
                      >
                        <Icon name="boxicons:slider-alt" size={15} aria-hidden="true" />
                        <span>Calibrar</span>
                      </button>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </section>

  <!-- SECCIÓN 2: MATRIZ DE CONFUSIÓN Y ACUERDO RESUMIDA -->
  <section class="mt-10 space-y-4 mb-12">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <div class="flex items-center gap-2">
          <h2 class="text-lg font-bold text-base-content">Matriz de Resumen y Acuerdo por Criterio</h2>
          <span class="badge badge-ghost text-xs font-semibold">Tendencia indicativa</span>
        </div>
        <p class="text-xs text-base-content/75 font-medium">
          Ordenado por mayor necesidad de calibración (más discrepancias primero).
        </p>
      </div>

      <!-- Buscador en vivo de la matriz -->
      <div class="w-full sm:w-64 shrink-0">
        <input
          id="search-matrix"
          type="search"
          placeholder="Buscar criterio o modelo..."
          class="input input-sm input-bordered w-full rounded-xl text-xs"
        />
      </div>
    </div>

    {metrics.length === 0 ? (
      <div class="rounded-2xl border border-dashed border-base-300 bg-base-100 p-6 text-center text-xs text-base-content/70">
        Sin métricas disponibles.
      </div>
    ) : (
      <div class="overflow-x-auto rounded-2xl border border-base-200 bg-base-100 shadow-xs" data-table-sort-root id="matrix-sort-root">
        <table class="table table-sm">
          <thead>
            <tr class="border-b border-base-200 text-xs font-bold uppercase tracking-wider text-base-content/75">
              <th>
                <DataTableHeaderCell sortKey="criterion">Criterio</DataTableHeaderCell>
              </th>
              <th>
                <DataTableHeaderCell sortKey="model">Modelo</DataTableHeaderCell>
              </th>
              <th class="text-center">
                <DataTableHeaderCell sortKey="evaluated" align="right">N Evaluados</DataTableHeaderCell>
              </th>
              <th class="text-center">
                <DataTableHeaderCell sortKey="agreement" align="right">% Acuerdo</DataTableHeaderCell>
              </th>
              <th class="text-center">
                <DataTableHeaderCell sortKey="discrepancies" align="right">Discrepancias</DataTableHeaderCell>
              </th>
              <th class="text-center text-error font-bold">FP</th>
              <th class="text-center text-warning font-bold">FN</th>
              <th class="text-center text-base-content/70">Sin Evidencia</th>
              <th class="text-center text-base-content/60">Fuera Scope</th>
              <th class="text-right">Acción</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-base-200 text-xs" data-table-sort-body>
            {channelDisplayOrder.map((group) => {
              const channelSections = group.sections.filter(
                (sec) => (metricsByChannelAndSection[group.key]?.[sec.key] || []).length > 0,
              );
              if (channelSections.length === 0) return null;

              return (
                <>
                  {channelSections.map((sec) => {
                    const secMetrics = metricsByChannelAndSection[group.key]?.[sec.key] || [];

                    return (
                      <>
                        <!-- Separador Plano de Sección -->
                        <tr class="bg-base-200/50 border-y border-base-300 font-semibold text-xs text-base-content/90 select-none matrix-section-header">
                          <td colspan="10" class="py-2.5 px-4">
                            <div class="flex items-center justify-between">
                              <div class="flex items-center gap-2">
                                <Icon name={group.icon} size={16} class="text-secondary shrink-0" />
                                <span class="font-bold">{group.label} &middot; {sec.label}</span>
                              </div>
                              <span class="text-xs font-mono text-base-content/70">
                                {secMetrics.length === 1 ? "1 criterio" : `${secMetrics.length} criterios`}
                              </span>
                            </div>
                          </td>
                        </tr>

                        <!-- Filas de Criterios (Atenuadas si totalEvaluated < 5) -->
                        {secMetrics.map((m) => {
                          const discrepanciesCount = m.falsePositiveCount + m.falseNegativeCount;
                          const isLowVolume = m.totalEvaluated < 5;

                          return (
                            <tr
                              class:list={[
                                "matrix-row hover:bg-base-200/40 transition-colors",
                                isLowVolume && "opacity-75 hover:opacity-100",
                              ]}
                              data-table-row
                              data-sort-criterion={m.criterionName}
                              data-sort-model={m.model}
                              data-sort-evaluated={String(m.totalEvaluated)}
                              data-sort-agreement={String(m.agreementRate)}
                              data-sort-discrepancies={String(discrepanciesCount)}
                              data-search-text={`${m.criterionName} ${m.criterionCode} ${m.model}`.toLowerCase()}
                            >
                              <td>
                                <div class="flex items-center gap-2">
                                  <span class="font-semibold text-base-content">{m.criterionName}</span>
                                  {rubricsCache[m.criterionCode]?.lastCalibrated && (
                                    <span
                                      class="badge badge-secondary/15 text-secondary border-0 font-mono text-xs font-medium"
                                      title={`Última calibración: ${rubricsCache[m.criterionCode].lastCalibrated}. ${rubricsCache[m.criterionCode].calibrationInfo || ""}`}
                                    >
                                      Calibrado {rubricsCache[m.criterionCode].lastCalibrated}
                                    </span>
                                  )}
                                  {isLowVolume && (
                                    <span class="badge badge-ghost badge-sm text-xs font-mono text-base-content/70" title="Muestra reducida: menos de 5 casos evaluados">
                                      N &lt; 5
                                    </span>
                                  )}
                                </div>
                              </td>
                              <td class="font-mono text-xs text-base-content/80 font-medium">{cleanModelName(m.model) || m.model}</td>
                              <td class="text-center font-bold tabular-nums">{m.totalEvaluated}</td>
                              <td class="text-center">
                                <div class="flex items-center justify-center gap-2">
                                  <progress
                                    class:list={[
                                      "progress w-14",
                                      m.agreementRate >= 85 ? "progress-success" : m.agreementRate >= 70 ? "progress-warning" : "progress-error",
                                    ]}
                                    value={m.agreementRate}
                                    max="100"
                                  ></progress>
                                  <span class="font-bold tabular-nums">{m.agreementRate}&nbsp;%</span>
                                </div>
                              </td>
                              <td class="text-center font-bold tabular-nums">
                                <span class:list={[
                                  "badge badge-sm font-mono font-bold",
                                  discrepanciesCount > 0 ? "badge-warning/20 text-warning" : "badge-ghost text-base-content/50",
                                ]}>
                                  {discrepanciesCount}
                                </span>
                              </td>
                              <td class="text-center font-bold text-error tabular-nums">{m.falsePositiveCount}</td>
                              <td class="text-center font-bold text-warning tabular-nums">{m.falseNegativeCount}</td>
                              <td class="text-center font-medium text-base-content/75 tabular-nums">{m.sinEvidenciaCount}</td>
                              <td class="text-center font-medium text-base-content/60 tabular-nums">{m.outOfScopeCount}</td>
                              <td class="text-right whitespace-nowrap">
                                <button
                                  type="button"
                                  class="btn-calibrate-from-summary btn btn-outline btn-secondary btn-xs font-medium"
                                  data-criterion={m.criterionCode}
                                  data-criterion-name={m.criterionName}
                                  data-fp-count={m.falsePositiveCount}
                                  data-fn-count={m.falseNegativeCount}
                                  disabled={!rubricsCache[m.criterionCode]?.block}
                                  title={rubricsCache[m.criterionCode]?.block ? "Calibrar rúbrica canónica de este criterio" : "Rúbrica no registrada en rubricas-calidad.md"}
                                >
                                  <Icon name="boxicons:slider-alt" size={15} aria-hidden="true" />
                                  <span>Calibrar</span>
                                </button>
                              </td>
                            </tr>
                          );
                        })}
                      </>
                    );
                  })}
                </>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </section>
</PageContainer>

<!-- Cache de Rúbricas Canónicas serializado Server-Side (Z4, W4) -->
<script id="rubrics-canonical-cache" type="application/json" set:html={safeRubricsJson}></script>
<!-- Cache de Métricas de Criterio serializado Server-Side para Contexto Neutral (Q3) -->
<script id="metrics-by-code-cache" type="application/json" set:html={safeMetricsJson}></script>

