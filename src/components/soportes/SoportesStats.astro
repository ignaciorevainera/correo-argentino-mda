---
import { Icon } from "astro-icon/components";

interface Props {
  total: number;
  active: number;
  totalMembers: number;
}

const { total, active, totalMembers } = Astro.props;
---

<div
  class="bg-base-100 border-base-300 flex flex-wrap gap-6 rounded-xl border p-4 shadow-xs"
>
  <div class="flex items-center gap-3">
    <div class="bg-secondary/10 text-secondary rounded-lg p-2.5">
      <Icon name="boxicons:headphone-mic-filled" size={20} aria-hidden="true" />
    </div>
    <div>
      <div class="text-base-content/60 text-xs font-medium">Total de mesas</div>
      <div class="text-base-content font-mono text-xl font-bold tabular-nums">
        {total}
      </div>
    </div>
  </div>

  <div class="border-base-200 hidden h-9 self-center border-r md:block"></div>

  <div class="flex items-center gap-3">
    <div class="bg-success/10 text-success rounded-lg p-2.5">
      <Icon name="boxicons:check-circle-filled" size={20} aria-hidden="true" />
    </div>
    <div>
      <div class="text-base-content/60 text-xs font-medium">Activas</div>
      <div class="text-success font-mono text-xl font-bold tabular-nums">
        {active}
      </div>
    </div>
  </div>

  <div class="border-base-200 hidden h-9 self-center border-r md:block"></div>

  <div class="flex items-center gap-3">
    <div class="bg-primary/15 text-secondary rounded-lg p-2.5">
      <Icon name="boxicons:group-filled" size={20} aria-hidden="true" />
    </div>
    <div>
      <div class="text-base-content/60 text-xs font-medium">
        Miembros globales
      </div>
      <div class="text-base-content font-mono text-xl font-bold tabular-nums">
        {totalMembers}
      </div>
    </div>
  </div>
</div>
