---
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import { isAllowed } from "@lib/rolesMatrix";

const user = Astro.locals.user;
const isAdminUser = user
  ? isAllowed("Administrar Contenido", user.role)
  : false;
---

<PageContainer width="xxl">
  <PageHeader
    description="Matriz unificada de equivalencias y derivacion tecnica de la Mesa de Ayuda."
    class="max-w-2xl"
  />

  <div class="skeleton-debounced flex flex-col gap-6">
    {
      isAdminUser && (
        <div class="alert alert-warning alert-soft flex items-center justify-between gap-4">
          <div class="flex flex-1 items-center gap-3">
            <div class="skeleton size-5 shrink-0 rounded-full" />
            <div class="flex flex-1 flex-col gap-1.5">
              <div class="skeleton h-4 w-48 rounded" />
              <div class="skeleton h-3 w-96 max-w-full rounded opacity-70" />
            </div>
          </div>
          <div class="skeleton h-8 w-24 shrink-0 rounded" />
        </div>
      )
    }

    <div
      class="bg-base-200/50 border-base-300/50 flex flex-wrap gap-6 rounded-xl border p-4"
    >
      <div class="flex items-center gap-2.5">
        <div class="skeleton size-9 shrink-0 rounded-lg"></div>
        <div class="flex flex-col gap-1.5">
          <div class="skeleton h-3 w-20 rounded"></div>
          <div class="skeleton h-5 w-8 rounded"></div>
        </div>
      </div>

      <div class="border-base-300 hidden h-10 self-center border-r md:block">
      </div>

      <div class="flex items-center gap-2.5">
        <div class="skeleton size-9 shrink-0 rounded-lg"></div>
        <div class="flex flex-col gap-1.5">
          <div class="skeleton h-3 w-12 rounded"></div>
          <div class="skeleton h-5 w-8 rounded"></div>
        </div>
      </div>

      <div class="border-base-300 hidden h-10 self-center border-r md:block">
      </div>

      <div class="flex items-center gap-2.5">
        <div class="skeleton size-9 shrink-0 rounded-lg"></div>
        <div class="flex flex-col gap-1.5">
          <div class="skeleton h-3 w-24 rounded"></div>
          <div class="skeleton h-5 w-8 rounded"></div>
        </div>
      </div>
    </div>

    <div class="flex w-full flex-nowrap items-center gap-2 md:gap-3">
      <div class="min-w-0 flex-1">
        <div class="skeleton h-8 w-full rounded-lg md:h-12"></div>
      </div>
      <div class="skeleton h-8 w-28 shrink-0 rounded-lg md:h-12 md:w-36"></div>
      <div class="skeleton h-8 w-32 shrink-0 rounded-lg md:h-12 md:w-44"></div>
      <div class="skeleton h-8 w-24 shrink-0 rounded-lg md:h-12 md:w-32"></div>
      <div class="skeleton h-8 w-10 shrink-0 rounded-lg md:h-12 md:w-28"></div>
      <div class="skeleton h-8 w-12 shrink-0 rounded-lg md:h-12 md:w-16"></div>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        Array.from({ length: 6 }).map(() => (
          <div class="card bg-base-100 border-base-300 border shadow-sm">
            <div class="card-body gap-4 p-5">
              <div class="flex items-center gap-3">
                <div class="skeleton size-10 shrink-0 rounded-full" />
                <div class="flex flex-1 flex-col gap-2">
                  <div class="skeleton h-4 w-3/4 rounded" />
                  <div class="skeleton h-3 w-1/2 rounded" />
                </div>
              </div>
              <div class="border-base-200 border-t" />
              <div class="space-y-2">
                <div class="skeleton h-4 w-full rounded" />
                <div class="skeleton h-4 w-5/6 rounded" />
                <div class="skeleton h-4 w-2/3 rounded" />
              </div>
              <div class="flex justify-end gap-2">
                <div class="skeleton h-8 w-24 rounded" />
                <div class="skeleton h-8 w-24 rounded" />
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</PageContainer>
