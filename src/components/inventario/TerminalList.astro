---
import TerminalRow from "./TerminalRow.astro";
import TerminalGroupHeader from "./TerminalGroupHeader.astro";
import type { TerminalDisplayView } from "@lib/terminalQueries";

interface Props {
  items: TerminalDisplayView[];
  terminalRowGridClass?: string;
}

const { items, terminalRowGridClass = "grid grid-cols-12 items-start" } =
  Astro.props;

const formatLastContact = (raw: string): string => {
  if (!raw) return "--";
  const parsed = new Date(raw.replace(" ", "T"));
  if (Number.isNaN(parsed.getTime())) return "--";
  const day = String(parsed.getDate()).padStart(2, "0");
  const month = String(parsed.getMonth() + 1).padStart(2, "0");
  const year = parsed.getFullYear();
  const hours = String(parsed.getHours()).padStart(2, "0");
  const minutes = String(parsed.getMinutes()).padStart(2, "0");
  return `${day}/${month}/${year} ${hours}:${minutes}`;
};
---

{
  items.map((item) =>
    item.type === "single" ? (
      <TerminalRow
        terminal={item.terminal}
        terminalRowGridClass={terminalRowGridClass}
      />
    ) : (
      <>
        <TerminalGroupHeader
          memberCount={item.cluster.members.length}
          sharedIps={item.cluster.sharedIps}
          sharedMacs={item.cluster.sharedMacs}
          sharedHostnames={item.cluster.sharedHostnames}
          activeHostname={item.cluster.active.hostname}
          activeIsOnline={item.cluster.activeIsOnline}
          activeLastContact={formatLastContact(
            item.cluster.active.lastContactRaw,
          )}
        />
        {item.cluster.members.map((member) => (
          <TerminalRow
            terminal={member}
            terminalRowGridClass={terminalRowGridClass}
            isActive={
              member.id === item.cluster.active.id
                ? item.cluster.activeIsOnline
                  ? "active"
                  : "recent"
                : null
            }
            sharedIps={item.cluster.sharedIps}
            sharedMacs={item.cluster.sharedMacs}
            sharedHostnames={item.cluster.sharedHostnames}
          />
        ))}
      </>
    ),
  )
}
