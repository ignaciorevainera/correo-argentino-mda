---
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";

const terminalHeaderGridClass = "grid-cols-12 gap-4";
const terminalRowGridClass = "grid grid-cols-12 items-start gap-4";
---

<PageContainer width="xxl">
  <div class="skeleton-debounced flex flex-col gap-4">
    <PageHeader
      description="Gestión centralizada del parque operativo: terminales y estaciones de trabajo."
    />

    <!-- ViewSwitcher Skeleton -->
    <div class="w-full">
      <div class="skeleton h-12 w-full rounded-lg"></div>
    </div>

    <div class="flex w-full flex-col gap-4">
      <!-- Filters Skeleton -->
      <div class="flex w-full flex-wrap items-center gap-3">
        <div class="skeleton h-12 w-32 grow rounded-lg"></div>
        <div class="skeleton h-12 w-32 grow rounded-lg"></div>
        <div class="skeleton h-12 w-32 grow rounded-lg"></div>
        <div class="skeleton h-12 w-32 grow rounded-lg"></div>
        <div class="skeleton h-12 w-32 grow rounded-lg"></div>
        <div class="skeleton h-12 w-48 rounded-lg"></div>
        <div class="skeleton h-12 w-32 rounded-lg"></div>
      </div>

      <!-- Search Input Skeleton -->
      <div class="w-full">
        <div class="skeleton h-14 w-full rounded-lg"></div>
      </div>
    </div>

    <!-- Table Skeleton -->
    <div class="space-y-6">
      <section class="space-y-3">
        <div
          class="border-base-300 bg-base-100 overflow-hidden rounded-xl border shadow-sm"
        >
          <!-- Table Header Skeleton -->
          <div
            class={`grid ${terminalHeaderGridClass} border-b border-base-300 px-4 py-3 bg-base-200/50`}
          >
            <div class="col-span-2">
              <div class="skeleton h-5 w-20 rounded"></div>
            </div>
            <div class="col-span-3">
              <div class="skeleton h-5 w-24 rounded"></div>
            </div>
            <div class="col-span-3">
              <div class="skeleton h-5 w-32 rounded"></div>
            </div>
            <div class="col-span-2">
              <div class="skeleton h-5 w-20 rounded"></div>
            </div>
            <div class="col-span-2 flex justify-end">
              <div class="skeleton h-5 w-28 rounded"></div>
            </div>
          </div>

          <!-- Table Rows Skeleton (10 rows) -->
          <div class="divide-base-300 divide-y">
            {
              Array.from({ length: 10 }).map(() => (
                <div class={`${terminalRowGridClass} px-4 py-4`}>
                  <div class="col-span-2 flex items-center gap-3">
                    <div class="skeleton size-8 shrink-0 rounded-lg" />
                    <div class="skeleton h-4 w-24 rounded" />
                  </div>
                  <div class="col-span-3 flex flex-col gap-1.5">
                    <div class="skeleton h-4 w-28 rounded" />
                    <div class="skeleton h-3 w-40 rounded" />
                  </div>
                  <div class="col-span-3 flex flex-col gap-1.5">
                    <div class="skeleton h-4 w-36 rounded" />
                    <div class="skeleton h-3 w-20 rounded" />
                  </div>
                  <div class="col-span-2 flex flex-col gap-1.5">
                    <div class="skeleton h-4 w-24 rounded" />
                    <div class="skeleton h-3 w-16 rounded" />
                  </div>
                  <div class="col-span-2 flex flex-col items-end gap-1.5">
                    <div class="skeleton h-4 w-12 rounded" />
                    <div class="skeleton h-3 w-28 rounded" />
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>
    </div>
  </div>
</PageContainer>
