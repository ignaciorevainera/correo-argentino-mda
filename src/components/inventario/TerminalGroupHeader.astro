---
import { Icon } from "astro-icon/components";

interface Props {
  memberCount: number;
  sharedIps?: string[];
  sharedMacs?: string[];
  sharedHostnames?: string[];
  activeHostname: string;
  activeIsOnline: boolean;
  activeLastContact: string;
}

const {
  memberCount,
  sharedIps = [],
  sharedMacs = [],
  sharedHostnames = [],
  activeHostname,
  activeIsOnline,
  activeLastContact,
} = Astro.props;
---

<article
  data-duplicate-cluster-header
  data-shared-ips={sharedIps.join(" ")}
  data-shared-macs={sharedMacs.join(" ")}
  data-shared-hostnames={sharedHostnames.join(" ")}
  class="border-warning/40 bg-warning/5 flex flex-wrap items-center gap-2 border-b border-l-4 px-4 py-2"
>
  <span
    class="text-warning inline-flex items-center gap-1.5 text-sm font-semibold"
  >
    <Icon name="boxicons:copy" size={16} />
    Duplicadas · {memberCount} registros
  </span>

  <span class="flex flex-wrap items-center gap-1.5">
    {
      sharedIps.map((ip) => (
        <span class="badge badge-warning badge-soft badge-sm font-mono">
          IP {ip}
        </span>
      ))
    }
    {
      sharedMacs.map((mac) => (
        <span class="badge badge-warning badge-soft badge-sm font-mono">
          MAC {mac}
        </span>
      ))
    }
    {
      sharedHostnames.map((hostname) => (
        <span class="badge badge-warning badge-soft badge-sm font-mono">
          Hostname {hostname}
        </span>
      ))
    }
  </span>

  <span class="ml-auto">
    {
      activeIsOnline ? (
        <span class="badge badge-success badge-sm gap-1.5">
          <span class="status status-success" />
          Activa: <span class="font-mono">{activeHostname}</span>
        </span>
      ) : (
        <span class="badge badge-ghost badge-sm gap-1.5">
          Más reciente: <span class="font-mono">{activeHostname}</span>
          <span class="text-base-content/60">· {activeLastContact}</span>
        </span>
      )
    }
  </span>
</article>
