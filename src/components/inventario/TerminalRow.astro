---
import { Icon } from "astro-icon/components";
import type { TerminalItem, TTPairState } from "@lib/terminalQueries";
import { getTerminalColorClass, type OsFamily } from "@lib/terminalHelpers";
import CopyButton from "@components/ui/CopyButton.astro";

type BoxiconName = `boxicons:${string}`;

interface Props {
  terminal: TerminalItem;
  terminalRowGridClass?: string;
  pairState?: TTPairState;
  paired?: boolean;
}

const {
  terminal,
  terminalRowGridClass = "grid grid-cols-12 items-start",
  pairState,
  paired,
} = Astro.props;

const isTTHostname = /^TT.{5}P$/.test(terminal.hostname);

// Dot de estado por antigüedad del último contacto: verde <24h,
// amarillo ≤30d, rojo >30d o sin datos.
const lastContactAge = (() => {
  const raw = terminal.lastContactRaw;
  if (!raw) return "error";
  const parsed = new Date(raw.replace(" ", "T"));
  if (Number.isNaN(parsed.getTime())) return "error";
  const diffMs = Date.now() - parsed.getTime();
  if (diffMs < 24 * 60 * 60 * 1000) return "success";
  if (diffMs <= 30 * 24 * 60 * 60 * 1000) return "warning";
  return "error";
})();

const getRowColorClass = (item: TerminalItem): string => {
  return getTerminalColorClass(item.osName, item.isTelegrafia);
};

const osFamilyLabel: Record<OsFamily, string> = {
  windows: "Windows",
  linux: "Linux",
  legacy: "Legacy",
};

const rowIcons: Record<
  "hardware" | "os" | "location",
  BoxiconName
> = {
  hardware: "boxicons:chip-filled",
  os: "boxicons:database-filled",
  location: "boxicons:location-pin-filled",
};

const copyValue = [
  `Hostname: ${terminal.hostname}`,
  `Dirección IPv4: ${terminal.ip}`,
  ``,
  `Marca: ${terminal.manufacturer}`,
  `Modelo: ${terminal.model}`,
  `SN: ${terminal.serial}`,
].join("\n");
---

<article
  data-table-row
  data-master-detail-sort-item
  data-terminal-row
  data-hostname={terminal.hostname}
  data-ip={terminal.ip}
  data-mac={terminal.mac}
  data-branch={terminal.branch}
  data-nis={terminal.nis}
  data-region={terminal.region}
  data-sort-hostname={terminal.hostname}
  data-sort-hardware={`${terminal.manufacturer} ${terminal.model}`}
  data-sort-os={terminal.osName}
  data-sort-location={terminal.branch}
  class:list={[
    terminalRowGridClass,
    "group border-base-300 hover:bg-base-300/40 px-4 py-3 transition-colors last:border-b-0",
    !paired && "border-b",
  ]}
>
  <div class="col-span-2 flex flex-row gap-4">
    <span
      class:list={[
        "text-accent inline-flex size-8 shrink-0 items-center justify-center self-center rounded-lg border",
        getRowColorClass(terminal),
      ]}
    >
      <Icon name="boxicons:desktop-filled" size={16} />
    </span>
    <div class="flex w-full flex-col gap-1">
      <div class="flex flex-row items-center gap-1.5">
        <span
          class="text-base-content truncate font-mono text-sm font-medium"
          data-highlight-target
        >
          {terminal.hostname}
        </span>
        {pairState === "missing-vm" && isTTHostname && !terminal.isTelegrafia && (
          <span class="badge badge-error badge-xs shrink-0">Sin VM</span>
        )}
      </div>
      <span
        class="text-base-content/70 truncate font-mono text-xs"
        data-highlight-target
      >
        {terminal.ip}
      </span>
      <span
        class="text-base-content/50 truncate font-mono text-xs"
        data-highlight-target
      >
        {terminal.mac}
      </span>
    </div>
  </div>

  <div class="relative col-span-3 flex flex-row gap-1.5">
    <Icon
      name={rowIcons.hardware}
      size={16}
      class="text-base-content/60 mt-0.5 shrink-0"
    />

    <div class="flex w-full min-w-0 flex-col gap-1">
      <span class="text-base-content truncate text-sm" data-highlight-target>
        {terminal.manufacturer}
      </span>
      <span
        class="text-base-content truncate text-xs font-medium"
        data-highlight-target
      >
        {terminal.model}
      </span>
      <span class="text-base-content/50 truncate font-mono text-xs">
        SN: <span data-highlight-target>{terminal.serial}</span>
      </span>
      <span class="text-base-content/70 truncate text-xs">
        RAM:{" "}
        <span class="text-base-content font-medium" data-highlight-target>
          {terminal.ram}
        </span>
      </span>
    </div>
    <div
      class="pointer-events-none absolute top-1.5 right-1.5 opacity-0 transition-opacity duration-200 group-hover:pointer-events-auto group-hover:opacity-100"
    >
      <CopyButton
        value={copyValue}
        variant="icon"
        appearance="ghost"
        size="sm"
        ariaLabel="Copiar datos del equipo"
        tooltipText="Copiar datos del equipo"
      />
    </div>
  </div>

  <div class="col-span-3 flex flex-row gap-1.5">
    <Icon
      name={rowIcons.os}
      size={16}
      class="text-base-content/60 mt-0.5 shrink-0"
    />
    <div class="flex w-full flex-col gap-1">
      <span
        class="text-base-content text-sm font-medium text-wrap"
        data-highlight-target
      >
        {terminal.osName}
      </span>

      <span class="badge badge-soft badge-xs">
        {osFamilyLabel[terminal.osFamily]}
        <span class="ml-1" data-highlight-target>{terminal.architecture}</span>
      </span>
    </div>
  </div>

  <div class="col-span-2 flex flex-row gap-1.5">
    <Icon
      name={rowIcons.location}
      size={16}
      class="text-base-content/60 mt-0.5 shrink-0"
    />
    <div class="flex flex-col gap-1">
      <span class="text-base-content truncate text-sm" data-highlight-target>
        {terminal.branch}
      </span>
      <span class="flex w-full flex-row items-center gap-1">
        <div
          class="badge badge-sm badge-soft badge-neutral max-w-full truncate font-mono text-xs"
          data-highlight-target
        >
          {terminal.nis}
        </div>
        <span class="text-base-content/60 truncate text-xs">•</span>
        <span
          class="text-base-content/60 truncate text-xs"
          data-highlight-target
        >
          {terminal.province}
        </span>
      </span>
    </div>
  </div>

  <div class="col-span-2 flex flex-row gap-1.5">
    <div class="flex w-full flex-col text-right font-mono">
      <span class="flex flex-row items-center justify-end gap-1.5">
        <span class:list={["status", `status-${lastContactAge}`]}></span>
        <span class="text-base-content truncate text-sm font-medium"
          >{terminal.lastContactDate}</span
        >
      </span>
      <span class="text-base-content/60 truncate font-mono text-xs">
        {terminal.lastContactTime}
      </span>
    </div>
  </div>
</article>
