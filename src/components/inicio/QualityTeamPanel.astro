---
import ActionButton from "@components/ui/ActionButton.astro";
import HomePanelCard from "./HomePanelCard.astro";
import QualityTeamCard from "./QualityTeamCard.astro";
import type { QualityTeamSummary } from "@lib/inicio/homeSummaries";

interface Props {
  summary: QualityTeamSummary;
}

const { summary } = Astro.props;
---

<HomePanelCard
  panel="quality-team"
  title="Calidad del equipo"
  icon="boxicons:star-filled"
>
  <QualityTeamCard summary={summary}>
    <ActionButton
      slot="action"
      href="/supervision/calidad-operadores"
      label="Ver más"
      icon="boxicons:chevron-right"
      variant="soft"
      color="btn-secondary"
      size="xs"
      class="dark:btn-accent"
      ariaLabel="Ver más: Calidad del equipo"
      data-home-more="quality-team"
    />
  </QualityTeamCard>
</HomePanelCard>
