---
import { Icon } from "astro-icon/components";
import type { QualitySummary } from "@lib/inicio/qualitySummary";

interface Props {
  summary: QualitySummary;
}

const { summary } = Astro.props;

const hasAudits = summary.auditsCount > 0;

const scoreTone = (score: number): string => {
  if (score >= 90) return "text-success";
  if (score >= 80) return "text-warning";
  return "text-error";
};

const scoreBar = (score: number): string => {
  if (score >= 90) return "bg-success";
  if (score >= 80) return "bg-warning";
  return "bg-error";
};

const deltaText =
  summary.delta === null
    ? null
    : `${summary.delta > 0 ? "+" : ""}${summary.delta.toFixed(1)} pts vs mes anterior`;
const deltaTone =
  summary.delta === null || summary.delta === 0
    ? "badge-soft badge-neutral"
    : summary.delta > 0
      ? "badge-soft badge-success"
      : "badge-soft badge-error";
const deltaIcon =
  summary.delta === null || summary.delta === 0
    ? "boxicons:minus"
    : summary.delta > 0
      ? "boxicons:trending-up"
      : "boxicons:trending-down";

const auditLabel =
  summary.auditsCount === 1 ? "1 auditoría" : `${summary.auditsCount} auditorías`;
---

{
  hasAudits ? (
    <div class="flex h-full flex-col gap-3">
      <span
        id="home-quality-score"
        class:list={[
          "font-mono text-3xl font-black leading-none tracking-tight tabular-nums",
          scoreTone(summary.average),
        ]}
      >
        {summary.average}%
      </span>

      <div class="flex items-center gap-2">
        <div class="min-w-0 flex-[2]">
          {summary.delta !== null ? (
            <span
              id="home-quality-delta"
              class:list={[
                "badge badge-sm w-full justify-center gap-0.5 truncate font-semibold",
                deltaTone,
              ]}
              title={deltaText ?? undefined}
            >
              <Icon name={deltaIcon} size={12} aria-hidden="true" is:inline />
              {deltaText}
            </span>
          ) : (
            <span
              id="home-quality-delta"
              class="text-base-content/50 block truncate text-xxs"
            >
              Sin comparación con el mes anterior
            </span>
          )}
        </div>
        <div class="flex flex-[1] justify-end [&>*]:w-full">
          <slot name="action" />
        </div>
      </div>

      <p id="home-quality-count" class="text-base-content/70 text-xs">
        {auditLabel} en {summary.monthLabel}
      </p>

      <ul class="flex flex-col gap-2">
        {
          summary.channels.map((channel) => (
            <li class="flex items-center gap-2">
              <span class="text-base-content/80 w-20 shrink-0 text-xxs font-semibold">
                {channel.label}
              </span>
              <div class="bg-base-200 h-1.5 min-w-0 flex-1 overflow-hidden rounded-full">
                <div
                  class:list={["h-full rounded-full", scoreBar(channel.average)]}
                  style={`width:${Math.max(0, Math.min(100, channel.average))}%`}
                />
              </div>
              <span class="text-base-content/80 w-14 shrink-0 text-right font-mono text-xxs tabular-nums">
                {channel.count > 0 ? `${channel.average}%` : "—"}
              </span>
              <span class="text-base-content/60 w-6 shrink-0 text-right font-mono text-xxs tabular-nums">
                {channel.count}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  ) : (
    <div data-quality-empty class="flex h-full flex-col items-center gap-2 py-2 text-center">
      <span class="bg-base-200 text-base-content/40 flex h-10 w-10 items-center justify-center rounded-full">
        <Icon name="boxicons:bar-chart-big" size={24} aria-hidden="true" is:inline />
      </span>
      <p class="text-base-content text-sm font-semibold">
        Todavía no tenés auditorías este mes.
      </p>
      <p class="text-base-content/70 text-xs">
        Cuando se audite alguna de tus atenciones, el score aparece acá.
      </p>
      <div class="mt-1 flex w-full justify-end">
        <slot name="action" />
      </div>
    </div>
  )
}
