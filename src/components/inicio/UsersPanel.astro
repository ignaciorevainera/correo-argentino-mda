---
import ActionButton from "@components/ui/ActionButton.astro";
import HomePanelCard from "./HomePanelCard.astro";
import AdminUsersCard from "./AdminUsersCard.astro";
import type { AdminUsersSummary } from "@lib/inicio/homeSummaries";

interface Props {
  summary: AdminUsersSummary;
}

const { summary } = Astro.props;
---

<HomePanelCard
  panel="users"
  title="Gestión de usuarios"
  icon="boxicons:group-filled"
>
  <AdminUsersCard summary={summary}>
    <ActionButton
      slot="action"
      href="/admin/usuarios"
      label="Ver más"
      icon="boxicons:chevron-right"
      variant="soft"
      color="btn-secondary"
      size="xs"
      class="dark:btn-accent"
      ariaLabel="Ver más: Gestión de usuarios"
      data-home-more="users"
    />
  </AdminUsersCard>
</HomePanelCard>
