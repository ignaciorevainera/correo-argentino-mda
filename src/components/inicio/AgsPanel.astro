---
import ActionButton from "@components/ui/ActionButton.astro";
import AgsNextCard from "./AgsNextCard.astro";

interface Props {
  variant?: "big" | "compact";
}

const { variant = "compact" } = Astro.props;
---

<AgsNextCard variant={variant}>
  <ActionButton
    slot="action"
    href="/supervision/asignacion-autogestiones"
    label="Ver más"
    icon="boxicons:chevron-right"
    variant="soft"
    color="btn-secondary"
    size="xs"
    class="dark:btn-accent"
    ariaLabel="Ver más: Próximo en autogestiones"
    data-home-more="ags"
  />
</AgsNextCard>
