---
import ActionButton from "@components/ui/ActionButton.astro";
import HomePanelCard from "./HomePanelCard.astro";
import AutomationSummaryCard from "./AutomationSummaryCard.astro";
import type { AutomationSummary } from "@lib/inicio/homeSummaries";

interface Props {
  summary: AutomationSummary;
}

const { summary } = Astro.props;
---

<HomePanelCard
  panel="automation"
  title="Automatizaciones"
  icon="boxicons:rocket-filled"
>
  <AutomationSummaryCard summary={summary}>
    <ActionButton
      slot="action"
      href="/automatizaciones/metricas"
      label="Ver más"
      icon="boxicons:chevron-right"
      variant="soft"
      color="btn-secondary"
      size="xs"
      class="dark:btn-accent"
      ariaLabel="Ver más: Automatizaciones"
      data-home-more="automation"
    />
  </AutomationSummaryCard>
</HomePanelCard>
