---
import ActionButton from "@components/ui/ActionButton.astro";
import HomePanelCard from "./HomePanelCard.astro";
import FeedbackSummaryCard from "./FeedbackSummaryCard.astro";
import type { FeedbackSummary } from "@lib/inicio/homeSummaries";

interface Props {
  summary: FeedbackSummary;
  compact?: boolean;
}

const { summary, compact = false } = Astro.props;
---

<HomePanelCard
  panel="feedback"
  title="Sugerencias y reportes"
  icon="boxicons:mail-open-filled"
>
  <FeedbackSummaryCard summary={summary} compact={compact}>
    <ActionButton
      slot="action"
      href="/admin/feedback"
      label="Ver más"
      icon="boxicons:chevron-right"
      variant="soft"
      color="btn-secondary"
      size="xs"
      class="dark:btn-accent"
      ariaLabel="Ver más: Sugerencias y reportes"
      data-home-more="feedback"
    />
  </FeedbackSummaryCard>
</HomePanelCard>
