---
import { Icon } from "astro-icon/components";

interface Props {
  displayName: string;
  greeting: string;
  dateLabel: string;
  mesaLabel?: string | null;
}

const { displayName, greeting, dateLabel, mesaLabel = null } = Astro.props;
---

<header class="space-y-2">
  <h1
    id="home-greeting"
    class="text-base-content text-3xl font-bold tracking-tight"
  >
    {greeting}, <span class="text-secondary dark:text-accent">{displayName}.</span>
  </h1>
  <p
    class="text-base-content/70 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm sm:text-base"
  >
    <span class="first-letter:uppercase">{dateLabel}</span>
    {
      mesaLabel && (
        <span class="badge badge-soft badge-secondary gap-1 font-semibold">
          <Icon name="boxicons:buildings-filled" size={14} aria-hidden="true" is:inline />
          {mesaLabel}
        </span>
      )
    }
  </p>
</header>
