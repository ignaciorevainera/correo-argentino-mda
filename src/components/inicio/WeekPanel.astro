---
import ActionButton from "@components/ui/ActionButton.astro";
import HomePanelCard from "./HomePanelCard.astro";
import WeekCard from "./WeekCard.astro";
import type { PersonalWeek } from "@lib/inicio/personalWeekLoader";

interface Props {
  week: PersonalWeek;
}

const { week } = Astro.props;
---

<HomePanelCard
  panel="week"
  title="Mi semana"
  subtitle="Cronograma vigente"
  icon="boxicons:calendar-filled"
>
  <WeekCard days={week.days} rangeLabel={week.rangeLabel}>
    <ActionButton
      slot="action"
      href="/supervision/cronograma"
      label="Ver más"
      icon="boxicons:chevron-right"
      variant="soft"
      color="btn-secondary"
      size="xs"
      class="dark:btn-accent"
      ariaLabel="Ver más: Mi semana"
      data-home-more="week"
    />
  </WeekCard>
</HomePanelCard>
