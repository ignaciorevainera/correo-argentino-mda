---
import ActionButton from "@components/ui/ActionButton.astro";
import HomePanelCard from "./HomePanelCard.astro";
import QualityCard from "./QualityCard.astro";
import type { QualitySummary } from "@lib/inicio/qualitySummary";

interface Props {
  summary: QualitySummary;
}

const { summary } = Astro.props;
---

<HomePanelCard
  panel="quality"
  title="Mi calidad"
  icon="boxicons:bar-chart-big-filled"
>
  <QualityCard summary={summary}>
    <ActionButton
      slot="action"
      href="/supervision/calidad-operadores"
      label="Ver más"
      icon="boxicons:chevron-right"
      variant="soft"
      color="btn-secondary"
      size="xs"
      class="dark:btn-accent"
      ariaLabel="Ver más: Mi calidad"
      data-home-more="quality"
    />
  </QualityCard>
</HomePanelCard>
