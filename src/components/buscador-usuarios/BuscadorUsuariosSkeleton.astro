---
import PageContainer from "@components/ui/PageContainer.astro";
import SkeletonCard from "@components/ui/skeletons/SkeletonCard.astro";
---

<PageContainer>
  <div class="skeleton-debounced">
    <div class="mb-8 grid gap-6 lg:grid-cols-3">
      <section
        class="bg-base-200/50 border-base-300 flex flex-col justify-center rounded-2xl border px-6 py-8 shadow-md md:px-8 lg:col-span-2"
      >
        <div class="mb-6 space-y-2.5 text-left">
          <div class="skeleton h-8 w-48 rounded"></div>
          <div class="skeleton h-4 w-96 rounded"></div>
        </div>

        <div class="group relative w-full">
          <div
            class="join border-base-300 bg-base-100 w-full overflow-hidden rounded-xl border shadow-md"
          >
            <div class="relative flex-1">
              <div
                class="pointer-events-none absolute inset-y-0 left-4 flex items-center"
              >
                <div class="skeleton size-6 rounded"></div>
              </div>
              <div class="skeleton h-14 w-full rounded-lg"></div>
            </div>
          </div>
        </div>
      </section>

      <div
        class="group border-accent/20 from-accent/5 relative flex flex-col justify-center overflow-hidden rounded-2xl border bg-linear-to-br via-transparent to-transparent p-6 backdrop-blur-md lg:p-8"
      >
        <div
          class="bg-accent/10 absolute -right-12 -bottom-12 size-48 rounded-full blur-3xl"
        >
        </div>

        <div class="relative z-10 mb-4 flex items-center gap-4">
          <div
            class="bg-accent/10 text-accent flex size-12 shrink-0 items-center justify-center rounded-xl shadow-inner"
          >
            <div class="skeleton size-6 rounded-lg"></div>
          </div>
          <div class="space-y-2">
            <div class="skeleton h-5 w-28 rounded"></div>
            <div class="skeleton h-3 w-20 rounded"></div>
          </div>
        </div>

        <div class="skeleton h-4 w-40 rounded"></div>
      </div>
    </div>

    <section>
      <div class="mb-6 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="skeleton h-6 w-36 rounded"></div>
          <div class="skeleton badge h-5 w-8 rounded-full"></div>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {[1, 2, 3, 4, 5, 6].map(() => <SkeletonCard type="user" />)}
      </div>
    </section>
  </div>
</PageContainer>
