---
import { Icon } from "astro-icon/components";
import Modal from "@components/ui/Modal.astro";
import InfoCard from "@components/ui/InfoCard.astro";
import SearchBar from "@components/ui/SearchBar.astro";
---

<Modal
  id="terminal-modal"
  size="full"
  class="flex h-[80vh] w-full flex-col overflow-hidden p-0 font-mono"
>
  <Fragment slot="content">
    <!-- Header -->
    <div
      class="bg-base-200 border-base-300 flex shrink-0 items-center justify-between border-b px-4 py-2.5 select-none"
    >
      <div class="flex min-w-0 items-center gap-2">
        <Icon
          name="boxicons:command-filled"
          size={16}
          class="text-secondary shrink-0"
        />
        <span class="text-base-content/70 truncate text-xs font-semibold"
          >net user <span id="terminal-user-title" class="font-mono"></span> /domain</span
        >
      </div>
      <button
        type="button"
        class="btn btn-ghost btn-xs shrink-0 cursor-pointer gap-1.5"
        id="refresh-terminal-btn"
        title="Refrescar consulta"
      >
        <Icon
          name="boxicons:refresh-ccw-filled"
          size={16}
          class="transition-transform duration-300"
          id="refresh-terminal-icon"
        />
        <span class="text-xxs">Refrescar</span>
      </button>
    </div>

    <!-- Tabs -->
    <div class="border-base-300 bg-base-200/50 flex shrink-0 border-b px-4">
      <button
        id="tab-panel-btn"
        class="border-secondary text-secondary cursor-pointer border-b-2 px-4 py-2.5 font-sans text-xs font-bold transition-all focus:outline-hidden"
        type="button"
      >
        Panel Organizado
      </button>
      <button
        id="tab-console-btn"
        class="text-base-content/60 hover:text-base-content cursor-pointer border-b-2 border-transparent px-4 py-2.5 font-sans text-xs font-bold transition-all focus:outline-hidden"
        type="button"
      >
        Consola CMD
      </button>
      <button
        id="tab-invgate-btn"
        class="text-base-content/60 hover:text-base-content hidden cursor-pointer border-b-2 border-transparent px-4 py-2.5 font-sans text-xs font-bold transition-all focus:outline-hidden"
        type="button"
      >
        InvGate
      </button>
    </div>

    <!-- Contenido principal -->
    <div class="relative flex min-h-0 flex-1 flex-col overflow-hidden">
      <!-- Loader general -->
      <div
        id="terminal-loading"
        class="bg-base-100/95 absolute inset-0 z-20 hidden flex-col items-center justify-center gap-3"
      >
        <span class="loading loading-spinner loading-lg text-secondary"></span>
        <span class="text-base-content/60 text-center font-sans text-xs"
          >Consultando en AD</span
        >
      </div>

      <!-- VISTA 1: Panel Organizado -->
      <div
        id="view-panel"
        class="grid min-h-0 flex-1 grid-cols-1 gap-4 overflow-y-auto p-4 md:grid-cols-5 md:grid-rows-[minmax(0,1fr)] md:overflow-hidden"
      >
        <!-- Columna Izquierda: Detalles (2/5) — scroll permitido -->
        <div
          class="border-base-300 relative flex min-h-0 flex-col border-r pr-4 md:col-span-2"
        >
          <div
            id="panel-details-scroll"
            class="min-h-0 flex-1 space-y-2 overflow-y-auto"
          >
            <div
              class="text-xxs text-base-content/50 border-base-300 mb-1 border-b pb-1 font-sans font-bold tracking-widest uppercase"
            >
              Detalles de Red
            </div>

            <InfoCard
              icon="boxicons:user"
              label="Cuenta de Red"
              id="term-info-username"
              copyId="btn-copy-username"
              monospace
              copyLabel="Copiar cuenta"
            />
            <InfoCard
              icon="boxicons:user-id-card"
              label="Nombre Completo"
              id="term-info-fullname"
              copyId="btn-copy-fullname"
              copyLabel="Copiar nombre"
            />
            <InfoCard
              icon="boxicons:briefcase"
              label="Cargo / Puesto"
              id="term-info-title"
              copyId="btn-copy-title"
              copyLabel="Copiar cargo"
            />
            <InfoCard
              icon="boxicons:badge"
              label="Número de Legajo"
              id="term-info-employeenumber"
              copyId="btn-copy-employeenumber"
              monospace
              copyLabel="Copiar legajo"
            />
            <InfoCard
              icon="boxicons:building"
              label="Ubicación / Oficina"
              id="term-info-office"
              copyId="btn-copy-office"
              copyLabel="Copiar oficina"
            />
            <InfoCard
              icon="boxicons:user-circle"
              label="Jefe Directo"
              id="term-info-manager"
              showCopy={false}
              copyLabel="Copiar jefe"
            >
              <button
                slot="action"
                type="button"
                id="btn-search-manager"
                class="btn btn-secondary btn-sm hidden shrink-0 cursor-pointer px-2 font-sans"
                title="Buscar supervisor en el portal"
              >
                <Icon
                  name="boxicons:search-filled"
                  size={16}
                  class="shrink-0"
                />
                <span class="text-xs">Buscar</span>
              </button>
            </InfoCard>

            <div
              class="text-xxs text-base-content/50 border-base-300 mt-3 mb-1 border-b pb-1 font-sans font-bold tracking-widest uppercase"
            >
              Seguridad y Acceso
            </div>

            <InfoCard
              icon="boxicons:lock"
              label="Último cambio de clave"
              id="term-info-pwdlastset"
              copyId="btn-copy-pwdlastset"
              copyLabel="Copiar fecha"
            />
            <InfoCard
              icon="boxicons:door-open"
              label="Último login en red"
              id="term-info-lastlogon"
              copyId="btn-copy-lastlogon"
              copyLabel="Copiar login"
            />
            <InfoCard
              icon="boxicons:calendar-plus"
              label="Fecha de alta (cuenta)"
              id="term-info-whencreated"
              copyId="btn-copy-whencreated"
              copyLabel="Copiar fecha de alta"
            />
            <InfoCard
              icon="boxicons:timer"
              label="Vencimiento cuenta"
              id="term-info-expires"
              copyId="btn-copy-expires"
              copyLabel="Copiar vencimiento"
            />
          </div>
          <div
            id="panel-fade-top"
            class="from-base-100 pointer-events-none absolute inset-x-0 top-0 z-10 h-8 bg-linear-to-b to-transparent opacity-0 transition-opacity duration-200"
            aria-hidden="true"
          >
          </div>
          <div
            id="panel-fade-bottom"
            class="from-base-100 pointer-events-none absolute inset-x-0 bottom-0 z-10 h-8 bg-linear-to-t to-transparent transition-opacity duration-200"
            aria-hidden="true"
          >
          </div>
        </div>

        <!-- Columna Derecha: Grupos (3/5) — scroll solo en el listado -->
        <div
          class="flex min-h-0 flex-col gap-2.5 overflow-hidden md:col-span-3"
        >
          <div
            class="border-base-300 flex shrink-0 items-center justify-between border-b pb-2"
          >
            <div class="flex items-center gap-2">
              <span
                class="text-xxs text-base-content/50 font-sans font-bold tracking-widest uppercase"
                >Grupos de Dominio</span
              >
              <span
                class="badge badge-sm badge-secondary text-secondary-content text-xxs font-sans font-bold"
                id="terminal-groups-count">0 grupos</span
              >
            </div>
            <button
              type="button"
              class="btn btn-ghost btn-xs text-secondary hover:bg-secondary/10 cursor-pointer gap-1 font-sans transition-all"
              id="copy-all-groups-btn"
              title="Copiar lista de grupos filtrados"
            >
              <Icon name="boxicons:copy" size={16} />
              <span>Copiar todos</span>
            </button>
          </div>

          <div class="flex shrink-0 items-center gap-3">
            <SearchBar
              id="terminal-groups-search"
              placeholder="Buscar o filtrar grupos..."
              clearable
              class="flex-1"
            />
            <div class="join bg-base-200/50 shrink-0">
              <button
                type="button"
                id="btn-view-grid"
                class="btn join-item text-secondary bg-base-300 cursor-pointer border-0 px-3"
                title="Vista Grilla"
              >
                <Icon name="boxicons:grid" size={16} />
              </button>
              <button
                type="button"
                id="btn-view-list"
                class="btn join-item text-base-content/50 hover:text-base-content cursor-pointer border-0 bg-transparent px-3"
                title="Vista Lista"
              >
                <Icon name="boxicons:list-ul" size={16} />
              </button>
            </div>
          </div>

          <div
            class="border-base-300/40 flex shrink-0 flex-wrap gap-1.5 border-b py-1 pb-2"
            id="group-category-filters"
          >
            <button
              type="button"
              data-filter="all"
              class="btn btn-sm rounded-full"
              >Todos (<span id="count-all">0</span>)</button
            >
            <button
              type="button"
              data-filter="seguridad"
              class="btn btn-sm rounded-full"
              ><Icon name="boxicons:shield-filled" size={20} />Seguridad (<span
                id="count-seguridad">0</span
              >)</button
            >
            <button
              type="button"
              data-filter="correo"
              class="btn btn-sm rounded-full"
              ><Icon name="boxicons:envelope-filled" size={20} />Correo (<span
                id="count-correo">0</span
              >)</button
            >
            <button
              type="button"
              data-filter="sistemas"
              class="btn btn-sm rounded-full"
              ><Icon name="boxicons:desktop-filled" size={20} />Sistemas (<span
                id="count-sistemas">0</span
              >)</button
            >
            <button
              type="button"
              data-filter="otros"
              class="btn btn-sm rounded-full"
              ><Icon name="boxicons:key-filled" size={20} />Otros (<span
                id="count-otros">0</span
              >)</button
            >
          </div>

          <div
            id="terminal-groups-list"
            class="bg-base-200/30 border-base-300 scrollbar-hide grid min-h-0 flex-1 auto-rows-max grid-cols-2 content-start gap-1.5 overflow-y-auto rounded-lg border p-3 transition-all"
          >
          </div>
        </div>
      </div>

      <!-- VISTA 2: Consola CMD -->
      <div
        id="view-console"
        class="flex hidden min-h-0 flex-1 flex-col overflow-hidden p-4"
      >
        <div
          class="text-base-content/50 flex shrink-0 items-center gap-2 text-xs"
        >
          <span>Microsoft Windows [Versión 10.0.19045]</span>
        </div>
        <div class="text-base-content/50 shrink-0 text-xs">
          (c) Microsoft Corporation. Todos los derechos reservados.
        </div>
        <div class="mt-2 flex shrink-0 items-start gap-1 text-xs">
          <span class="text-secondary shrink-0 font-bold">C:\Users\mda&gt;</span
          >
          <span class="text-base-content font-mono"
            >net user "<span id="terminal-command-username"></span>" /domain</span
          >
        </div>
        <div
          class="bg-base-250 border-base-300 scrollbar-hide mt-3 min-h-0 flex-1 overflow-y-auto rounded-md border p-4 text-xs"
        >
          <pre
            id="terminal-output"
            class="text-base-content/90 font-mono whitespace-pre-wrap">
          </pre>
        </div>
      </div>

      <!-- VISTA 3: InvGate (sin scroll salvo tickets) -->
      <div
        id="view-invgate"
        class="scrollbar-hide relative hidden min-h-0 flex-1 overflow-y-auto p-3"
      >
        <!-- Loader de InvGate -->
        <div
          id="invgate-loading"
          class="bg-base-100/95 absolute inset-0 z-20 hidden flex-col items-center justify-center gap-3"
        >
          <span class="loading loading-spinner loading-lg text-secondary"
          ></span>
          <span class="text-base-content/60 text-center font-sans text-xs"
            >Consultando datos en InvGate</span
          >
        </div>

        <!-- Error de InvGate -->
        <div
          id="invgate-error"
          class="bg-base-100/95 absolute inset-0 z-20 hidden flex-col items-center justify-center gap-3 px-6"
        >
        </div>

        <div class="grid grid-cols-2 gap-1.5 md:grid-cols-3">
          <div
            class="text-xxs text-base-content/50 border-base-300 col-span-full mt-1 mb-0.5 border-b pb-1 font-sans font-bold tracking-widest uppercase"
          >
            Cuenta InvGate
          </div>

          <InfoCard
            icon="boxicons:user-id-card"
            label="Nombre Completo"
            id="invgate-fullname"
            copyId="btn-copy-invgate-fullname"
            copyLabel="Copiar nombre"
          />
          <InfoCard
            icon="boxicons:envelope"
            label="Email"
            id="invgate-email"
            copyId="btn-copy-invgate-email"
            monospace
            copyLabel="Copiar email"
          />
          <InfoCard
            icon="boxicons:briefcase"
            label="Rol"
            id="invgate-role"
            copyId="btn-copy-invgate-role"
            copyLabel="Copiar rol"
          />
          <InfoCard
            icon="boxicons:briefcase-alt"
            label="Cargo / Puesto"
            id="invgate-position"
            copyId="btn-copy-invgate-position"
            copyLabel="Copiar cargo"
          />
          <!-- Jefe Directo -->
          <div
            class="bg-base-200/50 border-base-300 group relative flex min-w-0 items-start gap-2 rounded-lg border p-2"
          >
            <div
              class="bg-secondary/10 text-secondary flex size-10 shrink-0 items-center justify-center rounded-md"
            >
              <Icon name="boxicons:user-circle-filled" size={24} />
            </div>
            <div class="min-w-0 flex-1">
              <span
                class="text-base-content/50 block truncate text-xs font-bold tracking-wider uppercase select-none"
                >Jefe Directo</span
              >
              <span
                id="invgate-manager"
                class="text-base-content mt-0.5 block truncate text-xs font-semibold"
                >-</span
              >
            </div>
            <button
              type="button"
              id="btn-search-invgate-manager"
              class="btn btn-secondary btn-sm hidden shrink-0 cursor-pointer px-2 font-sans"
              title="Buscar jefe en el portal"
            >
              <Icon name="boxicons:search" size={16} class="shrink-0" />
              <span class="text-xs">Buscar</span>
            </button>
          </div>
          <InfoCard
            icon="boxicons:badge"
            label="ID de usuario"
            id="invgate-userid"
            copyId="btn-copy-invgate-userid"
            monospace
            copyLabel="Copiar ID"
          />

          <!-- Teléfonos -->
          <div
            class="text-xxs text-base-content/50 border-base-300 col-span-full mt-2 mb-0.5 border-b pb-1 font-sans font-bold tracking-widest uppercase"
          >
            Teléfonos
          </div>
          <div
            id="invgate-phones"
            class="col-span-full grid grid-cols-2 gap-1.5"
          >
          </div>

          <div
            class="text-xxs text-base-content/50 border-base-300 col-span-full mt-2 mb-0.5 border-b pb-1 font-sans font-bold tracking-widest uppercase"
          >
            Organización
          </div>

          <div class="col-span-full grid grid-cols-2 gap-1.5">
            <!-- Grupos -->
            <div
              class="bg-base-200/50 border-base-300 col-span-2 flex min-w-0 flex-col gap-1.5 rounded-lg border p-2"
            >
              <div class="flex items-center gap-1.5">
                <div
                  class="bg-secondary/10 text-secondary flex size-10 shrink-0 items-center justify-center rounded-md"
                >
                  <Icon name="boxicons:group-filled" size={24} />
                </div>
                <span
                  class="text-base-content/50 text-xs font-bold tracking-wider uppercase select-none"
                  >Grupos</span
                >
              </div>
              <div
                class="scrollbar-hide flex max-h-20 flex-wrap gap-1 overflow-y-auto"
                id="invgate-groups"
              >
              </div>
            </div>

            <!-- Mesas de ayuda (chips) -->
            <div
              class="bg-base-200/50 border-base-300 flex min-w-0 flex-col gap-1.5 rounded-lg border p-2"
            >
              <div class="flex items-center gap-1.5">
                <div
                  class="bg-secondary/10 text-secondary flex size-10 shrink-0 items-center justify-center rounded-md"
                >
                  <Icon name="boxicons:headphone-filled" size={24} />
                </div>
                <span
                  class="text-base-content/50 text-xs font-bold tracking-wider uppercase select-none"
                  >Mesas de ayuda</span
                >
              </div>
              <div
                class="scrollbar-hide flex max-h-20 flex-wrap gap-1 overflow-y-auto"
                id="invgate-helpdesks"
              >
              </div>
            </div>

            <!-- Ubicaciones (chips) -->
            <div
              class="bg-base-200/50 border-base-300 flex min-w-0 flex-col gap-1.5 rounded-lg border p-2"
            >
              <div class="flex items-center gap-1.5">
                <div
                  class="bg-secondary/10 text-secondary flex size-10 shrink-0 items-center justify-center rounded-md"
                >
                  <Icon name="boxicons:building-filled" size={24} />
                </div>
                <span
                  class="text-base-content/50 text-xs font-bold tracking-wider uppercase select-none"
                  >Ubicaciones</span
                >
              </div>
              <div
                class="scrollbar-hide flex max-h-20 flex-wrap gap-1 overflow-y-auto"
                id="invgate-locations"
              >
              </div>
            </div>

            <div
              class="text-xxs text-base-content/50 border-base-300 col-span-full mt-2 mb-0.5 border-b pb-1 font-sans font-bold tracking-widest uppercase"
            >
              Actividad
            </div>

            <!-- Tickets relacionados -->
            <div
              class="bg-base-200/50 border-base-300 col-span-full flex min-w-0 flex-col gap-1.5 rounded-lg border p-2"
            >
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-1.5">
                  <div
                    class="bg-secondary/10 text-secondary flex size-10 shrink-0 items-center justify-center rounded-md"
                  >
                    <Icon name="boxicons:task-filled" size={24} />
                  </div>
                  <span
                    class="text-base-content/50 text-xs font-bold tracking-wider uppercase select-none"
                    >Tickets relacionados</span
                  >
                </div>
                <span
                  id="invgate-open-tickets"
                  class="badge badge-sm badge-soft bg-success/10 text-success font-semibold"
                  >0</span
                >
              </div>
              <div
                id="invgate-tickets-list"
                class="scrollbar-hide flex max-h-40 flex-col gap-1 overflow-y-auto"
              >
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div
        class="bg-base-200 border-base-300 flex shrink-0 items-center justify-between border-t px-4 py-2.5 select-none"
      >
        <span class="text-xxs text-base-content/50 font-sans"
          >Conexión LDAP segura con mda.correo.local</span
        >
        <div class="flex gap-2">
          <button
            type="button"
            class="btn btn-ghost btn-xs gap-1"
            id="copy-terminal-btn"
          >
            <Icon name="boxicons:copy" size={16} />
            <span>Copiar salida raw</span>
          </button>
          <button
            type="button"
            class="btn btn-ghost btn-xs"
            id="close-terminal-footer-btn"
          >
            Cerrar
          </button>
        </div>
      </div>
    </div>
  </Fragment>
</Modal>

<style>
  #panel-details-scroll {
    scrollbar-width: none;
  }
  #panel-details-scroll::-webkit-scrollbar {
    display: none;
  }
</style>
