---
import Modal from "@components/ui/Modal.astro";
import FormField from "@components/ui/forms/FormField.astro";
import ActionCancelButton from "@components/ui/ActionCancelButton.astro";
import ActionConfirmButton from "@components/ui/ActionConfirmButton.astro";
---

<Modal
  id="edit-user-modal"
  title="Editar Datos de Contacto"
  icon="boxicons:pencil-filled"
>
  <Fragment slot="content">
    <p
      class="text-base-content/50 bg-base-200/50 border-base-300 mb-6 rounded-lg border p-2.5 text-xs"
    >
      Modifica los datos del colaborador. Las actualizaciones se guardarán
      inmediatamente en la base de datos central.
    </p>

    <form id="edit-user-form" class="space-y-4">
      <!-- Nombre (Solo lectura para contexto) -->
      <div class="form-control w-full">
        <label class="label py-1">
          <span
            class="label-text text-base-content/40 text-xs font-bold tracking-wider uppercase"
            >Nombre del Colaborador</span
          >
        </label>
        <input
          type="text"
          id="edit-user-fullname"
          class="input input-bordered bg-base-200 border-base-300 text-base-content/70 w-full cursor-not-allowed font-medium"
          disabled
          readonly
        />
      </div>

      <input type="hidden" id="edit-user-dni" />

      <div class="grid grid-cols-2 gap-4">
        <FormField
          id="edit-user-interno"
          name="edit-user-interno"
          label="Interno"
          placeholder="Ej. 4231"
          inputClass="font-mono"
          autocomplete="off"
        />
        <FormField
          id="edit-user-telefono"
          name="edit-user-telefono"
          label="Teléfono"
          placeholder="Ej. 11 1234-5678"
          inputClass="font-mono"
          autocomplete="off"
        />
      </div>
    </form>
  </Fragment>
  <Fragment slot="actions">
    <div class="modal-action mt-6 flex items-center justify-end gap-3">
      <ActionCancelButton
        type="button"
        id="close-edit-modal-btn"
        label="Cancelar"
        icon="boxicons:x-filled"
        variant="error"
      />
      <ActionConfirmButton
        type="submit"
        id="save-edit-btn"
        form="edit-user-form"
        color="btn-primary"
        label="Guardar Cambios"
        icon="boxicons:save-filled"
      />
    </div>
  </Fragment>
</Modal>
