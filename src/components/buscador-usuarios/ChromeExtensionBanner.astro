---
import { Icon } from "astro-icon/components";

const API_URL = "http://mda.correo.local/api/usuarios";
---

<div
  class="group border-accent/20 from-accent/5 relative flex flex-col justify-center overflow-hidden rounded-2xl border bg-linear-to-br via-transparent to-transparent p-6 backdrop-blur-md transition-all duration-300 lg:p-8"
>
  <!-- Efecto de brillo sutil de fondo -->
  <div
    class="bg-accent/10 group-hover:bg-accent/20 absolute -right-12 -bottom-12 size-48 rounded-full blur-3xl transition-colors duration-500"
  >
  </div>

  <div class="relative z-10 mb-4 flex items-center gap-4">
    <div
      class="bg-accent/10 text-accent flex size-12 shrink-0 items-center justify-center rounded-xl shadow-inner transition-transform duration-300 group-hover:scale-105"
    >
      <Icon name="boxicons:puzzle-filled" size={24} />
    </div>
    <div>
      <h4 class="text-accent text-lg font-bold tracking-tight">
        Extensión MDA
      </h4>
      <div
        class="text-xxs text-base-content/40 mt-1 font-bold tracking-widest uppercase"
      >
        Chrome / Edge
      </div>
    </div>
  </div>

  <p class="text-base-content/60 relative z-10 flex-1 text-sm">
    Busca usuarios al instante desde cualquier pestaña sin interrumpir tu tarea
    actual.
  </p>

  <div class="border-accent/10 relative z-10 mt-4 border-t pt-4">
    <div
      class="text-xxs text-base-content/40 mb-1.5 font-bold tracking-widest uppercase"
    >
      URL de la API
    </div>
    <div class="flex items-center gap-2">
      <code
        id="api-url-text"
        class="bg-base-300/50 border-base-300 text-base-content/70 flex-1 truncate rounded-lg border px-2.5 py-1.5 font-mono text-xs select-all"
        >{API_URL}</code
      >
      <button
        type="button"
        id="copy-api-url-btn"
        class="btn btn-ghost btn-xs size-7 shrink-0 cursor-pointer rounded-lg p-0"
        title="Copiar URL"
        data-copy-value={API_URL}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="size-3.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          id="copy-api-url-icon"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <a
    href="https://chromewebstore.google.com/detail/gijihnlphpfonpcglommpbefnmkobeoc?utm_source=item-share-cb"
    target="_blank"
    rel="noopener noreferrer"
    class="border-accent/10 group relative z-10 mt-6 flex items-center justify-between border-t pt-4"
  >
    <span
      class="text-base-content/50 group-hover:text-base-content/80 text-xs font-medium transition-colors"
      >Instalar desde Web Store</span
    >
    <Icon
      name="boxicons:chevron-right"
      size={20}
      class="text-accent transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
    />
  </a>
</div>

<script>
  const copyBtn = document.getElementById("copy-api-url-btn");
  const copyIcon = document.getElementById("copy-api-url-icon");

  copyBtn?.addEventListener("click", async () => {
    const url = copyBtn.getAttribute("data-copy-value") || "";
    if (!url) return;

    const canUseClipboardApi =
      typeof navigator !== "undefined" &&
      typeof navigator.clipboard !== "undefined" &&
      typeof navigator.clipboard.writeText === "function";

    if (canUseClipboardApi) {
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        fallbackCopy(url);
        return;
      }
    } else {
      fallbackCopy(url);
      return;
    }

    showCopied();
  });

  function fallbackCopy(value: string) {
    const textarea = document.createElement("textarea");
    textarea.value = value;
    textarea.setAttribute("readonly", "");
    textarea.setAttribute("aria-hidden", "true");
    textarea.style.position = "fixed";
    textarea.style.left = "-9999px";
    textarea.style.top = "0";
    textarea.style.opacity = "0";
    document.body.appendChild(textarea);
    textarea.focus();
    textarea.select();
    try {
      (document as any).execCommand("copy");
    } catch {}
    textarea.remove();
    showCopied();
  }

  function showCopied() {
    if (!copyIcon) return;
    copyIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />`;
    copyIcon.classList.add("text-success");
    setTimeout(() => {
      copyIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />`;
      copyIcon.classList.remove("text-success");
    }, 2000);
  }
</script>
