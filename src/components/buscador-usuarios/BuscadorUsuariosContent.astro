---
import { Icon } from "astro-icon/components";
import UserCard from "@components/UserCard.astro";
import CopyButton from "@components/ui/CopyButton.astro";
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import SearchEmptyState from "@components/ui/SearchEmptyState.astro";
import HeroSearchBar from "@components/ui/HeroSearchBar.astro";
import ChromeExtensionBanner from "./ChromeExtensionBanner.astro";
import EditUserModal from "./EditUserModal.astro";
import TerminalModal from "./TerminalModal.astro";
import Modal from "@components/ui/Modal.astro";
import SkeletonCard from "@components/ui/skeletons/SkeletonCard.astro";
const userRole = Astro.locals.user?.role || "";
---

<PageContainer>
  <!-- Contenedor Principal Optimizado (Grilla) -->
  <div class="mb-8 grid gap-6 lg:grid-cols-3">
    <!-- Sección de Búsqueda -->
    <section
      class="bg-base-200/50 border-base-300 flex flex-col justify-center rounded-2xl border px-6 py-8 shadow-md md:px-8 lg:col-span-2"
    >
      <div class="mb-6 flex items-start justify-between gap-4">
        <PageHeader
          description="Acceso rápido a contacto, internos y dependencias de todo el personal."
          class="flex-1 text-left"
          titleClass="text-2xl md:text-3xl"
        />
        <button
          id="sync-invgate-btn"
          class="btn btn-accent btn-outline btn-sm mt-1 hidden w-46.25 shrink-0 gap-2"
        >
          <span id="sync-invgate-icon" class="inline-flex items-center">
            <Icon
              name="boxicons:refresh-ccw"
              size={16}
              id="sync-icon-idle"
            />
            <Icon
              name="boxicons:check"
              size={16}
              class="hidden"
              id="sync-icon-success"
            />
            <Icon
              name="boxicons:x"
              size={16}
              class="hidden"
              id="sync-icon-error"
            />
            <span
              id="sync-icon-spinner"
              class="loading loading-spinner loading-xs hidden text-current"
            ></span>
          </span>
          <span id="sync-invgate-text">Sincronizar InvGate</span>
        </button>
      </div>

      <HeroSearchBar
        id="search-input"
        placeholder="Escribe para buscar..."
        ariaLabel="Buscar usuarios por nombre, apellido o DNI"
      />

      <div class="mt-6 flex flex-col gap-2">
        <div
          class="text-base-content/50 flex items-center gap-2 text-xs sm:text-sm"
          id="search-status"
        >
          <span>Listo para buscar.</span>
        </div>
        <div
          class="text-xxs text-base-content/40 flex items-center gap-1 sm:text-xs"
          id="sync-status"
        >
        </div>
      </div>
    </section>

    <!-- Banner Extensión -->
    <ChromeExtensionBanner />
  </div>

  <section>
    <div class="mb-6 flex items-center justify-between">
      <h2 class="flex items-center gap-2 text-xl font-bold" id="results-title">
        Usuarios sugeridos <span
          class="badge badge-sm badge-neutral"
          id="results-count">0</span
        >
      </h2>
      <div id="loading-indicator" class="hidden">
        <span class="loading loading-spinner loading-sm text-primary"></span>
        <span class="text-base-content/60 ml-2 text-sm">Buscando...</span>
      </div>
    </div>

    <div id="results-skeleton" class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {[1, 2, 3, 4, 5, 6].map(() => <SkeletonCard type="user" />)}
    </div>

    <div
      id="results-grid"
      class="hidden grid-cols-1 gap-6 opacity-0 transition-opacity duration-500 md:grid-cols-2"
    >
    </div>

    <SearchEmptyState
      id="empty-state"
      title="Comienza tu búsqueda"
      description="Encuentra usuarios rápidamente ingresando su nombre, apellido o DNI."
      icon="boxicons:search"
      useDualIcons={true}
      notFoundIcon="boxicons:user-minus-filled"
      showClearButton={true}
      clearButtonText="Limpiar búsqueda"
      clearButtonId="clear-search"
    />
  </section>
  <div id="icon-store" class="hidden" aria-hidden="true">
    <span data-icon="clock"><Icon name="boxicons:clock-filled" size={16} /></span>
    <span data-icon="check-success"><Icon name="boxicons:check" size={16} /></span>
    <span data-icon="x-error"><Icon name="boxicons:x" size={16} /></span>
  </div>
</PageContainer>

<UserCard />

<!-- Plantilla de CopyButton (icon) para clonar en HTML dinámico (grupos/teléfonos) -->
<template id="copy-icon-template">
  <CopyButton
    variant="icon"
    value="template"
    label="Copiar"
    size="xs"
    showTooltip={false}
    class="opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity cursor-pointer shrink-0"
  />
</template>

<!-- Modal de Edición de Contacto -->
<EditUserModal />

<!-- Modal de Consola Terminal (Grupos AD) -->
<TerminalModal />

<!-- Modal de Confirmación de Ticket InvGate -->
<Modal
  id="invgate-ticket-modal"
  title="Crear solicitud en InvGate"
  icon="boxicons:user-plus-filled"
  size="md"
>
  <Fragment slot="content">
    <p class="text-base-content/80 text-sm">
      ¿Estás seguro que deseas crear un ticket solicitando acceso a InvGate para
      el usuario <strong id="modal-user-name"></strong>?
    </p>
  </Fragment>
  <Fragment slot="actions">
    <div class="mt-6 flex justify-end gap-2">
      <form method="dialog">
        <button
          class="btn btn-ghost border-base-300 hover:bg-base-200 cursor-pointer border"
          >Cancelar</button
        >
      </form>
      <button
        id="confirm-create-ticket-btn"
        class="btn btn-primary cursor-pointer shadow-md">Crear Ticket</button
      >
    </div>
  </Fragment>
</Modal>

<script is:inline define:vars={{ userRole }}>
  window.__userRole = userRole;
</script>

<script>
  import "./lib";
</script>
