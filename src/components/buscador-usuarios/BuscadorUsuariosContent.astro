    if (!invgatePhones) return;
    invgatePhones.innerHTML = "";
    const phones: Array<[string, string]> = [
      ["Fijo", u.phone],
      ["Móvil", u.mobile],
      ["Oficina", u.office],
      ["Otro", u.other],
      ["Fax", u.fax],
    ].filter(([, value]) => value != null && value !== "") as Array<
      [string, string]
    >;
    if (phones.length === 0) {
      invgatePhones.innerHTML =
        '<span class="text-base-content/40 text-xs font-sans col-span-full">Sin datos</span>';
