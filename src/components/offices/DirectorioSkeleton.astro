---
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import { isAllowed } from "@lib/rolesMatrix";
import { can } from "@lib/roleConfig";

const user = Astro.locals.user;
const isAllowedAdmin = user
  ? isAllowed("Administrar Contenido", user.role)
  : false;
const canViewInvgateStats = user ? can(user.role, "team_leader") : false;
const officeDirectoryHeaderGridClass = isAllowedAdmin
  ? "grid-cols-[48px_80px_1.2fr_90px_1.8fr_110px_120px] gap-4"
  : "grid-cols-[48px_80px_1.2fr_90px_1.8fr_110px] gap-4";
---

<PageContainer width="xxl">
  <div class="skeleton-debounced flex flex-col gap-6">
    <PageHeader
      description="Visualización centralizada de la infraestructura, buscador de oficinas y mapa interactivo de cobertura nacional."
    />

    <!-- ViewSwitcher Skeleton -->
    <div class="w-full">
      <div class="skeleton h-12 w-full rounded-lg"></div>
    </div>

    <!-- Contenedor de Directorio Skeleton -->
    <div class="space-y-6">
      <!-- Form/Filtros Skeleton -->
      <div
        class="rounded-box border-base-300 bg-base-100 flex flex-col gap-4 border p-4 shadow-md"
      >
        <!-- FilterTabsBox Skeleton -->
        <div class="bg-base-200/50 rounded-box p-2">
          <div class="flex flex-wrap gap-1.5">
            <div class="skeleton h-10 w-28 rounded-lg"></div>
            <div class="skeleton h-10 w-36 rounded-lg"></div>
            <div class="skeleton h-10 w-32 rounded-lg"></div>
            <div class="skeleton h-10 w-28 rounded-lg"></div>
            <div class="skeleton h-10 w-24 rounded-lg"></div>
            <div class="skeleton h-10 w-32 rounded-lg"></div>
            <div class="skeleton h-10 w-20 rounded-lg"></div>
          </div>
        </div>

        <!-- Selects and Button Skeleton -->
        <div class="flex w-full flex-wrap items-center gap-3">
          <div class="skeleton h-12 w-32 grow rounded-lg"></div>
          <div class="skeleton h-12 w-32 grow rounded-lg"></div>
          <div class="skeleton h-12 w-32 grow rounded-lg"></div>
          <div class="skeleton h-12 w-32 grow rounded-lg"></div>
          <div class="skeleton h-12 w-32 rounded-lg"></div>
        </div>

        <!-- Search + Buttons Skeleton -->
        <div class="flex w-full flex-wrap items-center gap-3 sm:flex-nowrap">
          <div class="w-full">
            <div class="skeleton h-14 w-full rounded-lg"></div>
          </div>
          <div class="skeleton h-10 w-36 shrink-0 rounded-lg"></div>
          {
            isAllowedAdmin && (
              <div class="skeleton h-10 w-36 shrink-0 rounded-lg" />
            )
          }
          {
            canViewInvgateStats && (
              <div class="skeleton h-10 w-36 shrink-0 rounded-lg" />
            )
          }
        </div>
      </div>

      {
        canViewInvgateStats && (
          <div class="rounded-box border-base-300 bg-base-100 border p-4 shadow-md">
            <div class="flex flex-wrap items-center gap-4">
              <div class="skeleton h-[72px] w-[160px]" />
              <div class="skeleton h-[72px] w-[160px]" />
              <div class="skeleton h-[72px] w-[160px]" />
              <div class="skeleton h-[72px] w-[160px]" />
              <div class="skeleton ml-auto h-8 w-[146px] shrink-0" />
            </div>
          </div>
        )
      }

      <!-- Table Skeleton (MasterDetailTable layout) -->
      <div
        class="border-base-300 bg-base-100 overflow-hidden rounded-xl border shadow-sm"
      >
        <!-- Header Skeleton -->
        <div
          class={`grid ${officeDirectoryHeaderGridClass} border-b border-base-300 px-4 py-3 bg-base-200/50`}
        >
          <div></div>
          <div><div class="skeleton h-5 w-12 rounded"></div></div>
          <div><div class="skeleton h-5 w-24 rounded"></div></div>
          <div><div class="skeleton h-5 w-20 rounded"></div></div>
          <div><div class="skeleton h-5 w-32 rounded"></div></div>
          <div><div class="skeleton h-5 w-16 rounded"></div></div>
          {
            isAllowedAdmin && (
              <div>
                <div class="skeleton h-5 w-16 rounded" />
              </div>
            )
          }
        </div>

        <!-- Rows Skeleton (10 rows) -->
        <div class="divide-base-300 divide-y">
          {
            Array.from({ length: 10 }).map(() => (
              <div
                class={`grid ${officeDirectoryHeaderGridClass} items-center px-4 py-4`}
              >
                {/* Chevron placeholder */}
                <div class="flex justify-center">
                  <div class="skeleton size-5 rounded" />
                </div>
                {/* Code */}
                <div class="relative inline-flex">
                  <span class="bg-neutral absolute -top-0.5 right-4.5 z-10 size-2 rounded-full" />
                  <div class="skeleton h-4 w-12 rounded font-mono" />
                </div>
                {/* Name / Details */}
                <div class="flex flex-col gap-1.5">
                  <div class="skeleton h-4 w-40 rounded" />
                  <div class="skeleton h-3 w-24 rounded" />
                </div>
                {/* Dependency / NIS */}
                <div>
                  <div class="skeleton h-4 w-14 rounded" />
                </div>
                {/* Address */}
                <div class="flex flex-col gap-1.5">
                  <div class="skeleton h-4 w-52 rounded" />
                  <div class="skeleton h-3 w-28 rounded" />
                </div>
                {/* Cost Center */}
                <div>
                  <div class="skeleton h-4 w-16 rounded" />
                </div>
                {isAllowedAdmin && (
                  <div class="flex justify-end gap-2">
                    <div class="skeleton h-8 w-14 rounded-lg" />
                  </div>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</PageContainer>
