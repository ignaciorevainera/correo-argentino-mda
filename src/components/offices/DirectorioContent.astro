---
import { Icon } from "astro-icon/components";
import DataTableHeaderCell from "@components/ui/DataTableHeaderCell.astro";
import MasterDetailTable from "@components/ui/MasterDetailTable.astro";
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import SearchBar from "@components/ui/SearchBar.astro";
import ViewSwitcher from "@components/ui/ViewSwitcher.astro";
import SearchEmptyState from "@components/ui/SearchEmptyState.astro";
import StatsGrid from "@components/ui/StatsGrid.astro";
import StatsCard from "@components/ui/StatsCard.astro";
import {
  getOffices,
  hasClosedOffices,
  getCachedProvincesWithRegion,
  getOfficeTypeCounts,
} from "@lib/officeQueries";
import OfficeRow from "@components/offices/OfficeRow.astro";
import AgentsTicketModal from "@components/offices/AgentsTicketModal.astro";
import {
  officeTypeLabelByType,
  formatTypeLabel,
} from "@lib/officeHelpers";
import { db } from "@db/index";
import { regions, offices } from "@db/schema";
import { sql, or, eq } from "drizzle-orm";
import { getResolvedSearchParams } from "@lib/navigation";
import { isAllowed } from "@lib/rolesMatrix";
import { can } from "@lib/roleConfig";
import { hasPermission } from "@lib/rbac";
import { resolveUrl } from "@lib/url";
import "leaflet/dist/leaflet.css";

const user = Astro.locals.user;
const isAllowedAdmin = user
  ? isAllowed("Administrar Contenido", user.role)
  : false;
const canViewInvgateStats = user ? can(user.role, "team_leader") : false;
const canExport = user ? can(user.role, "team_leader") : false;
// Misma fuente que el middleware y el sidebar: el CTA aparece solo donde la
// ruta está permitida (supervisor + admin).
const canViewOfficeStats = user
  ? hasPermission("/oficinas/estadisticas", user.role)
  : false;

const searchParams = getResolvedSearchParams(Astro.request, Astro.url);

const typeFilter = searchParams.get("type") || "all";
const regionFilter = searchParams.get("region") || "all";
const provinceFilter = searchParams.get("province") || "all";
const zoneFilter = searchParams.get("zone") || "all";
const paqarFilter = searchParams.get("paqar") || "all";
const hasParentFilter = searchParams.get("hasParent") === "true";
const isHeadquarterFilter = searchParams.get("isHeadquarter") === "true";
const noAddressFilter = searchParams.get("noAddress") === "true";
const statusFilter = searchParams.get("status") || "all";
const searchFilter = searchParams.get("search") || "";

const allProvincesWithRegion = await getCachedProvincesWithRegion();

const [oficinasTotalesRow] = await db
  .select({ total: sql<number>`count(*)` })
  .from(offices);
const [oficinasActivasRow] = await db
  .select({ total: sql<number>`count(*)` })
  .from(offices)
  .where(eq(offices.active, true));
const oficinasTotales = Number(oficinasTotalesRow?.total ?? 0);
const oficinasActivas = Number(oficinasActivasRow?.total ?? 0);
const oficinasCerradas = oficinasTotales - oficinasActivas;

const provincesByRegion: Record<string, { code: string; name: string }[]> = {};
for (const p of allProvincesWithRegion) {
  const rName = p.regionName ?? "Sin región";
  if (!provincesByRegion[rName]) provincesByRegion[rName] = [];
  provincesByRegion[rName].push({ code: p.code, name: p.name });
}

const sortBy = (searchParams.get("sortBy") || undefined) as
  "code" | "name" | "parent-nis" | "address" | undefined;
const sortOrder = (searchParams.get("sortOrder") || undefined) as
  "asc" | "desc" | undefined;

const showClosedToggle = await hasClosedOffices();

const {
  data: officeDirectoryItems,
  count: totalOffices,
  hasMore,
} = await getOffices({
  page: 1,
  limit: 100,
  type: typeFilter,
  region: regionFilter,
  province: provinceFilter,
  zone: zoneFilter,
  paqar: paqarFilter,
  hasParent: hasParentFilter,
  isHeadquarter: isHeadquarterFilter,
  noAddress: noAddressFilter,
  status: statusFilter as "all" | "active" | "closed",
  search: searchFilter,
  sortBy,
  sortOrder,
});

const { processedCounts } = await getOfficeTypeCounts();

processedCounts.forEach((row) => {
  if (row.type && !officeTypeLabelByType[row.type]) {
    officeTypeLabelByType[row.type] = formatTypeLabel(row.type);
  }
});

const officeTypeOptions = [
  { value: "all", label: "Todas" },
  ...processedCounts
    .sort((a, b) => b.count - a.count)
    .map((row) => ({
      value: row.type,
      label: `${officeTypeLabelByType[row.type] || formatTypeLabel(row.type)} (${row.count})`,
    })),
];

const uniqueRegions = [
  ...new Set(
    allProvincesWithRegion
      .map((p) => p.regionName)
      .filter((r): r is string => Boolean(r)),
  ),
].sort((a, b) => a.localeCompare(b, "es", { sensitivity: "base" }));

const allRegions = await db.select().from(regions).orderBy(regions.name);

const allZonesRaw = await db
  .select({ zone: offices.zone })
  .from(offices)
  .where(sql`${offices.zone} IS NOT NULL AND ${offices.zone} != ''`)
  .groupBy(offices.zone);

const uniqueZones = allZonesRaw
  .map((z) => z.zone)
  .filter((z): z is string => Boolean(z))
  .sort((a, b) => a.localeCompare(b, "es", { numeric: true }));

let hasNoAddressOffices = false;
if (isAllowedAdmin) {
  const noAddressCount = await db
    .select({ count: sql<number>`count(*)` })
    .from(offices)
    .where(or(sql`${offices.address} IS NULL`, sql`${offices.address} = ''`));
  hasNoAddressOffices = noAddressCount[0].count > 0;
}

const advancedFilterCount =
  (zoneFilter !== "all" ? 1 : 0) +
  (paqarFilter !== "all" ? 1 : 0) +
  (hasParentFilter ? 1 : 0) +
  (isAllowedAdmin && hasNoAddressOffices && noAddressFilter ? 1 : 0) +
  (showClosedToggle && statusFilter === "closed" ? 1 : 0);

const hasDirectoryActions =
  canExport || isAllowedAdmin || canViewInvgateStats || canViewOfficeStats;

const officeDirectoryHeaderGridClass = isAllowedAdmin
  ? "grid-cols-[48px_80px_1.2fr_90px_1.8fr_110px_120px] gap-4"
  : "grid-cols-[48px_80px_1.2fr_90px_1.8fr_110px] gap-4";

const mainTabs = [
  { label: "Directorio de Oficinas", value: "directory" },
  { label: "Mapa de Regiones", value: "map" },
];
---

<PageContainer width="xxl">
  <PageHeader
    description="Visualización centralizada de la infraestructura, buscador de oficinas y mapa interactivo de cobertura nacional."
  />

  <div>
    <div class="mb-2 flex items-center gap-2">
      <span
        class="text-base-content/50 text-xs font-semibold tracking-wider uppercase"
        >Padrón</span
      >
    </div>
    <StatsGrid
      base={2}
      md={3}
      lg={3}
      ariaLabel="Resumen de oficinas"
      class="[&_.stat-figure]:hidden sm:[&_.stat-figure]:block"
    >
      <StatsCard
        icon="building-house-filled"
        label="Oficinas totales"
        value={oficinasTotales}
        color="primary"
        size="lg"
      />
      <StatsCard
        icon="check-circle-filled"
        label="Activas"
        value={oficinasActivas}
        color="success"
        size="lg"
      />
      <StatsCard
        icon="x-circle-filled"
        label="Inoperativas"
        value={oficinasCerradas}
        color="error"
        size="lg"
      />
    </StatsGrid>
  </div>

  <ViewSwitcher
    tabs={mainTabs}
    activeValue="directory"
    name="main_view_tabs"
    id="main-view-switcher"
    class="grid w-full grid-cols-2"
    containerClass="w-full"
  />
  <div id="main-view-directory" class="space-y-6">
    <div
      id="provinces-data"
      data-provinces={JSON.stringify(provincesByRegion)}
      class="hidden"
    >
    </div>
    <form
      method="GET"
      id="office-filters-form"
      class="rounded-box border-base-300 bg-base-100 flex flex-col gap-4 border p-4 shadow-md"
      aria-label="Filtros del directorio"
    >
      <div class="flex w-full flex-wrap items-center gap-3">
        <div class="min-w-52 flex-1">
          <SearchBar
            id="office-search"
            name="search"
            value={searchFilter}
            placeholder="Buscar por nombre, código, región o CP"
            clearable
          />
        </div>
        <div class="badge badge-neutral badge-lg whitespace-nowrap">
          <Icon name="boxicons:eye-filled" size={16} />
          <span id="total-count-badge">{totalOffices} resultados</span>
        </div>
        <button
          type="button"
          id="clear-filters-btn"
          class="btn btn-ghost btn-square shrink-0"
          aria-label="Limpiar todos los filtros"
          title="Limpiar todos los filtros"
        >
          <Icon name="boxicons:trash" size={20} />
        </button>
        {
          hasDirectoryActions && (
            <details class="dropdown dropdown-end shrink-0" data-dropdown>
              <summary
                class="btn btn-ghost btn-square list-none [&::-webkit-details-marker]:hidden"
                aria-label="Más acciones del directorio"
                title="Más acciones"
              >
                <Icon name="boxicons:dots-vertical-rounded" size={20} />
              </summary>
              <ul class="dropdown-content menu bg-base-100 border-base-300 shadow-overlay z-100 mt-1 w-60 rounded-xl border p-1.5">
                {canExport && (
                  <li>
                    <a
                      id="export-csv-btn"
                      href={`${import.meta.env.BASE_URL}api/export/offices`}
                      download
                      class="gap-2"
                    >
                      <Icon name="boxicons:file-detail-filled" size={18} />
                      Exportar CSV
                    </a>
                  </li>
                )}
                {isAllowedAdmin && (
                  <li>
                    <a
                      href={`${import.meta.env.BASE_URL}oficinas/create`}
                      class="gap-2"
                    >
                      <Icon name="boxicons:plus" size={18} />
                      Registrar oficina
                    </a>
                  </li>
                )}
                {canViewInvgateStats && (
                  <li>
                    <button
                      id="sync-invgate-btn"
                      type="button"
                      class="gap-2"
                    >
                      <Icon name="boxicons:refresh-cw" size={18} />
                      <span id="sync-btn-text">Sincronizar ahora</span>
                      <span
                        id="sync-btn-spinner"
                        class="loading loading-spinner loading-sm ml-auto hidden"
                      />
                    </button>
                  </li>
                )}
                {canViewOfficeStats && <li class="menu-title">Vistas</li>}
                {canViewOfficeStats && (
                  <li>
                    <a
                      href={resolveUrl("/oficinas/estructura")}
                      class="gap-2"
                      data-cta-estructura-oficinas
                    >
                      <Icon name="boxicons:network-chart-filled" size={18} />
                      Estructura
                    </a>
                  </li>
                )}
                {canViewOfficeStats && (
                  <li>
                    <a
                      href={resolveUrl("/oficinas/estadisticas")}
                      class="gap-2"
                      data-cta-estadisticas-oficinas
                    >
                      <Icon name="boxicons:bar-chart-big-filled" size={18} />
                      Estadísticas
                    </a>
                  </li>
                )}
                {isAllowedAdmin && (
                  <li>
                    <a
                      href={`${import.meta.env.BASE_URL}admin/invgate/ubicaciones?sync=true`}
                      class="gap-2"
                      data-cta-comparativa-oficinas
                    >
                      <Icon name="boxicons:pie-chart-filled" size={18} />
                      Comparativa InvGate
                    </a>
                  </li>
                )}
              </ul>
            </details>
          )
        }
      </div>

      <div class="grid w-full grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-5">
        <div>
          <select
            name="type"
            id="typeFilter"
            class="select border-base-300 focus:border-primary focus:ring-primary/20 w-full focus:ring-2 focus:outline-none"
            aria-label="Filtrar por tipo de oficina"
          >
            {
              officeTypeOptions.map((option) => (
                <option value={option.value} selected={typeFilter === option.value}>
                  {option.label}
                </option>
              ))
            }
          </select>
        </div>

        <div>
          <select
            name="region"
            id="regionFilter"
            class="select border-base-300 focus:border-primary focus:ring-primary/20 w-full focus:ring-2 focus:outline-none"
            aria-label="Filtrar por región"
          >
            <option value="all" selected={regionFilter === "all"}
              >Regiones</option
            >
            {
              uniqueRegions.map((region) => (
                <option value={region} selected={regionFilter === region}>
                  {region}
                </option>
              ))
            }
          </select>
        </div>

        <div>
          <select
            name="province"
            id="provinceFilter"
            class="select border-base-300 focus:border-primary focus:ring-primary/20 w-full focus:ring-2 focus:outline-none"
            aria-label="Filtrar por provincia"
          >
            <option value="all" selected={provinceFilter === "all"}
              >Provincias</option
            >
            {
              uniqueRegions.map((region) => (
                <optgroup label={region}>
                  {(provincesByRegion[region] || []).map((prov) => (
                    <option
                      value={prov.code}
                      selected={provinceFilter === prov.code}
                    >
                      {prov.name}
                    </option>
                  ))}
                </optgroup>
              ))
            }
          </select>
        </div>

        <label
          class="bg-base-200/40 border-base-300 flex min-h-10 cursor-pointer items-center justify-between gap-2 rounded-lg border px-3"
        >
          <span class="label-text text-xs font-medium sm:text-sm"
            >Solo cabeceras</span
          >
          <input
            type="checkbox"
            name="isHeadquarter"
            value="true"
            class="toggle toggle-sm toggle-primary"
            checked={isHeadquarterFilter}
            aria-label="Mostrar solo oficinas cabecera"
          />
        </label>

        <details class="dropdown dropdown-end w-full" data-dropdown>
          <summary
            class:list={[
              "btn w-full justify-between gap-2 text-sm font-normal",
              advancedFilterCount > 0
                ? "btn-soft btn-primary"
                : "btn-outline border-base-300",
            ]}
            aria-label={`Filtros avanzados${advancedFilterCount > 0 ? `, ${advancedFilterCount} activos` : ""}`}
          >
            <span class="flex items-center gap-2">
              <Icon name="boxicons:filter" size={16} />
              Avanzados
            </span>
            <span
              id="advanced-filter-count"
              class:list={[
                "badge badge-sm",
                advancedFilterCount > 0 ? "" : "hidden",
              ]}
              aria-live="polite">{advancedFilterCount}</span
            >
          </summary>
          <div
            class="dropdown-content bg-base-100 border-base-300 shadow-overlay z-100 mt-1 flex w-80 max-w-[calc(100vw-2rem)] flex-col gap-3 rounded-xl border p-3"
          >
            <span
              class="text-base-content/50 text-xs font-semibold tracking-wider uppercase"
              >Ubicación</span
            >
            <select
              name="zone"
              id="zoneFilter"
              class="select select-sm border-base-300 focus:border-primary focus:ring-primary/20 w-full focus:ring-2 focus:outline-none"
              aria-label="Filtrar por zona"
            >
              <option value="all" selected={zoneFilter === "all"}
                >Zonas (Todas)</option
              >
              {
                uniqueZones.map((zone) => (
                  <option value={zone} selected={zoneFilter === zone}>
                    {zone}
                  </option>
                ))
              }
            </select>
            <select
              name="paqar"
              id="paqarFilter"
              class="select select-sm border-base-300 focus:border-primary focus:ring-primary/20 w-full focus:ring-2 focus:outline-none"
              aria-label="Filtrar por servicios Paq.AR"
            >
              <option value="all" selected={paqarFilter === "all"}
                >Paq.AR (Todos)</option
              >
              <option value="admision" selected={paqarFilter === "admision"}
                >Admite Paq.AR</option
              >
              <option value="entrega" selected={paqarFilter === "entrega"}
                >Entrega Paq.AR</option
              >
              <option value="ambos" selected={paqarFilter === "ambos"}
                >Admite y Entrega</option
              >
            </select>

            <div class="divider my-0"></div>
            <span
              class="text-base-content/50 text-xs font-semibold tracking-wider uppercase"
              >Estado</span
            >
            <label class="label cursor-pointer justify-between gap-2 p-0">
              <span class="label-text text-xs font-medium sm:text-sm"
                >Depende de otra</span
              >
              <input
                type="checkbox"
                name="hasParent"
                value="true"
                class="toggle toggle-sm toggle-primary"
                checked={hasParentFilter}
                aria-label="Mostrar solo oficinas que dependen de otra"
              />
            </label>
            {
              isAllowedAdmin && hasNoAddressOffices && (
                <label class="label cursor-pointer justify-between gap-2 p-0">
                  <span class="label-text text-xs font-medium sm:text-sm">
                    Sin domicilio
                  </span>
                  <input
                    type="checkbox"
                    name="noAddress"
                    value="true"
                    class="toggle toggle-sm toggle-primary"
                    checked={noAddressFilter}
                    aria-label="Mostrar solo oficinas sin domicilio registrado"
                  />
                </label>
              )
            }
            {
              showClosedToggle && (
                <label class="label cursor-pointer justify-between gap-2 p-0">
                  <span class="label-text text-xs font-medium sm:text-sm">
                    Mostrar inoperativas
                  </span>
                  <input
                    type="checkbox"
                    name="status"
                    value="closed"
                    class="toggle toggle-sm toggle-primary"
                    checked={statusFilter === "closed"}
                    aria-label="Mostrar solo oficinas inoperativas"
                  />
                </label>
              )
            }
          </div>
        </details>
      </div>

    </form>

    <div id="office-table-wrapper">
      <div
        id="office-table-container"
        class:list={[officeDirectoryItems.length === 0 && "hidden"]}
      >
        <MasterDetailTable
          ariaLabel="Directorio de oficinas"
          minWidthClass="min-w-280"
          headerGridClass={officeDirectoryHeaderGridClass}
          class="bg-base-100"
          serverSideSort={true}
        >
          <div slot="header">
            <DataTableHeaderCell>
              <span class="sr-only">Expandir detalle</span>
            </DataTableHeaderCell>
          </div>
          <div slot="header">
            <DataTableHeaderCell sortKey="code"> Código </DataTableHeaderCell>
          </div>
          <div slot="header">
            <DataTableHeaderCell sortKey="name">Nombre</DataTableHeaderCell>
          </div>
          <div slot="header">
            <DataTableHeaderCell sortKey="parent-nis"
              >Dependencia</DataTableHeaderCell
            >
          </div>
          <div slot="header">
            <DataTableHeaderCell sortKey="address"
              >Dirección</DataTableHeaderCell
            >
          </div>
          <div slot="header">
            <DataTableHeaderCell sortKey="cost-center">CECO</DataTableHeaderCell
            >
          </div>
          {
            isAllowedAdmin && (
              <div slot="header">
                <DataTableHeaderCell>Acciones</DataTableHeaderCell>
              </div>
            )
          }
          {officeDirectoryItems.map((office) => <OfficeRow office={office} />)}
        </MasterDetailTable>
      </div>

      <SearchEmptyState
        id="no-results-state"
        class={officeDirectoryItems.length > 0 ? "hidden" : "flex"}
        title="No hay coincidencias"
        description="No hemos podido encontrar oficinas que coincidan con los filtros seleccionados. Probá modificando los criterios o restableciendo la búsqueda para explorar el directorio completo."
        showClearButton={true}
        clearButtonHref={import.meta.env.BASE_URL + "oficinas"}
        clearButtonText="Restablecer filtros"
      />

      <div
        id="scroll-sentinel"
        class:list={[
          "flex justify-center py-8 text-center",
          !hasMore && "hidden",
        ]}
        data-has-more={hasMore ? "true" : "false"}
      >
        <span
          class="loading loading-spinner loading-md text-primary hidden"
          id="loading-spinner"></span>
      </div>
    </div>
  </div>

  <div id="main-view-map" class="hidden space-y-6">
    <div id="views-wrapper" class="relative">
      <div class="flex flex-col gap-6 lg:flex-row">
        <section
          id="view-map"
          class="bg-base-100 border-base-content/10 relative z-0 min-w-0 flex-1 overflow-hidden rounded-xl border shadow-lg transition-all duration-500"
        >
          <div id="mapa-sucursales" class="relative z-0 h-150 w-full"></div>
        </section>

        <div
          id="map-controls"
          class="flex w-full shrink-0 flex-col gap-2 lg:w-64"
        >
          <div
            class="rounded-box border-base-300 bg-base-200/30 flex flex-col gap-2 border p-3"
          >
            <label class="label cursor-pointer justify-start gap-3 p-0">
              <input
                type="checkbox"
                class="toggle toggle-primary toggle-sm"
                checked
                id="chk-polygons"
              />
              <span class="label-text text-xs font-medium">Regiones</span>
            </label>
            <label class="label cursor-pointer justify-start gap-3 p-0">
              <input
                type="checkbox"
                class="toggle toggle-primary toggle-sm"
                checked
                id="chk-labels"
              />
              <span class="label-text text-xs font-medium">Códigos</span>
            </label>
          </div>

          <div class="divider my-0"></div>

          <div id="map-legend" class="flex flex-col gap-2">
            {
              allRegions.map((r) => (
                <div
                  class="legend-item-group border-base-300 bg-base-100 overflow-hidden rounded-lg border transition-colors duration-150"
                  data-region={r.name}
                >
                  <div class="legend-item hover:bg-base-200/50 flex cursor-pointer items-center justify-between gap-2 px-3 py-2 transition-colors">
                    <div class="flex items-center gap-3">
                      <span
                        class="size-4 shrink-0 rounded-sm"
                        style={`background-color: ${r.color}`}
                      />
                      <span class="text-sm font-semibold">{r.name}</span>
                    </div>
                    <button
                      type="button"
                      class="border-base-300 bg-base-200 text-base-content/70 hover:bg-base-300 focus-visible:ring-primary/50 btn-toggle-referents inline-flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-lg border transition-colors focus-visible:ring-2 focus-visible:outline-none"
                      data-region-id={r.id}
                      data-region-name={r.name}
                      aria-label="Ver tecnológicos regionales"
                      aria-expanded="false"
                    >
                      <Icon
                        name="boxicons:chevron-down-filled"
                        data-chevron-closed
                        size={16}
                      />
                      <Icon
                        name="boxicons:chevron-up-filled"
                        data-chevron-open
                        class="hidden"
                        size={16}
                      />
                    </button>
                  </div>
                  <div
                    class="referents-collapse-content border-base-200 bg-base-200/20 hidden border-t px-3 pt-1.5 pb-3 text-xs"
                    data-region-id={r.id}
                  >
                    <div class="border-base-300 flex items-center justify-between border-b pb-1">
                      <span class="text-base-content/50 text-xs font-semibold tracking-wider uppercase">
                        Tecnológicos
                      </span>
                    </div>
                    <div class="referents-list-container mt-2 flex flex-col gap-1.5" />
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
  <AgentsTicketModal />
</PageContainer>

<script>
  import "./lib";
</script>

<style is:global>
  .office-type-chip {
    border-width: 1px;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.04);
    border-radius: 0.5rem;
  }

  /* ADMINISTRACION */
  .office-type-chip-administracion {
    background-color: var(--color-indigo-100, #e0e7ff);
    border-color: var(--color-indigo-300, #a5b4fc);
    color: var(--color-indigo-900, #1e1b4b);
  }
  [data-theme="dark"] .office-type-chip-administracion {
    background-color: #1e1b4b;
