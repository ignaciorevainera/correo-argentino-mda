---
// NewMonthModal.astro
import Modal from "@components/ui/Modal.astro";
import SelectField from "@components/ui/forms/SelectField.astro";
import ActionCancelButton from "@components/ui/ActionCancelButton.astro";
import ActionConfirmButton from "@components/ui/ActionConfirmButton.astro";
---

<Modal
  id="new-month-modal"
  title="Agregar Nuevo Mes"
  icon="boxicons:calendar-plus-filled"
  titleClass="font-black text-lg uppercase tracking-tight"
  zIndex="z-200"
  actionsFooter
>
  <Fragment slot="content">
    <div class="space-y-4">
      <SelectField
        id="new-month-year"
        name="new-month-year"
        label="Seleccionar Año"
        size="sm"
      >
        <!-- Opciones inyectadas por JS a partir de state.uniqueMonths -->
      </SelectField>
      <SelectField
        id="new-month-month"
        name="new-month-month"
        label="Seleccionar Mes"
        size="sm"
      >
        <option value="0">Enero</option>
        <option value="1">Febrero</option>
        <option value="2">Marzo</option>
        <option value="3">Abril</option>
        <option value="4">Mayo</option>
        <option value="5">Junio</option>
        <option value="6">Julio</option>
        <option value="7">Agosto</option>
        <option value="8">Septiembre</option>
        <option value="9">Octubre</option>
        <option value="10">Noviembre</option>
        <option value="11">Diciembre</option>
      </SelectField>
      <p
        id="new-month-hint"
        class="text-base-content/50 label-xxs hidden"
        role="status"
        aria-live="polite"
      >
      </p>
    </div>
  </Fragment>
  <Fragment slot="actions">
    <ActionCancelButton
      type="button"
      id="cancel-new-month"
      label="Cancelar"
      variant="error"
    />
    <ActionConfirmButton
      type="button"
      id="confirm-new-month"
      color="btn-secondary"
      label="Agregar Mes"
      icon="boxicons:check-filled"
    />
  </Fragment>
</Modal>

<script>
  import { createMonth } from "../lib/api";
  import { state } from "../lib/state";
  import { showToast } from "../lib/notifications";

  const modal = document.getElementById(
    "new-month-modal",
  ) as HTMLDialogElement | null;

  if (modal) {
    const yearSelect = document.getElementById(
      "new-month-year",
    ) as HTMLSelectElement | null;
    const monthSelect = document.getElementById(
      "new-month-month",
    ) as HTMLSelectElement | null;
    const hint = document.getElementById("new-month-hint");
    const cancelBtn = document.getElementById("cancel-new-month");
    const confirmBtn = document.getElementById(
      "confirm-new-month",
    ) as HTMLButtonElement | null;

    const MESES = [
      "Enero",
      "Febrero",
      "Marzo",
      "Abril",
      "Mayo",
      "Junio",
      "Julio",
      "Agosto",
      "Septiembre",
      "Octubre",
      "Noviembre",
      "Diciembre",
    ];

    function monthKey(year: number, month: number): string {
      return `${year}-${String(month + 1).padStart(2, "0")}`;
    }

    /** Años = los presentes en los datos + el año actual. */
    function availableYears(): number[] {
      const years = new Set<number>();
      const currentYear = new Date().getFullYear();
      years.add(currentYear);
      for (const ym of state.uniqueMonths) {
        const y = parseInt(ym.slice(0, 4), 10);
        if (Number.isInteger(y)) years.add(y);
      }
      return Array.from(years).sort((a, b) => a - b);
    }

    function syncMonthOptions(): void {
      if (!yearSelect || !monthSelect) return;
      const year = parseInt(yearSelect.value, 10);
      const existing = new Set(state.uniqueMonths);
      Array.from(monthSelect.options).forEach((opt, idx) => {
        const taken = existing.has(monthKey(year, idx));
        opt.disabled = taken;
        opt.textContent = taken ? `${MESES[idx]} (ya cargado)` : MESES[idx];
      });
      const firstFree = Array.from(monthSelect.options).findIndex(
        (o) => !o.disabled,
      );
      if (firstFree >= 0 && monthSelect.selectedOptions[0]?.disabled) {
        monthSelect.value = String(firstFree);
      }
      updateConfirmState();
    }

    function isExistingSelection(): boolean {
      if (!yearSelect || !monthSelect) return false;
      const year = parseInt(yearSelect.value, 10);
      const month = parseInt(monthSelect.value, 10);
      return state.uniqueMonths.includes(monthKey(year, month));
    }

    function updateConfirmState(): void {
      if (!confirmBtn || !hint) return;
      const exists = isExistingSelection();
      confirmBtn.disabled = exists;
      hint.classList.toggle("hidden", !exists);
      if (exists) {
        hint.textContent =
          "Ese mes ya está cargado. Elegí otro para evitar perder datos.";
      }
    }

    function resetForm(): void {
      if (!yearSelect || !monthSelect) return;
      const currentYear = new Date().getFullYear();
      yearSelect.value = String(currentYear);
      monthSelect.value = String(new Date().getMonth());
      syncMonthOptions();
    }

    function populate(): void {
      if (!yearSelect) return;
      const years = availableYears();
      yearSelect.innerHTML = years
        .map((y) => `<option value="${y}">${y}</option>`)
        .join("");
      resetForm();
    }

    // El <dialog> nativo NO emite "show"/"showModal"; sí "toggle" al abrir/cerrar.
    modal.addEventListener("toggle", () => {
      if (modal.open) populate();
    });

    yearSelect?.addEventListener("change", syncMonthOptions);
    monthSelect?.addEventListener("change", updateConfirmState);

    cancelBtn?.addEventListener("click", () => {
      resetForm();
      modal.close();
    });

    confirmBtn?.addEventListener("click", async (e) => {
      e.preventDefault();
      if (!yearSelect || !monthSelect) return;

      const year = parseInt(yearSelect.value, 10);
      const month = parseInt(monthSelect.value, 10);

      if (state.uniqueMonths.includes(monthKey(year, month))) {
        showToast(
          "El mes seleccionado ya existe en los registros. No se puede volver a crear para evitar pérdida de datos.",
          "error",
        );
        return;
      }
      confirmBtn.disabled = true;
      try {
        await createMonth(year, month);
        modal.close();
        document.dispatchEvent(
          new CustomEvent("cronograma:month-created", {
            detail: { year, month },
          }),
        );
      } catch (err: unknown) {
        const msg =
          err instanceof Error ? err.message : "Error al intentar crear el mes.";
        showToast(msg, "error");
      } finally {
        confirmBtn.disabled = false;
        updateConfirmState();
      }
    });
  }
</script>
