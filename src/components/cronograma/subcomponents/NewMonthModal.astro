---
// NewMonthModal.astro
import Modal from "@components/ui/Modal.astro";
import SelectField from "@components/ui/forms/SelectField.astro";
import ActionCancelButton from "@components/ui/ActionCancelButton.astro";
import ActionConfirmButton from "@components/ui/ActionConfirmButton.astro";

const MONTHS = [
  "Enero",
  "Febrero",
  "Marzo",
  "Abril",
  "Mayo",
  "Junio",
  "Julio",
  "Agosto",
  "Septiembre",
  "Octubre",
  "Noviembre",
  "Diciembre",
];
---

<Modal
  id="new-month-modal"
  title="Agregar Nuevo Mes"
  icon="boxicons:calendar-plus-filled"
  titleClass="font-black text-lg uppercase tracking-tight"
  zIndex="z-200"
  actionsFooter
>
  <Fragment slot="content">
    <div class="space-y-4">
      <SelectField
        id="new-month-year"
        name="new-month-year"
        label="Seleccionar Año"
        size="sm"
        selectClass="font-mono"
      >
        <option value="">—</option>
      </SelectField>
      <SelectField
        id="new-month-month"
        name="new-month-month"
        label="Seleccionar Mes"
        size="sm"
      >
        {MONTHS.map((label, i) => (
          <option value={String(i)} data-month={String(i)} data-label={label}>{label}</option>
        ))}
      </SelectField>
      <p class="text-base-content/60 text-xs">
        Este flujo solo crea meses nuevos. Los meses ya cargados aparecen
        deshabilitados: para regenerar uno existente, primero eliminálo desde
        el cronograma.
      </p>
    </div>
  </Fragment>
  <Fragment slot="actions">
    <ActionCancelButton
      type="button"
      id="cancel-new-month"
      label="Cancelar"
      variant="error"
    />
    <ActionConfirmButton
      type="button"
      id="confirm-new-month"
      color="btn-secondary"
      label="Agregar Mes"
      icon="boxicons:check-filled"
    />
  </Fragment>
</Modal>

<script>
  import { createMonth } from "../lib/api";
  import { state } from "../lib/state";
  import { showToast } from "../lib/notifications";

  const modal = document.getElementById(
    "new-month-modal",
  ) as HTMLDialogElement | null;

  if (modal) {
    const yearSelect = document.getElementById(
      "new-month-year",
    ) as HTMLSelectElement | null;
    const monthSelect = document.getElementById(
      "new-month-month",
    ) as HTMLSelectElement | null;
    const cancelBtn = document.getElementById("cancel-new-month");
    const confirmBtn = document.getElementById(
      "confirm-new-month",
    ) as HTMLButtonElement | null;

    const existingMonths = (): string[] => state.uniqueMonths;
    const monthKey = (year: number, monthIndex: number): string =>
      `${year}-${String(monthIndex + 1).padStart(2, "0")}`;

    // Años derivados de los datos: del menor al mayor cargado, más un año
    // extra hacia adelante para poder extender el cronograma.
    function yearList(): number[] {
      const years = new Set<number>();
      for (const ym of existingMonths()) {
        const y = parseInt(ym.slice(0, 4), 10);
        if (!Number.isNaN(y)) years.add(y);
      }
      if (years.size === 0) years.add(new Date().getFullYear());
      const min = Math.min(...years);
      const max = Math.max(...years);
      const list: number[] = [];
      for (let y = min; y <= max + 1; y++) list.push(y);
      return list;
    }

    function refreshMonths(): void {
      if (!yearSelect || !monthSelect) return;
      const year = parseInt(yearSelect.value, 10);
      const existing = new Set(existingMonths());
      let firstFree = -1;
      for (const opt of Array.from(monthSelect.options)) {
        const idx = parseInt(opt.dataset.month ?? opt.value, 10);
        const label = opt.dataset.label ?? opt.textContent ?? "";
        const isExisting =
          !Number.isNaN(year) && existing.has(monthKey(year, idx));
        opt.disabled = isExisting;
        opt.textContent = isExisting ? `${label} (ya cargado)` : label;
        if (!isExisting && firstFree === -1) firstFree = idx;
      }
      monthSelect.value = firstFree === -1 ? "" : String(firstFree);
      updateConfirmState();
    }

    function selectionExists(): boolean {
      if (!yearSelect || !monthSelect) return true;
      const year = parseInt(yearSelect.value, 10);
      const month = parseInt(monthSelect.value, 10);
      if (Number.isNaN(year) || Number.isNaN(month)) return true;
      return existingMonths().includes(monthKey(year, month));
    }

    function updateConfirmState(): void {
      if (confirmBtn) confirmBtn.disabled = selectionExists();
    }

    function populate(): void {
      if (!yearSelect || !monthSelect) return;
      const prev = yearSelect.value;
      const years = yearList();
      yearSelect.innerHTML = years
        .map((y) => `<option value="${y}">${y}</option>`)
        .join("");
      yearSelect.value =
        prev && years.includes(parseInt(prev, 10))
          ? prev
          : String(years[0]);
      refreshMonths();
    }

    yearSelect?.addEventListener("change", refreshMonths);
    monthSelect?.addEventListener("change", updateConfirmState);
    document
      .getElementById("add-month-btn")
      ?.addEventListener("click", populate);

    cancelBtn?.addEventListener("click", () => {
      populate();
      modal.close();
    });

    confirmBtn?.addEventListener("click", async (e) => {
      e.preventDefault();
      if (!yearSelect || !monthSelect) return;

      const year = parseInt(yearSelect.value, 10);
      const month = parseInt(monthSelect.value, 10);
      if (Number.isNaN(year) || Number.isNaN(month)) return;

      if (selectionExists()) {
        showToast(
          "El mes seleccionado ya existe en los registros. No se puede volver a crear para evitar pérdida de datos.",
          "error",
        );
        updateConfirmState();
        return;
      }

      confirmBtn.disabled = true;
      try {
        await createMonth(year, month);
        modal.close();
        document.dispatchEvent(
          new CustomEvent("cronograma:month-created", {
            detail: { year, month },
          }),
        );
      } catch (err: unknown) {
        console.error("Error creating month:", err);
        showToast(
          err instanceof Error
            ? err.message
            : "Error al intentar crear el mes.",
          "error",
        );
      } finally {
        updateConfirmState();
      }
    });

    populate();
  }
</script>
