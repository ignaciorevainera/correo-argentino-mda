---
// OperatorDrawer.astro
import { Icon } from "astro-icon/components";
import SelectField from "@components/ui/forms/SelectField.astro";
---

<!-- Operator Profile Modal -->
<div
  id="operator-drawer-overlay"
  class="bg-base-content/40 fixed inset-0 z-110 hidden items-center justify-center p-4 backdrop-blur-md transition-all duration-300"
>
  <div
    id="operator-drawer"
    class="bg-base-100 border-base-300 relative flex h-185 max-h-[90vh] w-full max-w-3xl scale-95 flex-col overflow-hidden rounded-4xl border opacity-0 shadow-2xl transition-all duration-300"
  >
    <!-- Header with Background Gradient -->
    <div
      class="border-base-200 from-base-200/50 relative shrink-0 overflow-hidden border-b bg-linear-to-br to-transparent p-8"
    >
      <div class="relative z-10 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <div
            class="bg-secondary/15 border-secondary/20 text-secondary flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl border shadow-md select-none"
          >
            <span
              id="drawer-op-avatar-initials"
              class="text-xl font-black tracking-wider"></span>
          </div>
          <div class="flex flex-col">
            <h2
              id="drawer-op-name"
              class="text-base-content text-2xl font-black tracking-tight uppercase"
            >
            </h2>
            <div class="mt-0.5 flex items-center gap-2">
              <span class="bg-success h-2 w-2 rounded-full"></span>
              <span
                id="drawer-op-email"
                class="text-base-content/50 text-xs font-bold lowercase"></span>
            </div>
          </div>
        </div>
        <button
          id="close-drawer"
          class="btn btn-ghost btn-circle hover:bg-base-300"
          type="button"
        >
          <Icon name="boxicons:x-filled" size={28} />
        </button>
      </div>
    </div>

    <!-- Tabs Header -->
    <div class="border-base-200 bg-base-50/50 flex shrink-0 border-b">
      <button
        type="button"
        id="tab-profile-btn"
        class="border-secondary text-secondary border-b-2 px-6 py-3 text-xs font-black tracking-wider uppercase transition-all"
      >
        Perfil e Historial
      </button>
      <button
        type="button"
        id="tab-weekly-btn"
        class="text-base-content/60 hover:text-base-content border-b-2 border-transparent px-6 py-3 text-xs font-black tracking-wider uppercase transition-all"
      >
        Esquema Semanal Base
      </button>
    </div>

    <!-- Content: Profile e Historial tab -->
    <div
      id="drawer-profile-tab-content"
      class="bg-base-50/10 flex min-h-0 flex-1 flex-col p-6 md:p-8"
    >
      <div
        class="grid min-h-0 flex-1 grid-cols-1 gap-6 overflow-y-auto md:h-full md:grid-cols-2 md:gap-8 md:overflow-y-hidden"
      >
        <!-- Stats & Notes Column -->
        <div
          class="scrollbar-thin flex min-h-0 flex-col space-y-6 pr-2 pb-2 pl-1 md:h-full md:overflow-y-auto"
        >
          <section class="shrink-0">
            <h3
              class="text-xxs text-base-content/40 mb-3 flex items-center gap-1.5 font-black tracking-[0.2em] uppercase"
            >
              <Icon
                name="boxicons:chart-line-filled"
                size={14}
                class="text-base-content/50"
              />
              Rendimiento Mensual
            </h3>
            <div class="grid grid-cols-2 gap-4">
              <!-- Home Office Card -->
              <div
                class="group relative flex flex-col items-center overflow-hidden rounded-2xl border border-amber-500/10 bg-amber-500/5 p-4 text-center dark:bg-amber-400/5"
              >
                <div
                  class="pointer-events-none absolute -right-2 -bottom-2 text-amber-500 opacity-5 transition-transform duration-300 group-hover:scale-110"
                >
                  <Icon name="boxicons:home-filled" size={64} />
                </div>
                <div
                  class="mb-2 flex h-8 w-8 items-center justify-center rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400"
                >
                  <Icon name="boxicons:home-filled" size={18} />
                </div>
                <span
                  class="text-3xl font-black text-amber-600 dark:text-amber-400"
                  id="drawer-stat-ho">0</span
                >
                <span
                  class="text-tiny mt-1 font-black tracking-widest text-amber-600/70 uppercase dark:text-amber-400/70"
                  >Home Office</span
                >
              </div>
              <!-- Presencial Card -->
              <div
                class="bg-secondary/5 border-secondary/10 group relative flex flex-col items-center overflow-hidden rounded-2xl border p-4 text-center"
              >
                <div
                  class="text-secondary pointer-events-none absolute -right-2 -bottom-2 opacity-5 transition-transform duration-300 group-hover:scale-110"
                >
                  <Icon name="boxicons:building-filled" size={64} />
                </div>
                <div
                  class="bg-secondary/10 text-secondary mb-2 flex h-8 w-8 items-center justify-center rounded-lg"
                >
                  <Icon name="boxicons:building-filled" size={18} />
                </div>
                <span
                  class="text-secondary text-3xl font-black"
                  id="drawer-stat-p">0</span
                >
                <span
                  class="text-tiny text-secondary/70 mt-1 font-black tracking-widest uppercase"
                  >Presencial</span
                >
              </div>
            </div>
          </section>

          <!-- Ubicación de Trabajo -->
          <section class="shrink-0">
            <div class="mb-2 flex items-center justify-between">
              <h3
                class="text-xxs text-base-content/40 flex items-center gap-1.5 font-black tracking-[0.2em] uppercase"
              >
                <Icon
                  name="boxicons:map-filled"
                  size={14}
                  class="text-base-content/50"
                />
                Ubicación de Trabajo
              </h3>
              <span
                id="location-status-indicator"
                class="text-micro text-success/70 font-black tracking-widest uppercase opacity-0 transition-opacity duration-300"
                >Guardado</span
              >
            </div>
            <div
              class="join bg-base-200/50 border-base-300/50 grid w-full grid-cols-2 rounded-2xl border p-1"
            >
              <button
                type="button"
                id="btn-location-mg"
                class="btn btn-sm text-xxs btn-ghost text-base-content/60 rounded-xl font-black tracking-wider uppercase transition-all duration-200"
              >
                Monte Grande
              </button>
              <button
                type="button"
                id="btn-location-pp"
                class="btn btn-sm text-xxs btn-ghost text-base-content/60 rounded-xl font-black tracking-wider uppercase transition-all duration-200"
              >
                Parque Patricios
              </button>
            </div>
            <select id="drawer-op-location" class="sr-only">
              <option value="Monte Grande">Monte Grande</option>
              <option value="Parque Patricios">Parque Patricios</option>
            </select>
          </section>

          <!-- Reglas Personalizadas -->
          <section class="border-base-300 shrink-0 border-t border-dashed pt-4">
            <div class="mb-2 flex items-center justify-between">
              <h3
                class="text-xxs text-base-content/40 flex items-center gap-1.5 font-black tracking-[0.2em] uppercase"
              >
                <Icon
                  name="boxicons:badge-check-filled"
                  size={14}
                  class="text-base-content/50"
                />
                Reglas de Control de Asistencia
              </h3>
              <span
                id="rules-status-indicator"
                class="text-micro text-success/70 font-black tracking-widest uppercase opacity-0 transition-opacity duration-300"
                >Guardado</span
              >
            </div>
            <div class="grid grid-cols-2 gap-4">
              <SelectField
                id="drawer-op-min-p-week"
                name="drawer-op-min-p-week"
                label="Mínimo Días Presenciales / Sem"
                size="xs"
              >
                <option value="">Por Defecto (Global)</option>
                <option value="0">Sin Mínimo (0)</option>
                <option value="1">1 día</option>
                <option value="2">2 días</option>
                <option value="3">3 días</option>
                <option value="4">4 días</option>
                <option value="5">5 días</option>
              </SelectField>

              <SelectField
                id="drawer-op-max-ho"
                name="drawer-op-max-ho"
                label="Límite HO Consecutivos"
                size="xs"
              >
                <option value="">Por Defecto (Global)</option>
                <option value="1">1 día</option>
                <option value="2">2 días</option>
                <option value="3">3 días</option>
                <option value="4">4 días</option>
                <option value="5">5 días</option>
                <option value="6">6 días</option>
                <option value="7">7 días</option>
                <option value="10">10 días</option>
              </SelectField>
            </div>
          </section>
        </div>

        <!-- History Column -->
        <section class="flex min-h-0 flex-col md:h-full">
          <h3
            class="text-xxs text-base-content/40 mb-4 flex shrink-0 items-center gap-1.5 font-black tracking-[0.2em] uppercase"
          >
            <Icon
              name="boxicons:history-filled"
              size={14}
              class="text-base-content/50"
            />
            Historial de Asistencia
          </h3>
          <div
            id="drawer-history-list"
            class="scrollbar-thin h-auto space-y-0 pr-1 pb-2 pl-1 md:flex-1 md:overflow-y-auto"
          >
            <!-- Items will be injected here -->
          </div>
        </section>
      </div>
    </div>

    <!-- Content: Weekly base template tab -->
    <div
      id="drawer-weekly-tab-content"
      class="scrollbar-thin bg-base-50/20 hidden min-h-0 flex-1 space-y-6 overflow-y-auto p-6 md:p-8"
    >
      <!-- Info note -->
      <div
        class="bg-info/5 text-base-content/80 flex gap-3 rounded-2xl border border-sky-600/10 p-4 text-xs"
      >
        <Icon
          name="boxicons:info-circle-filled"
          class="shrink-0 text-sky-600"
          size={18}
        />
        <div>
          <strong class="mb-0.5 block font-bold text-sky-700 dark:text-sky-500"
            >Acerca del Esquema Semanal Base</strong
          >
          Este esquema se repite automáticamente todas las semanas del año de forma
          dinámica. Las ediciones individuales del mes se guardarán como excepciones
          específicas en ese día puntual sin alterar este esquema.
        </div>
      </div>

      <!-- Template Select Panel -->
      <div
        class="bg-base-200/30 border-base-300/50 space-y-3 rounded-3xl border p-5"
      >
        <div class="flex items-center justify-between">
          <label
            class="text-xxs text-base-content/50 font-black tracking-widest uppercase"
            >Plantillas Reutilizables</label
          >
          <div class="flex gap-2">
            <button
              type="button"
              id="weekly-template-create-btn"
              class="btn btn-xs btn-outline border-base-300 text-tiny hover:bg-secondary/10 hover:text-secondary hover:border-secondary font-black uppercase transition-all"
            >
              Nueva Plantilla
            </button>
            <button
              type="button"
              id="weekly-template-duplicate-btn"
              class="btn btn-xs btn-outline border-base-300 text-tiny hover:bg-secondary/10 hover:text-secondary hover:border-secondary font-black uppercase transition-all"
            >
              Duplicar
            </button>
          </div>
        </div>

        <select
          id="weekly-template-select"
          class="select select-bordered select-sm bg-base-100 focus:border-secondary w-full rounded-xl text-xs font-bold focus:outline-none"
        >
          <!-- Loaded dynamically -->
        </select>

        <!-- Dynamic inputs for custom template names -->
        <div
          id="template-custom-actions"
          class="bg-base-100 border-base-200 mt-2 hidden items-center gap-2 rounded-xl border p-2.5"
        >
          <input
            type="text"
            id="new-template-name"
            placeholder="Nombre de la plantilla..."
            class="input input-xs input-bordered focus:border-secondary bg-base-100 flex-1 rounded-lg text-xs font-bold focus:outline-none"
          />
          <button
            type="button"
            id="new-template-save-btn"
            class="btn btn-xs btn-secondary text-tiny rounded-lg font-black uppercase"
            >Guardar</button
          >
          <button
            type="button"
            id="new-template-delete-btn"
            class="btn btn-xs btn-error btn-outline text-tiny rounded-lg font-black uppercase"
            >Eliminar</button
          >
        </div>
      </div>

      <!-- Weekly Grid Days Editor -->
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <h3
            class="text-xxs text-base-content/40 font-black tracking-[0.2em] uppercase"
          >
            Días de la Semana
          </h3>
          <button
            type="button"
            id="weekly-clear-btn"
            class="btn btn-xs btn-ghost text-error hover:bg-error/10 text-tiny gap-1 rounded-lg font-black tracking-wider uppercase transition-all"
          >
            <Icon name="boxicons:trash-filled" size={13} />
            Limpiar Todo
          </button>
        </div>

        <div id="weekly-days-list" class="space-y-2">
          <!-- Populated dynamically via JS: Lunes to Domingo rows -->
        </div>
      </div>

      <!-- Save Buttons -->
      <div class="border-base-200 space-y-3 border-t pt-4">
        <div class="flex items-center justify-between">
          <label
            class="text-xxs text-base-content/50 font-black tracking-wider uppercase"
            >Aplicar Esquema al Mes Activo</label
          >
          <span
            class="badge badge-secondary badge-outline text-micro font-black tracking-wider uppercase"
            >Edición Rápida</span
          >
        </div>

        <div
          class="bg-base-200/40 border-base-300/60 space-y-2.5 rounded-2xl border p-3"
        >
          <!-- Primary CTA: Apply everything -->
          <button
            type="button"
            id="apply-weekly-all-btn"
            class="btn btn-sm btn-secondary text-xxs shadow-secondary/15 h-10 w-full gap-2 rounded-xl font-black tracking-wider uppercase shadow-lg transition-all duration-200 hover:brightness-105 active:scale-[0.98]"
          >
            <Icon name="boxicons:calendar-check-filled" size={15} />
            Aplicar Esquema Completo
          </button>

          <div class="relative flex items-center py-1">
            <div class="border-base-300/50 grow border-t"></div>
            <span
              class="text-micro text-base-content/30 mx-3 shrink font-black tracking-widest uppercase"
              >O aplicar parcial</span
            >
            <div class="border-base-300/50 grow border-t"></div>
          </div>

          <!-- Secondary Actions Side-by-Side -->
          <div class="grid grid-cols-2 gap-2">
            <button
              type="button"
              id="apply-weekly-days-btn"
              class="btn btn-xs btn-outline border-base-300 hover:border-secondary hover:bg-secondary/5 hover:text-secondary text-tiny h-9 gap-1.5 rounded-lg font-bold tracking-wider uppercase"
            >
              <Icon name="boxicons:calendar-filled" size={13} />
              Solo Días
            </button>
            <button
              type="button"
              id="apply-weekly-hours-btn"
              class="btn btn-xs btn-outline border-base-300 hover:border-secondary hover:bg-secondary/5 hover:text-secondary text-tiny h-9 gap-1.5 rounded-lg font-bold tracking-wider uppercase"
            >
              <Icon name="boxicons:timer-filled" size={13} />
              Solo Horas
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div
      class="border-base-200 bg-base-200/30 flex justify-end gap-3 rounded-b-4xl border-t p-6"
    >
      <button
        type="button"
        id="drawer-footer-close-btn"
        class="btn btn-ghost text-xs font-black uppercase">Cerrar</button
      >
      <button
        type="button"
        id="download-op-report-btn"
        class="btn btn-secondary shadow-secondary/20 rounded-xl px-8 text-xs font-black tracking-widest uppercase shadow-lg"
        disabled
        title="Próximamente">Descargar Reporte</button
      >
    </div>
  </div>
</div>

<script>
  import {
    openDrawer,
    closeDrawer,
    saveDrawerLocation,
    saveDrawerOperatorRules,
  } from "../lib/drawer";
  import { saveEdits } from "../lib/api";
  import { state } from "../lib/state";
  import { formatTimeInput } from "../lib/utils";
  import {
    handleTemplateSelectChange,
    handleCreateTemplateClick,
    handleSaveTemplateClick,
    handleDeleteTemplateClick,
    handleDuplicateTemplateClick,
    handleWeeklyInput,
    handleWeeklyFocusOut,
    handleWeeklyDayOptionClick,
    saveWeeklySchedule,
    populateWeeklyTemplatesDropdown,
    renderWeeklyDaysList,
    clearWeeklySchedule,
  } from "../lib/weekly-schedule";

  // Modal open trigger listener
  document.addEventListener("cronograma:open-drawer", (e: any) => {
    if (e.detail && e.detail.operatorName) {
      openDrawer(e.detail.operatorName);
    }
  });

  // Tab switching
  const tabProfileBtn = document.getElementById("tab-profile-btn");
  const tabWeeklyBtn = document.getElementById("tab-weekly-btn");
  const drawerProfileTabContent = document.getElementById(
    "drawer-profile-tab-content",
  );
  const drawerWeeklyTabContent = document.getElementById(
    "drawer-weekly-tab-content",
  );
  const closeDrawerBtn = document.getElementById("close-drawer");
  const drawerFooterCloseBtn = document.getElementById(
    "drawer-footer-close-btn",
  );

  closeDrawerBtn?.addEventListener("click", closeDrawer);
  drawerFooterCloseBtn?.addEventListener("click", closeDrawer);

  tabProfileBtn?.addEventListener("click", () => {
    if (
      tabProfileBtn &&
      tabWeeklyBtn &&
      drawerProfileTabContent &&
      drawerWeeklyTabContent
    ) {
      tabProfileBtn.className =
        "px-6 py-3 text-xs font-black uppercase tracking-wider border-b-2 border-secondary text-secondary transition-all";
      tabWeeklyBtn.className =
        "px-6 py-3 text-xs font-black uppercase tracking-wider border-b-2 border-transparent text-base-content/60 hover:text-base-content transition-all";
      drawerProfileTabContent.classList.remove("hidden");
      drawerWeeklyTabContent.classList.add("hidden");
    }
  });

  tabWeeklyBtn?.addEventListener("click", () => {
    if (
      tabProfileBtn &&
      tabWeeklyBtn &&
      drawerProfileTabContent &&
      drawerWeeklyTabContent
    ) {
      tabWeeklyBtn.className =
        "px-6 py-3 text-xs font-black uppercase tracking-wider border-b-2 border-secondary text-secondary transition-all";
      tabProfileBtn.className =
        "px-6 py-3 text-xs font-black uppercase tracking-wider border-b-2 border-transparent text-base-content/60 hover:text-base-content transition-all";
      drawerProfileTabContent.classList.add("hidden");
      drawerWeeklyTabContent.classList.remove("hidden");

      // Populate and render
      populateWeeklyTemplatesDropdown();
      renderWeeklyDaysList();
    }
  });

  // Location selector buttons
  const mgBtn = document.getElementById("btn-location-mg");
  const ppBtn = document.getElementById("btn-location-pp");
  const locSelect = document.getElementById(
    "drawer-op-location",
  ) as HTMLSelectElement | null;

  mgBtn?.addEventListener("click", () => {
    if (locSelect) {
      locSelect.value = "Monte Grande";
      saveDrawerLocation("Monte Grande");
    }
  });

  ppBtn?.addEventListener("click", () => {
    if (locSelect) {
      locSelect.value = "Parque Patricios";
      saveDrawerLocation("Parque Patricios");
    }
  });

  // Attendance Rules select change auto-save
  const opMinPWeekSelect = document.getElementById(
    "drawer-op-min-p-week",
  ) as HTMLSelectElement | null;
  const opMaxHoSelect = document.getElementById(
    "drawer-op-max-ho",
  ) as HTMLSelectElement | null;

  opMinPWeekSelect?.addEventListener("change", () =>
    saveDrawerOperatorRules(opMinPWeekSelect, opMaxHoSelect),
  );
  opMaxHoSelect?.addEventListener("change", () =>
    saveDrawerOperatorRules(opMinPWeekSelect, opMaxHoSelect),
  );

  // Weekly base schedule tab template management handlers
  const weeklyTemplateSelect = document.getElementById(
    "weekly-template-select",
  );
  weeklyTemplateSelect?.addEventListener("change", (e) => {
    const target = e.target as HTMLSelectElement;
    handleTemplateSelectChange(target.value);
  });

  document
    .getElementById("weekly-template-create-btn")
    ?.addEventListener("click", handleCreateTemplateClick);
  document
    .getElementById("new-template-save-btn")
    ?.addEventListener("click", handleSaveTemplateClick);
  document
    .getElementById("new-template-delete-btn")
    ?.addEventListener("click", handleDeleteTemplateClick);
  document
    .getElementById("weekly-template-duplicate-btn")
    ?.addEventListener("click", handleDuplicateTemplateClick);
  document
    .getElementById("weekly-clear-btn")
    ?.addEventListener("click", clearWeeklySchedule);

  const weeklyDaysList = document.getElementById("weekly-days-list");

  weeklyDaysList?.addEventListener("input", (e) => {
    handleWeeklyInput(e.target as HTMLInputElement);
  });

  weeklyDaysList?.addEventListener("focusout", (e) => {
    handleWeeklyFocusOut(e.target as HTMLInputElement);
  });

  weeklyDaysList?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
      "[data-weekly-option]",
    );
    if (btn) {
      handleWeeklyDayOptionClick(btn);
    }
  });

  const bindWeeklyApplyButton = (
    id: string,
    mode: "all" | "days" | "hours",
  ) => {
    document.getElementById(id)?.addEventListener("click", () => {
      const opName = document
        .getElementById("drawer-op-name")
        ?.textContent?.trim();
      if (opName) {
        const btn = document.getElementById(id) as HTMLButtonElement | null;
        saveWeeklySchedule(opName, btn, mode);
      }
    });
  };

  bindWeeklyApplyButton("apply-weekly-all-btn", "all");
  bindWeeklyApplyButton("apply-weekly-days-btn", "days");
  bindWeeklyApplyButton("apply-weekly-hours-btn", "hours");
</script>
