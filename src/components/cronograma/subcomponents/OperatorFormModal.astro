---
// OperatorFormModal.astro
import Modal from "@components/ui/Modal.astro";
import FormField from "@components/ui/forms/FormField.astro";
import SelectField from "@components/ui/forms/SelectField.astro";
import ActionCancelButton from "@components/ui/ActionCancelButton.astro";
import ActionConfirmButton from "@components/ui/ActionConfirmButton.astro";

const dialogId = "edit-operator-modal";
const titleIcon = "boxicons:edit-alt-filled";
const titleText = "Editar Operador";
const confirmBtnId = "confirm-edit-op";
const cancelBtnId = "cancel-edit-op";
const nameInputId = "edit-op-name";
const locationSelectId = "edit-op-location";
const confirmBtnText = "Guardar Cambios";
---

<Modal
  id={dialogId}
  title={titleText}
  icon={titleIcon}
  titleClass="font-black text-lg uppercase tracking-tight"
  zIndex="z-[200]"
  class="max-w-md"
>
  <Fragment slot="content">
    <input type="hidden" id="edit-op-original-name" />
    <div class="space-y-4">
      <FormField
        id={nameInputId}
        name={nameInputId}
        label="Nombre Completo"
        placeholder="Ej: Juan Pérez"
        size="sm"
      />
      <SelectField
        id={locationSelectId}
        name={locationSelectId}
        label="Sede Principal"
        size="sm"
      >
        <option value="Monte Grande">Monte Grande</option>
        <option value="Parque Patricios">Parque Patricios</option>
      </SelectField>
    </div>
  </Fragment>
  <Fragment slot="actions">
    <div class="modal-action mt-6 flex justify-end gap-2">
      <ActionCancelButton
        type="button"
        id={cancelBtnId}
        label="Cancelar"
        icon="boxicons:x-filled"
        variant="error"
      />
      <ActionConfirmButton
        type="button"
        id={confirmBtnId}
        color="btn-secondary"
        label={confirmBtnText}
        icon="boxicons:check-filled"
      />
    </div>
  </Fragment>
</Modal>

<script>
  import { editOperator } from "../lib/api";
  import { showToast } from "../lib/notifications";

  // --- EDIT OPERATOR LOGIC ---
  const editModal = document.getElementById(
    "edit-operator-modal",
  ) as HTMLDialogElement | null;
  if (editModal) {
    const originalNameInput = document.getElementById(
      "edit-op-original-name",
    ) as HTMLInputElement | null;
    const nameInput = document.getElementById(
      "edit-op-name",
    ) as HTMLInputElement | null;
    const locationSelect = document.getElementById(
      "edit-op-location",
    ) as HTMLSelectElement | null;
    const confirmBtn = document.getElementById(
      "confirm-edit-op",
    ) as HTMLButtonElement | null;
    const cancelBtn = document.getElementById(
      "cancel-edit-op",
    ) as HTMLButtonElement | null;

    cancelBtn?.addEventListener("click", () => {
      editModal.close();
    });

    confirmBtn?.addEventListener("click", async () => {
      const originalName = originalNameInput?.value?.trim();
      const name = nameInput?.value?.trim();
      const location = locationSelect?.value || "Monte Grande";
      const horarioDefault = "";

      if (!name || !originalName) {
        showToast("El nombre completo es requerido.", "warning");
        return;
      }

      confirmBtn.disabled = true;
      try {
        await editOperator({
          originalName,
          name,
          location,
          horarioDefault,
        });
        editModal.close();
        document.dispatchEvent(new CustomEvent("cronograma:data-changed"));
      } catch (err: unknown) {
        console.error("Error editing operator:", err);
        const msg =
          err instanceof Error
            ? err.message
            : "Error al intentar modificar operador.";
        showToast(msg, "error");
      } finally {
        confirmBtn.disabled = false;
      }
    });
  }
</script>
