---
import { Icon } from "astro-icon/components";

interface Props {
  letter: string;
  color: "success" | "error" | "warning" | "info";
  count?: number;
}

const { letter, color, count = 0 } = Astro.props;
const id = `group-${letter}`;
---

<div class="card bg-base-200/20 card-border shadow-sm">
  <div class="card-body space-y-4 p-4">
    <div
      class="border-base-300 flex items-center justify-between border-b pb-2"
    >
      <h3
        class="text-base-content flex items-center gap-2 text-sm font-bold tracking-wider uppercase"
      >
        <span
          class:list={[
            "flex h-6 w-6 items-center justify-center rounded-lg text-xs font-bold",
            `bg-${color}`,
            `text-${color}-content`,
          ]}
        >
          {letter}
        </span>
        Grupo {letter}
      </h3>
      <div class="flex items-center gap-1.5">
        <label
          class="flex cursor-pointer items-center"
          title="Habilitar/Deshabilitar grupo"
        >
          <input
            type="checkbox"
            data-group-toggle={letter}
            class="toggle toggle-xs toggle-secondary"
            checked
          />
        </label>
        <span
          class="badge badge-sm badge-ghost hidden font-mono text-xs font-bold tracking-tight"
          id={`${id}-next-date`}></span>
        <span class="badge badge-sm badge-neutral font-bold" id={`${id}-count`}
          >{count} ops</span
        >
      </div>
    </div>
    <div class="max-h-87.5 space-y-2 overflow-y-auto pr-1" id={`${id}-list`}>
    </div>
    <div
      class="border-base-300 add-member-container flex flex-col gap-1.5 border-t pt-3"
    >
      <label class="label-xxs text-base-content/40">Agregar Operador</label>
      <select
        class="select select-xs select-bordered add-member-select w-full font-bold"
        data-group={letter}
        id={`add-member-select-${letter}`}
      >
        <option value="" disabled selected>Seleccionar...</option>
      </select>
    </div>
  </div>
</div>
