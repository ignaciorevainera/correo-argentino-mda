---
// CronogramaDashboard.astro
import { Icon } from "astro-icon/components";
import ActionButton from "@components/ui/ActionButton.astro";
import FilterButtonBar from "@components/ui/FilterButtonBar.astro";
import SortDropdown from "@components/ui/SortDropdown.astro";
import SearchBar from "@components/ui/SearchBar.astro";
import MonthSelect from "@components/ui/MonthSelect.astro";

import OperatorDrawer from "./subcomponents/OperatorDrawer.astro";
import MonthlyDetailModal from "./subcomponents/MonthlyDetailModal.astro";
import RulesSettingsModal from "./subcomponents/RulesSettingsModal.astro";
import NewMonthModal from "./subcomponents/NewMonthModal.astro";
import OperatorFormModal from "./subcomponents/OperatorFormModal.astro";
import HolidaysModal from "./subcomponents/HolidaysModal.astro";
import GroupCard from "./subcomponents/GroupCard.astro";
import CronoCardHeader from "./subcomponents/CronoCardHeader.astro";
import CronoDatePicker from "./subcomponents/CronoDatePicker.astro";
import { STATUS_FILTER_OPTIONS } from "./lib/filters";

interface Props {
  userRole?: string;
  currentUser?: { id?: number; username?: string; role?: string };
}

const { userRole = "agent", currentUser = Astro.locals.user } = Astro.props;
const currentUsername = currentUser?.username
  ? currentUser.username.toLowerCase()
  : "";
const currentUserId = currentUser?.id ? String(currentUser.id) : "";
---

<div
  id="cronograma-app-container"
  data-user-role={userRole}
  data-current-username={currentUsername}
  data-current-user-id={currentUserId}
  class="flex min-h-0 w-full flex-1 flex-col"
>
  <div
    id="cronograma-container"
    class="animate-in fade-in scrollbar-thin flex min-h-0 w-full flex-1 flex-col overflow-y-auto pb-2 duration-500"
  >
    <div class="flex min-h-0 w-full flex-1 flex-col">
      <div
        class="bg-base-100/95 sticky top-0 z-40 flex shrink-0 flex-col justify-between pb-4 backdrop-blur-sm md:flex-row md:items-center"
      >
        <div
          id="view-switcher"
          class="flex shrink-0 flex-wrap items-center gap-3"
        >
          <!-- Vistas de Calendario -->
          <div
            class="bg-base-200/60 border-base-300 flex shrink-0 rounded-xl border p-1 shadow-sm"
          >
            <button
              type="button"
              id="switch-to-monthly-btn"
              class="btn btn-xs btn-secondary text-tiny shadow-secondary/15 h-7 rounded-lg px-3.5 font-black tracking-widest uppercase shadow-sm transition-all duration-200"
            >
              Mensual
            </button>
            <button
              type="button"
              id="switch-to-daily-btn"
              class="btn btn-xs btn-outline text-base-content/60 hover:bg-base-200/50 text-tiny h-7 rounded-lg border-transparent px-3.5 font-black tracking-widest uppercase"
            >
              Diario
            </button>
          </div>

          <!-- Vistas de Configuración y Turnos -->
          <div
            class="bg-base-200/60 border-base-300 flex shrink-0 rounded-xl border p-1 shadow-sm"
          >
            <button
              type="button"
              id="switch-to-groups-btn"
              class="btn btn-xs btn-outline text-base-content/60 hover:bg-base-200/50 text-tiny h-7 rounded-lg border-transparent px-3.5 font-black tracking-widest uppercase"
            >
              Grupos
            </button>
            <button
              type="button"
              id="switch-to-overtime-btn"
              class="btn btn-xs btn-outline text-base-content/60 hover:bg-base-200/50 text-tiny h-7 rounded-lg border-transparent px-3.5 font-black tracking-widest uppercase"
            >
              Extras
            </button>
            <button
              type="button"
              id="switch-to-pasiva-btn"
              class="btn btn-xs btn-outline text-base-content/60 hover:bg-base-200/50 text-tiny h-7 rounded-lg border-transparent px-3.5 font-black tracking-widest uppercase"
            >
              Pasivas
            </button>
          </div>
        </div>

        <CronoDatePicker
          id="date-picker-container"
          displayId="date-input-display"
          inputId="date-input"
          variant="top"
          minW="min-w-40"
          class="hidden"
        />
      </div>

      <!-- Daily View Section (Hidden by default) -->
      <div id="daily-view" class="hidden min-h-0 flex-1">
        <div
          class="bg-base-100 border-base-300 flex h-full flex-col overflow-hidden rounded-2xl border shadow-md"
        >
          <div class="bg-base-200 border-base-300 relative z-60 border-b">
            <div
              class="flex flex-col justify-between gap-3 px-6 py-3 lg:flex-row lg:items-center"
            >
              <!-- Center: Search & Sort inputs -->
              <div class="mx-0 flex w-full max-w-xs flex-1 gap-2 lg:mx-4">
                <SearchBar id="daily-search" class="min-w-48 flex-1" />
                <SortDropdown id="daily-sort" current="alphabetical" />
              </div>

              <!-- Right: Date Display & Maximize button -->
              <div
                class="flex shrink-0 flex-wrap items-center justify-start gap-2.5 lg:justify-end"
              >
                <div
                  class="bg-base-100 border-base-300 text-base-content/75 flex h-7 items-center gap-2 rounded-lg border px-3.5 py-1 shadow-sm"
                >
                  <Icon
                    name="boxicons:calendar-check-filled"
                    size={16}
                    class="text-secondary"
                  />
                  <span
                    class="text-xs font-semibold tabular-nums"
                    id="daily-date-display"></span>
                </div>

                <!-- Maximize Button Removed -->
              </div>
            </div>
          </div>
          <div class="flex min-h-0 flex-1 flex-col p-1.5">
            <div
              class="scrollbar-thin border-base-200 bg-base-100 min-h-0 flex-1 overflow-x-auto overflow-y-auto rounded-xl border"
            >
              <!-- Simplified container skeleton -- removed by renderDaily() on first call -->
              <div
                id="daily-view-skeleton"
                class="skeleton-debounced flex flex-col gap-2 p-4"
              >
                <div class="flex items-center gap-3">
                  <div class="skeleton h-10 w-10 shrink-0 rounded-full"></div>
                  <div class="flex flex-1 flex-col gap-1.5">
                    <div class="skeleton h-3.5 w-28 rounded"></div>
                    <div class="skeleton h-2.5 w-16 rounded opacity-60"></div>
                  </div>
                </div>
                <div class="flex items-center gap-3 opacity-70">
                  <div class="skeleton h-10 w-10 shrink-0 rounded-full"></div>
                  <div class="flex flex-1 flex-col gap-1.5">
                    <div class="skeleton h-3.5 w-32 rounded"></div>
                    <div class="skeleton h-2.5 w-20 rounded opacity-60"></div>
                  </div>
                </div>
                <div class="flex items-center gap-3 opacity-50">
                  <div class="skeleton h-10 w-10 shrink-0 rounded-full"></div>
                  <div class="flex flex-1 flex-col gap-1.5">
                    <div class="skeleton h-3.5 w-28 rounded"></div>
                    <div class="skeleton h-2.5 w-18 rounded opacity-60"></div>
                  </div>
                </div>
                <div class="flex items-center gap-3 opacity-70">
                  <div class="skeleton h-10 w-10 shrink-0 rounded-full"></div>
                  <div class="flex flex-1 flex-col gap-1.5">
                    <div class="skeleton h-3.5 w-32 rounded"></div>
                    <div class="skeleton h-2.5 w-16 rounded opacity-60"></div>
                  </div>
                </div>
                <div class="flex items-center gap-3 opacity-50">
                  <div class="skeleton h-10 w-10 shrink-0 rounded-full"></div>
                  <div class="flex flex-1 flex-col gap-1.5">
                    <div class="skeleton h-3.5 w-28 rounded"></div>
                    <div class="skeleton h-2.5 w-20 rounded opacity-60"></div>
                  </div>
                </div>
              </div>
              <table
                class="w-full border-separate border-spacing-0 text-left text-sm"
              >
                <thead
                  class="bg-base-100/98 text-base-content/50 border-base-300 sticky top-0 z-50 border-b text-xs font-bold tracking-widest uppercase shadow-sm backdrop-blur-sm"
                >
                  <tr>
                    <th
                      class="bg-base-100 border-base-200/70 sticky left-0 z-50 w-64 min-w-[16rem] border-r border-b px-6 py-3"
                      >Operador</th
                    >
                    <th
                      class="bg-base-100 border-base-200/70 sticky left-64 z-50 w-44 min-w-44 border-r border-b px-4 py-3 shadow-[4px_0_10px_-5px_rgba(0,0,0,0.1)]"
                      >Modalidad</th
                    >
                    <th class="border-base-200/70 border-b px-6 py-3">
                      <div
                        class="text-xxs text-base-content/40 flex w-full justify-between px-2 font-black select-none"
                      >
                        <span>00:00</span>
                        <span>02:00</span>
                        <span>04:00</span>
                        <span>06:00</span>
                        <span>08:00</span>
                        <span>10:00</span>
                        <span>12:00</span>
                        <span>14:00</span>
                        <span>16:00</span>
                        <span>18:00</span>
                        <span>20:00</span>
                        <span>22:00</span>
                        <span>24:00</span>
                      </div>
                    </th>
                  </tr>
                </thead>
                <tbody
                  id="operators-table-body"
                  class="divide-base-200 bg-base-100 divide-y"
                >
                </tbody>
              </table>
            </div>
          </div>
          <!-- Daily View Footer / Status Filters -->
          <div
            class="bg-base-200/40 border-base-300 no-print flex shrink-0 flex-col items-start justify-between gap-3 border-t px-6 py-3 lg:min-h-16 lg:flex-row lg:items-center"
          >
            <div class="flex flex-wrap items-center gap-4">
              <!-- Status Filters -->
              <FilterButtonBar
                id="filter-daily-status"
                options={STATUS_FILTER_OPTIONS}
                prefix="Estado:"
                allLabel="Todos"
                attribute="data-filter"
                showDots
              />

              <!-- Location Filters -->
              <FilterButtonBar
                id="filter-daily-location"
                options={[
                  { value: "Monte Grande", label: "MG" },
                  { value: "Parque Patricios", label: "PP" },
                ]}
                prefix="Sede:"
                allLabel="Todas"
                attribute="data-location"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Monthly View Section (Shown by default) -->
      <div id="monthly-view" class="min-h-0 flex-1">
        <div
          class="bg-base-100 border-base-300 flex h-full flex-col overflow-hidden rounded-2xl border shadow-md"
        >
          <div
            class="bg-base-200 border-base-300 relative z-60 shrink-0 border-b"
          >
            <div
              class="flex flex-col justify-between gap-3 px-6 py-3 lg:flex-row lg:items-center"
            >
              <!-- Left: Title, Navigation & Maximize button -->
              <div class="flex shrink-0 flex-wrap items-center gap-3">
                <!-- Month Navigator -->
                <div class="ml-2 flex items-center gap-1">
                  <button
                    type="button"
                    id="prev-month-btn"
                    class="btn btn-xs btn-ghost p-1"
                    title="Mes anterior"
                    aria-label="Mes anterior"
                  >
                    <Icon name="boxicons:chevron-left-filled" size={14} />
                  </button>
                  <MonthSelect id="month-selector" />
                  <button
                    type="button"
                    id="next-month-btn"
                    class="btn btn-xs btn-ghost p-1"
                    title="Mes siguiente"
                    aria-label="Mes siguiente"
                  >
                    <Icon name="boxicons:chevron-right-filled" size={14} />
                  </button>
                </div>

                <!-- Agregar nuevo mes -->
                <ActionButton
                  id="add-month-btn"
                  icon="boxicons:calendar-plus-filled"
                  label="Agregar nuevo mes"
                  title="Agregar nuevo mes"
                  size="md"
                  iconSize={18}
                  class="ml-2 [&_span]:hidden xl:[&_span]:inline"
                />

                <!-- Borrar mes actual -->
                <ActionButton
                  id="delete-month-btn"
                  icon="boxicons:calendar-minus-filled"
                  label="Borrar mes actual"
                  title="Borrar mes actual"
                  color="btn-error"
                  size="md"
                  iconSize={18}
                  class="ml-2 [&_span]:hidden xl:[&_span]:inline"
                />
              </div>

              <!-- Center: Search & Sort inputs -->
              <div class="mx-0 flex w-full max-w-md flex-1 gap-2 lg:mx-4">
                <SearchBar id="monthly-search" class="min-w-48 flex-1" />
                <SortDropdown id="monthly-sort" current="alphabetical" />
              </div>

              <div
                class="flex shrink-0 flex-wrap items-center justify-start gap-2.5 lg:justify-end"
              >
                <!-- Edit Mode Button -->
                <ActionButton
                  id="toggle-edit-mode-btn"
                  icon="boxicons:edit-alt-filled"
                  label="Editar"
                  labelId="edit-mode-text"
                  title="Modo Edición"
                  size="md"
                  iconSize={18}
                />

                <!-- Maximize Button Removed -->
              </div>
            </div>
          </div>
          <div class="flex min-h-0 flex-1 flex-col p-1.5">
            <div
              id="monthly-scroll-area"
              class="scrollbar-thin border-base-200 bg-base-100 min-h-0 flex-1 overflow-x-auto overflow-y-auto rounded-xl border"
            >
              <!-- Simplified container skeleton -- removed by renderMonthly() on first call -->
              <div
                id="monthly-view-skeleton"
                class="skeleton-debounced flex flex-col gap-2 p-4"
              >
                <div class="skeleton h-8 w-full rounded-lg"></div>
                <div class="skeleton h-12 w-full rounded-lg opacity-70"></div>
                <div class="skeleton h-12 w-full rounded-lg opacity-50"></div>
                <div class="skeleton h-12 w-full rounded-lg opacity-70"></div>
                <div class="skeleton h-12 w-full rounded-lg opacity-50"></div>
                <div class="skeleton h-12 w-full rounded-lg opacity-70"></div>
                <div class="skeleton h-12 w-full rounded-lg opacity-50"></div>
              </div>
              <table
                class="w-full border-separate border-spacing-0 text-left text-sm"
                id="monthly-table"
              >
                <thead class="bg-base-100" id="monthly-thead"> </thead>
                <tbody id="monthly-tbody"> </tbody>
                <!-- Invisible filler: JS sizes it so the coverage summary
                     (tfoot) stays pinned to the bottom when there are few
                     rows, without stretching data rows. -->
                <tbody id="monthly-filler-row" aria-hidden="true">
                  <tr>
                    <td class="border-0 p-0"></td>
                  </tr>
                </tbody>
                <tfoot
                  id="monthly-tfoot"
                  class="bg-base-100/95 border-base-300 sticky bottom-0 z-40 border-t-2 backdrop-blur-sm"
                >
                  <!-- Coverage stats injected here -->
                </tfoot>
              </table>
            </div>
          </div>
          <div
            class="bg-base-200/40 border-base-300 no-print flex shrink-0 flex-col items-stretch justify-between gap-3 border-t px-6 py-3 lg:min-h-16 lg:flex-row lg:items-center"
          >
            <div class="flex flex-wrap items-center gap-4">
              <!-- Status Filters Container -->
              <FilterButtonBar
                id="filter-monthly-status"
                options={STATUS_FILTER_OPTIONS}
                prefix="Estado:"
                allLabel="Todos"
                attribute="data-filter"
                showDots
              />

              <!-- Location Filters Container -->
              <FilterButtonBar
                id="filter-monthly-location"
                options={[
                  { value: "Monte Grande", label: "MG" },
                  { value: "Parque Patricios", label: "PP" },
                ]}
                prefix="Sede:"
                allLabel="Todas"
                attribute="data-location"
              />
            </div>
            <div
              class="flex shrink-0 flex-wrap justify-start gap-2 lg:justify-end"
            >
              <div class="relative">
                <input
                  type="file"
                  id="import-csv-input"
                  accept=".csv"
                  class="hidden"
                />
                <ActionButton
                  id="import-csv-btn"
                  icon="boxicons:folder-up-arrow-filled"
                  label="Importar CSV"
                  shortLabel="I.CSV"
                  title="Importar CSV"
                  size="md"
                  iconSize={18}
                />
              </div>
              <ActionButton
                id="export-csv-btn"
                icon="boxicons:file-filled"
                label="Exportar CSV"
                shortLabel="E.CSV"
                title="Exportar CSV"
                size="md"
                iconSize={18}
              />
              <ActionButton
                id="export-image-btn"
                icon="boxicons:image-filled"
                label="Exportar Imagen (PNG)"
                shortLabel="PNG"
                title="Exportar Imagen (PNG)"
                size="md"
                iconSize={18}
                color="btn-success"
              />
            </div>
          </div>
        </div>
      </div>

      <div id="groups-view" class="hidden">
        <div
          class="bg-base-100 border-base-300 space-y-6 rounded-2xl border p-6 shadow-md"
        >
          <CronoCardHeader
            icon="boxicons:group-filled"
            title="Configuración de Grupos"
            subtitle="Establece la rotación y horarios de sábados aplicados únicamente al mes seleccionado."
          >
            <MonthSelect id="groups-month-selector" class="shrink-0" />
          </CronoCardHeader>
          <!-- Configuration form -->
          <div
            id="rotation-config-card"
            class="bg-base-200/50 border-base-300/60 flex flex-col justify-between gap-4 rounded-xl border p-4 shadow-sm lg:flex-row lg:items-end"
          >
            <form
              id="rotation-config-form"
              class="flex w-full flex-col gap-4 md:flex-row md:items-end"
            >
              <div class="flex shrink-0 flex-col gap-1.5">
                <label class="label-xxs text-base-content/40"
                  >Fecha de Inicio (Sábado)</label
                >
                <CronoDatePicker
                  id="rotation-start-date-wrapper"
                  displayId="rotation-start-date-display"
                  inputId="rotation-start-date"
                  placeholder="dd/mm/yy"
                  required
                />
              </div>
              <div class="flex shrink-0 flex-col gap-1.5">
                <label class="label-xxs text-base-content/40"
                  >Grupo Inicial</label
                >
                <select
                  id="rotation-start-group"
                  class="select select-sm select-bordered text-base-content cursor-pointer font-bold"
                  required
                >
                  <option value="A">Grupo A</option>
                  <option value="B">Grupo B</option>
                  <option value="C">Grupo C</option>
                  <option value="D">Grupo D</option>
                </select>
              </div>
              <div class="flex flex-1 flex-col gap-1.5">
                <label class="label-xxs text-base-content/40"
                  >Orden de Rotación (Ej: A,B,C,D o D,C,B,A)</label
                >
                <input
                  type="text"
                  id="rotation-order"
                  class="input input-sm input-bordered text-base-content font-bold"
                  placeholder="A,B,C,D"
                  required
                />
              </div>
              <ActionButton
                type="submit"
                id="save-rotation-config-btn"
                icon="boxicons:save-filled"
                label="Guardar Configuración"
                color="btn-primary"
                size="md"
                class="shrink-0"
              />
            </form>
          </div>

          <!-- Groups Grid -->
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
            <GroupCard letter="A" color="success" />
            <GroupCard letter="B" color="error" />
            <GroupCard letter="C" color="warning" />
            <GroupCard letter="D" color="info" />
          </div>
        </div>

        <!-- Saturday Rotation Timeline Card -->
        <div
          id="saturday-rotation-card"
          class="bg-base-100 border-base-300 mt-6 space-y-6 rounded-2xl border p-6 shadow-md"
        >
          <CronoCardHeader
            icon="boxicons:calendar-filled"
            title="Horarios de Guardia – Sábados 7 a 13"
            subtitle="Línea de tiempo de guardias del grupo activo"
          >
            <div class="no-export flex flex-col gap-1">
              <span class="label-xxs text-base-content/40 select-none"
                >&nbsp;</span
              >
              <ActionButton
                id="copy-rotation-image-btn"
                icon="boxicons:clipboard-filled"
                label="Copiar Tabla"
                title="Copiar tabla de guardia al portapapeles como imagen"
                size="md"
                iconSize={18}
                color="btn-secondary"
              />
            </div>

            <div class="flex flex-col gap-1">
              <label class="label-xxs text-base-content/40"
                >Sábado de Guardia</label
              >
              <CronoDatePicker
                id="rotation-timeline-date-wrapper"
                displayId="rotation-timeline-date-display"
                inputId="rotation-timeline-date"
                placeholder="Seleccionar sábado..."
                minW="min-w-44"
              />
            </div>

            <div class="flex flex-col gap-1">
              <label class="label-xxs text-base-content/40"
                >Grupo Activo</label
              >
              <div
                class="bg-secondary/10 border-secondary/20 text-secondary flex h-8 items-center rounded-lg border px-3 py-1.5 text-xs font-bold shadow-sm select-none"
                id="rotation-active-group-display"
              >
                Grupo -
              </div>
            </div>
          </CronoCardHeader>

          <!-- Visual timeline grid -->
          <div class="space-y-2">
            <div
              id="rotation-timeline-wrapper"
              class="border-base-300 bg-base-200/30 overflow-x-auto rounded-xl border"
            >
              <table
                class="table-compact table w-full min-w-150 table-fixed border-collapse"
                id="rotation-timeline-table"
              >
                <thead>
                  <tr class="bg-base-200/60 border-base-300 border-b">
                    <th
                      class="text-base-content/80 border-base-300 w-44 border-r px-3 py-2.5 text-left text-xs font-bold tracking-wider uppercase"
                    >
                      Operador
                    </th>
                    <th
                      class="text-base-content/80 border-base-300 w-24 border-r px-2 py-2.5 text-center text-xs font-bold tracking-wide"
                      >7:00 hs</th
                    >
                    <th
                      class="text-base-content/80 border-base-300 w-24 border-r px-2 py-2.5 text-center text-xs font-bold tracking-wide"
                      >8:00 hs</th
                    >
                    <th
                      class="text-base-content/80 border-base-300 w-24 border-r px-2 py-2.5 text-center text-xs font-bold tracking-wide"
                      >9:00 hs</th
                    >
                    <th
                      class="text-base-content/80 border-base-300 w-24 border-r px-2 py-2.5 text-center text-xs font-bold tracking-wide"
                      >10:00 hs</th
                    >
                    <th
                      class="text-base-content/80 border-base-300 w-24 border-r px-2 py-2.5 text-center text-xs font-bold tracking-wide"
                      >11:00 hs</th
                    >
                    <th
                      class="text-base-content/80 w-24 px-2 py-2.5 text-center text-xs font-bold tracking-wide"
                      >12:00 hs</th
                    >
                  </tr>
                </thead>
                <tbody
                  id="rotation-timeline-body"
                  class="divide-base-300/40 divide-y"
                >
                  <tr>
                    <td
                      colspan="7"
                      class="text-base-content/30 py-8 text-center text-xs font-bold tracking-wider uppercase"
                    >
                      Seleccioná un sábado para ver la línea de tiempo
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- ===== OVERTIME VIEW ===== -->
      <div id="overtime-view" class="hidden">
        <div
          id="overtime-card"
          class="bg-base-100 border-base-300 space-y-6 rounded-2xl border p-6 shadow-md"
        >
          <CronoCardHeader
            icon="boxicons:clock-5-filled"
            title="Horas Extras – Fin de Semana"
            subtitle="Sábado y Domingo — 24 hs"
            iconBg="bg-warning/15"
            iconColor="text-warning"
          />

          <!-- Weekend selector + referente config -->
          <div
            class="bg-base-200/50 border-base-300/60 flex flex-col justify-between gap-4 rounded-xl border p-4 lg:flex-row lg:items-end"
          >
            <div
              class="flex flex-1 flex-col items-start gap-3 sm:flex-row sm:items-end"
            >
              <div class="flex shrink-0 flex-col gap-1.5">
                <label class="label-xxs text-base-content/40"
                  >Fin de Semana</label
                >
                <button
                  type="button"
                  id="preview-month-btn"
