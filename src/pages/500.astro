---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCleanBase } from "@lib/baseUrl";
import ActionButton from "@components/ui/ActionButton.astro";

interface Props {
  error: unknown;
}

const { error } = Astro.props;

if (error) {
  console.error("[SSR 500 Error]:", error);
}

const homeUrl = getCleanBase();
---

<BaseLayout title="Error interno del servidor" bare={true}>
  <main class="bg-base-100 relative flex min-h-screen flex-col overflow-hidden">
    <div
      class="absolute inset-0 flex flex-col items-center justify-center"
      aria-hidden="true"
    >
      {
        Array.from({ length: 7 }).map((_, i) => (
          <span class="text-base-content/5 text-[22vw] leading-none font-black tracking-tighter select-none">
            500
          </span>
        ))
      }
    </div>
    <div
      class="relative z-10 flex flex-1 flex-col items-center justify-center gap-8 px-6 text-center"
    >
      <div class="space-y-2">
        <h1
          class="text-base-content text-4xl font-bold tracking-tight md:text-5xl"
        >
          Error interno del servidor
        </h1>
        <p class="text-base-content/60 mx-auto max-w-md text-base md:text-lg">
          Ocurrió un problema inesperado al procesar la solicitud.
        </p>
      </div>
      <ActionButton
        href={homeUrl}
        icon="boxicons:arrow-left-stroke-filled"
        label="Volver al inicio"
        variant="soft"
        color="btn-primary"
      />
    </div>
  </main>
</BaseLayout>
