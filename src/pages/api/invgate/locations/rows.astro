---
import UbicacionRow from "@components/admin/invgate/UbicacionRow.astro";
import { getOrRefreshComparison } from "@lib/invgate/locationCache";
import {
  buildLocationComparisonView,
  LOCATION_PAGE_SIZE,
} from "@lib/invgate/locationComparisonView";

const searchParams = Astro.url.searchParams;
const page = parseInt(searchParams.get("page") || "1", 10) || 1;
const filter = searchParams.get("filter") || "all";
const q = searchParams.get("q") || "";

let results: any[] = [];
let pagination: { page: number; totalPages: number } = {
  page: 1,
  totalPages: 1,
};

try {
  const { data, error } = await getOrRefreshComparison();
  if (data) {
    const view = buildLocationComparisonView(data, {
      page,
      limit: LOCATION_PAGE_SIZE,
      filter,
      q,
    });
    results = view.results;
    pagination = view.pagination;
  } else if (error) {
    console.error("Error fetching locations in rows endpoint", error);
  }
} catch (err) {
  console.error("Error fetching locations in rows endpoint", err);
}

const hasMore = pagination.page < pagination.totalPages;

Astro.response.headers.set("X-Has-More", hasMore ? "true" : "false");

const rowGridClass =
  "grid grid-cols-[120px_1.5fr_100px_120px_100px_1.2fr_120px_1.5fr] items-center gap-4";
---

{
  results.map((row: any) => (
    <UbicacionRow row={row} rowGridClass={rowGridClass} />
  ))
}
