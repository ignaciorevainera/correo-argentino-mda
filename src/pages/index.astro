---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageContainer from "@components/ui/PageContainer.astro";
import QuickAccessCard from "@components/ui/QuickAccessCard.astro";
import SkeletonCard from "@components/ui/skeletons/SkeletonCard.astro";
import WelcomeHeader from "@components/inicio/WelcomeHeader.astro";
import PersonalHome from "@components/inicio/PersonalHome.astro";
import { normalizeRole, hasPermission } from "@lib/rbac";
import { isSectionVisibleSync } from "@lib/helpdeskAccess";
import {
  getHomeAccessEntries,
  getHomeTopCardRoutes,
} from "@lib/profileAccess";
import { getSessionAgent } from "@lib/inicio/sessionAgent";
import { resolveStoredAccess } from "@lib/inicio/dashboardLayout";
import { db } from "@db/index";
import { users } from "@db/schema";
import { eq } from "drizzle-orm";

const user = Astro.locals.user;
const userRole = normalizeRole(user?.role || "agent");
// Rol efectivo: si un admin está simulando una vista, se usa el rol simulado
// para filtrar accesos (sólo presentación; la autorización real no cambia).
const effectiveRole = Astro.locals.viewAs?.role ?? userRole;
const effectiveMesa = user?.helpdeskName ?? (Astro.locals.viewAs ? "TI_GSM_MDA TI" : null);

let displayName = user?.username ? user.username.trim() : "Usuario";
if (user && user.id !== 0) {
  // Mismo resolver que el home (userId primero, username legacy después).
  const agent = await getSessionAgent(user);
  const agentName = agent?.name.trim();
  if (agentName) displayName = agentName;
}

if (displayName === user?.username?.trim()) {
  displayName = displayName.charAt(0).toUpperCase() + displayName.slice(1);
}

// Saludo por franja horaria + fecha + sector del usuario.
const now = new Date();
const hour = now.getHours();
const greeting =
  hour < 12 ? "Buenos días" : hour < 20 ? "Buenas tardes" : "Buenas noches";
const dateLabel = new Intl.DateTimeFormat("es-AR", {
  weekday: "long",
  day: "numeric",
  month: "long",
}).format(now);

const MESA_LABELS: Record<string, string> = {
  "TI_GSM_MDA TI": "MDA TI",
  "TI_GSM_Mesa de Coord": "Mesa de Coordinación",
};
const rawMesa = user?.helpdeskName?.trim() ?? "";
const mesaLabel = rawMesa ? (MESA_LABELS[rawMesa] ?? rawMesa) : null;

const isRouteLocked = (href: string): boolean => {
  const lowerHref = href.toLowerCase();
  if (
    user?.id === 0 &&
    (lowerHref === "/supervision" ||
      lowerHref.startsWith("/supervision/") ||
      lowerHref === "/admin" ||
      lowerHref.startsWith("/admin/"))
  ) {
    return true;
  }
  if (!hasPermission(href, effectiveRole)) return true;
  if (!isSectionVisibleSync(effectiveMesa, effectiveRole, href)) return true;
  return false;
};

// Las cards de abajo salen de la matriz de permisos (rol + mesa), no de una
// lista fija. Se excluyen las rutas que ya tienen card arriba para no duplicar
// accesos (semana/calidad/AGS en perfiles personales; feedback/auditoría/
// usuarios en admin). La lista vive en `getHomeTopCardRoutes`.
const topCardRoutes = getHomeTopCardRoutes(effectiveRole);

const visibleHomeCards =
  user && user.id !== 0
    ? getHomeAccessEntries(effectiveRole, effectiveMesa, topCardRoutes)
    : getHomeAccessEntries("agent", null, topCardRoutes).filter(
        (item) => !isRouteLocked(item.href),
      );

// Accesos configurables: orden y selección guardados por rol.
let storedDashboard: unknown = null;
if (user && user.id !== 0) {
  const [layoutRow] = await db
    .select({ dashboardLayout: users.dashboardLayout })
    .from(users)
    .where(eq(users.id, user.id))
    .limit(1);
  storedDashboard = layoutRow?.dashboardLayout ?? null;
}

const permittedHrefs = visibleHomeCards.map((item) => item.href);
const accessOrder = resolveStoredAccess(
  storedDashboard,
  effectiveRole,
  permittedHrefs,
);
const cardsByHref = new Map(visibleHomeCards.map((item) => [item.href, item]));
const accessCards = accessOrder
  .map((href) => cardsByHref.get(href))
  .filter((item): item is NonNullable<typeof item> => Boolean(item));
---

<!--
=====================================================================
    __________________
  _/_|[][][][][][][][]| - - - 
 (   |CORREO ARG.MDA | - - -  
 =--OO------------OO/ - - -

 Si llegaste hasta acá y no sabés qué hacés, cerrá esta ventana.
 En cambio Si sabés exactamente lo qué hacés, aportá al proyecto:
 
 https://github.com/ignaciorevainera/correo-argentino-mda

 ¿Bug? → Abrí un issue.
 ¿PR?  → Bienvenido.
=====================================================================
-->
<BaseLayout>
  <PageContainer>
    <WelcomeHeader
      displayName={displayName}
      greeting={greeting}
      dateLabel={dateLabel}
      mesaLabel={user?.id !== 0 ? mesaLabel : null}
    />

    <PersonalHome server:defer>
      <div slot="fallback" class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        <SkeletonCard class="lg:col-span-2" />
        <SkeletonCard />
      </div>
    </PersonalHome>

    <!-- Módulos y accesos directos: un solo grid (módulos primero) -->
    {
      accessCards.length > 0 && (
        <section
          aria-label="Panel de módulos y accesos directos de la plataforma"
          class="flex flex-col gap-6"
        >
          <div
            data-access-grid
            class="grid grid-cols-[repeat(auto-fit,minmax(16rem,1fr))] gap-6"
          >
            {accessCards.map((item) => (
              <QuickAccessCard
                href={item.href}
                title={item.title}
                description={item.description}
                icon={item.icon}
                iconTone={item.iconTone}
              />
            ))}
          </div>
        </section>
      )
    }
  </PageContainer>
</BaseLayout>
