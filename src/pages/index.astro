---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageContainer from "@components/ui/PageContainer.astro";
import QuickAccessCard from "@components/ui/QuickAccessCard.astro";
import { Icon } from "astro-icon/components";
import { normalizeRole, hasPermission } from "@lib/rbac";
import { isSectionVisibleSync } from "@lib/helpdeskAccess";
import { db } from "@db/index";
import { agents } from "@db/schema";
import { eq } from "drizzle-orm";

const user = Astro.locals.user;
const userRole = normalizeRole(user?.role || "agent");

let displayName = user?.username ? user.username.trim() : "Usuario";
if (user && user.id !== 0) {
  const matchedAgent = await db
    .select({ name: agents.name })
    .from(agents)
    .where(eq(agents.username, user.username))
    .limit(1);
  if (matchedAgent.length > 0 && matchedAgent[0].name) {
    displayName = matchedAgent[0].name.trim();
  }
}

if (displayName === user?.username?.trim()) {
  displayName = displayName.charAt(0).toUpperCase() + displayName.slice(1);
}

const isRouteLocked = (href: string): boolean => {
  // #309: no hace falta un caso anónimo — el middleware redirige a /login antes
  // de renderizar esta página (PUBLIC_PAGE_PATHS en src/middleware.ts:31).
  if (!hasPermission(href, userRole)) return true;
  if (!isSectionVisibleSync(user?.helpdeskName, user?.role, href)) return true;
  return false;
};

const mainModules = [
  {
    href: "/supervision/cronograma",
    label: "Cronograma",
    sublabel: "Gestión de turnos",
    icon: "boxicons:calendar-filled",
    tone: "bg-error/10 text-error",
  },
  {
    href: "/supervision/asistencia",
    label: "Asistencia",
    sublabel: "Control de presentismo",
    icon: "boxicons:clock-filled",
    tone: "bg-success/10 text-success",
  },
  {
    href: "/supervision/calidad-operadores",
    label: "Calidad",
    sublabel: "Auditoría de llamadas",
    icon: "boxicons:bar-chart-big-filled",
    tone: "bg-warning/10 text-warning",
  },
  {
    href: "/supervision/asignacion-autogestiones",
    label: "AGS",
    sublabel: "Asignación de tareas",
    icon: "boxicons:git-branch-filled",
    tone: "bg-secondary/10 text-secondary",
  },
];

const visibleMainModules =
  user && user.id !== 0
    ? mainModules.filter(
        (m) =>
          !isRouteLocked(m.href) &&
          isSectionVisibleSync(user.helpdeskName, user.role, m.href),
      )
    : [];

// Los módulos adicionales (los que sólo ven algunos roles, además de los 8
// atajos que tiene todo usuario) se renderizan con la variante compacta de
// QuickAccessCard, para que no compitan visualmente con los atajos por defecto.

type BoxiconName = `boxicons:${string}`;

interface QuickAccessItem {
  href: string;
  title: string;
  description: string;
  icon: BoxiconName;
  iconTone: string;
}

const quickAccessItems: QuickAccessItem[] = [
  {
    href: "/titulos",
    title: "Títulos",
    description: "Copia títulos normalizados listos para la gestión diaria.",
    icon: "boxicons:list-ul-filled",
    iconTone: "bg-warning/10 text-warning",
  },
  {
    href: "/mesas-de-ayuda",
    title: "Mesas de Ayuda",
    description:
      "Revisa derivaciones por tema para resolver casos con rapidez.",
    icon: "boxicons:headphone-mic-filled",
    iconTone: "bg-accent/10 text-accent",
  },
  {
    href: "/buscador-usuarios",
    title: "Buscador de usuarios",
    description: "Encuentra personal interno para chequear datos y accesos.",
    icon: "boxicons:user-search-filled",
    iconTone: "bg-info/10 text-info",
  },
  {
    href: "/recursos/contactos",
    title: "Contactos",
    description:
      "Consulta teléfonos, correos y enlaces de servicios y proveedores.",
    icon: "boxicons:phone-filled",
    iconTone: "bg-secondary/10 text-secondary",
  },
  {
    href: "/recursos",
    title: "Recursos",
    description: "Centraliza accesos para tareas de soporte.",
    icon: "boxicons:link-filled",
    iconTone: "bg-error/10 text-error",
  },
  {
    href: "/recursos/aplicativos",
    title: "Aplicativos",
    description: "Descarga herramientas para la operatoria diaria.",
    icon: "boxicons:grid-circle-diagonal-right-filled",
    iconTone: "bg-neutral/10 text-neutral",
  },
  {
    href: "/oficinas",
    title: "Oficinas",
    description:
      "Explora el mapa de cobertura y consulta el directorio de oficinas.",
    icon: "boxicons:building-house-filled",
    iconTone: "bg-success/10 text-success",
  },
  {
    href: "/inventario-terminales",
    title: "Inventario de terminales",
    description: "Inventario integral de terminales y cubics.",
    icon: "boxicons:desktop-filled",
    iconTone: "bg-accent/10 text-accent",
  },
];

// Los accesos rápidos también respetan rol + mesa: si no hay permiso, el card
// NO se renderiza (oculto, nunca deshabilitado).
const visibleQuickAccessItems =
  user && user.id !== 0
    ? quickAccessItems.filter((item) => !isRouteLocked(item.href))
    : quickAccessItems;
---

<!--
=====================================================================
    __________________
  _/_|[][][][][][][][]| - - - 
 (   |CORREO ARG.MDA | - - -  
 =--OO------------OO/ - - -

 Si llegaste hasta acá y no sabés qué hacés, cerrá esta ventana.
 En cambio Si sabés exactamente lo qué hacés, aportá al proyecto:
 
 https://github.com/ignaciorevainera/correo-argentino-mda

 ¿Bug? → Abrí un issue.
 ¿PR?  → Bienvenido.
=====================================================================
-->
<BaseLayout>
  <PageContainer>
    <header class="space-y-2">
      <h1 class="text-base-content text-3xl font-bold tracking-tight">
        {
          user?.id !== 0 ? (
            <>
              ¡Hola,{" "}
              <span class="text-secondary dark:text-primary">{displayName}</span>!
            </>
          ) : (
            "¡Hola!"
          )
        }
      </h1>
      <p class="text-base-content/70 max-w-3xl text-sm sm:text-base">
        Bienvenido al panel principal. Desde aquí puedes entrar rápido a los
        módulos operativos del portal.
      </p>
    </header>

    <!-- Panel de Módulos y Accesos -->
    <section
      aria-label="Panel de módulos y accesos directos de la plataforma"
      class="flex flex-col gap-6"
    >
      <!-- Módulos Principales -->
      {
        visibleMainModules.length > 0 && (
          <div class="grid grid-cols-[repeat(auto-fit,minmax(16rem,1fr))] gap-6">
            {visibleMainModules.map((mod) => (
              <QuickAccessCard
                href={mod.href}
                title={mod.label}
                description={mod.sublabel}
                icon={mod.icon}
                iconTone={mod.tone}
                layout="compact"
              />
            ))}
          </div>
        )
      }

      <!-- Enlaces de acceso rápido -->
      <div class="grid grid-cols-[repeat(auto-fit,minmax(16rem,1fr))] gap-6">
        {
          visibleQuickAccessItems.map((item) => (
            <QuickAccessCard
              href={item.href}
              title={item.title}
              description={item.description}
              icon={item.icon}
              iconTone={item.iconTone}
            />
          ))
        }
      </div>
    </section>
  </PageContainer>
</BaseLayout>
