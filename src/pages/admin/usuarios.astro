---
import { db } from "@db/index";
import { users, agents, schedules, mesas } from "@db/schema";
import { eq, sql } from "drizzle-orm";
import { passwordSchema, hashPassword } from "@lib/security";
import BaseLayout from "@layouts/BaseLayout.astro";
import { logAdminFromAstro } from "@lib/auditLogger";
import { isValidRole, normalizeRole } from "@lib/rbac";
import { mesaHasParticipaciones } from "@lib/helpdeskAccess";
import AdminUsersContent from "@components/admin/users/AdminUsersContent.astro";
import AdminUsersSkeleton from "@components/admin/users/AdminUsersSkeleton.astro";

let successMsg = "";
let errorMsg = "";

if (Astro.request.method === "POST") {
  const isAjax = Astro.request.headers
    .get("accept")
    ?.includes("application/json");
  const formData = await Astro.request.formData();
  const action = formData.get("action")?.toString() ?? "create";

  // Politica: nadie edita su propio usuario (rol, mesa, nombre, username,
  // participaciones). La única auto-modificación permitida es la contraseña,
  // que se hace desde /profile. El rol admin además no es editable por nadie
  // en el sistema de permisos (whitelist hardcoded, short-circuit en
  // isSectionVisibleSync).
  const SELF_EDIT_BLOCKED_ACTIONS = new Set([
    "change-role",
    "update-name",
    "update-user",
    "rename-username",
    "update-participaciones",
  ]);
  const selfEditBlocked =
    SELF_EDIT_BLOCKED_ACTIONS.has(action) &&
    Number(formData.get("userId")) === Astro.locals.user.id;

  if (selfEditBlocked) {
    errorMsg =
      "No podés editar tu propio usuario desde acá. Solo podés cambiar tu contraseña desde tu perfil.";
  } else if (action === "create") {
    const username = formData.get("username")?.toString().trim().toLowerCase();
    const password = formData.get("password")?.toString();
    const role = formData.get("role")?.toString();
    const name = formData.get("name")?.toString().trim();
    const rawHelpdesk = formData.get("helpdesk")?.toString() ?? "";
    const participaciones = {
      enCronograma: formData.get("enCronograma") === "on",
      asignableCubic: formData.get("asignableCubic") === "on",
      incluidoCalidad: formData.get("incluidoCalidad") === "on",
      asignableAgs: formData.get("asignableAgs") === "on",
    };

    let helpdeskId: number | null = null;
    let helpdeskName: string | null = null;
    if (rawHelpdesk) {
      const sep = rawHelpdesk.indexOf("|");
      const idStr = sep === -1 ? rawHelpdesk : rawHelpdesk.slice(0, sep);
      const hdName = sep === -1 ? "" : rawHelpdesk.slice(sep + 1);
      const parsedId = Number(idStr);
      helpdeskId = Number.isFinite(parsedId) && parsedId > 0 ? parsedId : null;
      helpdeskName = hdName || null;
    }

    // Task B3 usa mesaRow para sanitizar participaciones
    let mesaRow: typeof mesas.$inferSelect | undefined;
    if (!username || !password || !role || !name) {
      errorMsg = "Nombre completo, nombre de red, contraseña y rol son obligatorios.";
    } else if (!isValidRole(role)) {
      errorMsg = `Rol inválido: "${role}".`;
    } else if (helpdeskId == null || !helpdeskName) {
      errorMsg = "La mesa de ayuda es obligatoria: seleccioná una de la lista.";
    } else {
      const [row] = await db.select().from(mesas).where(eq(mesas.invgateId, helpdeskId));
      mesaRow = row;
      if (!mesaRow || !mesaRow.active) {
        errorMsg = "La mesa de ayuda seleccionada no existe o está inactiva.";
      } else {
        // Nombre canónico desde DB, nunca del cliente.
        helpdeskName = mesaRow.name;
      }
    }

    if (!errorMsg) {
      const pwdValidation = passwordSchema.safeParse(password);
      if (!pwdValidation.success) {
        errorMsg = pwdValidation.error.issues[0].message;
      } else {
        const finalParticipaciones = mesaHasParticipaciones(mesaRow?.name)
          ? participaciones
          : { enCronograma: false, asignableCubic: false, incluidoCalidad: false, asignableAgs: false };
        // Un supervisor no figura en el cronograma como operador (forzado).
        if (normalizeRole(role) === "supervisor") finalParticipaciones.enCronograma = false;

        try {
          const hashedPassword = await hashPassword(password);
          // better-sqlite3 commitea sincrónicamente al retornar el callback:
          // usando async/await el driver lanza "Transaction function cannot
          // return a promise", hace rollback y las statements se ejecutan en
          // autocommit. Callback SÍNCRONO + .run()/.get().
          db.transaction((tx) => {
            tx.insert(users)
              .values({
                username,
                password: hashedPassword,
                role: role as any,
                helpdeskId,
                helpdeskName,
              })
              .run();

            const existingAgent = tx
              .select({ id: agents.id })
              .from(agents)
              .where(
                sql`lower(coalesce(${agents.username}, '')) = ${username}`,
              )
              .get();

            if (existingAgent) {
              tx.update(agents)
                .set({ name, ...finalParticipaciones })
                .where(eq(agents.id, existingAgent.id))
                .run();
            } else {
              tx.insert(agents)
                .values({
                  name,
                  username,
                  ...finalParticipaciones,
                })
                .run();
            }
          });
          successMsg = `Usuario "${username}" creado con éxito.`;
          await logAdminFromAstro(
            Astro.locals,
            `Creó al usuario "${name}" (${username}) con rol ${role}. Participaciones: cronograma=${finalParticipaciones.enCronograma ? "sí" : "no"}, cubic=${finalParticipaciones.asignableCubic ? "sí" : "no"}, calidad=${finalParticipaciones.incluidoCalidad ? "sí" : "no"}, AGS=${finalParticipaciones.asignableAgs ? "sí" : "no"}`,
          );
        } catch (e) {
          console.error("[usuarios] Error al crear usuario:", e);
          const msg = e instanceof Error ? e.message : String(e);
          // La transaccion inserta users (username UNIQUE) y agents (name
          // UNIQUE): distinguir la columna evita reportar "usuario ya existe"
          // cuando en realidad choco el nombre completo del agente.
          if (msg.includes("users.username")) {
            errorMsg = "Error: El nombre de usuario ya existe.";
          } else if (msg.includes("agents.name")) {
            errorMsg =
              "Error: Ya existe un agente con ese nombre completo.";
          } else {
            errorMsg = "Error al crear el usuario.";
          }
        }
      }
    }
  } else if (action === "update-participaciones") {
    const userId = Number(formData.get("userId"));
    // Mesa canonica via join: users.helpdeskName puede quedar stale cuando
    // mesaSync renombra una mesa. Fallback al denormalizado solo si el join
    // no resuelve (usuario huerfano), igual que el gating de la UI.
    const [target] = await db
      .select({
        role: users.role,
        helpdeskName: users.helpdeskName,
        mesaName: mesas.name,
      })
      .from(users)
      .leftJoin(mesas, eq(users.helpdeskId, mesas.invgateId))
      .where(eq(users.id, userId));

    if (!target) {
      errorMsg = "Usuario no encontrado.";
    } else if (
      !mesaHasParticipaciones(target.mesaName ?? target.helpdeskName)
    ) {
      errorMsg = `La mesa "${((target.mesaName ?? target.helpdeskName) ?? "Sin mesa de ayuda").trim()}" no tiene secciones con participaciones.`;
    } else {
      const participaciones = {
        // Un supervisor no figura en el cronograma como operador (forzado).
        enCronograma:
          normalizeRole(target.role) !== "supervisor" && formData.get("enCronograma") === "on",
        asignableCubic: formData.get("asignableCubic") === "on",
        incluidoCalidad: formData.get("incluidoCalidad") === "on",
        asignableAgs: formData.get("asignableAgs") === "on",
      };
      try {
        const [targetUser] = await db
          .select({ username: users.username })
          .from(users)
          .where(eq(users.id, userId));
        const targetUsername = targetUser?.username || "desconocido";

        const [existingAgent] = await db
          .select({ id: agents.id })
          .from(agents)
          .where(sql`lower(coalesce(${agents.username}, '')) = ${targetUsername}`);

        if (existingAgent) {
          await db
            .update(agents)
            .set(participaciones)
            .where(eq(agents.id, existingAgent.id));
        } else {
          await db.insert(agents).values({
            name: targetUsername.toUpperCase(),
            username: targetUsername,
            ...participaciones,
          });
        }
        successMsg = "Participaciones actualizadas con éxito.";
        await logAdminFromAstro(
          Astro.locals,
          `Actualizó participaciones de "${targetUsername}": cronograma=${participaciones.enCronograma ? "sí" : "no"}, cubic=${participaciones.asignableCubic ? "sí" : "no"}, calidad=${participaciones.incluidoCalidad ? "sí" : "no"}, AGS=${participaciones.asignableAgs ? "sí" : "no"}`,
        );
      } catch (e) {
        errorMsg = "Error al actualizar participaciones.";
      }
    }
  } else if (action === "update-name") {
    const userId = Number(formData.get("userId"));
    const newName = formData.get("newName")?.toString().trim();
    if (userId && newName) {
      try {
        const [existingAgent] = await db
          .select({ id: agents.id, name: agents.name })
          .from(agents)
          .innerJoin(
            users,
            sql`lower(coalesce(${agents.username}, '')) = ${users.username}`,
          )
          .where(eq(users.id, userId));

        if (!existingAgent) {
          errorMsg = "No existe fila de agente vinculada a este usuario.";
        } else {
          const oldName = existingAgent.name;

          db.transaction((tx) => {
            tx.update(agents)
              .set({ name: newName })
              .where(eq(agents.id, existingAgent.id))
              .run();

            if (oldName !== newName) {
              tx.update(schedules)
                .set({ agentName: newName })
                .where(eq(schedules.agentName, oldName))
                .run();
            }
          });

          successMsg = "Nombre actualizado con éxito.";
          await logAdminFromAstro(
            Astro.locals,
            oldName !== newName
              ? `Renombró al agente de "${oldName}" a "${newName}" (propagado a cronogramas)`
              : `Actualizó el nombre del agente a "${newName}"`,
          );
        }
      } catch (e) {
        errorMsg = "Error al actualizar el nombre. ¿Ya existe un agente con ese nombre?";
      }
    }
  } else if (action === "update-user") {
    const userId = Number(formData.get("userId"));
    const newUsername = formData
      .get("username")
      ?.toString()
      .trim()
      .toLowerCase();
    const newName = formData.get("name")?.toString().trim();

    if (!newUsername || !newName) {
      errorMsg = "Nombre completo y nombre de red son obligatorios.";
    } else {
      // Mesa canonica via join: users.helpdeskName puede quedar stale cuando
      // mesaSync renombra una mesa. Mismo criterio que update-participaciones
      // y el gating de la UI.
      const [target] = await db
        .select({
          username: users.username,
          role: users.role,
          helpdeskName: users.helpdeskName,
          mesaName: mesas.name,
        })
        .from(users)
        .leftJoin(mesas, eq(users.helpdeskId, mesas.invgateId))
        .where(eq(users.id, userId));

      if (!target) {
        errorMsg = "Usuario no encontrado.";
      } else {
        const oldUsername = target.username;
        // Sin mesa participativa no hay flags que persistir; un supervisor
        // nunca figura en cronograma (forzado). Mismo saneamiento que create.
        const mesaParticipativa = mesaHasParticipaciones(
          target.mesaName ?? target.helpdeskName,
        );
        const participaciones = {
          enCronograma:
            mesaParticipativa &&
            normalizeRole(target.role) !== "supervisor" &&
            formData.get("enCronograma") === "on",
          asignableCubic:
            mesaParticipativa && formData.get("asignableCubic") === "on",
          incluidoCalidad:
            mesaParticipativa && formData.get("incluidoCalidad") === "on",
          asignableAgs:
            mesaParticipativa && formData.get("asignableAgs") === "on",
        };
        const FLAG_LABELS = {
          enCronograma: "cronograma",
          asignableCubic: "cubic",
          incluidoCalidad: "calidad",
          asignableAgs: "AGS",
        } as const;

        try {
          const [existingAgent] = await db
            .select({
              id: agents.id,
              name: agents.name,
              enCronograma: agents.enCronograma,
              asignableCubic: agents.asignableCubic,
              incluidoCalidad: agents.incluidoCalidad,
              asignableAgs: agents.asignableAgs,
            })
            .from(agents)
            .where(
              sql`lower(coalesce(${agents.username}, '')) = ${oldUsername.toLowerCase()}`,
            );

          // Callback SÍNCRONO: better-sqlite3 no admite promesas en
          // transaction() (lanza TypeError y hace rollback).
          db.transaction((tx) => {
            if (newUsername !== oldUsername) {
              tx.update(users)
                .set({ username: newUsername })
                .where(eq(users.id, userId))
                .run();
            }

            if (existingAgent) {
              tx.update(agents)
                .set({ name: newName, username: newUsername, ...participaciones })
                .where(eq(agents.id, existingAgent.id))
                .run();
            } else {
              // Self-heal: usuarios sin fila agents (vinculo por username)
              // ahora pueden editarse y se crea la fila en el mismo submit.
              tx.insert(agents)
                .values({
                  name: newName,
                  username: newUsername,
                  ...participaciones,
                })
                .run();
            }

            // El rename de username no cambia el nombre visible; solo si el
            // nombre cambio se propaga a los cronogramas guardados.
            if (existingAgent && existingAgent.name !== newName) {
              tx.update(schedules)
                .set({ agentName: newName })
                .where(eq(schedules.agentName, existingAgent.name))
                .run();
            }
          });

          const changes: string[] = [];
          if (newUsername !== oldUsername) {
            changes.push(
              `nombre de red "${oldUsername}" → "${newUsername}"`,
            );
          }
          if (!existingAgent) {
            changes.push(`creada la fila de agente "${newName}"`);
            const setFlags = (
              Object.keys(FLAG_LABELS) as (keyof typeof FLAG_LABELS)[]
            )
              .filter((flag) => participaciones[flag])
              .map((flag) => FLAG_LABELS[flag]);
            if (setFlags.length > 0) {
              changes.push(`participaciones activadas: ${setFlags.join(", ")}`);
            }
          } else {
            if (existingAgent.name !== newName) {
              changes.push(`nombre visible "${existingAgent.name}" → "${newName}"`);
            }
            const changedFlags = (
              Object.keys(FLAG_LABELS) as (keyof typeof FLAG_LABELS)[]
            ).filter((flag) => existingAgent[flag] !== participaciones[flag]);
            if (changedFlags.length > 0) {
              changes.push(
                `participaciones: ${changedFlags
                  .map(
                    (flag) =>
                      `${FLAG_LABELS[flag]}=${participaciones[flag] ? "sí" : "no"}`,
                  )
                  .join(", ")}`,
              );
            }
          }

          successMsg = "Usuario actualizado con éxito.";
          await logAdminFromAstro(
            Astro.locals,
            `Actualizó al usuario "${oldUsername}"${changes.length > 0 ? `: ${changes.join("; ")}` : " (sin cambios)"}`,
          );
        } catch (e) {
          console.error("[usuarios] Error al actualizar usuario:", e);
          const msg = e instanceof Error ? e.message : String(e);
          if (msg.includes("users.username")) {
            errorMsg = "Error: Ese nombre de usuario ya existe.";
          } else if (msg.includes("agents.name")) {
            errorMsg =
              "Error: Ya existe un agente con ese nombre completo.";
          } else {
            errorMsg = "Error al actualizar el usuario.";
          }
        }
      }
    }
  } else if (action === "reset-password") {
    const userId = Number(formData.get("userId"));
    const newPassword = formData.get("newPassword")?.toString();
    if (userId && newPassword) {
      const pwdValidation = passwordSchema.safeParse(newPassword);
      if (!pwdValidation.success) {
        errorMsg = pwdValidation.error.issues[0].message;
      } else {
        try {
          const [targetUser] = await db
            .select({ username: users.username })
            .from(users)
            .where(eq(users.id, userId));
          const targetUsername = targetUser?.username || "desconocido";

          const hashedPassword = await hashPassword(newPassword);
          await db
            .update(users)
            .set({ password: hashedPassword })
            .where(eq(users.id, userId));
          successMsg = "Contraseña actualizada con éxito.";
          await logAdminFromAstro(
            Astro.locals,
            `Blanqueó la contraseña de "${targetUsername}"`,
          );
        } catch (e) {
          errorMsg = "Error al actualizar la contraseña.";
        }
      }
    }
  } else if (action === "rename-username") {
    const userId = Number(formData.get("userId"));
    const newUsername = formData
      .get("newUsername")
      ?.toString()
      .trim()
      .toLowerCase();
    if (userId && newUsername) {
      try {
        const [existing] = await db
          .select({ username: users.username })
          .from(users)
          .where(eq(users.id, userId));
        const oldUsername = existing?.username || "desconocido";

        await db
          .update(users)
          .set({ username: newUsername })
          .where(eq(users.id, userId));

        await db
          .update(agents)
          .set({ username: newUsername })
          .where(sql`lower(coalesce(${agents.username}, '')) = ${oldUsername.toLowerCase()}`);

        successMsg = `Usuario renombrado a "${newUsername}" con éxito.`;
        await logAdminFromAstro(
          Astro.locals,
          `Renombró al usuario de "${oldUsername}" a "${newUsername}"`,
        );
      } catch (e) {
        console.error("[usuarios] Error al renombrar usuario:", e);
        const msg = e instanceof Error ? e.message : String(e);
        errorMsg = msg.includes("UNIQUE constraint failed")
          ? "Error: Ese nombre de usuario ya existe."
          : "Error al actualizar el usuario.";
      }
    }
  } else if (action === "change-role") {
    const userId = Number(formData.get("userId"));
    const newRole = formData.get("newRole")?.toString();
    const raw = formData.get("helpdesk")?.toString() ?? "";

    let helpdeskId: number | null = null;
    let helpdeskName: string | null = null;
    let mesaRow: typeof mesas.$inferSelect | undefined;
    if (raw) {
      const sep = raw.indexOf("|");
      const idStr = sep === -1 ? raw : raw.slice(0, sep);
      const name = sep === -1 ? "" : raw.slice(sep + 1);
      const parsedId = Number(idStr);
      helpdeskId = Number.isFinite(parsedId) && parsedId > 0 ? parsedId : null;
      helpdeskName = name || null;
      const [row] = await db.select().from(mesas).where(eq(mesas.invgateId, helpdeskId));
      if (!row || !row.active) {
        errorMsg = "La mesa de ayuda seleccionada no existe o está inactiva.";
      } else {
        mesaRow = row;
        helpdeskName = row.name;
      }
    }

    if (userId && newRole && isValidRole(newRole) && !errorMsg) {
      try {
        const [targetUser] = await db
          .select({
            username: users.username,
            role: users.role,
            helpdeskName: users.helpdeskName,
          })
          .from(users)
          .where(eq(users.id, userId));
        const targetUsername = targetUser?.username || "desconocido";
        const oldRole = targetUser?.role || "desconocido";
        const oldHelpdesk = targetUser?.helpdeskName || "Sin mesa de ayuda";

        // Politica de participaciones por mesa: al mover a una mesa no
        // participativa (o dejar sin mesa) se resetean; un supervisor nunca
        // figura en cronograma. Evita el "fantasma" del agente en
        // cronograma/calidad/cubics/guardia de otra mesa.
        const resetFlags = !(mesaRow && mesaHasParticipaciones(mesaRow.name));
        const isSupervisor = normalizeRole(newRole) === "supervisor";
        const resetParticipaciones = resetFlags || isSupervisor;

        // Callback SÍNCRONO: better-sqlite3 no admite promesas en
        // transaction() (lanza TypeError y hace rollback).
        db.transaction((tx) => {
          tx.update(users)
            .set({ role: newRole as any, helpdeskId, helpdeskName })
            .where(eq(users.id, userId))
            .run();

          const targetAgent = tx
            .select({ id: agents.id })
            .from(agents)
            .where(
              sql`lower(coalesce(${agents.username}, '')) = lower(${targetUsername})`,
            )
            .get();

          if (targetAgent && resetParticipaciones) {
            tx.update(agents)
              .set({
                ...(resetFlags
                  ? {
                      enCronograma: false,
                      asignableCubic: false,
                      incluidoCalidad: false,
                      asignableAgs: false,
                    }
                  : {}),
                ...(isSupervisor ? { enCronograma: false } : {}),
              })
              .where(eq(agents.id, targetAgent.id))
              .run();
          }
        });
        successMsg = "Rol y mesa de ayuda actualizados con éxito.";
        await logAdminFromAstro(
          Astro.locals,
          `Cambió el rol de "${targetUsername}" de "${oldRole}" a "${newRole}" y la mesa de ayuda de "${oldHelpdesk}" a "${helpdeskName || "Sin mesa de ayuda"}"${resetParticipaciones ? " (participaciones reseteadas)" : ""}`,
        );
      } catch (e) {
        errorMsg = "Error al actualizar el usuario.";
      }
    } else if (userId && newRole && !isValidRole(newRole)) {
      errorMsg = `Rol inválido: "${newRole}".`;
    }
  }

  if (isAjax) {
    if (errorMsg) {
      return new Response(JSON.stringify({ success: false, error: errorMsg }), {
        status: 400,
        headers: { "Content-Type": "application/json" },
      });
    }
    // Los forms de los modales recargan la pagina tras el submit: si el toast
    // de exito viaja solo en el JSON, se pierde con el reload. Se propaga por
    // query params para que ToastContainer lo consuma en la pagina recargada.
    const redirectUrl = new URL(Astro.url.href);
    if (successMsg) {
      redirectUrl.searchParams.set("toast_msg", successMsg);
      redirectUrl.searchParams.set("toast_type", "success");
    }
    return new Response(
      JSON.stringify({
        success: true,
        message: successMsg,
        redirectUrl: redirectUrl.href,
      }),
      { status: 200, headers: { "Content-Type": "application/json" } },
    );
  }
}
---

<BaseLayout>
  <AdminUsersContent server:defer successMsg={successMsg} errorMsg={errorMsg}>
    <AdminUsersSkeleton slot="fallback" />
  </AdminUsersContent>
</BaseLayout>
