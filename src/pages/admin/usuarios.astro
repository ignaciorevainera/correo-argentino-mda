---
import { db } from "@db/index";
import { users, agents, schedules } from "@db/schema";
import { eq, sql } from "drizzle-orm";
import { passwordSchema, hashPassword } from "@lib/security";
import BaseLayout from "@layouts/BaseLayout.astro";
import { logAdminFromAstro } from "@lib/auditLogger";
import AdminUsersContent from "@components/admin/users/AdminUsersContent.astro";
import AdminUsersSkeleton from "@components/admin/users/AdminUsersSkeleton.astro";

let successMsg = "";
let errorMsg = "";

if (Astro.request.method === "POST") {
  const isAjax = Astro.request.headers
    .get("accept")
    ?.includes("application/json");
  const formData = await Astro.request.formData();
  const action = formData.get("action")?.toString() ?? "create";

  if (action === "create") {
    const username = formData.get("username")?.toString().trim().toLowerCase();
    const password = formData.get("password")?.toString();
    const role = formData.get("role")?.toString();
    const name = formData.get("name")?.toString().trim();
    const rawHelpdesk = formData.get("helpdesk")?.toString() ?? "";
    const participaciones = {
      enCronograma: formData.get("enCronograma") === "on",
      asignableCubic: formData.get("asignableCubic") === "on",
      incluidoCalidad: formData.get("incluidoCalidad") === "on",
      asignableAgs: formData.get("asignableAgs") === "on",
    };

    let helpdeskId: number | null = null;
    let helpdeskName: string | null = null;
    if (rawHelpdesk) {
      const sep = rawHelpdesk.indexOf("|");
      const idStr = sep === -1 ? rawHelpdesk : rawHelpdesk.slice(0, sep);
      const hdName = sep === -1 ? "" : rawHelpdesk.slice(sep + 1);
      const parsedId = Number(idStr);
      helpdeskId = Number.isFinite(parsedId) && parsedId > 0 ? parsedId : null;
      helpdeskName = hdName || null;
    }

    if (!username || !password || !role || !name) {
      errorMsg = "Nombre completo, nombre de red, contraseña y rol son obligatorios.";
    } else {
      const pwdValidation = passwordSchema.safeParse(password);
      if (!pwdValidation.success) {
        errorMsg = pwdValidation.error.issues[0].message;
      } else {
        try {
          const hashedPassword = await hashPassword(password);
          await db.transaction(async (tx) => {
            await tx.insert(users).values({
              username,
              password: hashedPassword,
              role: role as any,
              helpdeskId,
              helpdeskName,
            });

            const [existingAgent] = await tx
              .select({ id: agents.id })
              .from(agents)
              .where(sql`lower(coalesce(${agents.username}, '')) = ${username}`);

            if (existingAgent) {
              await tx
                .update(agents)
                .set({ name, ...participaciones })
                .where(eq(agents.id, existingAgent.id));
            } else {
              await tx.insert(agents).values({
                name,
                username,
                ...participaciones,
              });
            }
          });
          successMsg = `Usuario "${username}" creado con éxito.`;
          await logAdminFromAstro(
            Astro.locals,
            `Creó al usuario "${name}" (${username}) con rol ${role}. Participaciones: cronograma=${participaciones.enCronograma ? "sí" : "no"}, cubic=${participaciones.asignableCubic ? "sí" : "no"}, calidad=${participaciones.incluidoCalidad ? "sí" : "no"}, AGS=${participaciones.asignableAgs ? "sí" : "no"}`,
          );
        } catch (e) {
          errorMsg = "Error: El nombre de usuario ya existe.";
        }
      }
    }
  }

  if (action === "update-participaciones") {
    const userId = Number(formData.get("userId"));
    const participaciones = {
      enCronograma: formData.get("enCronograma") === "on",
      asignableCubic: formData.get("asignableCubic") === "on",
      incluidoCalidad: formData.get("incluidoCalidad") === "on",
      asignableAgs: formData.get("asignableAgs") === "on",
    };
    if (userId) {
      try {
        const [targetUser] = await db
          .select({ username: users.username })
          .from(users)
          .where(eq(users.id, userId));
        const targetUsername = targetUser?.username || "desconocido";

        const [existingAgent] = await db
          .select({ id: agents.id })
          .from(agents)
          .where(sql`lower(coalesce(${agents.username}, '')) = ${targetUsername}`);

        if (existingAgent) {
          await db
            .update(agents)
            .set(participaciones)
            .where(eq(agents.id, existingAgent.id));
        } else {
          await db.insert(agents).values({
            name: targetUsername.toUpperCase(),
            username: targetUsername,
            ...participaciones,
          });
        }
        successMsg = "Participaciones actualizadas con éxito.";
        await logAdminFromAstro(
          Astro.locals,
          `Actualizó participaciones de "${targetUsername}": cronograma=${participaciones.enCronograma ? "sí" : "no"}, cubic=${participaciones.asignableCubic ? "sí" : "no"}, calidad=${participaciones.incluidoCalidad ? "sí" : "no"}, AGS=${participaciones.asignableAgs ? "sí" : "no"}`,
        );
      } catch (e) {
        errorMsg = "Error al actualizar participaciones.";
      }
    }
  }

  if (action === "update-name") {
    const userId = Number(formData.get("userId"));
    const newName = formData.get("newName")?.toString().trim();
    if (userId && newName) {
      try {
        const [existingAgent] = await db
          .select({ id: agents.id, name: agents.name })
          .from(agents)
          .innerJoin(
            users,
            sql`lower(coalesce(${agents.username}, '')) = ${users.username}`,
          )
          .where(eq(users.id, userId));

        if (!existingAgent) {
          errorMsg = "No existe fila de agente vinculada a este usuario.";
        } else {
          const oldName = existingAgent.name;

          await db.transaction(async (tx) => {
            await tx
              .update(agents)
              .set({ name: newName })
              .where(eq(agents.id, existingAgent.id));

            if (oldName !== newName) {
              await tx
                .update(schedules)
                .set({ agentName: newName })
                .where(eq(schedules.agentName, oldName));
            }
          });

          successMsg = "Nombre actualizado con éxito.";
          await logAdminFromAstro(
            Astro.locals,
            oldName !== newName
              ? `Renombró al agente de "${oldName}" a "${newName}" (propagado a cronogramas)`
              : `Actualizó el nombre del agente a "${newName}"`,
          );
        }
      } catch (e) {
        errorMsg = "Error al actualizar el nombre. ¿Ya existe un agente con ese nombre?";
      }
    }
  }

  if (action === "reset-password") {
    const userId = Number(formData.get("userId"));
    const newPassword = formData.get("newPassword")?.toString();
    if (userId && newPassword) {
      const pwdValidation = passwordSchema.safeParse(newPassword);
      if (!pwdValidation.success) {
        errorMsg = pwdValidation.error.issues[0].message;
      } else {
        try {
          const [targetUser] = await db
            .select({ username: users.username })
            .from(users)
            .where(eq(users.id, userId));
          const targetUsername = targetUser?.username || "desconocido";

          const hashedPassword = await hashPassword(newPassword);
          await db
            .update(users)
            .set({ password: hashedPassword })
            .where(eq(users.id, userId));
          successMsg = "Contraseña actualizada con éxito.";
          await logAdminFromAstro(
            Astro.locals,
            `Blanqueó la contraseña de "${targetUsername}"`,
          );
        } catch (e) {
          errorMsg = "Error al actualizar la contraseña.";
        }
      }
    }
  }

  if (action === "rename-username") {
    const userId = Number(formData.get("userId"));
    const newUsername = formData
      .get("newUsername")
      ?.toString()
      .trim()
      .toLowerCase();
    if (userId && newUsername) {
      try {
        const [existing] = await db
          .select({ username: users.username })
          .from(users)
          .where(eq(users.id, userId));
        const oldUsername = existing?.username || "desconocido";

        await db
          .update(users)
          .set({ username: newUsername })
          .where(eq(users.id, userId));

        await db
          .update(agents)
          .set({ username: newUsername })
          .where(sql`lower(coalesce(${agents.username}, '')) = ${oldUsername.toLowerCase()}`);

        successMsg = `Usuario renombrado a "${newUsername}" con éxito.`;
        await logAdminFromAstro(
          Astro.locals,
          `Renombró al usuario de "${oldUsername}" a "${newUsername}"`,
        );
      } catch (e) {
        errorMsg = "Error: Ese nombre de usuario ya existe.";
      }
    }
  }

  if (action === "change-role") {
    const userId = Number(formData.get("userId"));
    const newRole = formData.get("newRole")?.toString();
    const raw = formData.get("helpdesk")?.toString() ?? "";

    let helpdeskId: number | null = null;
    let helpdeskName: string | null = null;
    if (raw) {
      const sep = raw.indexOf("|");
      const idStr = sep === -1 ? raw : raw.slice(0, sep);
      const name = sep === -1 ? "" : raw.slice(sep + 1);
      const parsedId = Number(idStr);
      helpdeskId = Number.isFinite(parsedId) && parsedId > 0 ? parsedId : null;
      helpdeskName = name || null;
    }

    if (userId && newRole) {
      try {
        const [targetUser] = await db
          .select({
            username: users.username,
            role: users.role,
            helpdeskName: users.helpdeskName,
          })
          .from(users)
          .where(eq(users.id, userId));
        const targetUsername = targetUser?.username || "desconocido";
        const oldRole = targetUser?.role || "desconocido";
        const oldHelpdesk = targetUser?.helpdeskName || "Sin mesa de ayuda";

        await db
          .update(users)
          .set({ role: newRole as any, helpdeskId, helpdeskName })
          .where(eq(users.id, userId));
        successMsg = "Rol y mesa de ayuda actualizados con éxito.";
        await logAdminFromAstro(
          Astro.locals,
          `Cambió el rol de "${targetUsername}" de "${oldRole}" a "${newRole}" y la mesa de ayuda de "${oldHelpdesk}" a "${helpdeskName || "Sin mesa de ayuda"}"`,
        );
      } catch (e) {
        errorMsg = "Error al actualizar el usuario.";
      }
    }
  }

  if (isAjax) {
    if (errorMsg) {
      return new Response(JSON.stringify({ success: false, error: errorMsg }), {
        status: 400,
        headers: { "Content-Type": "application/json" },
      });
    }
    // For forms in modals, we probably want them to reload to see the updated table, so redirectUrl: Astro.url.href
    return new Response(
      JSON.stringify({
        success: true,
        message: successMsg,
        redirectUrl: Astro.url.href,
      }),
      { status: 200, headers: { "Content-Type": "application/json" } },
    );
  }
}
---

<BaseLayout>
  <AdminUsersContent server:defer successMsg={successMsg} errorMsg={errorMsg}>
    <AdminUsersSkeleton slot="fallback" />
  </AdminUsersContent>
</BaseLayout>
