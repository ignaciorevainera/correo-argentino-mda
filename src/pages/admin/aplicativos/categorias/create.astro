---
import FormField from "@components/ui/forms/FormField.astro";
import { db } from "@db/index";
import { applicationCategories } from "@db/schema";
import { logAdminFromAstro } from "@lib/auditLogger";
import AsyncFormScript from "@components/admin/ui/AsyncFormScript.astro";
import { resolveUrl } from "@lib/url";
import { redirectWithToast } from "@lib/api/redirectWithToast";
import { toastResponse } from "@lib/api/toastResponse";
import SectionCard from "@components/ui/SectionCard.astro";
import FormShell from "@components/ui/FormShell.astro";

let errorMsg = "";

if (Astro.request.method === "POST") {
  const isAjax = Astro.request.headers
    .get("accept")
    ?.includes("application/json");
  try {
    const formData = await Astro.request.formData();
    const title = formData.get("title")?.toString().trim();

    if (!title) {
      throw new Error("El título es obligatorio.");
    }

    if (
      title.toLowerCase() === "sin categoría" ||
      title.toLowerCase() === "sin categoria"
    ) {
      throw new Error(
        "No se puede crear una categoría con este nombre reservado.",
      );
    }

    await db.insert(applicationCategories).values({
      title,
    });
    await logAdminFromAstro(
      Astro.locals,
      `Creó la categoría de aplicativos "${title}"`,
    );

    if (isAjax) {
      return toastResponse({
        success: true,
        message: "Categoría creada con éxito.",
        redirectUrl: resolveUrl("/admin/aplicativos"),
      });
    }

    return redirectWithToast(
      "/admin/aplicativos",
      "Categoría creada con éxito.",
    );
  } catch (error: any) {
    console.error("DEBUG ERROR CREATE CATEGORIA APLICATIVOS:", error);
    if (isAjax) {
      return toastResponse({
        success: false,
        error: error.message || "Error al guardar la categoría.",
      });
    }
    errorMsg = error.message || "Error al guardar la categoría.";
  }
}
---

<FormShell
  backHref={resolveUrl("/admin/aplicativos")}
  title="Nueva categoría de aplicativos"
  subtitle="Definí cómo se agruparán los aplicativos en la intranet."
  formId="categoria-form"
  containerWidth="2xl"
  saveColor="btn-secondary"
  saveLabel="Guardar Categoría"
  async
>
  <script is:inline define:vars={{ errorMsg }}>
    if (errorMsg) {
      window.addEventListener("load", () =>
        window.showToast?.(errorMsg, "alert-error"),
      );
    }
  </script>

  <SectionCard>
    <div class="p-6 sm:p-8">
      <div class="grid grid-cols-1 gap-y-5">
        <FormField
          id="input-title"
          name="title"
          label="Título de la Categoría"
          required
          value=""
          placeholder="Ej: Herramientas de Red"
          inputClass="font-medium"
          autofocus
        />
      </div>
    </div>
  </SectionCard>
</FormShell>

<AsyncFormScript />
