---
import FormField from "@components/ui/forms/FormField.astro";
import SelectField from "@components/ui/forms/SelectField.astro";
import { db } from "@db/index";
import { resourceCategories } from "@db/schema";
import { logAdminFromAstro } from "@lib/auditLogger";
import AsyncFormScript from "@components/admin/ui/AsyncFormScript.astro";
import { resolveUrl } from "@lib/url";
import { redirectWithToast } from "@lib/api/redirectWithToast";
import { toastResponse } from "@lib/api/toastResponse";
import SectionCard from "@components/ui/SectionCard.astro";
import FormLegend from "@components/ui/forms/FormLegend.astro";
import FormShell from "@components/ui/FormShell.astro";

let errorMsg = "";
let category = { id: "", title: "", iconName: "", tone: "primary" };

const PREDEFINED_ICONS = [
  { value: "boxicons:star-filled", label: "Estrella (Destacados)" },
  { value: "boxicons:file-detail-filled", label: "Documento (Normativas)" },
  { value: "boxicons:group-filled", label: "Grupo (Usuarios / RRHH)" },
  { value: "boxicons:building-house-filled", label: "Edificio (Intranet)" },
  { value: "boxicons:chip-filled", label: "Microchip (Hardware)" },
  { value: "boxicons:spanner-filled", label: "Llave (Herramientas)" },
  { value: "boxicons:check-shield-filled", label: "Escudo (Seguridad / VPN)" },
  { value: "boxicons:link-filled", label: "Enlace (Portales / Accesos)" },
  { value: "boxicons:help-circle-filled", label: "Ayuda (Soporte / FAQ)" },
  { value: "boxicons:calendar-filled", label: "Calendario (Cronograma)" },
];

const iconsList = [...PREDEFINED_ICONS];

if (Astro.request.method === "POST") {
  const isAjax = Astro.request.headers
    .get("accept")
    ?.includes("application/json");
  try {
    const formData = await Astro.request.formData();
    const title = formData.get("title")?.toString().trim();
    const iconName = formData.get("iconName")?.toString().trim();

    if (!title || !iconName) {
      throw new Error("El título y el icono son obligatorios.");
    }

    if (
      title.toLowerCase() === "sin categoría" ||
      title.toLowerCase() === "sin categoria"
    ) {
      throw new Error(
        "No se puede crear una categoría con este nombre reservado.",
      );
    }

    const tone = formData.get("tone")?.toString().trim() || "primary";

    await db.insert(resourceCategories).values({
      title,
      iconName,
      tone,
    });
    await logAdminFromAstro(
      Astro.locals,
      `Creó la categoría de recursos "${title}"`,
    );

    const successMsg = "Categoría creada con éxito.";
    if (isAjax) {
      return toastResponse({
        success: true,
        message: successMsg,
        redirectUrl: resolveUrl("/admin/recursos"),
      });
    }
    return redirectWithToast("/admin/recursos", successMsg);
  } catch (error: any) {
    console.error("DEBUG ERROR CREATE CATEGORIA RECURSOS:", error);
    errorMsg = error.message || "Error al guardar la categoría.";
    if (isAjax) {
      return toastResponse({ success: false, error: errorMsg });
    }
  }
}
---

<FormShell
  backHref={resolveUrl("/admin/recursos")}
  title="Nueva categoría de recursos"
  subtitle="Definí cómo se agruparán y visualizarán los enlaces."
  formId="categoria-form"
  containerWidth="2xl"
  saveColor="btn-secondary"
  saveLabel="Guardar"
  async
>
  <script is:inline define:vars={{ errorMsg }}>
    if (errorMsg) {
      window.addEventListener("load", () =>
        window.showToast?.(errorMsg, "alert-error"),
      );
    }
  </script>

  <SectionCard>
    <div class="p-6 sm:p-8">
      <div class="grid grid-cols-1 gap-y-5">
        <FormField
          id="input-title"
          name="title"
          label="Título de la Categoría"
          required
          value={category.title}
          placeholder="Ej: Sistemas operativos"
          inputClass="font-medium"
          autofocus
        />

        <SelectField
          id="select-iconName"
          name="iconName"
          label="Ícono Visual"
          selectClass="font-medium"
          options={iconsList}
          value="boxicons:star-filled"
        />

        <fieldset class="fieldset">
          <FormLegend class="mb-2">Color de Identificación (Tono)</FormLegend>
          <div
            class="bg-base-200/50 border-base-300 flex w-full flex-col gap-2.5 rounded-xl border p-4"
          >
            <label class="flex cursor-pointer items-center gap-2">
              <input
                type="radio"
                name="tone"
                value="primary"
                class="radio radio-primary radio-sm"
                checked
              />
              <span class="text-sm font-medium">Amarillo</span>
            </label>

            <label class="flex cursor-pointer items-center gap-2">
              <input
                type="radio"
                name="tone"
                value="secondary"
                class="radio radio-secondary radio-sm"
              />
              <span class="text-sm font-medium">Azul</span>
            </label>

            <label class="flex cursor-pointer items-center gap-2">
              <input
                type="radio"
                name="tone"
                value="accent"
                class="radio radio-accent radio-sm"
              />
              <span class="text-sm font-medium">Celeste</span>
            </label>

            <label class="flex cursor-pointer items-center gap-2">
              <input
                type="radio"
                name="tone"
                value="success"
                class="radio radio-success radio-sm"
              />
              <span class="text-sm font-medium">Verde</span>
            </label>

            <label class="flex cursor-pointer items-center gap-2">
              <input
                type="radio"
                name="tone"
                value="info"
                class="radio radio-info radio-sm"
              />
              <span class="text-sm font-medium">Azul claro</span>
            </label>

            <label class="flex cursor-pointer items-center gap-2">
              <input
                type="radio"
                name="tone"
                value="warning"
                class="radio radio-warning radio-sm"
              />
              <span class="text-sm font-medium">Naranja</span>
            </label>

            <label class="flex cursor-pointer items-center gap-2">
              <input
                type="radio"
                name="tone"
                value="error"
                class="radio radio-error radio-sm"
              />
              <span class="text-sm font-medium">Rojo</span>
            </label>

            <label class="flex cursor-pointer items-center gap-2">
              <input
                type="radio"
                name="tone"
                value="neutral"
                class="radio radio-neutral radio-sm"
              />
              <span class="text-sm font-medium">Gris</span>
            </label>
          </div>
        </fieldset>
      </div>
    </div>
  </SectionCard>
</FormShell>

<AsyncFormScript />
