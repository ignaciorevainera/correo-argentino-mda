---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import PermisosContent from "@components/admin/permisos/PermisosContent.astro";
import PermisosSkeleton from "@components/admin/permisos/PermisosSkeleton.astro";
---

<BaseLayout title="Permisos y accesos">
  <PageContainer>
    <PageHeader
      title="Permisos y accesos"
      description="Configura qué ven y pueden hacer cada rol y mesa"
    />
    <PermisosContent server:defer>
      <PermisosSkeleton slot="fallback" />
    </PermisosContent>
  </PageContainer>
</BaseLayout>
