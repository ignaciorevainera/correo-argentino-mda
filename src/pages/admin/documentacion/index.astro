---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import { Icon } from "astro-icon/components";
import { resolveUrl } from "@lib/url";
import { getAllDocs, getDocSections, getDocUrl } from "@lib/docs/docsCatalog";

const sections = getDocSections();
const totalDocs = getAllDocs().length;

const query = (Astro.url.searchParams.get("q") ?? "").trim();
const normalize = (value: string): string =>
  value
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "");
const normalizedQuery = normalize(query);

const filteredSections = sections
  .map((section) => ({
    ...section,
    docs: section.docs.filter((doc) => {
      if (!normalizedQuery) return true;
      return normalize(
        `${doc.title} ${doc.description} ${doc.filePath} ${doc.sectionLabel}`,
      ).includes(normalizedQuery);
    }),
  }))
  .filter((section) => section.docs.length > 0);

const visibleDocs = filteredSections.reduce(
  (total, section) => total + section.docs.length,
  0,
);

const readingMinutes = (wordCount: number) =>
  Math.max(1, Math.ceil(wordCount / 200));

const labelFor = (slug: string, title: string) =>
  slug.endsWith("/README") ? "Guía de lectura" : title;
---

<BaseLayout title="Documentación técnica | MDA">
  <PageContainer width="xl" gap="lg" class="py-6">
    <PageHeader
      title="Documentación técnica"
      description="Auditoría del sistema actual, arquitectura objetivo y plan de reconstrucción del Portal MDA. Vista de solo lectura."
      backHref={resolveUrl("/admin")}
      backLabel="Volver a Administración"
    />

    <form
      method="get"
      action={resolveUrl("/admin/documentacion")}
      class="border-base-300 bg-base-100 rounded-box flex flex-col gap-3 border p-4 sm:flex-row sm:items-center sm:justify-between"
      role="search"
    >
      <label class="relative flex-1">
        <span class="sr-only">Buscar documento</span>
        <Icon
          name="boxicons:search"
          size={20}
          class="text-base-content/50 pointer-events-none absolute top-1/2 left-3 -translate-y-1/2"
          is:inline
        />
        <input
          id="doc-search"
          name="q"
          type="search"
          value={query}
          placeholder="Buscar por título, tema o ruta..."
          class="input input-sm input-bordered focus:border-secondary w-full pl-9 focus:outline-hidden"
          autocomplete="off"
        />
      </label>
      <div class="flex shrink-0 items-center gap-2">
        <button type="submit" class="btn btn-secondary btn-sm"> Buscar </button>
        {
          query && (
            <a
              href={resolveUrl("/admin/documentacion")}
              class="btn btn-ghost btn-sm"
            >
              Limpiar
            </a>
          )
        }
        <p
          class="text-base-content/60 text-xs font-semibold"
          aria-live="polite"
        >
          {
            query
              ? `${visibleDocs} de ${totalDocs} documentos`
              : `${totalDocs} documentos`
          }
        </p>
      </div>
    </form>

    {
      filteredSections.map((section) => (
        <section class="space-y-3">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <div>
              <h2 class="text-base-content text-xl font-bold">
                {section.label}
              </h2>
              <p class="text-base-content/60 text-sm">{section.description}</p>
            </div>
            <span class="badge badge-ghost badge-sm">
              {section.docs.length}
            </span>
          </div>

          <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
            {section.docs.map((doc) => (
              <a
                href={getDocUrl(doc.slug)}
                class="group border-base-300 bg-base-100 hover:border-secondary/60 hover:bg-base-200/40 rounded-box flex flex-col gap-2 border p-4 transition-colors"
              >
                <div class="flex flex-wrap items-center gap-2">
                  <span class="badge badge-ghost badge-sm">
                    {doc.sectionLabel}
                  </span>
                  <span class="text-base-content/50 text-xs">
                    {readingMinutes(doc.wordCount)} min de lectura
                  </span>
                </div>
                <h3 class="text-base-content group-hover:text-secondary text-base leading-snug font-semibold">
                  {labelFor(doc.slug, doc.title)}
                </h3>
                {doc.description && (
                  <p class="text-base-content/65 line-clamp-3 text-sm">
                    {doc.description}
                  </p>
                )}
                <code class="text-base-content/40 mt-auto block truncate text-[0.7rem]">
                  {doc.filePath}
                </code>
              </a>
            ))}
          </div>
        </section>
      ))
    }

    {
      filteredSections.length === 0 && (
        <div class="border-base-300 bg-base-100 rounded-box border p-8 text-center">
          <p class="text-base-content font-semibold">Sin resultados</p>
          <p class="text-base-content/60 mt-1 text-sm">
            No hay documentos que coincidan con “{query}”. Probá con otro
            término.
          </p>
          <a
            href={resolveUrl("/admin/documentacion")}
            class="btn btn-secondary btn-sm mt-4"
          >
            Ver todos los documentos
          </a>
        </div>
      )
    }
  </PageContainer>
</BaseLayout>
