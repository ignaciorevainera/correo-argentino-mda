---
import { getCleanBase } from "@lib/baseUrl";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import AdminShortcutRow from "@components/admin/AdminShortcutRow.astro";
import SyncDashboard from "@components/admin/SyncDashboard.astro";
import AdminInvGateQAStatusCard from "@components/ui/AdminInvGateQAStatusCard.astro";
import AdminWiseCxStatusCard from "@components/ui/AdminWiseCxStatusCard.astro";
import AdminLdapStatusCard from "@components/ui/AdminLdapStatusCard.astro";
import { resolveUrl } from "@lib/url";
import { hasPermission } from "@lib/rbac";
import { getUnassignedFeedbackCount } from "@lib/getUnassignedFeedbackCount";

const user = Astro.locals.user;
const unassignedFeedbackCount = await getUnassignedFeedbackCount();

interface AdminModule {
  title: string;
  icon: string;
  iconTone: string;
  href?: string;
  active: boolean;
}

const cleanBase = getCleanBase();
const canViewDocs = hasPermission("/admin/documentacion", user.role);

const modulesGroup1: AdminModule[] = [
  {
    title: "Usuarios",
    icon: "boxicons:group-filled",
    iconTone: "bg-secondary/10 text-secondary",
    href: "/admin/usuarios",
    active: true,
  },
  {
    title: "Sugerencias y Reportes",
    icon: "boxicons:mail-open-filled",
    iconTone: "bg-warning/10 text-warning",
    href: "/admin/feedback",
    active: true,
  },
  {
    title: "Auditoría",
    icon: "boxicons:history-filled",
    iconTone: "bg-neutral/10 text-neutral",
    href: "/admin/auditoria",
    active: true,
  },
  {
    title: "Papelera",
    icon: "boxicons:trash-filled",
    iconTone: "bg-error/10 text-error",
    href: "/admin/papelera",
    active: true,
  },
];

const modulesGroup2: AdminModule[] = [
  {
    title: "Recursos",
    icon: "boxicons:link-filled",
    iconTone: "bg-accent/10 text-accent",
    href: "/admin/recursos",
    active: true,
  },
  {
    title: "Aplicativos",
    icon: "boxicons:grid-circle-diagonal-right-filled",
    iconTone: "bg-accent/10 text-accent",
    href: "/admin/aplicativos",
    active: true,
  },
  {
    title: "Contactos",
    icon: "boxicons:phone-filled",
    iconTone: "bg-info/10 text-info",
    href: "/admin/contactos",
    active: true,
  },
  {
    title: "Calibración de Calidad IA",
    icon: "boxicons:slider-alt-filled",
    iconTone: "bg-secondary/10 text-secondary",
    href: "/admin/calidad/calibracion",
    active: true,
  },
  ...(canViewDocs
    ? [
        {
          title: "Documentación técnica",
          icon: "boxicons:book-content",
          iconTone: "bg-info/10 text-info",
          href: "/admin/documentacion",
          active: true,
        } satisfies AdminModule,
      ]
    : []),
];

const modulesGroupInvgate: AdminModule[] = [
  {
    title: "Ubicaciones InvGate",
    icon: "boxicons:map-filled",
    iconTone: "bg-secondary/10 text-secondary",
    href: "/admin/invgate/ubicaciones",
    active: true,
  },
  {
    title: "Agrupación de oficinas",
    icon: "boxicons:building-house-filled",
    iconTone: "bg-success/10 text-success",
    href: "/admin/oficinas/edificios",
    active: true,
  },
  {
    title: "Usuarios sin ubicación",
    icon: "boxicons:user-x-filled",
    iconTone: "bg-warning/10 text-warning",
    href: "/admin/usuarios-sin-ubicacion",
    active: true,
  },
];
---

<BaseLayout>
  <PageContainer>
    <PageHeader
      title="Administración"
      description={`Configuración y gestión centralizada del sistema. Bienvenido, ${user.username}.`}
    />

    <SyncDashboard />

    <div class="mb-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <AdminInvGateQAStatusCard />
      <AdminWiseCxStatusCard />
      <AdminLdapStatusCard />
    </div>

    <div
      class="card bg-base-100 border-base-300 divide-base-200 divide-y overflow-hidden border"
    >
      {
        modulesGroup1.map((mod) => {
          const isLocked = mod.href
            ? !hasPermission(mod.href, user.role)
            : false;

          return (
            <AdminShortcutRow
              title={mod.title}
              icon={mod.icon}
              iconTone={mod.iconTone}
              href={mod.href}
              active={mod.active}
              locked={isLocked}
              badgeCount={mod.href === "/admin/feedback" ? unassignedFeedbackCount : 0}
            />
          );
        })
      }
    </div>

    <div
      class="card bg-base-100 border-base-300 divide-base-200 divide-y overflow-hidden border"
    >
      {
        modulesGroup2.map((mod) => (
          <AdminShortcutRow
            title={mod.title}
            icon={mod.icon}
            iconTone={mod.iconTone}
            href={mod.href}
            active={mod.active}
          />
        ))
      }
    </div>

    <div
      class="card bg-base-100 border-base-300 divide-base-200 divide-y overflow-hidden border"
    >
      {
        modulesGroupInvgate.map((mod) => {
          const isLocked = mod.href
            ? !hasPermission(mod.href, user.role)
            : false;

          return (
            <AdminShortcutRow
              title={mod.title}
              icon={mod.icon}
              iconTone={mod.iconTone}
              href={mod.href}
              active={mod.active}
              locked={isLocked}
            />
          );
        })
      }
    </div>
  </PageContainer>
</BaseLayout>
