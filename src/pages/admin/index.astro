---
import { getCleanBase } from "@lib/baseUrl";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import { Icon } from "astro-icon/components";
import SyncDashboard from "@components/admin/SyncDashboard.astro";
import AdminInvGateQAStatusCard from "@components/ui/AdminInvGateQAStatusCard.astro";
import AdminWiseCxStatusCard from "@components/ui/AdminWiseCxStatusCard.astro";
import { resolveUrl } from "@lib/url";
import { can } from "@lib/roleConfig";
import { getUnassignedFeedbackCount } from "@lib/getUnassignedFeedbackCount";

const user = Astro.locals.user;
const unassignedFeedbackCount = await getUnassignedFeedbackCount();

interface AdminModule {
  title: string;
  icon: string;
  iconTone: string;
  href?: string;
  active: boolean;
}

const cleanBase = getCleanBase();

const modulesGroup1: AdminModule[] = [
  {
    title: "Usuarios",
    icon: "boxicons:group-filled",
    iconTone: "text-secondary",
    href: "/admin/usuarios",
    active: true,
  },
  {
    title: "Sugerencias y Reportes",
    icon: "boxicons:mail-open-filled",
    iconTone: "text-primary",
    href: "/admin/feedback",
    active: true,
  },
  {
    title: "Auditoría",
    icon: "boxicons:history",
    iconTone: "text-neutral",
    href: "/admin/auditoria",
    active: true,
  },
];

const modulesGroup2: AdminModule[] = [
  {
    title: "Operadores",
    icon: "boxicons:user-id-card-filled",
    iconTone: "text-error",
    href: "/admin/operadores",
    active: true,
  },
  {
    title: "Recursos",
    icon: "boxicons:link-filled",
    iconTone: "text-accent",
    href: "/admin/recursos",
    active: true,
  },
  {
    title: "Aplicativos",
    icon: "boxicons:grid-circle-diagonal-right-filled",
    iconTone: "text-accent",
    href: "/admin/aplicativos",
    active: true,
  },
  {
    title: "Contactos",
    icon: "boxicons:phone-filled",
    iconTone: "text-primary",
    href: "/admin/contactos",
    active: true,
  },
];

const modulesGroupInvgate: AdminModule[] = [
  {
    title: "Ubicaciones InvGate",
    icon: "boxicons:map-filled",
    iconTone: "text-secondary",
    href: "/admin/invgate/ubicaciones",
    active: true,
  },
];
---

<BaseLayout>
  <PageContainer>
    <PageHeader
      title="Administración"
      description={`Configuración y gestión centralizada del sistema. Bienvenido, ${user.username}.`}
    />

    <SyncDashboard />

    <div class="mb-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-2">
      <AdminInvGateQAStatusCard />
      <AdminWiseCxStatusCard />
    </div>

    <div
      class="card bg-base-100 border-base-300 divide-base-200 divide-y overflow-hidden border"
    >
      {
        modulesGroup1.map((mod) => {
          const isLocked =
            (mod.href === "/admin/usuarios" ||
              mod.href === "/admin/auditoria" ||
              mod.href === "/admin/feedback") &&
            !can(user.role, "admin");

          if (mod.active && mod.href && !isLocked) {
            return (
              <a
                href={resolveUrl(mod.href)}
                class="hover:bg-base-200 group focus-visible:ring-primary flex items-center gap-4 px-6 py-5 transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset"
                aria-label={`Ir a ${mod.title}`}
              >
                <Icon
                  name={mod.icon}
                  size={24}
                  class:list={["shrink-0 transition-colors", mod.iconTone]}
                  aria-hidden="true"
                />
                <span class="text-base-content flex flex-1 flex-wrap items-center gap-2 text-base font-semibold md:text-lg">
                  {mod.title}
                  {mod.href === "/admin/feedback" &&
                    unassignedFeedbackCount > 0 && (
                      <span class="badge badge-error badge-sm rounded-md px-2 py-0.5 text-xs font-semibold">
                        {unassignedFeedbackCount} solicitudes sin asignar
                      </span>
                    )}
                </span>
                <Icon
                  name="boxicons:arrow-right-stroke-circle-filled"
                  size={22}
                  class="text-base-content/30 group-hover:text-base-content/60 transition-colors duration-150"
                  aria-hidden="true"
                />
              </a>
            );
          } else {
            return (
              <div
                aria-disabled="true"
                title={isLocked ? "Acceso restringido por rol" : "Próximamente"}
                class="flex cursor-not-allowed items-center gap-4 px-6 py-5 opacity-40 select-none"
              >
                <Icon
                  name={mod.icon}
                  size={24}
                  class:list={["shrink-0", mod.iconTone]}
                  aria-hidden="true"
                />
                <span class="text-base-content flex-1 text-base font-semibold md:text-lg">
                  {mod.title}
                </span>
                {isLocked ? (
                  <Icon
                    name="boxicons:lock"
                    size={22}
                    class="text-base-content/60"
                    aria-hidden="true"
                  />
                ) : (
                  <span class="badge badge-ghost badge-sm font-medium">
                    Pronto
                  </span>
                )}
              </div>
            );
          }
        })
      }
    </div>

    <div
      class="card bg-base-100 border-base-300 divide-base-200 divide-y overflow-hidden border"
    >
      {
        modulesGroup2.map((mod) => {
          if (mod.active && mod.href) {
            return (
              <a
                href={resolveUrl(mod.href)}
                class="hover:bg-base-200 group focus-visible:ring-primary flex items-center gap-4 px-6 py-5 transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset"
                aria-label={`Ir a ${mod.title}`}
              >
                <Icon
                  name={mod.icon}
                  size={24}
                  class:list={["shrink-0 transition-colors", mod.iconTone]}
                  aria-hidden="true"
                />
                <span class="text-base-content flex-1 text-base font-semibold md:text-lg">
                  {mod.title}
                </span>
                <Icon
                  name="boxicons:arrow-right-stroke-circle-filled"
                  size={22}
                  class="text-base-content/30 group-hover:text-base-content/60 transition-colors duration-150"
                  aria-hidden="true"
                />
              </a>
            );
          } else {
            return (
              <div
                aria-disabled="true"
                title="Próximamente"
                class="flex cursor-not-allowed items-center gap-4 px-6 py-5 opacity-40 select-none"
              >
                <Icon
                  name={mod.icon}
                  size={24}
                  class:list={["shrink-0", mod.iconTone]}
                  aria-hidden="true"
                />
                <span class="text-base-content flex-1 text-base font-semibold md:text-lg">
                  {mod.title}
                </span>
                <span class="badge badge-ghost badge-sm font-medium">
                  Pronto
                </span>
              </div>
            );
          }
        })
      }
    </div>

    <div
      class="card bg-base-100 border-base-300 divide-base-200 divide-y overflow-hidden border"
    >
      {
        modulesGroupInvgate.map((mod) => {
          const isLocked =
            mod.href === "/admin/invgate/ubicaciones" &&
            !can(user.role, "team_leader");

          if (mod.active && mod.href && !isLocked) {
            return (
              <a
                href={resolveUrl(mod.href)}
                class="hover:bg-base-200 group focus-visible:ring-primary flex items-center gap-4 px-6 py-5 transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset"
                aria-label={`Ir a ${mod.title}`}
              >
                <Icon
                  name={mod.icon}
                  size={24}
                  class:list={["shrink-0 transition-colors", mod.iconTone]}
                  aria-hidden="true"
                />
                <span class="text-base-content flex-1 text-base font-semibold md:text-lg">
                  {mod.title}
                </span>
                <Icon
                  name="boxicons:arrow-right-stroke-circle-filled"
                  size={22}
                  class="text-base-content/30 group-hover:text-base-content/60 transition-colors duration-150"
                  aria-hidden="true"
                />
              </a>
            );
          } else {
            return (
              <div
                aria-disabled="true"
                title={isLocked ? "Acceso restringido por rol" : "Próximamente"}
                class="flex cursor-not-allowed items-center gap-4 px-6 py-5 opacity-40 select-none"
              >
                <Icon
                  name={mod.icon}
                  size={24}
                  class:list={["shrink-0", mod.iconTone]}
                  aria-hidden="true"
                />
                <span class="text-base-content flex-1 text-base font-semibold md:text-lg">
                  {mod.title}
                </span>
                {isLocked ? (
                  <Icon
                    name="boxicons:lock"
                    size={22}
                    class="text-base-content/60"
                    aria-hidden="true"
                  />
                ) : (
                  <span class="badge badge-ghost badge-sm font-medium">
                    Pronto
                  </span>
                )}
              </div>
            );
          }
        })
      }
    </div>
  </PageContainer>
</BaseLayout>
