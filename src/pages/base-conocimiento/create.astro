---
import { and, eq, or } from "drizzle-orm";
import { db } from "@db/index";
import { mesas } from "@db/schema";
import { MDA_TI_HELPDESK } from "@lib/helpdeskAccess";
import FormShell from "@components/ui/FormShell.astro";
import FormField from "@components/ui/forms/FormField.astro";
import SelectField from "@components/ui/forms/SelectField.astro";
import SectionCard from "@components/ui/SectionCard.astro";
import KbEditor from "@components/base-conocimiento/KbEditor.astro";
import { can } from "@lib/roleConfig";
import { getModulePermissions } from "@lib/rbac";
import { kbArticleSchema } from "@lib/validations";
import { createArticle } from "@lib/kb";
import { categoryKey, listCategories } from "@lib/kbCategories";
import { logAdminActionStructured } from "@lib/auditLogger";
import { redirectWithToast } from "@lib/api/redirectWithToast";
import { getCsrfTokenForSession, validateCsrfToken } from "@lib/csrf";
import { resolveUrl } from "@lib/url";
import { getCleanBase } from "@lib/baseUrl";
import type { ToastType } from "@lib/toastClient";

type ArticleStatus = "draft" | "published" | "archived";

type MesaOption = {
  id: number;
  name: string;
};

const statusOptions: Array<{ value: ArticleStatus; label: string }> = [
  { value: "draft", label: "Borrador" },
  { value: "published", label: "Publicado" },
  { value: "archived", label: "Archivado" },
];

const habilitadaCondition = and(
  eq(mesas.active, true),
  or(eq(mesas.assignable, true), eq(mesas.name, MDA_TI_HELPDESK)),
);

const loadActiveMesas = () =>
  db
    .select({ id: mesas.invgateId, name: mesas.name })
    .from(mesas)
    .where(habilitadaCondition)
    .orderBy(mesas.name)
    .all();

const user = Astro.locals.user;
const canWrite = getModulePermissions("base-conocimiento", user.role).canWrite;

if (!canWrite) {
  return redirectWithToast(
    "/base-conocimiento",
    "No tenés permisos para crear artículos.",
    "error",
  );
}

const sessionHelpdeskId = user.helpdeskId;
if (
  typeof sessionHelpdeskId !== "number" ||
  !Number.isInteger(sessionHelpdeskId) ||
  sessionHelpdeskId <= 0
) {
  return redirectWithToast(
    "/base-conocimiento",
    "Tu usuario no tiene una mesa asignada.",
    "error",
  );
}

const isAdmin = can(user.role, "admin");
const csrfToken = getCsrfTokenForSession(Astro.locals.sessionId);
let errorMsg = "";
let toastType: ToastType = "alert-error";
let activeMesas: MesaOption[] = [];
let formValues = {
  title: "",
  category: "",
  content: "",
  status: "draft",
  helpdeskId: String(sessionHelpdeskId),
};

if (isAdmin) {
  try {
    activeMesas = loadActiveMesas();
    if (activeMesas.length === 0) {
      errorMsg = "No hay mesas activas disponibles para crear el artículo.";
    }
  } catch (error) {
    console.error("[KbCreate] Error cargando las mesas:", error);
    errorMsg = "No se pudieron cargar las mesas disponibles.";
  }
}

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    formValues.title = formData.get("title")?.toString() ?? "";
    formValues.category = formData.get("category")?.toString() ?? "";
    formValues.content = formData.get("content")?.toString() ?? "";
    formValues.status = formData.get("status")?.toString().trim() || "draft";
    const rawHelpdeskId = formData.get("helpdeskId")?.toString().trim() ?? "";
    if (isAdmin) {
      formValues.helpdeskId = rawHelpdeskId;
    }

    if (
      !Astro.locals.sessionId ||
      !validateCsrfToken(
        String(formData.get("csrf_token") ?? ""),
        Astro.locals.sessionId,
      )
    ) {
      const csrfMsg =
        "No pudimos validar tu sesión. Revisá el contenido y volvé a guardar.";
      errorMsg = errorMsg ? `${errorMsg} ${csrfMsg}` : csrfMsg;
    } else {
      let helpdeskId: number | null = sessionHelpdeskId;

      if (isAdmin) {
        const parsedHelpdeskId = Number(rawHelpdeskId);

        if (!rawHelpdeskId) {
          errorMsg = "Seleccioná una mesa para crear el artículo.";
          helpdeskId = null;
        } else if (
          !Number.isInteger(parsedHelpdeskId) ||
          parsedHelpdeskId <= 0
        ) {
          errorMsg = "La mesa indicada no existe o está inactiva.";
          helpdeskId = null;
        } else {
          const [activeMesa] = await db
            .select({ id: mesas.invgateId })
            .from(mesas)
            .where(
              and(eq(mesas.invgateId, parsedHelpdeskId), habilitadaCondition),
            )
            .limit(1);

          if (!activeMesa) {
            errorMsg = "La mesa indicada no existe o está inactiva.";
            helpdeskId = null;
          } else {
            helpdeskId = parsedHelpdeskId;
          }
        }
      }

      const parsed = kbArticleSchema.safeParse({
        title: formValues.title,
        category: formValues.category,
        content: formValues.content,
        status: formValues.status,
      });

      if (!parsed.success) {
        const validationMsg = parsed.error.issues
          .map((issue) => issue.message)
          .join(", ");
        errorMsg = errorMsg ? `${errorMsg} ${validationMsg}` : validationMsg;
      } else if (helpdeskId === null) {
        if (!errorMsg) {
          errorMsg = "La mesa indicada no existe o está inactiva.";
        }
      } else if (
        parsed.data.category &&
        !listCategories(helpdeskId).some(
          (category) =>
            categoryKey(category.name) === categoryKey(parsed.data.category),
        )
      ) {
        errorMsg = "La categoría seleccionada no es válida.";
      } else {
        const articleId = createArticle({
          helpdeskId,
          title: parsed.data.title,
          content: parsed.data.content,
          category: parsed.data.category,
          status: parsed.data.status,
          authorUserId: user.id,
          publishedByUserId: user.id,
        });

        if (articleId === null) {
          errorMsg = "No se pudo guardar el artículo. Intentá de nuevo.";
        } else {
          await logAdminActionStructured(
            user.username || "Sistema",
            `Creó el artículo "${parsed.data.title}"`,
            "kb_article",
            articleId,
            null,
            {
              title: parsed.data.title,
              helpdeskId,
              category: parsed.data.category ?? null,
              status: parsed.data.status,
            },
          );
          return redirectWithToast(
            "/base-conocimiento",
            "Artículo creado con éxito.",
          );
        }
      }
    }
  } catch (error) {
    console.error("[KbCreate] Error guardando el artículo:", error);
    errorMsg = "No se pudo guardar el artículo. Intentá de nuevo.";
  }
}

const mesaParamRaw = Astro.url.searchParams.get("mesa") ?? "";
const mesaParamId = Number(mesaParamRaw);
if (
  isAdmin &&
  Astro.request.method !== "POST" &&
  Number.isInteger(mesaParamId) &&
  mesaParamId > 0
) {
  const [mesaParam] = await db
    .select({ id: mesas.invgateId })
    .from(mesas)
    .where(and(eq(mesas.invgateId, mesaParamId), habilitadaCondition))
    .limit(1);

  if (mesaParam) {
    formValues.helpdeskId = String(mesaParamId);
  }
}

const parsedEditorHelpdeskId = Number(formValues.helpdeskId);
const editorTargetHelpdeskId =
  Number.isInteger(parsedEditorHelpdeskId) && parsedEditorHelpdeskId > 0
    ? parsedEditorHelpdeskId
    : sessionHelpdeskId;
const targetCategories = editorTargetHelpdeskId
  ? listCategories(editorTargetHelpdeskId)
  : [];
const nuevaCategoria = Astro.url.searchParams.get("nueva_categoria") ?? "";
const categoriaOptions = [
  { value: "", label: "Sin categoría" },
  ...targetCategories.map((category) => ({
    value: category.name,
    label: category.name,
  })),
];
const categoriaSeleccionada =
  nuevaCategoria &&
  !targetCategories.some(
    (c) => categoryKey(c.name) === categoryKey(nuevaCategoria),
  )
    ? [...categoriaOptions, { value: nuevaCategoria, label: nuevaCategoria }]
    : categoriaOptions;
---

<FormShell
  backHref={resolveUrl("/base-conocimiento")}
  title="Nuevo artículo"
  subtitle="Completá los datos para crear un artículo en la base de conocimiento."
  formId="kb-article-form"
  saveLabel="Crear artículo"
  containerWidth="xxl"
>
  <script is:inline define:vars={{ errorMsg, toastType }}>
    if (errorMsg) {
      window.addEventListener("load", () =>
        window.showToast?.(errorMsg, toastType),
      );
    }
  </script>

  <script>
    const formElement = document.getElementById("kb-article-form");
    if (formElement instanceof HTMLFormElement) {
      formElement.addEventListener("submit", (event) => {
        if (formElement.dataset.submitting === "true") {
          event.preventDefault();
          return;
        }

        queueMicrotask(() => {
          if (event.defaultPrevented) return;
          formElement.dataset.submitting = "true";
          const submitButton = formElement.querySelector<HTMLButtonElement>(
            'button[type="submit"]:not([form])',
          );
          if (submitButton) {
            submitButton.disabled = true;
            submitButton.classList.add("btn-disabled");
          }
        });
      });
    }
  </script>

  <input type="hidden" name="csrf_token" value={csrfToken} />

  <SectionCard title="Datos del artículo" icon="boxicons:article-filled">
    <div class="space-y-6 p-6 sm:p-8">
      <div
        data-kb-fields-row
        class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4"
      >
        <FormField
          id="kb-title"
          name="title"
          label="Título"
          required
          value={formValues.title}
          placeholder="Ej: Configurar una cuenta de correo"
          maxlength={120}
          autofocus
          class="min-w-0"
        />

        <SelectField
          id="kb-category"
          name="category"
          label="Categoría"
          options={categoriaSeleccionada}
          value={nuevaCategoria || formValues.category}
          helpText="Opcional"
          class="min-w-0"
        />

        <div class="min-w-0" data-kb-mesa-cell>
          {
            isAdmin ? (
              <SelectField
                id="kb-helpdesk"
                name="helpdeskId"
                label="Mesa"
                required
                options={activeMesas.map((mesa) => ({
                  value: String(mesa.id),
                  label: mesa.name,
                }))}
                value={formValues.helpdeskId}
                helpText="La mesa donde se publica el artículo."
                selectClass="truncate"
              />
            ) : (
              <div class="min-w-0">
                <span class="fieldset-legend font-bold tracking-wider">
                  Mesa
                </span>
                <p class="text-base-content/70 py-2 text-sm break-words">
                  <span class="font-semibold">{user.helpdeskName}</span>
                </p>
              </div>
            )
          }
        </div>

        <SelectField
          id="kb-status"
          name="status"
          label="Estado"
          required
          options={statusOptions}
          value={formValues.status}
          helpText="Los lectores solo pueden ver artículos publicados."
          class="min-w-0"
        />
      </div>

      <div class="flex justify-end">
        <a
          href={`${getCleanBase()}base-conocimiento/categorias`}
          class="link link-secondary link-hover text-xs"
        >
          Administrar categorías
        </a>
      </div>

      <details class="collapse-arrow border-base-300 collapse border">
        <summary class="collapse-title font-semibold">Nueva categoría</summary>
        <div class="collapse-content">
          <div class="flex flex-wrap items-end gap-3">
            <label class="fieldset flex-1">
              <span class="fieldset-legend font-bold tracking-wider"
                >Nombre de la nueva categoría</span
              >
              <input
                type="text"
                name="name"
                form="kb-new-category-form"
                required
                minlength="2"
                maxlength="60"
                class="input w-full"
              />
            </label>
            <button
              type="submit"
              form="kb-new-category-form"
              class="btn btn-secondary"
            >
              Crear categoría
            </button>
          </div>
          <p class="text-base-content/60 mt-2 text-xs">
            Al crearla volvés a este formulario con la categoría seleccionada.
          </p>
        </div>
      </details>

      <div class="space-y-2">
        <label
          for="kb-content"
          class="fieldset-legend font-bold tracking-wider"
        >
          Contenido <span class="text-error">*</span>
        </label>
        <KbEditor
          id="kb-content"
          name="content"
          required
          value={formValues.content}
          targetHelpdeskId={editorTargetHelpdeskId}
          data-kb-target-mesa-selector={isAdmin ? "#kb-helpdesk" : undefined}
          helpText="Escribí el contenido en Markdown. Las imágenes se guardan en la mesa seleccionada."
        />
      </div>
    </div>
  </SectionCard>
</FormShell>

<form
  id="kb-new-category-form"
  method="POST"
  action={resolveUrl("/base-conocimiento/categorias")}
  class="hidden"
>
  <input type="hidden" name="action" value="create" />
  <input
    id="kb-new-category-return-to"
    type="hidden"
    name="returnTo"
    value={isAdmin
      ? `/base-conocimiento/create?mesa=${formValues.helpdeskId}`
      : "/base-conocimiento/create"}
  />
  <input type="hidden" name="csrf_token" value={csrfToken} />
  {
    isAdmin && (
      <input
        id="kb-new-category-helpdesk"
        type="hidden"
        name="helpdeskId"
        value={formValues.helpdeskId}
      />
    )
  }
</form>

<script>
  const helpdeskSelect = document.getElementById("kb-helpdesk");
  const categoryHelpdeskInput = document.getElementById(
    "kb-new-category-helpdesk",
  );
  const categoryReturnToInput = document.getElementById(
    "kb-new-category-return-to",
  );
  if (
    helpdeskSelect instanceof HTMLSelectElement &&
    categoryHelpdeskInput instanceof HTMLInputElement
  ) {
    const syncCategoryHelpdesk = () => {
      categoryHelpdeskInput.value = helpdeskSelect.value;
      if (categoryReturnToInput instanceof HTMLInputElement) {
        const nextReturnTo = new URL(
          categoryReturnToInput.value,
          window.location.origin,
        );
        nextReturnTo.searchParams.set("mesa", helpdeskSelect.value);
        categoryReturnToInput.value =
          nextReturnTo.pathname + nextReturnTo.search;
      }
    };
    helpdeskSelect.addEventListener("change", syncCategoryHelpdesk);
    syncCategoryHelpdesk();
  }
</script>

<script>
  if (new URLSearchParams(window.location.search).has("nueva_categoria")) {
    window.addEventListener("load", () => {
      const url = new URL(window.location.href);
      url.searchParams.delete("nueva_categoria");
      url.searchParams.delete("toast_msg");
      url.searchParams.delete("toast_type");
      window.history.replaceState({}, "", url.pathname + url.search);
    });
  }
</script>
