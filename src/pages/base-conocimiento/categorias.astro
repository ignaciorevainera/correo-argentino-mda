---
import { and, eq, or } from "drizzle-orm";
import { db } from "@db/index";
import { mesas } from "@db/schema";
import { getModulePermissions } from "@lib/rbac";
import { can } from "@lib/roleConfig";
import { logAdminActionStructured } from "@lib/auditLogger";
import { redirectWithToast } from "@lib/api/redirectWithToast";
import { getCsrfTokenForSession, validateCsrfToken } from "@lib/csrf";
import { MDA_TI_HELPDESK } from "@lib/helpdeskAccess";
import { getCleanBase } from "@lib/baseUrl";
import {
  buildCategoryRedirectTarget,
  isCategoryFormKbPath,
  kbPathname,
  KB_CATEGORIAS_PATH,
  normalizeKbReturnPath,
} from "@lib/kbRedirects";
import {
  categoryKey,
  createCategory,
  deleteCategory,
  listCategories,
  listCategoryCounts,
  renameCategory,
} from "@lib/kbCategories";
import { resolveUrl } from "@lib/url";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import SectionCard from "@components/ui/SectionCard.astro";
import ActionButton from "@components/ui/ActionButton.astro";
import FormField from "@components/ui/forms/FormField.astro";

const user = Astro.locals.user;
const perms = getModulePermissions("base-conocimiento", user.role);
if (!perms.canWrite) {
  return redirectWithToast(
    "/base-conocimiento",
    "Acceso no autorizado",
    "error",
  );
}

const sessionHelpdeskId = user.helpdeskId;
const isAdmin = can(user.role, "admin");

const csrfToken = getCsrfTokenForSession(Astro.locals.sessionId);

const cleanBase = getCleanBase();
const returnToRaw = Astro.url.searchParams.get("returnTo") ?? "";
const returnTo =
  normalizeKbReturnPath(returnToRaw, cleanBase) ?? KB_CATEGORIAS_PATH;

let errorMsg = "";
let successMsg = "";

type KbCategoryAudit = {
  action: string;
  entityId: number;
  before: Record<string, unknown> | null;
  after: Record<string, unknown> | null;
};
let audit: KbCategoryAudit | null = null;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  if (
    !Astro.locals.sessionId ||
    !validateCsrfToken(
      String(formData.get("csrf_token") ?? ""),
      Astro.locals.sessionId,
    )
  ) {
    return redirectWithToast(
      returnTo,
      "Token CSRF inválido o ausente",
      "error",
    );
  }
  const action = String(formData.get("action") ?? "");
  const postedReturnTo = String(formData.get("returnTo") ?? "");
  const postedReturnToNormalized = normalizeKbReturnPath(
    postedReturnTo,
    cleanBase,
  );
  const effectiveReturnTo = postedReturnToNormalized ?? returnTo;
  const postedHelpdeskId = Number(formData.get("helpdeskId") ?? 0);
  const isInlineFromForm =
    postedReturnToNormalized !== null &&
    postedReturnToNormalized !== KB_CATEGORIAS_PATH;
  let targetHelpdeskId = sessionHelpdeskId;
  let createdName = "";

  if (isAdmin && Number.isInteger(postedHelpdeskId) && postedHelpdeskId > 0) {
    const [mesa] = db
      .select({ id: mesas.invgateId })
      .from(mesas)
      .where(
        and(
          eq(mesas.invgateId, postedHelpdeskId),
          eq(mesas.active, true),
          or(eq(mesas.assignable, true), eq(mesas.name, MDA_TI_HELPDESK)),
        ),
      )
      .limit(1)
      .all();

    if (mesa) {
      targetHelpdeskId = postedHelpdeskId;
    } else {
      errorMsg = "La mesa indicada no existe o está deshabilitada.";
    }
  }

  if (targetHelpdeskId === null || targetHelpdeskId <= 0) {
    errorMsg = errorMsg || "Tu usuario no tiene mesa asignada.";
  } else if (!errorMsg) {
    const name = String(formData.get("name") ?? "");
    const id = Number(formData.get("id") ?? 0);

    if (action === "create") {
      const result = createCategory({
        helpdeskId: targetHelpdeskId,
        name,
        userId: user.id,
      });
      if (result.ok) {
        successMsg = `Categoría "${result.name}" creada.`;
        createdName = result.name;
        audit = {
          action: `Creó la categoría "${result.name}"`,
          entityId: result.id,
          before: null,
          after: { name: result.name, helpdeskId: targetHelpdeskId },
        };
      } else if (result.reason === "duplicate") {
        errorMsg = "Ya existe una categoría con ese nombre en la mesa.";
      } else {
        errorMsg = "El nombre debe tener entre 2 y 60 caracteres.";
      }
    } else if (action === "rename") {
      const result = renameCategory({ id, helpdeskId: targetHelpdeskId, name });
      if (result.ok) {
        successMsg = "Categoría actualizada.";
        audit = {
          action: `Actualizó la categoría "${result.previousName}" → "${result.name}"`,
          entityId: id,
          before: { name: result.previousName, helpdeskId: targetHelpdeskId },
          after: {
            name: result.name,
            helpdeskId: targetHelpdeskId,
            articlesUpdated: result.articlesUpdated,
          },
        };
      } else if (result.reason === "duplicate") {
        errorMsg = "Ya existe una categoría con ese nombre en la mesa.";
      } else if (result.reason === "not_found") {
        errorMsg = "La categoría no existe.";
      } else {
        errorMsg = "El nombre debe tener entre 2 y 60 caracteres.";
      }
    } else if (action === "delete") {
      const result = deleteCategory({ id, helpdeskId: targetHelpdeskId });
      if (result.ok) {
        successMsg = "Categoría eliminada.";
        audit = {
          action: `Eliminó la categoría "${result.name}"`,
          entityId: id,
          before: {
            name: result.name,
            helpdeskId: targetHelpdeskId,
            articlesInUse: 0,
          },
          after: null,
        };
      } else if (result.reason === "in_use") {
        errorMsg =
          "La categoría está en uso en artículos y no se puede eliminar.";
        audit = {
          action: `No eliminó la categoría "${result.name}": en uso en ${result.articlesInUse} artículo(s)`,
          entityId: id,
          before: {
            name: result.name,
            helpdeskId: targetHelpdeskId,
            articlesInUse: result.articlesInUse,
          },
          after: null,
        };
      } else {
        errorMsg = "La categoría no existe.";
      }
    }
  }

  if (audit) {
    await logAdminActionStructured(
      user.username || "Sistema",
      audit.action,
      "kb_category",
      audit.entityId,
      audit.before,
      audit.after,
    );
  }

  if (successMsg) {
    return redirectWithToast(
      buildCategoryRedirectTarget({
        returnTo: effectiveReturnTo,
        base: cleanBase,
        createdName,
        fromCategoryForm: isInlineFromForm
          ? isCategoryFormKbPath(kbPathname(effectiveReturnTo))
          : false,
      }),
      successMsg,
      "success",
    );
  }

  if (errorMsg && isInlineFromForm) {
    return redirectWithToast(effectiveReturnTo, errorMsg, "error");
  }
}

const categorias = sessionHelpdeskId ? listCategories(sessionHelpdeskId) : [];
const conteos = sessionHelpdeskId
  ? listCategoryCounts(sessionHelpdeskId)
  : new Map<string, number>();
const editParam = Number(Astro.url.searchParams.get("edit") ?? 0);
const editingId =
  Number.isInteger(editParam) && editParam > 0 ? editParam : null;
const categoriasHref = resolveUrl(KB_CATEGORIAS_PATH);
---

<BaseLayout title="Categorías">
  <PageContainer>
    <PageHeader
      title="Categorías"
      description="Administrá las categorías disponibles para los artículos de tu mesa."
    />

    {
      errorMsg && (
        <div role="alert" class="alert alert-error mb-4">
          {errorMsg}
        </div>
      )
    }

    <SectionCard title="Categorías de la mesa" icon="boxicons:grid-filled">
      <div class="space-y-6 p-6 sm:p-8">
        <form method="POST" class="flex flex-wrap items-end gap-3">
          <input type="hidden" name="action" value="create" />
          <input type="hidden" name="returnTo" value={returnTo} />
          <input type="hidden" name="csrf_token" value={csrfToken} />
          <FormField
            id="kb-category-name"
            name="name"
            label="Nombre"
            required
            minlength={2}
            maxlength={60}
            placeholder="Ej: Redes"
            class="flex-1"
          />
          <button type="submit" class="btn btn-primary"
            >Agregar categoría</button
          >
        </form>

        <ul data-kb-categories-list class="divide-base-300 divide-y">
          {
            categorias.map((categoria) => {
              const editing = editingId === categoria.id;
              return (
                <li class="py-3">
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <div>
                      <p class="font-semibold">{categoria.name}</p>
                      <p class="text-base-content/60 text-xs">
                        {conteos.get(categoryKey(categoria.name)) ?? 0} artículo(s)
                      </p>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                      <ActionButton
                        href={`${categoriasHref}?edit=${categoria.id}`}
                        icon="boxicons:pencil-filled"
                        ariaLabel={`Editar ${categoria.name}`}
                        size="xs"
                      />
                      <form
                        method="POST"
                        onsubmit="return confirm('¿Eliminar esta categoría?');"
                      >
                        <input type="hidden" name="action" value="delete" />
                        <input type="hidden" name="id" value={categoria.id} />
                        <input type="hidden" name="returnTo" value={returnTo} />
                        <input type="hidden" name="csrf_token" value={csrfToken} />
                        <ActionButton
                          type="submit"
                          icon="boxicons:trash-filled"
                          ariaLabel={`Eliminar ${categoria.name}`}
                          size="xs"
                          color="btn-error"
                        />
                      </form>
                    </div>
                  </div>

                  {editing && (
                    <form
                      method="POST"
                      class="border-base-300 mt-3 flex flex-wrap items-center gap-2 border-t pt-3"
                    >
                      <input type="hidden" name="action" value="rename" />
                      <input type="hidden" name="id" value={categoria.id} />
                      <input type="hidden" name="returnTo" value={returnTo} />
                      <input type="hidden" name="csrf_token" value={csrfToken} />
                      <FormField
                        id={`kb-category-rename-${categoria.id}`}
                        name="name"
                        label="Nuevo nombre"
                        required
                        value={categoria.name}
                        minlength={2}
                        maxlength={60}
                        size="sm"
                      />
                      <button type="submit" class="btn btn-sm btn-primary">
                        Guardar {categoria.name}
                      </button>
                      <a class="btn btn-sm" href={categoriasHref}>
                        Cancelar
                      </a>
                    </form>
                  )}
                </li>
              );
            })
          }
        </ul>
      </div>
    </SectionCard>
  </PageContainer>
</BaseLayout>
