---
import { resolveLifecycleLabel } from "@lib/workflow/automation-status";

interface Props {
  statusId: number;
  hasClosure?: boolean;
  /** En curso: se resalta en secondary para diferenciarla de las finalizadas. */
  active?: boolean;
  class?: string;
}

const {
  statusId,
  hasClosure = false,
  active = false,
  class: className = "",
} = Astro.props;
---

<span
  class:list={[
    "text-xs font-semibold tracking-wide uppercase whitespace-nowrap",
    active ? "text-secondary" : "text-base-content/60",
    className,
  ]}
>
  {resolveLifecycleLabel(statusId, hasClosure)}
</span>
