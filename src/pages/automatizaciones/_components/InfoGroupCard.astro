---
interface Props {
  title: string;
  /** Valor principal; si se omite, solo se muestra el título y las filas. */
  primary?: string;
}

const { title, primary } = Astro.props;
---

<div class="bg-base-100 rounded-xl p-5">
  <h3 class="text-base-content/60 text-xs font-semibold tracking-wide uppercase">
    {title}
  </h3>
  {primary && <p class="text-base-content mt-1 text-base font-semibold">{primary}</p>}
  <dl class="mt-3 grid gap-x-6 gap-y-2 text-sm">
    <slot />
  </dl>
</div>
