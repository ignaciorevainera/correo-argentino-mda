---
import BaseLayout from "@layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
---

<BaseLayout title="Página no encontrada">
  <div
    class="flex min-h-[80vh] flex-col items-center justify-center gap-6 px-4 text-center"
  >
    <Icon
      name="boxicons:sad"
      size={224}
      class="text-base-content/20"
      aria-hidden="true"
    />
    <div>
      <span class="text-base-content text-4xl font-black tracking-tight">
        Página no encontrada
      </span>
      <p class="text-base-content/70 mt-2 max-w-xl text-xl">
        La ruta solicitada no existe o fue movida.
      </p>
    </div>
    <a href="/" class="btn btn-primary btn-lg"> Volver al inicio </a>
  </div>
</BaseLayout>
