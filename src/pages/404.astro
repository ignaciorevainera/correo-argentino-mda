---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCleanBase } from "@lib/baseUrl";
import ActionButton from "@components/ui/ActionButton.astro";

const homeUrl = getCleanBase();
---

<BaseLayout title="Página no encontrada" bare={true}>
  <main
    class="relative flex min-h-screen flex-col overflow-hidden bg-base-100"
  >
    <div
      class="absolute inset-0 flex flex-col items-center justify-center"
      aria-hidden="true"
    >
      {
        Array.from({ length: 7 }).map((_, i) => (
          <span
            key={i}
            class="text-base-content/5 text-[22vw] font-black leading-none tracking-tighter select-none"
          >
            404
          </span>
        ))
      }
    </div>
    <div
      class="relative z-10 flex flex-1 flex-col items-center justify-center gap-8 px-6 text-center"
    >
      <div class="space-y-2">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-base-content">
          Página no encontrada
        </h1>
        <p class="text-base md:text-lg text-base-content/60 max-w-md mx-auto">
          El recurso solicitado no existe o no se encuentra disponible.
        </p>
      </div>
      <ActionButton
        href={homeUrl}
        icon="boxicons:arrow-back"
        label="Volver al inicio"
        variant="soft"
        color="btn-primary"
      />
    </div>
  </main>
</BaseLayout>
