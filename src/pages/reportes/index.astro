---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageContainer from "@components/ui/PageContainer.astro";
import MetricsHeader from "@components/ui/MetricsHeader.astro";
import QuickAccessCard from "@components/ui/QuickAccessCard.astro";
import MetricBentoWidget from "@components/reportes/dashboard/MetricBentoWidget.astro";
import { Icon } from "astro-icon/components";
import { getCleanBase } from "@lib/baseUrl";
import { db } from "@db/index";
import { offices, terminals, automationParents } from "@db/schema";
import { eq, sql, isNotNull } from "drizzle-orm";
import { getCategoryCatalogReport } from "@lib/categories/service";
import { getHelpdesksReport } from "@lib/helpdesks/service";
import { getWorkflowReport } from "@lib/workflows/service";
import { getAutomationMetrics } from "@lib/workflow/metrics";

const cleanBase = getCleanBase();

// 1. Categorías
let categoryMetrics = {
  totalNodes: 719,
  deadNodes: 377,
  wastePercent: 52,
  maxDepth: 6,
};
try {
  const catReport = await getCategoryCatalogReport(2);
  const depths = Object.keys(catReport.metrics.depthDistribution || {}).map(
    Number,
  );
  const maxDepth = depths.length > 0 ? Math.max(...depths) : 6;
  categoryMetrics = {
    totalNodes: catReport.metrics.totalNodes,
    deadNodes: catReport.metrics.deadNodes,
    wastePercent: catReport.metrics.structuralWastePercent,
    maxDepth,
  };
} catch {
  // Fallback seguro
}

// 2. Mesas de Ayuda
let helpdeskMetrics = {
  totalIncoming: 0,
  totalResolved: 0,
  totalActive: 0,
  desksCount: 0,
};
try {
  const hdReport = await getHelpdesksReport();
  const items = hdReport.items || [];
  const incoming = items.reduce(
    (acc, h) => acc + (h.incomingTicketsMonth || 0),
    0,
  );
  const resolved = items.reduce(
    (acc, h) => acc + (h.resolvedTicketsMonth || 0),
    0,
  );
  const active = items.reduce((acc, h) => acc + (h.backlog?.active || 0), 0);
  helpdeskMetrics = {
    totalIncoming: incoming,
    totalResolved: resolved,
    totalActive: active,
    desksCount: items.length,
  };
} catch {
  // Fallback seguro
}

const helpdeskBalance =
  helpdeskMetrics.totalResolved - helpdeskMetrics.totalIncoming;

// 3. Workflows de Proceso
let workflowMetrics = {
  totalCount: 0,
  completedCount: 0,
  activeCount: 0,
  slaPercent: 0,
  avgHours: 0,
};
try {
  const wfReport = await getWorkflowReport("implementacion");
  workflowMetrics = {
    totalCount: wfReport.overview.totalInstances,
    completedCount: wfReport.overview.completedInstances,
    activeCount: wfReport.overview.activeInstances,
    slaPercent: wfReport.overview.slaCompliancePercent,
    avgHours: wfReport.overview.avgLeadTimeHours || 0,
  };
} catch {
  // Fallback seguro
}

// 4. Red de Oficinas
let officeMetrics = { total: 0, active: 0, withTerminals: 0 };
try {
  const [totalRes] = await db
    .select({ count: sql<number>`count(*)` })
    .from(offices);
  const [activeRes] = await db
    .select({ count: sql<number>`count(*)` })
    .from(offices)
    .where(eq(offices.active, true));
  const [withTermRes] = await db
    .select({ count: sql<number>`count(distinct ${terminals.nis})` })
    .from(terminals)
    .where(isNotNull(terminals.nis));
  officeMetrics = {
    total: totalRes?.count || 0,
    active: activeRes?.count || 0,
    withTerminals: withTermRes?.count || 0,
  };
} catch {
  // Fallback seguro
}

// 5. Inventario de Terminales
let terminalMetrics = { total: 0, winCount: 0, brandsCount: 0 };
try {
  const [totalTermRes] = await db
    .select({ count: sql<number>`count(*)` })
    .from(terminals);
  const [winRes] = await db
    .select({ count: sql<number>`count(*)` })
    .from(terminals)
    .where(sql`operating_system LIKE '%Windows%'`);
  const [brandsRes] = await db
    .select({ count: sql<number>`count(distinct ${terminals.manufacturer})` })
    .from(terminals)
    .where(isNotNull(terminals.manufacturer));
  terminalMetrics = {
    total: totalTermRes?.count || 0,
    winCount: winRes?.count || 0,
    brandsCount: brandsRes?.count || 0,
  };
} catch {
  // Fallback seguro
}

// 6. Automatizaciones
let automationMetrics = { totalParents: 0, totalClosed: 0, inProgress: 0 };
try {
  const autReport = getAutomationMetrics();
  automationMetrics = {
    totalParents: autReport.executive.total,
    totalClosed: autReport.executive.finalized,
    inProgress: autReport.executive.active,
  };
} catch {
  // Fallback seguro
}

const quickShortcuts = [
  {
    title: "Árbol de Categorías",
    href: "reportes/categorias",
    icon: "boxicons:network-chart-filled",
    tone: "bg-info/10 text-info",
  },
  {
    title: "Flujo de Mesas",
    href: "reportes/mesas",
    icon: "boxicons:dashboard-filled",
    tone: "bg-secondary/10 text-secondary",
  },
  {
    title: "Workflows de Proceso",
    href: "reportes/workflows",
    icon: "boxicons:git-repo-forked-filled",
    tone: "bg-accent/10 text-accent",
  },
  {
    title: "Red de Oficinas",
    href: "oficinas/estadisticas",
    icon: "boxicons:building-house-filled",
    tone: "bg-success/10 text-success",
  },
  {
    title: "Inventario de Terminales",
    href: "inventario-terminales/estadisticas",
    icon: "boxicons:desktop-filled",
    tone: "bg-accent/10 text-accent",
  },
  {
    title: "Automatizaciones",
    href: "automatizaciones",
    icon: "boxicons:rocket-filled",
    tone: "bg-secondary/10 text-secondary",
  },
];
---

<BaseLayout title="Centro de Métricas | Portal MDA">
  <PageContainer width="xxl">
    <MetricsHeader title="Centro de Métricas y Analítica" />

    <!-- Estructura principal: 2 columnas de widgets a la izquierda, 1 columna de atajos a la derecha -->
    <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-3">
      <!-- Primeras dos columnas: Widgets de resumen (grilla de 2) -->
      <section
        class="space-y-4 lg:col-span-2"
        aria-label="Widgets de resumen y analítica"
      >
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <!-- Widget 1: Taxonomía de Categorías -->
          <MetricBentoWidget
            title="Categorías"
            category="Catálogo"
            href="reportes/categorias"
            icon="boxicons:network-chart-filled"
            iconTone="text-info"
            iconBoxTone="bg-info/10"
            badge={`${categoryMetrics.totalNodes} nodos`}
            badgeTone="badge-soft badge-info"
          >
            <div class="space-y-3 text-sm">
              <div
                class="border-base-200/50 flex items-baseline justify-between border-b py-1"
              >
                <span class="text-base-content/70 text-sm"
                  >Nodos sin tickets</span
                >
                <span class="text-base-content font-mono text-sm font-bold">
                  {categoryMetrics.deadNodes} ({categoryMetrics.wastePercent}%)
                </span>
              </div>
              <div
                class="border-base-200/50 flex items-baseline justify-between border-b py-1"
              >
                <span class="text-base-content/70 text-sm"
                  >Profundidad actual</span
                >
                <span class="text-base-content font-mono text-sm font-bold">
                  {categoryMetrics.maxDepth} niveles
                </span>
              </div>

              <!-- Micro-gráfico: Barra segmentada de optimización del catálogo -->
              <div class="space-y-1.5 pt-1.5">
                <div
                  class="text-base-content/60 flex justify-between font-mono text-xs"
                >
                  <span>Utilidad taxonómica</span>
                  <span>{100 - categoryMetrics.wastePercent}% activos</span>
                </div>
                <div
                  class="bg-base-200 flex h-2.5 w-full overflow-hidden rounded-full"
                >
                  <div
                    class="bg-info h-full transition-all duration-500"
                    style={`width: ${Math.max(5, 100 - categoryMetrics.wastePercent)}%`}
                    title="Nodos con tickets históricos"
                  >
                  </div>
                  <div
                    class="bg-error/40 h-full transition-all duration-500"
                    style={`width: ${categoryMetrics.wastePercent}%`}
                    title="Nodos sin tickets (desperdicio)"
                  >
                  </div>
                </div>
              </div>
            </div>
          </MetricBentoWidget>

          <!-- Widget 2: Flujo de Mesas de Ayuda -->
          <MetricBentoWidget
            title="Mesas de Ayuda"
            category="Soporte"
            href="reportes/mesas"
            icon="boxicons:dashboard-filled"
            iconTone="text-secondary"
            iconBoxTone="bg-secondary/10"
            badge={`${helpdeskMetrics.desksCount} mesas`}
            badgeTone="badge-soft badge-secondary"
          >
            <div class="space-y-3 text-sm">
              <div
                class="border-base-200/50 flex items-baseline justify-between border-b py-1"
              >
                <span class="text-base-content/70 text-sm"
                  >Tickets ingresados</span
                >
                <span
                  data-helpdesk-incoming
                  class="text-base-content font-mono text-sm font-bold"
                >
                  {helpdeskMetrics.totalIncoming.toLocaleString("es-AR")}
                </span>
              </div>
              <div
                class="border-base-200/50 flex items-baseline justify-between border-b py-1"
              >
                <span class="text-base-content/70 text-sm"
                  >Tickets resueltos</span
                >
                <span
                  data-helpdesk-resolved
                  class="text-base-content font-mono text-sm font-bold"
                >
                  {helpdeskMetrics.totalResolved.toLocaleString("es-AR")}
                </span>
              </div>

              <!-- Balance del período: resueltos menos ingresados -->
              <div class="flex items-baseline justify-between py-1">
                <span class="text-base-content/70 text-sm">
                  Balance del período (resueltos − ingresados)
                </span>
                <span
                  data-helpdesk-balance
                  class:list={[
                    "font-mono text-sm font-bold",
                    helpdeskBalance >= 0 ? "text-success" : "text-error",
                  ]}
                >
                  {helpdeskBalance > 0 ? "+" : ""}{helpdeskBalance.toLocaleString(
                    "es-AR",
                  )}
                </span>
              </div>
            </div>
          </MetricBentoWidget>

          <!-- Widget 3: Workflows de Proceso -->
          <MetricBentoWidget
            title="Workflows de Proceso"
            category="InvGate"
            href="reportes/workflows"
            icon="boxicons:git-repo-forked-filled"
            iconTone="text-accent"
            iconBoxTone="bg-accent/10"
            badge={`${workflowMetrics.totalCount} casos`}
            badgeTone="badge-soft badge-accent"
          >
            <div class="space-y-3 text-sm">
              <div
                class="border-base-200/50 flex items-baseline justify-between border-b py-1"
              >
                <span class="text-base-content/70 text-sm"
                  >Casos completados</span
                >
                <span class="text-base-content font-mono text-sm font-bold">
                  {workflowMetrics.completedCount}
                </span>
              </div>
              <div
                class="border-base-200/50 flex items-baseline justify-between border-b py-1"
              >
                <span class="text-base-content/70 text-sm"
                  >Duración promedio</span
                >
                <span class="text-base-content font-mono text-sm font-bold">
                  {(workflowMetrics.avgHours ?? 0).toFixed(1)} hs
                </span>
              </div>

              <!-- Micro-gráfico: Barra de progreso de cumplimiento de SLA -->
              <div class="space-y-1.5 pt-1.5">
                <div
                  class="text-base-content/60 flex justify-between font-mono text-xs"
                >
                  <span>Cumplimiento SLA</span>
                  <span class="text-accent font-bold"
                    >{workflowMetrics.slaPercent}%</span
                  >
                </div>
                <progress
                  class="progress progress-accent w-full"
                  value={workflowMetrics.slaPercent}
                  max="100"
                  aria-label={`SLA cumplido en ${workflowMetrics.slaPercent}%`}
                ></progress>
              </div>
            </div>
          </MetricBentoWidget>

          <!-- Widget 4: Red de Oficinas -->
          <MetricBentoWidget
            title="Red de Oficinas"
            category="Infraestructura"
            href="oficinas/estadisticas"
            icon="boxicons:building-house-filled"
            iconTone="text-success"
            iconBoxTone="bg-success/10"
            badge={`${officeMetrics.total.toLocaleString("es-AR")} oficinas`}
            badgeTone="badge-soft badge-success"
          >
            <div class="space-y-3 text-sm">
              <div
                class="border-base-200/50 flex items-baseline justify-between border-b py-1"
              >
                <span class="text-base-content/70 text-sm"
                  >Oficinas activas</span
                >
                <span class="text-base-content font-mono text-sm font-bold">
                  {officeMetrics.active.toLocaleString("es-AR")}
                </span>
              </div>
              <div
                class="border-base-200/50 flex items-baseline justify-between border-b py-1"
              >
                <span class="text-base-content/70 text-sm">Con terminales</span>
                <span class="text-base-content font-mono text-sm font-bold">
                  {officeMetrics.withTerminals.toLocaleString("es-AR")}
                </span>
              </div>

              <!-- Micro-gráfico: Ratio de cobertura operativa -->
              <div class="space-y-1.5 pt-1.5">
                <div
                  class="text-base-content/60 flex justify-between font-mono text-xs"
                >
                  <span>Cobertura operativa</span>
                  <span class="text-success font-bold">
                    {
                      officeMetrics.total > 0
                        ? Math.round(
                            (officeMetrics.active / officeMetrics.total) * 100,
                          )
                        : 0
                    }%
                  </span>
                </div>
                <progress
                  class="progress progress-success w-full"
                  value={officeMetrics.total > 0
                    ? Math.round(
                        (officeMetrics.active / officeMetrics.total) * 100,
                      )
                    : 0}
                  max="100"
                  aria-label="Porcentaje de oficinas activas en red"></progress>
              </div>
            </div>
          </MetricBentoWidget>

          <!-- Widget 5: Inventario de Terminales -->
          <MetricBentoWidget
            title="Inventario de Terminales"
            category="Hardware"
            href="inventario-terminales/estadisticas"
            icon="boxicons:desktop-filled"
            iconTone="text-accent"
            iconBoxTone="bg-accent/10"
            badge={`${terminalMetrics.total.toLocaleString("es-AR")} puestos`}
            badgeTone="badge-soft badge-accent"
          >
            <div class="space-y-3 text-sm">
              <div
                class="border-base-200/50 flex items-baseline justify-between border-b py-1"
              >
                <span class="text-base-content/70 text-sm"
                  >Equipos con Windows</span
                >
                <span class="text-base-content font-mono text-sm font-bold">
                  {terminalMetrics.winCount.toLocaleString("es-AR")}
                </span>
              </div>
              <div
                class="border-base-200/50 flex items-baseline justify-between border-b py-1"
              >
                <span class="text-base-content/70 text-sm"
                  >Fabricantes registrados</span
                >
                <span class="text-base-content font-mono text-sm font-bold">
                  {terminalMetrics.brandsCount}
                </span>
              </div>

              <!-- Micro-gráfico: Adopción SO estándar -->
              <div class="space-y-1.5 pt-1.5">
                <div
                  class="text-base-content/60 flex justify-between font-mono text-xs"
                >
                  <span>Estandarización SO</span>
                  <span class="text-accent font-bold">
                    {
                      terminalMetrics.total > 0
                        ? Math.round(
                            (terminalMetrics.winCount / terminalMetrics.total) *
                              100,
                          )
                        : 0
                    }% Windows
                  </span>
                </div>
                <progress
                  class="progress progress-accent w-full"
                  value={terminalMetrics.total > 0
                    ? Math.round(
                        (terminalMetrics.winCount / terminalMetrics.total) *
                          100,
                      )
                    : 0}
                  max="100"
                  aria-label="Equipos bajo estándar Windows"></progress>
              </div>
            </div>
          </MetricBentoWidget>

          <!-- Widget 6: Centro de Automatizaciones -->
          <MetricBentoWidget
            title="Centro de Automatizaciones"
            category="Automatización"
            href="automatizaciones"
            icon="boxicons:rocket-filled"
            iconTone="text-secondary"
            iconBoxTone="bg-secondary/10"
            badge={`${automationMetrics.totalParents.toLocaleString("es-AR")} procesos`}
            badgeTone="badge-soft badge-secondary"
          >
            <div class="space-y-3 text-sm">
              <div
                class="border-base-200/50 flex items-baseline justify-between border-b py-1"
              >
                <span class="text-base-content/70 text-sm"
                  >Procesos cerrados</span
                >
                <span class="text-base-content font-mono text-sm font-bold">
                  {automationMetrics.totalClosed.toLocaleString("es-AR")}
                </span>
              </div>
              <div
                class="border-base-200/50 flex items-baseline justify-between border-b py-1"
              >
                <span class="text-base-content/70 text-sm"
                  >Procesos en curso</span
                >
                <span class="text-base-content font-mono text-sm font-bold">
                  {automationMetrics.inProgress}
                </span>
              </div>

              <!-- Micro-gráfico: Embudo de finalización -->
              <div class="space-y-1.5 pt-1.5">
                <div
                  class="text-base-content/60 flex justify-between font-mono text-xs"
                >
                  <span>Tasa de resolución</span>
                  <span class="text-secondary font-bold">
                    {
                      automationMetrics.totalParents > 0
                        ? Math.round(
                            (automationMetrics.totalClosed /
                              automationMetrics.totalParents) *
                              100,
                          )
                        : 0
                    }%
                  </span>
                </div>
                <progress
                  class="progress progress-secondary w-full"
                  value={automationMetrics.totalParents > 0
                    ? Math.round(
                        (automationMetrics.totalClosed /
                          automationMetrics.totalParents) *
                          100,
                      )
                    : 0}
                  max="100"
                  aria-label="Porcentaje de procesos de automatización completados"
                ></progress>
              </div>
            </div>
          </MetricBentoWidget>
        </div>
      </section>

      <!-- Última columna: Lista de atajos rápidos -->
      <section
        class="space-y-4 lg:col-span-1"
        aria-label="Atajos rápidos a reportes"
      >
        <div class="flex flex-col gap-2.5">
          {
            quickShortcuts.map((s) => (
              <QuickAccessCard
                title={s.title}
                description=""
                href={`${cleanBase}${s.href}`}
                icon={s.icon}
                iconTone={s.tone}
                layout="mini"
              />
            ))
          }
        </div>
      </section>
    </div>
  </PageContainer>
</BaseLayout>
