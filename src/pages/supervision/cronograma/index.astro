---
import { getCleanBase } from "@lib/baseUrl";
import BaseLayout from "@layouts/BaseLayout.astro";
import CronogramaDashboard from "@components/cronograma/CronogramaDashboard.astro";
import { Icon } from "astro-icon/components";
import PageContainer from "@components/ui/PageContainer.astro";
import { normalizeRole } from "@lib/rbac";
const cleanBase = getCleanBase();

const user = Astro.locals.user;
const role = normalizeRole(user.role);
---

<BaseLayout>
  <PageContainer width="xl" id="crono-page-container">
    <CronogramaDashboard userRole={role} currentUser={user} />
  </PageContainer>
</BaseLayout>

<style is:global>
  body:has(#monthly-view:not(.hidden)) main,
  body:has(#daily-view:not(.hidden)) main,
  body:has(#groups-view:not(.hidden)) main,
  body:has(#overtime-view:not(.hidden)) main,
  body:has(#pasiva-view:not(.hidden)) main {
    overflow-y: hidden !important;
    display: flex !important;
    flex-direction: column !important;
  }

  body:has(#monthly-view:not(.hidden)) #crono-page-container,
  body:has(#daily-view:not(.hidden)) #crono-page-container,
  body:has(#groups-view:not(.hidden)) #crono-page-container,
  body:has(#overtime-view:not(.hidden)) #crono-page-container,
  body:has(#pasiva-view:not(.hidden)) #crono-page-container {
    flex: 1;
    min-height: 0;
  }

  body:has(#groups-view:not(.hidden)) #cronograma-container {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  body:has(#groups-view:not(.hidden)) #cronograma-container::-webkit-scrollbar {
    display: none;
  }
</style>
