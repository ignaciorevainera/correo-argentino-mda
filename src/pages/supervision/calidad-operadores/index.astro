---
import BaseLayout from "@layouts/BaseLayout.astro";
import CalidadContent from "@components/supervision/calidad/CalidadContent.astro";
import CalidadSkeleton from "@components/supervision/calidad/CalidadSkeleton.astro";

const cookieMonth = Astro.cookies.get("calidad_month")?.value;
const validCookieMonth =
  cookieMonth && /^\d{2}-\d{4}$/.test(cookieMonth) ? cookieMonth : undefined;
const month = Astro.url.searchParams.get("month") ?? validCookieMonth;
---

<BaseLayout>
  <CalidadContent server:defer month={month}>
    <CalidadSkeleton slot="fallback" />
  </CalidadContent>
</BaseLayout>
