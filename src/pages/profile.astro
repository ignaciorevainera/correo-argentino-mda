---
import ActionButton from "@components/ui/ActionButton.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import DetailList from "@components/ui/DetailList.astro";
import FlagList from "@components/ui/FlagList.astro";
import QuickAccessCard from "@components/ui/QuickAccessCard.astro";
import { Icon } from "astro-icon/components";
import {
  formatSessionExpiry,
  getProfileDetails,
  getVisibleProfileAccess,
} from "@lib/profileAccess";
import { normalizeRole } from "@lib/rbac";
import { db } from "@db/index";
import { users } from "@db/schema";
import { eq } from "drizzle-orm";

const user = Astro.locals.user;
if (!user || user.id === 0) {
  return Astro.redirect(
    (import.meta.env.BASE_URL || "/").replace(/\/$/, "") + "/login",
  );
}

const roleLabelMap: Record<string, string> = {
  admin: "Administrador",
  supervisor: "Supervisor",
  team_leader: "Team Leader",
  "team-leader": "Team Leader",
  "team leader": "Team Leader",
  referent: "Referente",
  agent: "Agente",
};

const roleAvatarClasses: Record<string, string> = {
  admin: "bg-error/10 text-error ring-error/20",
  supervisor: "bg-info/10 text-info ring-info/20",
  team_leader: "bg-accent/10 text-accent ring-accent/20",
  "team-leader": "bg-accent/10 text-accent ring-accent/20",
  "team leader": "bg-accent/10 text-accent ring-accent/20",
  referent: "bg-warning/10 text-warning ring-warning/20",
  agent: "bg-neutral/10 text-neutral-content ring-neutral/20",
};

const badgeClasses: Record<string, string> = {
  admin: "badge-error",
  supervisor: "badge-info",
  team_leader: "badge-accent",
  "team-leader": "badge-accent",
  "team leader": "badge-accent",
  referent: "badge-warning",
  agent: "badge-neutral",
};

const role = normalizeRole(user.role);
const roleLabel = roleLabelMap[role] ?? "Agente";
const avatarClass = roleAvatarClasses[role] ?? roleAvatarClasses.agent;
const badgeClass = badgeClasses[role] ?? badgeClasses.agent;

const { employee, agent, sessionExpiresAt } = await getProfileDetails({
  userId: user.id,
  username: user.username,
  sessionId: Astro.locals.sessionId,
});

const [currentUser] = await db
  .select({ authProvider: users.authProvider, hasPassword: users.password })
  .from(users)
  .where(eq(users.id, user.id));

const canChangePassword = currentUser?.authProvider === "local" && Boolean(currentUser.hasPassword);

const displayName =
  employee?.fullname?.trim() || agent?.name?.trim() || user.username;
const initials =
  displayName
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join("")
    .toUpperCase() || user.username.slice(0, 2).toUpperCase();

const sessionExpiry = formatSessionExpiry(sessionExpiresAt);
const accessSections = getVisibleProfileAccess(role, user.helpdeskName);
const accessTotal = accessSections.reduce(
  (total, section) => total + section.entries.length,
  0,
);

const identityItems = [
  { label: "Usuario", value: user.username, mono: true },
  { label: "Nombre y apellido", value: employee?.fullname ?? "" },
  { label: "DNI", value: employee?.dni ?? "", mono: true },
  { label: "Legajo", value: employee?.interno ?? "", mono: true },
  { label: "Puesto", value: employee?.position ?? "" },
  { label: "Teléfono", value: employee?.telefono ?? "", mono: true },
  {
    label: "Sucursal",
    value: employee?.officeName
      ? `${employee.officeName} (${employee.sucursal ?? ""})`.trim()
      : (employee?.sucursal ?? ""),
  },
  {
    label: "Id InvGate",
    value: employee?.invgateId != null ? String(employee.invgateId) : "",
    mono: true,
  },
];

const accountItems = [
  { label: "Rol", value: roleLabel },
  { label: "Mesa de ayuda", value: user.helpdeskName ?? "Sin mesa asignada" },
  {
    label: "Estado InvGate",
    value: employee?.invgateExists
      ? "Sincronizado con InvGate"
      : "Sin sincronizar con InvGate",
  },
  { label: "Vence", value: sessionExpiry ?? "" },
];

const operatorItems = [
  { label: "Centro de asignación", value: agent?.location ?? "" },
  { label: "Horario por defecto", value: agent?.horarioDefault ?? "" },
  {
    label: "Estado excepcional",
    value: agent?.estadoExcepcional
      ? `${agent.estadoExcepcional}${agent.estadoExcepcionalMotivo ? ` — ${agent.estadoExcepcionalMotivo}` : ""}`
      : "",
  },
];

const participations = agent
  ? [
      {
        label: "Cronograma",
        icon: "boxicons:calendar-filled",
        active: agent.enCronograma,
      },
      {
        label: "Asistencia",
        icon: "boxicons:clock-filled",
        active: agent.enAsistencia,
      },
      {
        label: "Calidad",
        icon: "boxicons:bar-chart-big-filled",
        active: agent.incluidoCalidad,
      },
      {
        label: "Cubics",
        icon: "boxicons:desktop-filled",
        active: agent.asignableCubic,
      },
      {
        label: "Autogestiones",
        icon: "boxicons:git-branch-filled",
        active: agent.asignableAgs,
      },
    ]
  : [];
---

<BaseLayout title="Perfil">
  <PageContainer>
    <PageHeader
      title="Perfil"
      description="Tus datos, tu mesa de ayuda y los accesos habilitados hoy en el sistema."
    />

    <div class="flex flex-col gap-8">
      <section
        aria-labelledby="profile-heading"
        class="card bg-base-100 border-base-300 relative overflow-hidden border shadow-sm"
      >
        <div
          class="from-primary/5 pointer-events-none absolute inset-0 bg-linear-to-br via-transparent to-transparent opacity-50"
          aria-hidden="true"
        >
        </div>
        <div class="card-body gap-6 p-6 md:p-8">
          <div
            class="z-10 flex flex-col items-start gap-5 md:flex-row md:items-center"
          >
            <div
              class:list={[
                "flex h-20 w-20 shrink-0 items-center justify-center rounded-full text-2xl font-black shadow-inner ring-4 md:h-24 md:w-24 md:text-3xl",
                avatarClass,
              ]}
              aria-hidden="true"
            >
              {initials}
            </div>
            <div class="flex min-w-0 flex-col gap-2">
              <div class="flex flex-wrap items-center gap-2">
                <h1
                  id="profile-heading"
                  class="text-base-content text-2xl font-bold tracking-tight md:text-3xl"
                >
                  {displayName}
                </h1>
                <span
                  class:list={[
                    "badge badge-sm font-bold tracking-wider uppercase",
                    badgeClass,
                  ]}
                >
                  {roleLabel}
                </span>
              </div>
              <p class="text-base-content/60 font-mono text-sm">
                {user.username}
              </p>
              <div class="mt-1">
                {
                  canChangePassword ? (
                    <ActionButton
                      icon="boxicons:lock-open-filled"
                      color="btn-neutral"
                      ariaLabel="Blanqueo de contraseña"
                      label="Blanqueo de contraseña"
                      aria-haspopup="dialog"
                      onclick="document.getElementById('modal-self-password').showModal()"
                    />
                  ) : (
                    <span class="badge badge-outline border-base-300 text-base-content/60 text-xs">
                      Autenticación administrada por Azure AD
                    </span>
                  )
                }
              </div>
            </div>
          </div>

          <div
            class="border-base-200 z-10 grid gap-6 border-t pt-6 md:grid-cols-2"
          >
            <div class="space-y-3">
              <h2
                class="text-base-content/70 flex items-center gap-2 text-sm font-bold tracking-tight"
              >
                <Icon
                  name="boxicons:user-circle-filled"
                  size={18}
                  class="text-secondary shrink-0"
                  aria-hidden="true"
                />
                Datos personales
              </h2>
              <DetailList items={identityItems} columns={2} />
            </div>
            <div class="space-y-3">
              <h2
                class="text-base-content/70 flex items-center gap-2 text-sm font-bold tracking-tight"
              >
                <Icon
                  name="boxicons:key-filled"
                  size={18}
                  class="text-secondary shrink-0"
                  aria-hidden="true"
                />
                Cuenta y acceso
              </h2>
              <DetailList items={accountItems} columns={2} />
            </div>
          </div>
        </div>
      </section>

      {
        agent && (
          <section
            aria-labelledby="operator-heading"
            class="card bg-base-100 border-base-300 border shadow-sm"
          >
            <div class="card-body gap-5 p-6">
              <div class="space-y-1">
                <h2
                  id="operator-heading"
                  class="text-base-content text-lg font-bold tracking-tight"
                >
                  Operativa y participaciones
                </h2>
                <p class="text-base-content/60 text-xs">
                  Flags de tu ficha de operador: definen en qué módulos sos
                  evaluado y qué turnos podés recibir.
                </p>
              </div>
              <DetailList items={operatorItems} columns={2} />
              <FlagList flags={participations} class="pt-2" />
            </div>
          </section>
        )
      }

      <section aria-labelledby="access-heading" class="space-y-5">
        <div class="flex flex-wrap items-end justify-between gap-2">
          <h2
            id="access-heading"
            class="text-base-content text-xl font-bold tracking-tight"
          >
            Accesos permitidos
          </h2>
          <p class="text-base-content/60 text-xs">
            {accessTotal}
            {accessTotal === 1 ? "módulo" : "módulos"} disponibles para tu rol y tu
            mesa de ayuda.
          </p>
        </div>

        {
          accessSections.map((section) => (
            <div class="space-y-3">
              <div class="flex flex-wrap items-baseline gap-x-2">
                <h3 class="text-base-content/70 text-xs font-bold tracking-wider uppercase">
                  {section.label}
                </h3>
                <p class="text-base-content/50 text-xs">
                  {section.description}
                </p>
              </div>
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                {section.entries.map((entry) => (
                  <QuickAccessCard
                    href={entry.href}
                    title={entry.title}
                    description={entry.description}
                    icon={entry.icon}
                    iconTone={entry.iconTone}
                    layout="mini"
                  />
                ))}
              </div>
            </div>
          ))
        }

        {
          accessTotal === 0 && (
            <div class="border-base-300 bg-base-200/50 rounded-2xl border border-dashed p-12 text-center">
              <Icon
                name="boxicons:lock-filled"
                size={40}
                class="text-base-content mx-auto mb-3 opacity-30"
                aria-hidden="true"
              />
              <h3 class="text-base-content/80 text-base font-semibold">
                Sin accesos disponibles
              </h3>
              <p class="text-base-content/60 mt-1 text-sm">
                Tu rol y tu mesa de ayuda no habilitan ningún módulo del
                sistema. Contactá a un administrador si necesitás acceso a
                alguna funcionalidad.
              </p>
            </div>
          )
        }
      </section>
    </div>
  </PageContainer>
</BaseLayout>
