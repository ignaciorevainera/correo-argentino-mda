---
import { getCleanBase } from "@lib/baseUrl";
import "@styles/global.css";
import geistLatinWoff2 from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import geistMonoLatinWoff2 from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";

// Utils
import {
  navSections,
  getSectionTitle,
  getResolvedPathname,
  type NavItem,
} from "@lib/navigation";
import { normalizeRole, hasPermission } from "@lib/rbac";
import { isSectionVisibleSync } from "@lib/helpdeskAccess";
import { getUnassignedFeedbackCount } from "@lib/getUnassignedFeedbackCount";
import { COLUMN_CAP_SM, COLUMN_CAP_LG } from "@lib/enlacesColumns";
import { DEFAULT_VIEW_COLUMNS } from "@lib/viewMode";
import { ClientRouter } from "astro:transitions";
import { getCsrfTokenForSession } from "@lib/csrf";
import { db } from "@db/index";
import { users } from "@db/schema";
import { eq } from "drizzle-orm";

// Components
import { Navbar, DrawerContent } from "./_components";
import {
  AboutProjectModal,
  FeedbackModal,
  CommandPaletteModal,
  PasswordChangeModal,
} from "@/components/ui/modals";
import ToastContainer from "@components/ui/ToastContainer.astro";
import AsyncFormScript from "@components/admin/ui/AsyncFormScript.astro";
import AdminChatbotWidget from "@/components/admin/ai/AdminChatbotWidget";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const resolvedPath = getResolvedPathname(Astro.request, Astro.url);
const currentPath = resolvedPath;
const rawTitle =
  title || getSectionTitle(resolvedPath) || "Portal Mesa de Ayuda";
const inferredTitle =
  rawTitle &&
  rawTitle !== "Portal MDA" &&
  rawTitle !== "Portal Mesa de Ayuda" &&
  rawTitle !== "Portal"
    ? `Portal MDA | ${rawTitle}`
    : "Portal MDA";

const flattenQuickAccessItems = (items: NavItem[]): NavItem[] =>
  items.flatMap((item) => {
    const nestedChildren = Array.isArray(item.children)
      ? item.children.map((child) => ({
          ...child,
          parentLabel: item.label,
          nested: true,
        }))
      : [];

    return [{ ...item, children: undefined }, ...nestedChildren];
  });

const cleanBase = getCleanBase();
const csrfToken = getCsrfTokenForSession(Astro.locals.sessionId);

const getRelativePath = (path: string) => {
  if (path.startsWith(cleanBase)) {
    return "/" + path.slice(cleanBase.length);
  }
  if (path === cleanBase.slice(0, -1)) {
    return "/";
  }
  return path;
};

const relativeCurrentPath = getRelativePath(currentPath);
const isLoginRoute = /^\/login\/?$/.test(relativeCurrentPath);

/**
 * View transitions scoped al módulo de automatizaciones: el ClientRouter
 * solo se inyecta en sus rutas, así que el resto del portal navega de forma
 * tradicional sin riesgo para las páginas con scripts pesados.
 */
const isAutomationModule = /^\/automatizaciones(\/|$)/.test(
  relativeCurrentPath,
);

const isActiveRoute = (href: string) =>
  href === "/"
    ? relativeCurrentPath === "/"
    : relativeCurrentPath === href ||
      relativeCurrentPath.startsWith(`${href}/`);

const user = Astro.locals.user;
const normalizedUserRole = normalizeRole(user.role);
const viewAs = Astro.locals.viewAs;
// Rol efectivo para la capa de presentación (sidebar/home/cards). La cookie
// sólo la aplica el middleware si el rol real es admin.
const effectiveRole = viewAs?.role ?? normalizedUserRole;
const effectiveMesa = user?.helpdeskName ?? (viewAs ? "TI_GSM_MDA TI" : null);
const isRealAdmin = normalizedUserRole === "admin";
const isPublicGeneratorRoute =
  user.id === 0 && /^\/generador-firmas\/?$/.test(relativeCurrentPath);

let canChangePassword = false;
let passwordChangedAt: Date | null = null;
if (user.id > 0) {
  const [account] = await db
    .select({
      authProvider: users.authProvider,
      hasPassword: users.password,
      passwordChangedAt: users.passwordChangedAt,
    })
    .from(users)
    .where(eq(users.id, user.id));
  canChangePassword =
    account?.authProvider === "local" && Boolean(account.hasPassword);
  passwordChangedAt = account?.passwordChangedAt ?? null;
}

let unassignedFeedbackCount = 0;
if (effectiveRole === "admin") {
  unassignedFeedbackCount = await getUnassignedFeedbackCount();
}

const isRouteLocked = (href: string): boolean => {
  const lowerHref = href.toLowerCase();
  if (
    user.id === 0 &&
    (lowerHref === "/supervision" ||
      lowerHref.startsWith("/supervision/") ||
      lowerHref === "/admin" ||
      lowerHref.startsWith("/admin/"))
  ) {
    return true;
  }
  if (!hasPermission(href, effectiveRole)) return true;
  if (!isSectionVisibleSync(effectiveMesa, effectiveRole, href)) return true;
  return false;
};

let visibleNavSections = navSections
  .map((section) => ({
    ...section,
    items: section.items.filter(
      (item) => !isRouteLocked(item.href) && item.href !== "/supervision",
    ),
  }))
  .filter((section) => section.items.length > 0);

const quickAccessItems: NavItem[] = visibleNavSections.flatMap((section) =>
  flattenQuickAccessItems(section.items),
);

const globalFontFaceCss = `
  @font-face {
    font-family: "Geist Variable";
    src: url("${geistLatinWoff2}") format("woff2");
    font-display: swap;
    font-style: normal;
    font-weight: 100 900;
  }

  @font-face {
    font-family: "Geist Mono Variable";
    src: url("${geistMonoLatinWoff2}") format("woff2");
    font-display: swap;
    font-style: normal;
    font-weight: 100 900;
  }
`;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    {isAutomationModule && <ClientRouter />}

    <script
      is:inline
      define:vars={{ capSm: COLUMN_CAP_SM, capLg: COLUMN_CAP_LG, defaultColumns: DEFAULT_VIEW_COLUMNS }}
    >
      const applyTheme = () => {
        const savedTheme = localStorage.getItem("theme");
        const theme =
          savedTheme === "light" || savedTheme === "dark"
            ? savedTheme
            : "light";
        document.documentElement.setAttribute("data-theme", theme);

        const root = document.documentElement;
        const mode = localStorage.getItem("enlacesViewMode");
        if (mode === "compact" || mode === "normal" || mode === "large") {
          root.setAttribute("data-view-mode", mode);
        }
        const cols = localStorage.getItem("enlacesViewColumns");
        // 767/1280: umbrales de @lib/enlacesColumns (fuente única, inyectada).
        const cap = window.innerWidth < capSm ? 1 : window.innerWidth < capLg ? 2 : 4;
        const pref =
          cols === "1" || cols === "2" || cols === "3" || cols === "4"
            ? Number(cols)
            : defaultColumns;
        // Se aplica SIEMPRE (no solo con valor guardado): cubre al usuario
        // default (sin localStorage), que si no pintaria el :root 3 y el
        // island lo bajaria al cap -> flash. Mismo ancho (viewport) y mismo
        // calculo que applyEffectiveColumns() del island, sobre <html>.
        const effective = String(Math.min(pref, cap));
        root.setAttribute("data-view-columns", effective);
        root.style.setProperty("--columns-effective", effective);

        const toggle = document.getElementById("theme-toggle");
        if (toggle instanceof HTMLInputElement) {
          toggle.checked = theme === "dark";
        }
      };
      applyTheme();
      // En view transitions el swap no re-ejecuta este script y el html nuevo
      // llega sin data-theme (daisyUI --prefersdark secuestraria el tema):
      // se re-aplica el tema guardado inmediatamente despues de cada swap.
      document.addEventListener("astro:after-swap", applyTheme);
      // Persistencia + aplicacion del tema: delegacion en document (sobrevive
      // a los swaps, a diferencia de los listeners por-elemento de theme-change).
      document.addEventListener("change", (event) => {
        if (
          event.target instanceof HTMLInputElement &&
          event.target.classList.contains("theme-controller")
        ) {
          const theme = event.target.checked ? "dark" : "light";
          localStorage.setItem("theme", theme);
          document.documentElement.setAttribute("data-theme", theme);
        }
      });
    </script>
    <style is:global set:html={globalFontFaceCss}></style>
    <link
      rel="preload"
      href={geistLatinWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={geistMonoLatinWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" type="image/svg+xml" href={`${cleanBase}favicon.svg`} />

    <meta name="apple-mobile-web-app-title" content="MDA" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {csrfToken && <meta name="csrf-token" content={csrfToken} />}
    <link rel="manifest" href={`${cleanBase}site.webmanifest`} />

    <title>{inferredTitle}</title>
  </head>

  <body
    class="bg-base-100 text-base-content min-h-screen max-w-full overflow-x-hidden"
  >
    {
      isLoginRoute ? (
        // El login define su propio layout (panel de marca + formulario).
        <div class="min-h-screen">
          <slot />
        </div>
      ) : isPublicGeneratorRoute ? (
        <div class="flex h-screen flex-col overflow-hidden">
          <Navbar
            user={user}
            normalizedUserRole={normalizedUserRole}
            minimal
          />
          <main class="flex-1 overflow-x-hidden overflow-y-auto p-4 [scrollbar-gutter:stable_both-edges] md:p-6">
            <slot />
          </main>
        </div>
      ) : (
        <div class="drawer lg:drawer-open h-screen overflow-hidden">
          <input
            id="main-drawer"
            type="checkbox"
            class="drawer-toggle"
            aria-label="toggle sidebar"
          />
          <DrawerContent
            visibleNavSections={visibleNavSections}
            isActiveRoute={isActiveRoute}
            isRouteLocked={isRouteLocked}
            unassignedFeedbackCount={unassignedFeedbackCount}
          />

          <div class="drawer-content flex h-screen max-w-full flex-col overflow-hidden">
        <!-- Navbar -->
        <Navbar
          user={user}
          normalizedUserRole={effectiveRole}
          isRealAdmin={isRealAdmin}
          viewAs={viewAs}
          canChangePassword={canChangePassword}
        />

        {
          viewAs && (
            <div
              data-view-as-banner
              class="border-secondary/30 bg-secondary/10 text-secondary dark:border-accent/40 dark:bg-accent/10 dark:text-accent flex flex-wrap items-center justify-between gap-2 border-b px-4 py-1.5 text-xs"
            >
              <span>
                Viendo como <strong>{viewAs.label}</strong> · vista previa (tus
                permisos reales no cambian)
              </span>
              <form method="POST" action={`${cleanBase}api/admin/view-as`}>
                <input type="hidden" name="csrf_token" value={csrfToken} />
                <input type="hidden" name="profile" value="none" />
                <button
                  type="submit"
                  class="btn btn-soft btn-secondary dark:btn-accent btn-xs"
                  data-exit-view-as
                >
                  Salir
                </button>
              </form>
            </div>
          )
        }

        <!-- Main content -->
        <main
          class="flex-1 overflow-x-hidden overflow-y-auto p-4 [scrollbar-gutter:stable_both-edges] md:p-6"
        >
          <slot />
        </main>
      </div>
    </div>
      )
    }
  </body>

  <!-- Modals & Toast's container-->
  {
    !isLoginRoute && !isPublicGeneratorRoute && (
      <>
        <CommandPaletteModal
          items={quickAccessItems}
          isRouteLocked={isRouteLocked}
        />
        <AboutProjectModal />
      </>
    )
  }
  <FeedbackModal />
  {canChangePassword && (
    <PasswordChangeModal lastChangedAt={passwordChangedAt} />
  )}
  <ToastContainer />
  <AsyncFormScript />
  {effectiveRole === "admin" && (
    <div class="hidden md:block">
      <AdminChatbotWidget client:idle />
    </div>
  )}

  <script src="../../scripts/toggle-mode.ts"></script>
</html>
